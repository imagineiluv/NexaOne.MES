<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Use the same evaluated plugin set as the host. This keeps build output, publish output, and
       child-process bundle smoke aligned when a future product profile replaces Cleaner. -->
  <Import Project="..\..\eng\product-profiles\NexaOne.ProductProfiles.props" />

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.*" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <!-- MSSQL 방언 실검증(MssqlDialectSyntaxTests, env-gate NEXAONE_MSSQL_TEST_CONN)용 — 미설정 시 소프트 스킵. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />
    <PackageReference Include="bunit" Version="2.9.0" />
    <!-- GHSA-pgww-w46g-26qg가 수정된 AngleSharp patch를 명시적으로 고정한다. -->
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="Moq" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\00.Main\NexaOne.Server\NexaOne.Server.csproj" />
    <!-- Integration tests use the shared domain implementations directly; project-owned policy
         references follow the selected packaging profile. -->
    <ProjectReference Include="@(NexaOneProductPlugin)" />
  </ItemGroup>

  <!-- Product-specific tests follow the same selected profile boundary as their project reference.
       PomOnly must compile without importing any Cleaner source or assembly. -->
  <ItemGroup Condition="'$(NexaOneProductProfileName)' != 'Cleaner'">
    <Compile Remove="CleanerProjectionAuthorityValidatorTests.cs" />
  </ItemGroup>

  <!-- Child-process smoke runs the host copied into this exact test output. Populate its plugin
       folder from the current ProjectReference outputs so an external artifacts path cannot fall back to
       an older src/**/bin tree. -->
  <Target Name="PrepareCurrentHostSmokeOutput" AfterTargets="Build">
    <MSBuild Projects="@(NexaOneProductPlugin)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_CurrentHostSmokeModule" />
    </MSBuild>
    <Error Condition="!Exists('%(_CurrentHostSmokeModule.FullPath)')"
           Text="Current host-smoke module output is missing: %(_CurrentHostSmokeModule.FullPath)" />
    <ItemGroup>
      <_StaleCurrentHostSmokeModule Include="$(OutDir)Modules\NexaOne.*.dll" />
      <_StaleCurrentHostSmokeModule Include="$(OutDir)Modules\*.deps.json" />
    </ItemGroup>
    <Delete Files="@(_StaleCurrentHostSmokeModule)" />
    <Copy SourceFiles="@(_CurrentHostSmokeModule)"
          DestinationFolder="$(OutDir)Modules"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
