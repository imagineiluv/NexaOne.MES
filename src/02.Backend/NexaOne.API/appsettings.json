{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "_comment": "Provider: MsSql(기본) | Sqlite. 코드 수정/재빌드 없이 이 값과 ConnectionStrings:NexaOne만 바꿔 전환. SQLite 예: \"Data Source=nexaone.db\"",
    "Provider": "MsSql"
  },
  "ConnectionStrings": {
    "NexaOne": "Server=localhost;Database=NexaOneEES;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_32_BYTES_MINIMUM_SECRET_KEY",
    "Issuer": "NexaOne",
    "Audience": "NexaOne",
    "AccessTokenExpiryHours": 8,
    "RefreshTokenExpiryDays": 7
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@nexaone.local",
    "FromDisplayName": "NexaOne MES",
    "UseSsl": true
  },
  "AllowedOrigins": [
    "http://localhost:5000"
  ],
  "_comment_Events": "이벤트 버스/Outbox는 기본 비활성(opt-in). 운영에서 Kafka 사용 시 Kafka:Enabled=true + Events:Outbox:Enabled=true. 키를 명시해 운영자가 기본값을 인지하게 한다(코드 기본값과 동일).",
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092"
  },
  "Events": {
    "Outbox": {
      "Enabled": false,
      "Topic": "nexaone.events",
      "PollIntervalMs": 5000,
      "BatchSize": 100,
      "MaxAttempts": 10
    }
  }
}
