{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NexaOne": "Server=localhost;Database=NexaOneEES;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_32_BYTES_MINIMUM_SECRET_KEY",
    "Issuer": "NexaOne",
    "Audience": "NexaOne",
    "AccessTokenExpiryHours": 8,
    "RefreshTokenExpiryDays": 7
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@nexaone.local",
    "FromDisplayName": "NexaOne MES",
    "UseSsl": true
  },
  "AllowedOrigins": [
    "http://localhost:5000"
  ]
}
