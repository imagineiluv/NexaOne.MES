<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NexaOne.Common\NexaOne.Common.csproj" />
    <ProjectReference Include="..\NexaOne.Application\NexaOne.Application.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.Abstractions\NexusCom.Data.Abstractions.csproj" />
    <!-- SqliteProviderFactory가 SqliteProvider를 생성한다(Spring factory-method 우회). SQLite 방언 어댑터
         (SqliteEesDbCapability)도 이 프로젝트에 있어, NexaOne의 SQLite 적응 코드를 한 곳에 모은다. -->
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.Sqlite\NexusCom.Data.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.*" />
    <!-- SQLite 스키마 부트스트랩(SqliteSchemaInitializer) — 로컬/테스트 실행 시 db/migrations를
         SQLite 방언으로 변환해 스키마를 생성한다. NexusCom.Data.Sqlite와 동일 버전으로 고정한다. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
