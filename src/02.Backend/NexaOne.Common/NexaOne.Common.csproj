<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 어셈블리 통합(ADR consolidation): NexaOne.Application / NexaOne.Infrastructure /
       NexaOne.ServiceContracts 세 Default-ALC 공유 프로젝트를 NexaOne.Common 단일 어셈블리로 병합했다.
       소스는 역할별 하위폴더(Application/ Infrastructure/ ServiceContracts/)로 보존되어 추후 재분리가 쉽다.
       네임스페이스는 불변(NexaOne.Application.* 등) — 어셈블리명과 독립이므로 소비자 코드 무변경.
       아래 의존성은 병합된 세 프로젝트 외부 의존성의 합집합(내부 ProjectReference는 단일화로 소멸). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\submodules\NexusFramework\src\NexaFramework\NexaFramework.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaDB\src\NexaDB.Data.Abstractions\NexaDB.Data.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ICacheService 인메모리 구현(MemoryCacheService)용 — IMemoryCache -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.*" />
    <!-- IConfiguration.GetValue<T> 확장(JwtService/RefreshTokenStore) — Default-ALC 어셈블리는 명시 참조 필요. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <!-- SQLite 스키마 부트스트랩(SqliteSchemaInitializer) — NexaDB.Data.Sqlite와 동일 버전으로 고정. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
  </ItemGroup>

</Project>
