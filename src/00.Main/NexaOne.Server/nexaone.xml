    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="equipmentStateMatrixRepository" type="NexaOne.EST.Infrastructure.EquipmentStateMatrixRepository, NexaOne.EST">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="equipmentStateRepository" type="NexaOne.EST.Infrastructure.EquipmentStateRepository, NexaOne.EST">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="equipmentAlarmService" type="NexaOne.EST.Application.Est.EquipmentAlarmService, NexaOne.EST">
