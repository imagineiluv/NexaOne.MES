<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ============================================================================================
       NexaOne.Server = 서비스 빈 컨테이너(ADR-005). 이 파일(자식 컨텍스트)은 9개 도메인 모듈의 서비스와
       그 의존 리포지토리를 빈으로 등록한다. 모든 서비스는 server.xml(부모 컨텍스트)의 '공통 서버 빈'을 ref로
       공통 호출한다: eesDataSource(데이터소스) · appConfiguration(IConfiguration) · eesDialect(SQL 방언) ·
       opcUaDriver(OPC-UA 드라이버, lazy). 외부 조회는 ApplicationServer.GetBean(service, name).

       제외된 서비스(콘솔 컨테이너로 조립 불가 — API/웹 인프라 의존, 빈을 지어내지 않음):
       - MdmMasterService     : ICacheService(캐시) 의존
       - LotTrackingService   : ITrackingMasterGateway(API 조립 계층 어댑터 — 컨테이너에 구현 없음)
       - MenuService          : ILogger<MenuService>(로깅) 의존
       - ConditionSettingService : int maxSavedConditions(스칼라 설정값) 의존
       - DeployService        : IDeployFileStorage(파일시스템 저장소, API 계층 구현) 의존
       위 서비스는 NexaOne.API(ASP.NET DI)에서 해당 인프라와 함께 제공된다.
       ============================================================================================ -->

  <!-- ===== MDM (Master Data Management) ===== -->

  <object id="equipmentRepository" type="NexaOne.MDM.Infrastructure.EquipmentRepository, NexaOne.MDM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="equipmentService" type="NexaOne.MDM.Application.Equipments.EquipmentService, NexaOne.MDM">
    <constructor-arg ref="equipmentRepository" />
  </object>

  <!-- ===== EST (Equipment State Tracking) ===== -->

