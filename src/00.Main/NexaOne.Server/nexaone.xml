  </object>
  <object id="equipmentStateService" type="NexaOne.EST.Application.Est.EquipmentStateService, NexaOne.EST">
    <constructor-arg ref="equipmentStateMatrixRepository" />
    <constructor-arg ref="equipmentStateRepository" />
  </object>

