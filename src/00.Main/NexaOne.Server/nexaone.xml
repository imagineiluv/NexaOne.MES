<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== Shared helpers ===== -->

  <!-- 빈 ConfigurationManager(IConfiguration 구현). 컨테이너에 IConfiguration이 없어 outbox 게이트(config["Events:Outbox:Enabled"])
       가 null→off로 평가되게 한다. 이 NexusFramework 호스트에서는 API 티어가 디스패처를 돌리므로 off가 올바른 기본값(ADR-002). -->
  <object id="appConfiguration" type="Microsoft.Extensions.Configuration.ConfigurationManager, Microsoft.Extensions.Configuration" />

  <!-- eesDialect(INexaOneEESDbCapability)와 eesDataSource는 server.xml(부모 컨텍스트)에 정의된다.
       DB 전환(MSSQL↔SQLite)이 server.xml 한 파일로 끝나도록 dialect를 그쪽에 두고, 여기서는 ref로만 참조한다.
       자식 컨텍스트는 부모 객체를 참조 가능하다(eesDataSource도 동일 방식으로 주입). -->


  <!-- ===== MDM (Master Data Management) ===== -->

  <object id="equipmentRepository"
          type="NexaOne.MDM.Infrastructure.EquipmentRepository, NexaOne.MDM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <object id="equipmentService"
          type="NexaOne.MDM.Application.Equipments.EquipmentService, NexaOne.MDM">
    <constructor-arg ref="equipmentRepository" />
  </object>

  <!-- ===== EST (Equipment State Tracking) — 구 EPT ===== -->

  <object id="equipmentAlarmRepository"
          type="NexaOne.EST.Infrastructure.EquipmentAlarmRepository, NexaOne.EST">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <object id="equipmentAlarmService"
          type="NexaOne.EST.Application.Est.EquipmentAlarmService, NexaOne.EST">
    <constructor-arg ref="equipmentAlarmRepository" />
  </object>

  <!-- ===== FDC (Fault Detection and Classification) ===== -->

  <!-- FdcInterlockRuleRepository는 IConfiguration을 받지 않는다(outbox 비대상) — 데이터소스 단일 인자. -->
  <object id="fdcInterlockRuleRepository"
          type="NexaOne.FDC.Infrastructure.FdcInterlockRuleRepository, NexaOne.FDC">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- FdcInterlockHistoryRepository(EesDataSource, IConfiguration) — config는 ADR-002 outbox opt-in 게이트 판독용. -->
  <object id="fdcInterlockHistoryRepository"
          type="NexaOne.FDC.Infrastructure.FdcInterlockHistoryRepository, NexaOne.FDC">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <!-- FdcInterlockService(ruleRepository, historyRepository) — Spring.NET은 C# 선택적 파라미터(기본 null)를
       인식하지 못하므로 2번째 인자 IFdcInterlockHistoryRepository도 실제 빈으로 주입한다(미주입 시 생성자 매칭 실패). -->
  <object id="fdcInterlockService"
          type="NexaOne.FDC.Application.Fdc.FdcInterlockService, NexaOne.FDC">
    <constructor-arg ref="fdcInterlockRuleRepository" />
    <constructor-arg ref="fdcInterlockHistoryRepository" />
  </object>

  <!-- ===== RMS (Recipe Management System) ===== -->

  <object id="recipeRepository"
          type="NexaOne.RMS.Infrastructure.RecipeRepository, NexaOne.RMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <!-- RecipeService가 추가로 요구하는 파라미터 리포지토리(데이터소스 단일 인자). -->
  <object id="recipeParamRepository"
          type="NexaOne.RMS.Infrastructure.RecipeParamRepository, NexaOne.RMS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- RecipeService(recipeRepository, paramRepository) — 2개 리포지토리 모두 주입. -->
  <object id="recipeService"
          type="NexaOne.RMS.Application.Rms.RecipeService, NexaOne.RMS">
    <constructor-arg ref="recipeRepository" />
    <constructor-arg ref="recipeParamRepository" />
  </object>

  <!-- ===== QMS (Quality Management System) ===== -->

  <object id="defectRepository"
          type="NexaOne.QMS.Infrastructure.DefectRepository, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <!-- QmsService가 추가로 요구하는 리포지토리들(모두 데이터소스 단일 인자). -->
  <object id="defectClassRepository"
          type="NexaOne.QMS.Infrastructure.DefectClassRepository, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <object id="inspectionSpecRepository"
          type="NexaOne.QMS.Infrastructure.InspectionSpecRepository, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <object id="inspectionResultRepository"
          type="NexaOne.QMS.Infrastructure.InspectionResultRepository, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <object id="spcParamRepository"
          type="NexaOne.QMS.Infrastructure.SpcParamRepository, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- QmsService(defect, defectClass, spec, result, spcParam) — 5개 리포지토리 순서대로 주입. -->
  <object id="qmsService"
          type="NexaOne.QMS.Application.Qms.QmsService, NexaOne.QMS">
    <constructor-arg ref="defectRepository" />
    <constructor-arg ref="defectClassRepository" />
    <constructor-arg ref="inspectionSpecRepository" />
    <constructor-arg ref="inspectionResultRepository" />
    <constructor-arg ref="spcParamRepository" />
  </object>

  <!-- ===== CMMS (Computerized Maintenance Management System) — 구 EMS ===== -->

  <object id="workOrderRepository"
          type="NexaOne.CMMS.Infrastructure.WorkOrderRepository, NexaOne.CMMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <object id="cmmsService"
          type="NexaOne.CMMS.Application.Cmms.CmmsService, NexaOne.CMMS">
    <constructor-arg ref="workOrderRepository" />
  </object>

  <!-- ===== POM (Production Order Management) — 구 PPM ===== -->

  <object id="productionPlanRepository"
          type="NexaOne.POM.Infrastructure.ProductionPlanRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <object id="pomService"
          type="NexaOne.POM.Application.Pom.PomService, NexaOne.POM">
    <constructor-arg ref="productionPlanRepository" />
  </object>

  <!-- ===== SHP (Shipment) — 구 DLV ===== -->

  <object id="deliveryOrderRepository"
          type="NexaOne.SHP.Infrastructure.DeliveryOrderRepository, NexaOne.SHP">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <!-- ShpService가 추가로 요구하는 리포지토리들(모두 데이터소스 단일 인자). -->
  <object id="deliveryItemRepository"
          type="NexaOne.SHP.Infrastructure.DeliveryItemRepository, NexaOne.SHP">
    <constructor-arg ref="eesDataSource" />
  </object>

  <object id="shipmentHistoryRepository"
          type="NexaOne.SHP.Infrastructure.ShipmentHistoryRepository, NexaOne.SHP">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- ShpService(orderRepository, itemRepository, historyRepository) — 3개 리포지토리 순서대로 주입. -->
  <object id="shpService"
          type="NexaOne.SHP.Application.Shp.ShpService, NexaOne.SHP">
    <constructor-arg ref="deliveryOrderRepository" />
    <constructor-arg ref="deliveryItemRepository" />
    <constructor-arg ref="shipmentHistoryRepository" />
  </object>

  <!-- ===== SYS ===== -->

  <object id="userRepository"
          type="NexaOne.SYS.Infrastructure.UserRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>

  <!-- UserService가 추가로 요구하는 리포지토리들. -->
  <object id="roleRepository"
          type="NexaOne.SYS.Infrastructure.RoleRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <object id="multiLanguageResourceRepository"
          type="NexaOne.SYS.Infrastructure.MultiLanguageResourceRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- LoginFailureHistoryRepository(dataSource, dialect) — IConfiguration이 아닌 INexaOneEESDbCapability(eesDialect)를 받는다. -->
  <object id="loginFailureHistoryRepository"
          type="NexaOne.SYS.Infrastructure.LoginFailureHistoryRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>

  <!-- UserService(userRepository, roleRepository, langRepository, failureRepository) — 4개 리포지토리 순서대로 주입. -->
  <object id="userService"
          type="NexaOne.SYS.Application.Users.UserService, NexaOne.SYS">
    <constructor-arg ref="userRepository" />
    <constructor-arg ref="roleRepository" />
    <constructor-arg ref="multiLanguageResourceRepository" />
    <constructor-arg ref="loginFailureHistoryRepository" />
  </object>

</objects>
