<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Hallmark app design system: keep the repository-root token file as the single source,
       while exposing it to the Web SDK at /css/tokens.css in development and publish output. -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\..\..\..\tokens.css"
             Link="wwwroot\css\tokens.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 순수 헬퍼(예: BatchProcessWorker.BuildDesired) 격리 단위 테스트를 위해 내부 가시성 부여. -->
    <InternalsVisibleTo Include="NexaOne.ServerTests" />
  </ItemGroup>

  <!-- Portal client(React/GrapesJS) 빌드 통합 — 소스는 Server/ClientApps/Portal이 소유하고,
       vite.config.ts가 번들을 이 호스트의 wwwroot/spa로 출력한다. 공개 URL /spa는 호환을 위해 유지한다.
       publish 시에는 항상 빌드해 정적 자산 파이프라인이 자산을 수집하기 전에 wwwroot/spa가 채워지게 한다.
       일반 dev `dotnet build`에서는 느린 npm 빌드를 기본 비활성화한다(개발자는 -p:BuildSpa=true로 강제 가능). -->
  <PropertyGroup>
    <PortalClientRoot>$(MSBuildProjectDirectory)\ClientApps\Portal\</PortalClientRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApps\**\node_modules\**;ClientApps\**\dist\**;ClientApps\**\*.tsbuildinfo</DefaultItemExcludes>
    <!-- dev 빌드 게이트: 기본 off. publish는 _IsPublishing(=true) 조건으로 게이트와 무관하게 빌드한다. -->
    <BuildSpa Condition="'$(BuildSpa)'==''">false</BuildSpa>
  </PropertyGroup>

  <!-- Web SDK가 ClientApps 아래 JSON/소스를 Content로 게시하지 않도록 명시적으로 격리한다.
       IDE 탐색을 위해 소스는 None으로 유지하고, 생성물과 로컬 환경파일은 프로젝트 항목에서 제외한다. -->
  <ItemGroup>
    <Content Remove="ClientApps\**" />
    <None Remove="ClientApps\**" />
    <None Include="ClientApps\**"
          Exclude="ClientApps\**\node_modules\**;ClientApps\**\dist\**;ClientApps\**\*.tsbuildinfo;ClientApps\**\.env;ClientApps\**\*.local" />
  </ItemGroup>

  <ItemGroup>
    <!-- 배치 cron 파서(Gateway/CronSchedule) — 시스템 스케줄러(NexaFramework QuartzScheduler)와 동일 엔진.
         NexaFramework를 통해 전이 참조되지만, CronExpression을 직접 사용하므로 명시 참조로 고정한다. -->
    <PackageReference Include="Quartz" Version="3.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.*" />
    <!-- 통합 호스트(접근 A) — WebApplication. Spring.NET 빈 컨테이너(ApplicationServer)와 공존:
         컨테이너는 모듈 서비스/워커, WebApplication은 HTTP + 워커 수명주기. Hosting은 Sdk.Web 프레임워크에 포함. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\submodules\NexaFramework\src\NexaFramework\NexaFramework.csproj" />
    <ProjectReference Include="..\..\02.Backend\NexaOne.Common\NexaOne.Common.csproj" />
    <ProjectReference Include="..\..\02.Backend\NexaOne.Infrastructure.Messaging\NexaOne.Infrastructure.Messaging.csproj" />
    <!-- Phase 4 Task 3 — 공유 Blazor 컴포넌트 RCL(MetaScreen·렌더러·인증/ApiClient 서비스). Default ALC 일반 참조로
         호스트와 NexaOne.Web(exe)이 동일 컴포넌트 단일 출처를 공유한다. plugin(./Modules) 복사 대상 아님
         (CopyDomainModulePlugins는 모듈 DLL만 나열 — 무변경) → ADR-006 ALC 동일성 불변. -->
    <ProjectReference Include="..\..\01.Web\NexaOne.Web.Components\NexaOne.Web.Components.csproj" />
    <!-- PLC DriverFactory와 실제 프로토콜 드라이버는 공통 서버(Spring 부모) 빈으로 조합한다.
         부모 컨텍스트(Default ALC)에 Hosting/IPlcDriver 타입이 있어야 FDC 플러그인 모듈과 타입 동일성이 유지된다. -->
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.Hosting\NexaLogic.Plc.Hosting.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.OpcUa\NexaLogic.Plc.OpcUa.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.ModbusTcp\NexaLogic.Plc.ModbusTcp.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.SiemensS7\NexaLogic.Plc.SiemensS7.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.MitsubishiMc\NexaLogic.Plc.MitsubishiMc.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaLogic\src\NexaLogic.Plc.AllenBradley\NexaLogic.Plc.AllenBradley.csproj" />
    <!-- DB 공급자는 NexaDB.Data 메타 패키지 '하나'로 참조한다 — 이 단일 참조가 MsSql·Sqlite 두 공급자
         어셈블리를 함께 출력에 끌어온다(어셈블리는 분리 유지). 따라서 코드 재빌드 없이 server.xml만 바꿔
         MSSQL↔SQLite를 전환할 수 있다(두 공급자 DLL이 호스트 Default ALC에 상존). -->
    <ProjectReference Include="..\..\..\submodules\NexaDB\src\NexaDB.Data\NexaDB.Data.csproj" />
    <!-- 공통 Dapper 조회 seam의 성공/지연/timeout/error를 System.Diagnostics.Metrics로 노출한다.
         Hosting 프로젝트의 서비스 호스트는 사용하지 않고 DataDiagnosticsMeterSink만 조합한다. -->
    <ProjectReference Include="..\..\..\submodules\NexaDB\src\NexaDB.Data.Hosting\NexaDB.Data.Hosting.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexaDB\src\NexaDB.Data.PostgreSql\NexaDB.Data.PostgreSql.csproj" Condition="'$(DbmsType)'=='PostgreSQL'" />
    <ProjectReference Include="..\..\..\submodules\NexaDB\src\NexaDB.Data.MySql\NexaDB.Data.MySql.csproj" Condition="'$(DbmsType)'=='MySQL'" />
  </ItemGroup>

  <!-- SQLite 모드에서 SqliteSchemaInitializer가 출력 디렉터리 옆(db/migrations)에서 DDL을 찾도록 복사한다.
       MSSQL 모드에서는 사용되지 않는다(운영은 마이그레이션을 외부 적용). -->
  <ItemGroup>
    <Content Include="config\db\migrations\*.sql" Link="db\migrations\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 파일 기반 쿼리 레지스트리 — db/queries/{mssql,sqlite}/*.xml 을 출력의 db/queries/ 로 복사(방언 구조 보존).
       게이트웨이(FileQueryRegistry)가 명명 쿼리를 해석한다. 배포 시 리포 미존재 환경에서도 동작하도록 복사한다
       (개발/테스트는 BaseDirectory 상위탐색으로도 리포 루트 db/queries를 찾지만, 배포 robustness 위해 명시 복사). -->
  <ItemGroup>
    <Content Include="config\db\queries\**\*.xml" Link="db\queries\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 격리 인증 쿼리(db/queries-auth/{mssql,sqlite}/*.xml)를 출력으로 복사한다(공개 db/queries와 분리 유지).
       호스트 인증 서비스만 전용 레지스트리로 로드한다. 배포 robustness 위해 명시 복사(테스트는 상위탐색). -->
  <ItemGroup>
    <Content Include="config\db\queries-auth\**\*.xml" Link="db\queries-auth\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 도메인 모듈은 플러그인으로 ./Modules/에 게시한다(설계 §3.1). ReferenceOutputAssembly=false: 모듈 DLL을
       Server 기본 로드 컨텍스트(Default ALC)에 넣지 않아 nexaone.xml의 ClassLoader가 plugin ALC로 전담 로드하게
       하고, 빌드 순서만 보장한다(모듈이 Server보다 먼저 빌드됨). 공유 의존성(Infrastructure/Common/Application/
       Configuration 등)은 위 ProjectReference로 Default ALC에 이미 있으므로 모듈이 그것을 공유한다. -->
  <ItemGroup>
    <ProjectReference Include="..\..\04.Modules\NexaOne.MDM\NexaOne.MDM.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.EST\NexaOne.EST.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.FDC\NexaOne.FDC.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.RMS\NexaOne.RMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.QMS\NexaOne.QMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.EMS\NexaOne.EMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.IVT\NexaOne.IVT.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.POM\NexaOne.POM.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.PRC\NexaOne.PRC.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.SHP\NexaOne.SHP.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.SYS\NexaOne.SYS.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Portal client 빌드 타깃 — wwwroot/spa로 vite 번들을 출력한다. ResolveProjectStaticWebAssets(정적 웹 자산이
       wwwroot를 스캔하는 시점) '이전'에 실행해야 갓 빌드된 wwwroot/spa/**가 자산 매니페스트에 포함되고,
       그 결과 publish 출력에 함께 게시된다. publish는 build를 선행하므로 이 내부 build에서 타깃이 돈다.
       Condition: BuildSpa=true(개발자 강제) 또는 _IsPublishing=true(dotnet publish)일 때만 실행 →
       일반 dev `dotnet build`에서는 느린 npm 빌드를 건너뛴다.
       node_modules 부재 시에만 `npm ci`로 재현 가능한 설치(package-lock.json 기반) 후 `npm run build`. -->
  <Target Name="BuildPortalClientBundle" BeforeTargets="ResolveStaticWebAssetsConfiguration;AssignTargetPaths;Build" Condition="'$(BuildSpa)'=='true' Or '$(_IsPublishing)'=='true'">
    <Message Importance="high" Text="Building Portal client into wwwroot/spa from $(PortalClientRoot) ..." />
    <Exec Command="npm ci" WorkingDirectory="$(PortalClientRoot)" Condition="!Exists('$(PortalClientRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(PortalClientRoot)" />

    <!-- vite는 emptyOutDir로 이전 출력을 지우고 콘텐츠 해시 파일명(index-XXXX.js)으로 새로 쓴다. 정적 웹 자산
         파이프라인은 obj에 빌드/게시 매니페스트(staticwebassets.*.json)를 캐시하는데, 이 캐시가 직전 빌드의
         '옛 해시 파일'을 그대로 보존한 채 신규 파일과 합쳐져(union) 증분 publish 시 사라진 파일을 복사하려다
         MSB3030으로 실패한다. SPA를 (재)빌드할 때마다 이 캐시 매니페스트를 삭제해 ResolveProjectStaticWebAssets가
         현재 wwwroot/spa 디스크 상태에서 매니페스트를 처음부터 다시 계산하도록 강제한다(정확한 증분 동작). -->
    <ItemGroup>
      <_StaleStaticWebAssetManifest Include="$(IntermediateOutputPath)staticwebassets.build.json" />
      <_StaleStaticWebAssetManifest Include="$(IntermediateOutputPath)staticwebassets.development.json" />
      <_StaleStaticWebAssetManifest Include="$(IntermediateOutputPath)staticwebassets.pack.json" />
      <_StaleStaticWebAssetManifest Include="$(IntermediateOutputPath)staticwebassets.publish.json" />
      <_StaleStaticWebAssetManifest Include="$(IntermediateOutputPath)staticwebassets.build.endpoints.json" />
    </ItemGroup>
    <Delete Files="@(_StaleStaticWebAssetManifest)" Condition="Exists('%(FullPath)')" />

    <!-- 기본 Content 글롭(wwwroot\**)은 프로젝트 평가 시점에 확정되므로, 위 vite 빌드가 끝나면 @(Content)에
         박제된 '이전' wwwroot\spa 파일 항목이 실제 디스크와 어긋난다. DiscoverStaticWebAssets는 @(Content)를
         읽으므로, 여기서 stale 항목을 제거하고 갓 빌드된 파일을 동일 메타데이터로 다시 포함시켜 매니페스트가
         현재 번들을 가리키게 한다. -->
    <ItemGroup>
      <Content Remove="wwwroot\spa\**" />
      <Content Include="wwwroot\spa\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    </ItemGroup>
  </Target>

  <!-- 모듈 DLL '만' ./Modules/로 복사한다(.deps.json 제외). .deps.json이 없어야 AssemblyDependencyResolver가
       모듈의 공유 의존성을 plugin ALC에 자체 복사하지 않고 Default ALC로 흘려보내, EesDataSource/IConfiguration 등의
       타입 동일성이 server.xml 컨텍스트와 유지된다. (런타임 로드는 MSSQL 환경에서 실행 검증 필요.) -->
  <Target Name="CopyDomainModulePlugins" AfterTargets="Build">
    <ItemGroup>
      <!-- Resolve the actual target paths produced by this build. Hard-coded project bin paths
           bypass an external artifacts path and can silently package stale default-bin plugin DLLs. -->
      <_ModulePluginProject Include="@(_MSBuildProjectReferenceExistent)"
                            Condition="'%(ReferenceOutputAssembly)' == 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_ModulePluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_ModulePluginDll" />
    </MSBuild>
    <Error Condition="'@(_ModulePluginDll)' == ''"
           Text="No current domain module outputs were resolved for the host plugin bundle." />
    <Error Condition="!Exists('%(_ModulePluginDll.FullPath)')"
           Text="Current domain module output is missing: %(_ModulePluginDll.FullPath)" />
    <Copy SourceFiles="@(_ModulePluginDll)" DestinationFolder="$(OutDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <!-- publish 산출물에도 모듈 플러그인 복사 — publish는 계산된 파일 목록만 실어 OutDir의 Modules/를
       가져가지 않는다(운영 배포 검증에서 발견: 게시본 부팅 시 모듈 0개 로드). -->
  <Target Name="CopyDomainModulePluginsOnPublish" AfterTargets="Publish" DependsOnTargets="CopyDomainModulePlugins">
    <Copy SourceFiles="@(_ModulePluginDll)" DestinationFolder="$(PublishDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <!-- 호스트 설정 — 역할별 폴더로 정리(Spring→config): config/app.xml(서비스 매니페스트),
       config/host/(공통 서버 빈 server.xml + SQLite 변형 server.sqlite.xml), config/modules/(모듈별 빈 9개).
       글롭으로 출력에 상대경로 보존 복사한다(db/queries 패턴과 동일). app.xml의 configFiles는 config/modules/*.xml를 가리킨다. -->
  <ItemGroup>
    <!-- config/db/** 는 위에서 db\ 링크로 별도 복사하므로 제외(중복 포함 방지). -->
    <Content Include="config\**\*.xml" Exclude="config\db\**\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- SmartUX(:9020) 실제 데스크톱 메뉴 트리 시드(SUX 카테고리 331행, docs/.../smartux-menu-inventory.json에서 정규화 추출).
       어셈블리에 임베드해 CWD/복사 경로와 무관하게 부트스트랩(SeedDevMenuIfEmpty)이 읽는다. Dev/SQLite 전용 경로. -->
  <ItemGroup>
    <EmbeddedResource Include="config\seed\nexaone-menu.json" />
  </ItemGroup>

</Project>
