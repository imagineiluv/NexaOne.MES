<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\submodules\NexusFramework\src\NexusFramework\NexusFramework.csproj" />
    <ProjectReference Include="..\..\02.Backend\NexaOne.Application\NexaOne.Application.csproj" />
    <ProjectReference Include="..\..\02.Backend\NexaOne.Infrastructure\NexaOne.Infrastructure.csproj" />
    <ProjectReference Include="..\..\02.Backend\NexaOne.Infrastructure.Messaging\NexaOne.Infrastructure.Messaging.csproj" />
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.MsSql\NexusCom.Data.MsSql.csproj" Condition="'$(DbmsType)'=='MSSQL' or '$(DbmsType)'==''" />
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.PostgreSql\NexusCom.Data.PostgreSql.csproj" Condition="'$(DbmsType)'=='PostgreSQL'" />
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.MySql\NexusCom.Data.MySql.csproj" Condition="'$(DbmsType)'=='MySQL'" />
    <!-- SQLite 공급자는 항상 참조한다(작고 외부 DB 불필요). 이로써 server.xml만 바꿔(코드 재빌드 없이)
         MSSQL↔SQLite 전환이 가능하다 — SqliteProvider DLL이 호스트 Default ALC에 상존. -->
    <ProjectReference Include="..\..\..\submodules\NexusCom\src\NexusCom.Data.Sqlite\NexusCom.Data.Sqlite.csproj" />
  </ItemGroup>

  <!-- SQLite 모드에서 SqliteSchemaInitializer가 출력 디렉터리 옆(db/migrations)에서 DDL을 찾도록 복사한다.
       MSSQL 모드에서는 사용되지 않는다(운영은 마이그레이션을 외부 적용). -->
  <ItemGroup>
    <Content Include="..\..\..\db\migrations\*.sql" Link="db\migrations\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 도메인 모듈은 플러그인으로 ./Modules/에 게시한다(설계 §3.1). ReferenceOutputAssembly=false: 모듈 DLL을
       Server 기본 로드 컨텍스트(Default ALC)에 넣지 않아 nexaone.xml의 ClassLoader가 plugin ALC로 전담 로드하게
       하고, 빌드 순서만 보장한다(모듈이 Server보다 먼저 빌드됨). 공유 의존성(Infrastructure/Common/Application/
       Configuration 등)은 위 ProjectReference로 Default ALC에 이미 있으므로 모듈이 그것을 공유한다. -->
  <ItemGroup>
    <ProjectReference Include="..\..\04.Modules\NexaOne.MDM\NexaOne.MDM.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.EST\NexaOne.EST.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.FDC\NexaOne.FDC.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.RMS\NexaOne.RMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.QMS\NexaOne.QMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.CMMS\NexaOne.CMMS.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.POM\NexaOne.POM.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.SHP\NexaOne.SHP.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\04.Modules\NexaOne.SYS\NexaOne.SYS.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 모듈 DLL '만' ./Modules/로 복사한다(.deps.json 제외). .deps.json이 없어야 AssemblyDependencyResolver가
       모듈의 공유 의존성을 plugin ALC에 자체 복사하지 않고 Default ALC로 흘려보내, EesDataSource/IConfiguration 등의
       타입 동일성이 server.xml 컨텍스트와 유지된다. (런타임 로드는 MSSQL 환경에서 실행 검증 필요.) -->
  <Target Name="CopyDomainModulePlugins" AfterTargets="Build">
    <ItemGroup>
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.MDM\bin\$(Configuration)\net8.0\NexaOne.MDM.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.EST\bin\$(Configuration)\net8.0\NexaOne.EST.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.FDC\bin\$(Configuration)\net8.0\NexaOne.FDC.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.RMS\bin\$(Configuration)\net8.0\NexaOne.RMS.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.QMS\bin\$(Configuration)\net8.0\NexaOne.QMS.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.CMMS\bin\$(Configuration)\net8.0\NexaOne.CMMS.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.POM\bin\$(Configuration)\net8.0\NexaOne.POM.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.SHP\bin\$(Configuration)\net8.0\NexaOne.SHP.dll" />
      <_ModulePluginDll Include="..\..\04.Modules\NexaOne.SYS\bin\$(Configuration)\net8.0\NexaOne.SYS.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModulePluginDll)" DestinationFolder="$(OutDir)Modules" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Content Include="server.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="nexaone.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="app.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
