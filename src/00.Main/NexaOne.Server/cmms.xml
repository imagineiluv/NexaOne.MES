<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== CMMS (Computerized Maintenance Management System) ===== -->

  <object id="workOrderRepository" type="NexaOne.CMMS.Infrastructure.WorkOrderRepository, NexaOne.CMMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="maintenancePlanRepository" type="NexaOne.CMMS.Infrastructure.MaintenancePlanRepository, NexaOne.CMMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="sparePartRepository" type="NexaOne.CMMS.Infrastructure.SparePartRepository, NexaOne.CMMS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="cmmsService" type="NexaOne.CMMS.Application.Cmms.CmmsService, NexaOne.CMMS">
    <constructor-arg ref="workOrderRepository" />
  </object>
  <object id="maintenancePlanService" type="NexaOne.CMMS.Application.Cmms.MaintenancePlanService, NexaOne.CMMS">
    <constructor-arg ref="maintenancePlanRepository" />
    <constructor-arg ref="sparePartRepository" />
  </object>

  <!-- 예방정비 도래 점검 워커(BackgroundService) — 모듈 소유 주기 작업. quartzScheduler/messageBus는 부모(server.xml)
       빈을 cross-context ref로 주입한다(eesDataSource와 동일). Program.cs가 IHostedService로 자동발견해 호스팅한다.
       ctor: (IRecurringScheduler, IMaintenancePlanRepository, IMessageBus, bool enabled, int intervalSeconds, string topic). -->
  <object id="maintenanceDueCheckWorker" type="NexaOne.CMMS.Application.Cmms.MaintenanceDueCheckWorker, NexaOne.CMMS">
    <constructor-arg ref="quartzScheduler" />
    <constructor-arg ref="maintenancePlanRepository" />
    <constructor-arg ref="messageBus" />
    <!-- 도래 점검 워커 enable 스위치(Worker:Cmms:MaintenanceDue:Enabled). 기본 false(추가형·게이트 OFF). -->
    <constructor-arg value="false" />
    <constructor-arg value="3600" />
    <constructor-arg value="nexaone.events" />
  </object>

</objects>
