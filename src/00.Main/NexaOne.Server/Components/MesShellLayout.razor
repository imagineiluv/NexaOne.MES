@inherits LayoutComponentBase

@* SmartUX(:9020) 레퍼런스 셸 재현 — 네이비 사이드바 + 화이트 상단바 + 본문(메타 화면).
   /meta 화면의 기본 레이아웃(HostRoutes의 DefaultLayout). 로그인(/login)은 별도 HostLayout(중앙 카드). *@
<div class="mes-shell">
    <aside class="mes-sidebar">
        <div class="mes-logo">
            <svg class="cube" viewBox="0 0 24 24" fill="none" stroke="#15b89a" stroke-width="1.8" stroke-linejoin="round">
                <path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="M3 7l9 5 9-5" /><path d="M12 12v10" />
            </svg>
            <span class="brand">NexaOne<small>MES</small></span>
        </div>
        <nav class="mes-nav">
            @{ var activeIdx = ActiveIndex(); }
            @for (var i = 0; i < Menu.Length; i++)
            {
                var m = Menu[i];
                <a class="mes-nav-item @(i == activeIdx ? "active" : "")" href="@m.Href">
                    @((MarkupString)Icon(m.Icon))
                    <span>@m.Label</span>
                    <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
                </a>
            }
        </nav>
        <div class="mes-pin">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 17v5M5 9h14l-1.5 8h-11z M8 9V5a4 4 0 0 1 8 0v4"/></svg>
            메뉴 고정 기능
        </div>
    </aside>

    <div class="mes-main">
        <header class="mes-topbar">
            <span class="star">&#9734;</span>
            <span class="tb-title">제조실행시스템 (NexaOne MES)</span>
            <div class="mes-quickmenu"><input placeholder="Quick Menu" /></div>
            <span class="tb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.5-2.4 1a7 7 0 0 0-1.7-1l-.4-2.5h-4l-.4 2.5a7 7 0 0 0-1.7 1l-2.4-1-2 3.5 2 1.5a7 7 0 0 0 0 2l-2 1.5 2 3.5 2.4-1a7 7 0 0 0 1.7 1l.4 2.5h4l.4-2.5a7 7 0 0 0 1.7-1l2.4 1 2-3.5-2-1.5a7 7 0 0 0 .1-1z"/></svg></span>
            <span class="tb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span>
        </header>
        <section class="mes-content">
            @Body
        </section>
    </div>
</div>

@code {
    [Inject] private Microsoft.AspNetCore.Components.NavigationManager Nav { get; set; } = default!;

    private sealed record MenuItem(string Label, string Href, string Icon);

    // SmartUX 메뉴 구성 재현. 데모 화면(/meta/DEMO_*)으로 라우팅해 클릭 시 실제 화면이 뜨게 한다.
    private static readonly MenuItem[] Menu =
    [
        new("대시보드",   "/meta/DEMO_LAYOUT",           "grid"),
        new("영업 관리",  "/meta/DEMO_GRID",             "bag"),
        new("생산 관리",  "/meta/DEMO_PARAM",            "gear"),
        new("작업 관리",  "/meta/DEMO_LAYOUT",           "clip"),
        new("창고 관리",  "/meta/DEMO_PLANT_FORM",       "box"),
        new("출하 관리",  "/meta/DEMO_GRID",             "truck"),
        new("구매 관리",  "/meta/DEMO_PARAM",            "cart"),
        new("품질 관리",  "/meta/DEMO_QMS_DEFECT_CLASS", "shield"),
        new("EMS",        "/meta/DEMO_LAYOUT",           "wrench"),
        new("EPT",        "/meta/DEMO_GRID",             "clock"),
        new("FDC",        "/meta/DEMO_LAYOUT",           "pulse"),
        new("QMS",        "/meta/DEMO_QMS_DEFECT_CLASS", "shield"),
        new("기준 정보",  "/meta/DEMO_GRID",             "db"),
        new("공통 관리",  "/meta/DEMO_PARAM",            "gear"),
    ];

    // 현재 경로와 일치하는 첫 메뉴만 활성 표시(여러 메뉴가 같은 데모로 링크돼도 1개만 강조).
    private int ActiveIndex()
    {
        var cur = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        for (var i = 0; i < Menu.Length; i++)
            if (string.Equals(cur, Menu[i].Href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)) return i;
        return -1;
    }

    // 사이드바 라인 아이콘(stroke=currentColor — CSS가 색 제어). 입력 없음(정적)이라 MarkupString 안전.
    private static string Icon(string key)
    {
        const string open = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">";
        var body = key switch
        {
            "grid"   => "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/>",
            "bag"    => "<path d='M6 7h12l-1 13H7z'/><path d='M9 7a3 3 0 0 1 6 0'/>",
            "gear"   => "<circle cx='12' cy='12' r='3'/><path d='M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2'/>",
            "clip"   => "<rect x='6' y='4' width='12' height='17' rx='2'/><path d='M9 4h6v3H9z'/><path d='M9 12l2 2 4-4'/>",
            "box"    => "<path d='M3 7l9-4 9 4v10l-9 4-9-4z'/><path d='M3 7l9 4 9-4M12 11v10'/>",
            "truck"  => "<path d='M2 6h12v9H2z'/><path d='M14 9h4l3 3v3h-7z'/><circle cx='6' cy='18' r='1.6'/><circle cx='18' cy='18' r='1.6'/>",
            "cart"   => "<circle cx='9' cy='20' r='1.5'/><circle cx='18' cy='20' r='1.5'/><path d='M2 3h3l2.5 12h11l2-8H6'/>",
            "shield" => "<path d='M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z'/><path d='M9 12l2 2 4-4'/>",
            "wrench" => "<path d='M21 4a5 5 0 0 1-6.5 6.5L5 20l-1-1 9.5-9.5A5 5 0 0 1 20 3z'/>",
            "clock"  => "<circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/>",
            "pulse"  => "<path d='M3 12h4l2 6 4-12 2 6h6'/>",
            "db"     => "<ellipse cx='12' cy='5' rx='8' ry='3'/><path d='M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5'/><path d='M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'/>",
            _        => "<rect x='4' y='4' width='16' height='16' rx='2'/>",
        };
        return open + body + "</svg>";
    }
}
