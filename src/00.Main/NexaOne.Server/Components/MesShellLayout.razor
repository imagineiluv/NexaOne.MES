@inherits LayoutComponentBase
@implements IDisposable
@inject NexaOne.Web.Services.Api.IApiClient Api
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject NexaOne.Server.Services.OpenedScreensState Opened
@inject Microsoft.Extensions.Logging.ILogger<MesShellLayout> Logger
@inject NexaOne.Web.Services.Auth.AuthTokenService TokenService
@inject NexaOne.Web.Services.Auth.JwtAuthStateProvider AuthState
@inject NexaOne.Web.Services.Meta.IRealtimeAlertFeed AlertFeed
@inject NexaOne.Web.Services.Meta.IScreenDefinitionProvider Definitions
@inject NexaOne.Web.Services.UiTextService Ui
@inject Microsoft.JSInterop.IJSRuntime JS

@* SmartUX(:9020) 레퍼런스 셸 재현 — 네이비 사이드바(계층 아코디언) + 화이트 상단바 + 본문(메타 화면) + 하단 MDI 탭.
   사이드바는 SYS.MenuTree(게이트웨이)로 데이터 주도 구축한다(대분류 Folder → 하위 Screen). 쿼리 실패/공백 시
   최소 정적 폴백으로 셸이 절대 빈 화면이 되지 않게 한다. /meta 화면(HostRoutes의 DefaultLayout). *@
<div class="mes-shell @(_navCollapsed ? "nav-collapsed" : "")" style="@(_navWidth is int w ? $"--mes-nav-width:{w}px" : null)">
    <a class="mes-skip-link" href="#mes-main-content">@Ui.T("shell.skipToContent", "본문 바로가기")</a>
    <aside class="mes-sidebar">
        @* NAF 브랜드 로고(픽셀 클러스터 + naf 워드마크 + NOW AND FUTURE) — 브랜드 이미지 벡터 재현. *@
        <div class="mes-logo">
            <div class="naf-logo" role="img" aria-label="NAF — Now and Future">
                <svg class="naf-mark" viewBox="0 0 120 50" fill="currentColor" aria-hidden="true">
                    <rect x="10" y="2" width="6" height="6"/><rect x="0" y="12" width="9" height="9"/><rect x="19" y="9" width="5" height="5"/>
                    <rect x="32" y="20" width="7" height="28"/><rect x="32" y="20" width="24" height="7"/><rect x="49" y="20" width="7" height="28"/>
                    <rect x="64" y="20" width="24" height="7"/><rect x="81" y="20" width="7" height="28"/><rect x="64" y="41" width="24" height="7"/><rect x="64" y="31" width="7" height="17"/>
                    <rect x="96" y="8" width="7" height="40"/><rect x="96" y="8" width="22" height="7"/><rect x="96" y="26" width="18" height="7"/>
                </svg>
                <small class="naf-tag">NOW AND FUTURE</small>
            </div>
        </div>
        <nav class="mes-nav" aria-label="@Ui.T("shell.businessMenu", "MES 업무 메뉴")">
            @* §20.12 — 즐겨찾기 메뉴(개인화). 서버 영속이라 어느 브라우저에서 접속해도 동일하다.
               (최근 사용 섹션은 사용자 요청으로 사이드바에서 제거 — 서버 추적(NavigateTo)은 유지) *@
            @if (_favorites.Count > 0)
            {
                <div class="mes-side-caption">★ @Ui.T("shell.favorites", "즐겨찾기")</div>
                @for (var i = 0; i < _favorites.Count; i++)
                {
                    var idx = i;                      @* 람다 캡처용 로컬 복사(루프 변수 직접 캡처 금지) *@
                    var fav = _favorites[idx];
                    var favName = Ui.T($"menu.{fav.MenuId}", fav.MenuName);
                    <div @key="fav.MenuId" class="fav-item" title="@favName">
                        <span class="fav-name" role="button" tabindex="0" @onclick="() => NavigateTo(fav.UiId, fav.MenuName)"
                              @onkeydown="e => { if (IsActivateKey(e)) NavigateTo(fav.UiId, fav.MenuName); }">@favName</span>
                        @* §20.12 순서 변경 — 실제 button으로 키보드·터치 접근을 보장하고 성공 시에만 캐시 반영. *@
                        @if (idx > 0)
                        {
                            <button type="button" class="fav-move" title="@Ui.T("common.up", "위로")"
                                    aria-label="@string.Format(Ui.T("shell.moveFavoriteUp", "{0} 위로"), favName)"
                                    @onclick="() => MoveFavoriteAsync(idx, -1)">▲</button>
                        }
                        @if (idx < _favorites.Count - 1)
                        {
                            <button type="button" class="fav-move" title="@Ui.T("common.down", "아래로")"
                                    aria-label="@string.Format(Ui.T("shell.moveFavoriteDown", "{0} 아래로"), favName)"
                                    @onclick="() => MoveFavoriteAsync(idx, +1)">▼</button>
                        }
                    </div>
                }
                <div class="mes-side-divider"></div>
            }
            @* 트리 필터(P3-11) — 메뉴명/UI_ID 부분일치 잎+조상 폴더만 표시, 필터 중엔 전부 펼침. *@
            <div class="mes-navfilter">
                <input placeholder="@Ui.T("shell.menuFilter", "메뉴 필터…")" value="@_navFilter" @oninput="OnNavFilterInput"
                       aria-label="@Ui.T("shell.menuFilter", "메뉴 필터")" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_navFilter))
            {
                @* 필터 중 — 구역 없이 평면 렌더(검색 결과 정확성). *@
                <MesNavTree Nodes="VisibleForest" Depth="0" Open="EffectiveOpenFolders" ActiveUiId="@ActiveUiId()"
                            OnToggle="ToggleFolder" OnNavigate="OnNavigateNode" DisplayName="MenuDisplay"
                            KnownScreenUiIds="_knownScreenUiIds" />
            }
            else
            {
                @* IA 구역화(5구역) — 최상위 메뉴를 논리 구역으로 묶어 스캔성↑. 구역 헤더 + 구역별 트리. *@
                @foreach (var (resKey, label, roots) in SectionedForest())
                {
                    <div class="mes-nav-section">@Ui.T(resKey, label)</div>
                    <MesNavTree Nodes="roots" Depth="0" Open="EffectiveOpenFolders" ActiveUiId="@ActiveUiId()"
                                OnToggle="ToggleFolder" OnNavigate="OnNavigateNode" DisplayName="MenuDisplay"
                                KnownScreenUiIds="_knownScreenUiIds" />
                }
            }
        </nav>
        <div class="mes-pin">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 17v5M5 9h14l-1.5 8h-11z M8 9V5a4 4 0 0 1 8 0v4"/></svg>
            @Ui.T("shell.menuPin", "메뉴 고정 기능")
        </div>
        @* P3-11 — 사이드바 폭 드래그 조절(레일 모드가 아닐 때만). 부트 스크립트 nxSidebarResizeInit가 처리. *@
        @if (!_navCollapsed)
        {
            <div class="mes-nav-resize" @ref="_navResizeHandle"
                 role="separator" tabindex="0"
                 aria-label="@Ui.T("shell.resizeNavigation", "탐색 영역 너비 조절")"
                 aria-orientation="vertical" aria-valuemin="180" aria-valuemax="420"
                 aria-valuenow="@(_navWidth ?? 230)"
                 title="@Ui.T("shell.resizeNavigationHint", "드래그하거나 좌우 화살표 키로 너비 조절")"></div>
        }
    </aside>

    @* 좁은 화면 사이드바 드로어 딤 배경 — 클릭 시 닫기. CSS로 좁은 화면+드로어 열림에서만 표시. *@
    <div class="mes-nav-backdrop" @onclick="() => _navCollapsed = true" aria-hidden="true"></div>

    <div class="mes-main">
        <header class="mes-topbar">
            @* 사이드바 접기 토글(P3-11/16) — 좁은 화면에선 사이드바가 오버레이로 뜬다(CSS 미디어쿼리). *@
            <span class="tb-ico" role="button" tabindex="0" aria-label="@Ui.T("shell.toggleMenu", "메뉴 접기/펼치기")"
                  title="@Ui.T("shell.toggleMenu", "메뉴 접기/펼치기")"
                  @onclick="() => _navCollapsed = !_navCollapsed"
                  @onkeydown="e => { if (IsActivateKey(e)) _navCollapsed = !_navCollapsed; }">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </span>
            @* §20.12 — 활성 화면 즐겨찾기 토글(★=등록됨). 메뉴 매핑이 없는 화면(직접 라우트 등)은 표시만 한다. *@
            <span class="star @(IsActiveFavorite() ? "active" : "")" role="button" tabindex="0"
                  aria-label="@(IsActiveFavorite() ? Ui.T("shell.removeFavorite", "즐겨찾기 해제") : Ui.T("shell.addFavorite", "즐겨찾기 등록"))"
                  title="@(IsActiveFavorite() ? Ui.T("shell.removeFavorite", "즐겨찾기 해제") : Ui.T("shell.addFavorite", "즐겨찾기 등록"))"
                  @onclick="ToggleActiveFavoriteAsync"
                  @onkeydown="async e => { if (IsActivateKey(e)) await ToggleActiveFavoriteAsync(); }">@(IsActiveFavorite() ? "★" : "☆")</span>
            @* 상단바 컨텍스트 — 제품명 + 활성 화면 브레드크럼(데드스페이스를 현재 위치로 채움). *@
            <div class="tb-context">
                <span class="tb-title">@Ui.T("shell.productName", "제조실행시스템 (NexaOne MES)")</span>
                @{ var _activeScreen = Opened.Screens.FirstOrDefault(s => string.Equals(s.UiId, Opened.ActiveUiId, StringComparison.OrdinalIgnoreCase)); }
                @if (_activeScreen is not null)
                {
                    <span class="tb-crumb-sep" aria-hidden="true">›</span>
                    <span class="tb-crumb">@Ui.T($"screen.{_activeScreen.UiId}.title", _activeScreen.Title)</span>
                }
            </div>
            @* Quick Menu — 사이드바 트리 인덱스(_uiToTitle) 기반 타이프어헤드 점프(레거시 퀵메뉴 미러, 서버 호출 없음). *@
            <div class="mes-quickmenu">
                <input placeholder="@Ui.T("shell.quickMenu", "빠른 메뉴")" aria-label="@Ui.T("shell.quickMenu", "빠른 메뉴")" value="@_quickQuery"
                       @oninput="OnQuickInput" @onkeydown="OnQuickKeyDown" />
                @if (_quickMatches.Count > 0)
                {
                    <div class="quick-results">
                        @foreach (var m in _quickMatches)
                        {
                            <div class="quick-item" role="button" tabindex="0" @key="m.UiId" @onclick="() => QuickGo(m)"
                                 @onkeydown='e => { if (IsActivateKey(e)) QuickGo(m); else if (e.Key == "Escape") { _quickQuery = string.Empty; _quickMatches.Clear(); } }'>
                                <span>@m.Title</span><small>@m.UiId</small>
                            </div>
                        }
                    </div>
                }
            </div>
            @* 즐겨찾기 드로어 토글(사용자 요청) — 우측에서 슬라이드로 즐겨찾기 목록을 연다. *@
            <span class="tb-ico" role="button" tabindex="0" aria-label="@Ui.T("shell.favoriteList", "즐겨찾기 목록")"
                  title="@Ui.T("shell.favoriteList", "즐겨찾기 목록")"
                  @onclick="ToggleFavDrawerAsync"
                  @onkeydown="async e => { if (IsActivateKey(e)) await ToggleFavDrawerAsync(); }">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>
            </span>
            @* 알림 센터(P3-20) — 버스 알림성 이벤트(알람/인터락/작업지시)의 벨 아이콘+최근 목록.
               열면 미읽음 뱃지 초기화. 피드는 회로 밖 스레드에서 콜백하므로 InvokeAsync로 전환한다. *@
            <div class="mes-alertmenu">
                <span class="tb-ico" role="button" tabindex="0" aria-label="@Ui.T("shell.alerts", "알림")"
                      title="@Ui.T("shell.alerts", "알림")"
                      @onclick="ToggleAlerts"
                      @onkeydown='e => { if (IsActivateKey(e)) ToggleAlerts(); else if (e.Key == "Escape") _alertsOpen = false; }'>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    @if (_alertUnread > 0)
                    {
                        <span class="alert-badge">@(_alertUnread > 99 ? "99+" : _alertUnread.ToString())</span>
                    }
                </span>
                @if (_alertsOpen)
                {
                    <div class="alert-dropdown" @onkeydown='e => { if (e.Key == "Escape") _alertsOpen = false; }'>
                        <div class="alert-dd-head">@Ui.T("shell.alerts", "알림")</div>
                        @if (_alerts.Count == 0)
                        {
                            <div class="alert-dd-empty">@Ui.T("shell.noAlerts", "알림이 없습니다.")</div>
                        }
                        @foreach (var alert in _alerts)
                        {
                            <div class="alert-dd-item">
                                <span class="alert-cat">@alert.Category</span>
                                <span class="alert-title">@alert.Title</span>
                                <small>@alert.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</small>
                            </div>
                        }
                    </div>
                }
            </div>
            @* 사용자 메뉴 — ID 표시·비밀번호 변경·로그아웃(리프레시 토큰 폐기 후 세션 종료).
               (구 톱니 아이콘은 연결 기능이 없어 제거 — 장식 UI를 두지 않는다) *@
            <div class="mes-usermenu">
                <span class="tb-ico" role="button" tabindex="0" aria-label="@Ui.T("shell.userMenu", "사용자 메뉴")"
                      title="@Ui.T("shell.userMenu", "사용자 메뉴")"
                      @onclick="() => _userMenuOpen = !_userMenuOpen"
                      @onkeydown="e => { if (IsActivateKey(e)) _userMenuOpen = !_userMenuOpen; }">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                </span>
                @if (_userMenuOpen)
                {
                    <div class="user-dropdown" role="menu" aria-label="@Ui.T("shell.userMenu", "사용자 메뉴")"
                         @onkeydown='e => { if (e.Key == "Escape") _userMenuOpen = false; }'>
                        <div class="user-dd-id">@(_userId.Length > 0 ? _userId : Ui.T("shell.userFallback", "(사용자)"))</div>
                        <a class="user-dd-item" role="menuitem" href="/change-password">@Ui.T("shell.changePassword", "비밀번호 변경")</a>
                        <div class="user-dd-item" role="menuitem" tabindex="0" @onclick="ToggleThemeAsync"
                             @onkeydown="async e => { if (IsActivateKey(e)) await ToggleThemeAsync(); }">@(_darkTheme ? Ui.T("shell.lightMode", "라이트 모드") : Ui.T("shell.darkMode", "다크 모드"))</div>
                        <div class="user-dd-item" role="menuitem" tabindex="0" @onclick="ToggleLanguageAsync"
                             @onkeydown="async e => { if (IsActivateKey(e)) await ToggleLanguageAsync(); }">@(_language == "EnUs" ? Ui.T("shell.switchToKorean", "한국어로 전환") : "Switch to English")</div>
                        <div class="user-dd-item" role="menuitem" tabindex="0" @onclick="HandleLogoutAsync"
                             @onkeydown="async e => { if (IsActivateKey(e)) await HandleLogoutAsync(); }">@Ui.T("shell.logout", "로그아웃")</div>
                    </div>
                }
            </div>
        </header>

        @* 즐겨찾기 우측 슬라이드 드로어(사용자 요청) — 이동/순서변경/해제. 항상 DOM에 두고 transform으로 슬라이드.
           닫힘 상태 격리: inert(포커스/클릭 차단) + aria-hidden 문자열 바인딩 — bool 바인딩은 Blazor가
           true를 빈 값(aria-hidden="")으로 렌더해 유효 ARIA 토큰이 아니다. Escape=닫기, 포커스는 nxDialog*. *@
        @if (_favDrawerOpen)
        {
            <div class="mes-favdrawer-backdrop" @onclick="CloseFavDrawerAsync"></div>
        }
        <aside class="mes-favdrawer @(_favDrawerOpen ? "open" : "")" aria-hidden="@(_favDrawerOpen ? "false" : "true")"
               inert="@(!_favDrawerOpen)" @ref="_favDrawerRef"
               @onkeydown='async e => { if (e.Key == "Escape") await CloseFavDrawerAsync(); }'>
            <div class="mes-favdrawer-head">
                <span class="h-title">★ @Ui.T("shell.favorites", "즐겨찾기")</span>
                <button class="mes-favdrawer-close" title="@Ui.T("common.close", "닫기")"
                        aria-label="@Ui.T("shell.closeFavorites", "즐겨찾기 닫기")" @onclick="CloseFavDrawerAsync">×</button>
            </div>
            @if (_favorites.Count == 0)
            {
                <div class="mes-favdrawer-empty">@Ui.T("shell.noFavorites", "즐겨찾기가 없습니다 — 화면 상단의 ☆을 눌러 등록하세요.")</div>
            }
            else
            {
                <div class="mes-favdrawer-list">
                    @for (var i = 0; i < _favorites.Count; i++)
                    {
                        var idx = i;                      @* 람다 캡처용 로컬 복사 *@
                        var fav = _favorites[idx];
                        var favName = Ui.T($"menu.{fav.MenuId}", fav.MenuName);
                        <div @key="fav.MenuId" class="mes-favdrawer-item" title="@favName">
                            <span class="name" role="button" tabindex="0" @onclick="() => FavDrawerNavigateAsync(fav)"
                                  @onkeydown="async e => { if (IsActivateKey(e)) await FavDrawerNavigateAsync(fav); }">@favName</span>
                            @if (idx > 0)
                            {
                                <button class="op" title="@Ui.T("common.up", "위로")"
                                        aria-label="@string.Format(Ui.T("shell.moveFavoriteUp", "{0} 위로"), favName)"
                                        @onclick="() => MoveFavoriteAsync(idx, -1)">▲</button>
                            }
                            @if (idx < _favorites.Count - 1)
                            {
                                <button class="op" title="@Ui.T("common.down", "아래로")"
                                        aria-label="@string.Format(Ui.T("shell.moveFavoriteDown", "{0} 아래로"), favName)"
                                        @onclick="() => MoveFavoriteAsync(idx, +1)">▼</button>
                            }
                            <button class="op del" title="@Ui.T("shell.removeFavorite", "즐겨찾기 해제")"
                                    aria-label="@string.Format(Ui.T("shell.removeNamedFavorite", "{0} 즐겨찾기 해제"), favName)"
                                    @onclick="() => RemoveFavoriteAsync(fav.MenuId)">×</button>
                        </div>
                    }
                </div>
            }
        </aside>

        @* MDI 탭 — 열린 /meta 화면들. 활성 강조 + X로 닫기 + 우클릭 컨텍스트(닫기/다른 탭/모두, P3-10).
           탭이 많으면 가로 스크롤(오버플로). 탭이 없으면 바를 숨긴다. *@
        @if (Opened.Screens.Count > 0)
        {
            <div class="mes-mditabs" role="tablist" aria-label="@Ui.T("shell.openScreens", "열린 화면")">
                @foreach (var tab in Opened.Screens)
                {
                    var tabActive = string.Equals(tab.UiId, Opened.ActiveUiId, StringComparison.OrdinalIgnoreCase);
                    @* P3-10 순서 변경 — HTML5 DnD: 잡은 탭을 놓은 탭 앞으로. dragover preventDefault가 있어야 drop이 발화한다.
                       키보드: Enter/Space=이동, Delete=닫기(tablist 관례). *@
                    <div class="mes-mditab @(tabActive ? "active" : "")" @key="tab.UiId" draggable="true"
                         role="tab" aria-selected="@(tabActive ? "true" : "false")" tabindex="0"
                         @onclick="() => NavigateTo(tab.UiId, tab.Title)"
                         @onkeydown='e => { if (IsActivateKey(e)) NavigateTo(tab.UiId, tab.Title); else if (e.Key == "Delete") CloseTab(tab.UiId); }'
                         @ondragstart="() => _dragTabUiId = tab.UiId"
                         @ondragover:preventDefault="true" @ondragover="() => { }"
                         @ondrop="() => DropTab(tab.UiId)"
                         @oncontextmenu="e => OpenTabMenu(e, tab.UiId)" @oncontextmenu:preventDefault="true">
                        <span class="mes-mditab-label">@TabTitle(tab)</span>
                        <span class="close" role="button" tabindex="0"
                              aria-label="@string.Format(Ui.T("shell.closeNamedTab", "{0} 탭 닫기"), TabTitle(tab))"
                              @onclick="() => CloseTab(tab.UiId)" @onclick:stopPropagation="true"
                              @onkeydown="e => { if (IsActivateKey(e)) CloseTab(tab.UiId); }"
                              @onkeydown:stopPropagation="true">&times;</span>
                    </div>
                }
            </div>
        }

        @* 탭 우클릭 컨텍스트 메뉴 — 투명 백드롭 클릭으로 닫힘. *@
        @if (_tabMenuUiId is not null)
        {
            <div class="tabmenu-backdrop" @onclick="CloseTabMenu" @oncontextmenu="CloseTabMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="tabmenu" role="menu" aria-label="@Ui.T("shell.tabMenu", "탭 메뉴")" style="left:@(_tabMenuX)px; top:@(_tabMenuY)px;"
                 @onkeydown='e => { if (e.Key == "Escape") CloseTabMenu(); }'>
                <div class="tabmenu-item" role="menuitem" tabindex="0" @onclick="() => TabMenuClose()"
                     @onkeydown="e => { if (IsActivateKey(e)) TabMenuClose(); }">@Ui.T("common.close", "닫기")</div>
                <div class="tabmenu-item" role="menuitem" tabindex="0" @onclick="() => TabMenuCloseOthers()"
                     @onkeydown="e => { if (IsActivateKey(e)) TabMenuCloseOthers(); }">@Ui.T("shell.closeOtherTabs", "다른 탭 모두 닫기")</div>
                <div class="tabmenu-item" role="menuitem" tabindex="0" @onclick="() => TabMenuCloseAll()"
                     @onkeydown="e => { if (IsActivateKey(e)) TabMenuCloseAll(); }">@Ui.T("shell.closeAllTabs", "모두 닫기")</div>
            </div>
        }

        <section id="mes-main-content" class="mes-content" tabindex="-1">
            <div class="mes-content-inner">
                @Body
            </div>
        </section>
    </div>

    @* 전역 API 토스트(403/5xx/검증 실패) — ApiNotificationService의 유일한 소비자(P1-4). *@
    <NexaOne.Web.Components.ApiToastHost />

    @* Radzen 다이얼로그/툴팁/알림 호스트 — 파괴적 명령 확인(RadzenDialog) 등이 여기서 렌더된다. *@
    <RadzenComponents />
</div>

@code {
    // 사이드바 트리(N단계: 대분류 → 중분류 → … → 화면) 및 펼침 상태. OnInitialized에서 SYS.MenuTree로 1회 구축.
    private sealed record MenuNode(string Id, string Name, string? ParentId, int Seq, string Type, string UiId);

    private List<MesMenuNode> _forest = new();
    // 화면 점등 여부는 화면별 동기 DB 조회 대신 트리 갱신 시 한 번 읽은 ID 집합으로 판정한다.
    private IReadOnlySet<string> _knownScreenUiIds
        = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _openFolders = new(StringComparer.OrdinalIgnoreCase);
    // uiId → 메뉴명(MDI 탭 제목). 트리에서 파생.
    private Dictionary<string, string> _uiToTitle = new(StringComparer.OrdinalIgnoreCase);
    // uiId → 조상 폴더 id 목록(활성 화면의 모든 상위 폴더 자동 펼침용).
    private Dictionary<string, IReadOnlyList<string>> _uiToAncestors = new(StringComparer.OrdinalIgnoreCase);
    // uiId → menuId — §20.12 즐겨찾기/최근 기록의 키는 MENU_ID다(같은 화면을 여러 잎이 가리키면 마지막 잎).
    private Dictionary<string, string> _uiToMenuId = new(StringComparer.OrdinalIgnoreCase);
    // §20.12 — 즐겨찾기/최근 메뉴(서버 영속). 실패는 빈 목록으로 흡수돼 셸을 깨지 않는다.
    private List<FavoriteMenuDto> _favorites = new();
    private List<RecentMenuDto> _recents = new();
    // 사이드바 트리 스테일네스 게이트 — 이동 시 60초 초과면 재조회(메뉴-역할 변경 반영).
    private DateTime _treeLoadedAt = DateTime.MinValue;
    private bool _treeRefreshing;

    // ── 사이드바 접기/트리 필터(P3-11) ──────────────────────────────────────
    private bool _navCollapsed;
    private string _navFilter = string.Empty;

    private void OnNavFilterInput(ChangeEventArgs e) => _navFilter = e.Value?.ToString() ?? string.Empty;

    // 필터 중엔 매칭 잎+조상 폴더만 남긴 트리(폴더명 매칭은 하위 전체 유지). 필터 없으면 원본.
    private List<MesMenuNode> VisibleForest
        => string.IsNullOrWhiteSpace(_navFilter) ? _forest : FilterForest(_forest, _navFilter.Trim());

    // 내비 IA 구역(5구역, 사용자 확정) — 최상위 메뉴를 논리 구역으로 묶어 시각 구분한다. 각 루트를
    // 이름/ID 키워드(모듈코드·한국어)로 구역에 배정하고, 미매칭은 마지막(시스템)으로. 순서·이름 조정은 여기서.
    private static readonly (string ResKey, string Label, string[] Keywords)[] NavSections =
    {
        ("nav.section.ops",     "운영·생산", new[] { "대시보드", "Dashboard", "영업", "SLS", "PPM", "WPM", "창고", "IVT", "출하", "DLV", "구매", "PRC" }),
        ("nav.section.quality", "품질",      new[] { "품질", "QCA", "QMS" }),
        ("nav.section.equip",   "설비",      new[] { "설비", "EMS", "EPT", "FDC" }),
        ("nav.section.master",  "기준정보",   new[] { "기준", "레시피", "RMS", "MDM", "COM" }),
        ("nav.section.system",  "시스템",     new[] { "시스템", "SYS" }),
    };

    private static int SectionIndexOf(MesMenuNode node)
    {
        var hay = (node.Name ?? "") + " " + (node.Id ?? "");
        for (var i = 0; i < NavSections.Length; i++)
            if (NavSections[i].Keywords.Any(k => hay.Contains(k, StringComparison.OrdinalIgnoreCase)))
                return i;
        return NavSections.Length - 1;   // 미매칭 → 시스템(마지막)
    }

    // 구역 순서·구역 내 원래 순서 유지, 빈 구역 제외. (필터 중엔 호출 안 함 — 평면 렌더)
    private IEnumerable<(string ResKey, string Label, List<MesMenuNode> Roots)> SectionedForest()
    {
        var buckets = NavSections.Select(_ => new List<MesMenuNode>()).ToArray();
        foreach (var root in VisibleForest) buckets[SectionIndexOf(root)].Add(root);
        for (var i = 0; i < NavSections.Length; i++)
            if (buckets[i].Count > 0) yield return (NavSections[i].ResKey, NavSections[i].Label, buckets[i]);
    }

    // 필터 중엔 남은 폴더를 전부 펼쳐 매칭 잎이 바로 보이게 한다(수동 펼침 상태는 비필터 시 복원).
    private HashSet<string> EffectiveOpenFolders
        => string.IsNullOrWhiteSpace(_navFilter) ? _openFolders : CollectFolderIds(VisibleForest);

    private List<MesMenuNode> FilterForest(List<MesMenuNode> nodes, string query)
    {
        var result = new List<MesMenuNode>();
        foreach (var node in nodes)
        {
            // 현재 언어에 표시되는 번역명도 검색 대상으로 삼는다. 영어 모드에서 보이는
            // "Quality Inspection"을 입력했는데 한국어 원본만 비교해 결과가 사라지던 불일치를 막는다.
            var displayName = MenuDisplay(node);
            if (node.IsFolder)
            {
                if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || displayName.Contains(query, StringComparison.OrdinalIgnoreCase))
                {
                    result.Add(node);   // 폴더명 매칭 = 하위 전체 유지
                    continue;
                }
                var kids = FilterForest(node.Children.ToList(), query);
                if (kids.Count > 0) result.Add(node with { Children = kids });
            }
            else if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                  || displayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                  || node.UiId.Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                result.Add(node);
            }
        }
        return result;
    }

    private static HashSet<string> CollectFolderIds(List<MesMenuNode> nodes)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Walk(IReadOnlyList<MesMenuNode> list)
        {
            foreach (var n in list)
            {
                if (!n.IsFolder) continue;
                ids.Add(n.Id);
                Walk(n.Children);
            }
        }
        Walk(nodes);
        return ids;
    }

    protected override async Task OnInitializedAsync()
    {
        await BuildTreeAsync();
        await ReloadPersonalizationAsync();
        _userId = await TokenService.GetUserIdAsync() ?? string.Empty;
        // 다국어(P3-14) — 사용자 언어 로드 후 비-한국어면 공통 문구 리소스를 주입(실패=한국어 폴백).
        try
        {
            _language = await Api.GetUserLanguageAsync();
            Ui.Load(_language, _language == "KoKr"
                ? new Dictionary<string, string>(StringComparer.Ordinal)
                : await Api.GetLanguageResourcesAsync(_language));
        }
        catch { /* 리소스 실패는 폴백(한국어)으로 — 셸을 깨지 않는다 */ }
        // 알림 센터(P3-20) — 최근 스냅숏 + 신규 알림 구독.
        _alerts = AlertFeed.Recent.ToList();
        _alertSubscription = AlertFeed.Subscribe(OnAlertAsync);
        Opened.Changed += OnOpenedChanged;
        Nav.LocationChanged += OnLocationChanged;
        SyncCurrentRoute();
    }

    // ── 다국어(P3-14)·테마(P3-17)·사이드바 폭(P3-11) ─────────────────────────
    private string _language = "KoKr";
    private string? _documentLanguageApplied;
    private bool _darkTheme;
    private int? _navWidth;                  // 사이드바 폭(px) — localStorage 'nx-nav-width' 복원값.
    private ElementReference _navResizeHandle;
    private DotNetObjectReference<MesShellLayout>? _selfRef;
    private bool _navResizeInit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 저장된 테마 상태를 토글 라벨에 반영(적용 자체는 HostApp 부트 스크립트가 이미 완료).
            _darkTheme = string.Equals(await JS.InvokeAsync<string>("nxGetTheme"), "dark", StringComparison.Ordinal);
            // 저장된 사이드바 폭 복원(있으면).
            var saved = await JS.InvokeAsync<int>("nxGetNavWidth");
            if (saved > 0) _navWidth = saved;
            // 반응형 뷰포트 감시 — 좁은 화면 진입 시 사이드바 자동 접기(오버레이 기본 노출 방지).
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("nxViewportWatch", _selfRef); }
            catch { /* JS 미탑재 — 반응형 자동접기 없이 정상 동작 */ }
            StateHasChanged();
        }
        // 비동기 사용자 설정 로드는 첫 렌더 뒤에 끝날 수 있다. 실제 적용값이 달라질 때마다
        // 다시 동기화해 저장된 EnUs로 첫 진입해도 <html lang="en">이 되도록 한다.
        if (!string.Equals(_documentLanguageApplied, _language, StringComparison.Ordinal))
        {
            await JS.InvokeVoidAsync("nxSetLanguage", _language);
            _documentLanguageApplied = _language;
        }
        // 즐겨찾기 드로어 열림 — inert가 벗겨진 렌더 이후에만 포커스 이동 가능(펜딩 플래그).
        if (_favDrawerFocusPending && _favDrawerOpen)
        {
            _favDrawerFocusPending = false;
            try { await JS.InvokeVoidAsync("nxDialogOpen", _favDrawerRef); }
            catch { /* JS 미탑재 — 포커스 관리 없이 정상 동작 */ }
        }
        // 리사이즈 핸들은 레일 모드 진입/이탈로 붙었다 떨어지므로, 존재할 때 1회 배선한다(idempotent).
        if (!_navCollapsed && !_navResizeInit)
        {
            _navResizeInit = true;
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("nxSidebarResizeInit", _navResizeHandle, _selfRef); }
            catch { /* JS 미탑재 — 폭 조절 없이 정상 동작 */ }
        }
        else if (_navCollapsed)
        {
            _navResizeInit = false;   // 레일 모드 이탈 시 재배선 허용
        }
    }

    // 사이드바 폭 드래그 종료 콜백(부트 스크립트) — 반영 + localStorage 저장은 스크립트가 담당.
    [JSInvokable]
    public Task OnNavResized(int width)
    {
        _navWidth = width;
        return InvokeAsync(StateHasChanged);
    }

    // 반응형 뷰포트 변화 콜백(nxViewportWatch) — 좁은 화면 진입=자동 접기(오버레이 기본 노출 방지),
    // 넓어지면 복원. 경계 교차 시에만 호출되므로 같은 구간 내 사용자 토글은 보존된다.
    [JSInvokable]
    public Task OnViewportChanged(bool narrow)
    {
        _navCollapsed = narrow;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        _darkTheme = !_darkTheme;
        await JS.InvokeVoidAsync("nxSetTheme", _darkTheme ? "dark" : "light");
    }

    // 언어 전환 — 서버 저장(SYS_USER.LANGUAGE) 성공 시에만 리소스 재로드(§20.8 원칙 미러).
    private async Task ToggleLanguageAsync()
    {
        var next = _language == "EnUs" ? "KoKr" : "EnUs";
        if (!await Api.SetUserLanguageAsync(next)) return;
        _language = next;
        Ui.Load(next, next == "KoKr"
            ? new Dictionary<string, string>(StringComparer.Ordinal)
            : await Api.GetLanguageResourcesAsync(next));
        // 저장과 리소스 교체가 모두 성공한 뒤 문서 언어를 바꿔 실패 시 화면 상태가 어긋나지 않게 한다.
        await JS.InvokeVoidAsync("nxSetLanguage", next);
        _documentLanguageApplied = next;
    }

    // ── 알림 센터(P3-20) ─────────────────────────────────────────────────────
    private List<NexaOne.Web.Services.Meta.RealtimeAlert> _alerts = new();
    private IDisposable? _alertSubscription;
    private bool _alertsOpen;
    private int _alertUnread;

    private void ToggleAlerts()
    {
        _alertsOpen = !_alertsOpen;
        if (_alertsOpen) _alertUnread = 0;   // 열람 = 미읽음 초기화
    }

    private async Task OnAlertAsync(NexaOne.Web.Services.Meta.RealtimeAlert alert)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _alerts.Insert(0, alert);
                if (_alerts.Count > 50) _alerts.RemoveAt(_alerts.Count - 1);
                if (!_alertsOpen) _alertUnread++;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* 회로 폐기 경합 — 무시 */ }
        catch (InvalidOperationException) { /* 회로 미부착 — 무시 */ }
    }

    // ── 상단바: Quick Menu(타이프어헤드 점프) + 사용자 메뉴(로그아웃) ─────────
    private string _quickQuery = string.Empty;
    private List<QuickMatch> _quickMatches = new();
    private bool _userMenuOpen;
    private string _userId = string.Empty;

    private sealed record QuickMatch(string UiId, string Title);

    private void OnQuickInput(ChangeEventArgs e)
    {
        _quickQuery = e.Value?.ToString() ?? string.Empty;
        var q = _quickQuery.Trim();
        // 다국어(P3-14 v2) — 표시는 번역명, 매칭은 한국어 원문/번역명/UI_ID 모두 허용(어느 언어로 쳐도 찾힌다).
        _quickMatches = q.Length == 0
            ? new List<QuickMatch>()
            : _uiToTitle
                .Select(kv => (UiId: kv.Key, Display: MenuDisplayByUiId(kv.Key, kv.Value), Original: kv.Value))
                .Where(m => m.Original.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || m.Display.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || m.UiId.Contains(q, StringComparison.OrdinalIgnoreCase))
                .OrderBy(m => m.Display, StringComparer.Ordinal)
                .Take(8)
                .Select(m => new QuickMatch(m.UiId, m.Display))
                .ToList();
    }

    // ── 다국어(P3-14 v2) — 메뉴명/탭 제목 번역 헬퍼(menu.{MENU_ID} 리소스, 미존재=한국어 원문) ──
    private string MenuDisplay(MesMenuNode n) => Ui.T($"menu.{n.Id}", n.Name);

    private string MenuDisplayByUiId(string uiId, string fallback)
        => _uiToMenuId.TryGetValue(uiId, out var menuId) ? Ui.T($"menu.{menuId}", fallback) : fallback;

    // 탭 제목은 열 때의 메뉴명이 저장되지만 렌더 시 현재 언어로 번역한다(전환 즉시 반영).
    private string TabTitle(NexaOne.Server.Services.OpenedScreen tab)
        => MenuDisplayByUiId(tab.UiId, tab.Title);

    private void OnQuickKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _quickQuery = string.Empty; _quickMatches.Clear(); }
        else if (e.Key == "Enter" && _quickMatches.Count > 0) QuickGo(_quickMatches[0]);
    }

    private void QuickGo(QuickMatch m)
    {
        _quickQuery = string.Empty;
        _quickMatches.Clear();
        NavigateTo(m.UiId, m.Title);
    }

    // 로그아웃 — 서버 리프레시 토큰 폐기(실패해도 로컬 세션은 종료) → 토큰 클리어 → 로그인으로.
    private async Task HandleLogoutAsync()
    {
        _userMenuOpen = false;
        try
        {
            var userId = await TokenService.GetUserIdAsync();
            var refresh = await TokenService.GetRefreshTokenAsync();
            if (userId is not null && refresh is not null)
                await Api.LogoutAsync(userId, refresh);
        }
        catch { /* 서버 폐기 실패(오프라인 등)여도 로컬 종료는 진행한다 */ }
        await TokenService.ClearAsync();
        AuthState.NotifyAuthChanged(null);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    // §20.12 순서 변경 — 이웃과 교환한 전체 순서를 서버에 재부여(PUT favorites/order), 성공 시에만 캐시 갱신.
    // 즐겨찾기 드로어(사용자 요청) — 열림 상태 + 이동/해제. 이동 시 드로어를 닫아 콘텐츠에 집중.
    // 열기/닫기는 항상 아래 메서드 경유 — inert 해제 '이후'(렌더 후)에만 포커스 이동이 가능해서
    // OnAfterRenderAsync 펜딩 플래그로 nxDialogOpen(첫 포커스+Tab 트랩)을 호출한다. 닫기는 포커스 복귀.
    private bool _favDrawerOpen;
    private bool _favDrawerFocusPending;
    private ElementReference _favDrawerRef;

    private async Task ToggleFavDrawerAsync()
    {
        if (_favDrawerOpen) { await CloseFavDrawerAsync(); return; }
        _favDrawerOpen = true;
        _favDrawerFocusPending = true;
    }

    private async Task CloseFavDrawerAsync()
    {
        if (!_favDrawerOpen) return;
        try { await JS.InvokeVoidAsync("nxDialogClose", _favDrawerRef); } catch { /* JS 미탑재 */ }
        _favDrawerOpen = false;
    }

    private async Task FavDrawerNavigateAsync(FavoriteMenuDto fav)
    {
        await CloseFavDrawerAsync();
        NavigateTo(fav.UiId, fav.MenuName);
    }

    private async Task RemoveFavoriteAsync(string menuId)
    {
        if (await Api.RemoveFavoriteMenuAsync(menuId))
            _favorites = await Api.GetFavoriteMenusAsync();   // 실패 시 캐시 미갱신(§20.8 원칙)
    }

    private async Task MoveFavoriteAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _favorites.Count) return;
        var reordered = new List<FavoriteMenuDto>(_favorites);
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);
        if (await Api.ReorderFavoriteMenusAsync(reordered.Select(f => f.MenuId).ToList()))
            _favorites = reordered;
    }

    private async Task ReloadPersonalizationAsync()
    {
        try
        {
            _favorites = await Api.GetFavoriteMenusAsync();
            _recents = await Api.GetRecentMenusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "개인화 메뉴 조회 실패 — 빈 목록으로 대체합니다.");
            _favorites = new();
            _recents = new();
        }
    }

    private bool IsActiveFavorite()
    {
        var ui = ActiveUiId();
        return ui is not null
            && _uiToMenuId.TryGetValue(ui, out var menuId)
            && _favorites.Any(f => string.Equals(f.MenuId, menuId, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ToggleActiveFavoriteAsync()
    {
        var ui = ActiveUiId();
        if (ui is null || !_uiToMenuId.TryGetValue(ui, out var menuId)) return;
        var ok = IsActiveFavorite()
            ? await Api.RemoveFavoriteMenuAsync(menuId)
            : await Api.AddFavoriteMenuAsync(menuId);
        if (ok) _favorites = await Api.GetFavoriteMenusAsync();   // 실패 시 캐시 미갱신(§20.8 원칙)
    }

    private async Task BuildTreeAsync()
    {
        List<MenuNode> nodes;
        try
        {
            // 역할 필터 트리(GET /api/v1/sys/menu-tree) — 미매핑 메뉴=공개, 매핑 메뉴=역할 일치 시만.
            // @currentUser 바인딩이 필요해 SYS.MenuTree 직접 조회 대신 호스트 엔드포인트를 쓴다.
            var rows = await Api.GetMenuTreeAsync();
            nodes = rows.Select(ToNode).ToList();
            if (nodes.Count == 0)
            {
                Logger.LogWarning("메뉴 트리가 0행 — 정적 폴백 메뉴를 사용합니다.");
                nodes = FallbackNodes();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "메뉴 트리 조회 실패 — 정적 폴백 메뉴를 사용합니다.");
            nodes = FallbackNodes();
        }

        _forest = PruneEmptyFolders(BuildForest(nodes));
        _treeLoadedAt = DateTime.UtcNow;

        try
        {
            _knownScreenUiIds = await Definitions.GetKnownUiIdsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "화면 정의 ID 카탈로그 조회 실패 — 리터럴 라우트만 점등합니다.");
            _knownScreenUiIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }

        // 파생 인덱스 — uiId→제목, uiId→조상 폴더 목록(활성 화면 진입 시 모든 상위 폴더 자동 펼침).
        _uiToTitle = new(StringComparer.OrdinalIgnoreCase);
        _uiToAncestors = new(StringComparer.OrdinalIgnoreCase);
        foreach (var root in _forest) IndexNode(root, Array.Empty<string>());
    }

    // 평면 노드 → 부모-자식 N단계 포레스트. 형제는 DISPLAY_SEQUENCE → MENU_ID 순. 순환 데이터는 visited로 무한재귀 차단.
    private static List<MesMenuNode> BuildForest(List<MenuNode> nodes)
    {
        var childrenByParent = nodes
            .Where(n => !string.IsNullOrWhiteSpace(n.ParentId))
            .GroupBy(n => n.ParentId!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key,
                g => g.OrderBy(n => n.Seq).ThenBy(n => n.Id, StringComparer.Ordinal).ToList(),
                StringComparer.OrdinalIgnoreCase);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        MesMenuNode Build(MenuNode n)
        {
            IReadOnlyList<MesMenuNode> kids = Array.Empty<MesMenuNode>();
            if (visited.Add(n.Id) && childrenByParent.TryGetValue(n.Id, out var list))
                kids = list.Select(Build).ToList();
            return new MesMenuNode(n.Id, n.Name, n.ParentId, n.Seq, n.Type, n.UiId, kids);
        }

        return nodes.Where(n => string.IsNullOrWhiteSpace(n.ParentId))
                    .OrderBy(n => n.Seq).ThenBy(n => n.Id, StringComparer.Ordinal)
                    .Select(Build).ToList();
    }

    // 역할 필터로 화면 잎이 모두 숨은 폴더는 표시하지 않는다(빈 폴더 방지). 잎은 그대로 통과.
    private static List<MesMenuNode> PruneEmptyFolders(List<MesMenuNode> nodes)
    {
        var result = new List<MesMenuNode>();
        foreach (var n in nodes)
        {
            if (!n.IsFolder) { result.Add(n); continue; }
            var kids = PruneEmptyFolders(n.Children.ToList());
            if (kids.Count > 0) result.Add(n with { Children = kids });
        }
        return result;
    }

    // 트리 1회 순회로 화면 잎의 제목·조상 인덱스를 채운다(폴더는 조상 경로에 누적).
    private void IndexNode(MesMenuNode node, IReadOnlyList<string> ancestors)
    {
        if (node.IsFolder)
        {
            var next = new List<string>(ancestors) { node.Id };
            foreach (var c in node.Children) IndexNode(c, next);
        }
        else if (!string.IsNullOrWhiteSpace(node.UiId))
        {
            _uiToTitle[node.UiId] = node.Name;
            _uiToAncestors[node.UiId] = ancestors;
            _uiToMenuId[node.UiId] = node.Id;
        }
    }

    // 게이트웨이 행 → 노드. 방언 값 타입 정규화: 문자열/숫자 모두 안전 변환, PARENT_MENU_ID는 null/공백 허용.
    private static MenuNode ToNode(IReadOnlyDictionary<string, object?> r) => new(
        Id: Str(r, "MENU_ID"),
        Name: Str(r, "MENU_NAME"),
        ParentId: NullableStr(r, "PARENT_MENU_ID"),
        Seq: Int(r, "DISPLAY_SEQUENCE"),
        Type: Str(r, "MENU_TYPE"),
        UiId: Str(r, "UI_ID"));

    private static string Str(IReadOnlyDictionary<string, object?> r, string key)
        => r.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";

    private static string? NullableStr(IReadOnlyDictionary<string, object?> r, string key)
    {
        if (!r.TryGetValue(key, out var v) || v is null) return null;
        var s = v.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    private static int Int(IReadOnlyDictionary<string, object?> r, string key)
    {
        if (!r.TryGetValue(key, out var v) || v is null) return 0;
        return v switch
        {
            int i => i,
            long l => (int)l,
            _ => int.TryParse(v.ToString(), out var p) ? p : 0
        };
    }

    // 접근성(P3-15) — role="button" 요소의 키보드 활성화 판정(Enter/Space).
    private static bool IsActivateKey(KeyboardEventArgs e) => e.Key is "Enter" or " " or "Spacebar";

    private void ToggleFolder(string folderId)
    {
        // 레일 모드(P3-11)에선 하위가 숨어 있으므로 폴더 클릭 = 사이드바 복원 + 해당 폴더 펼침.
        if (_navCollapsed)
        {
            _navCollapsed = false;
            _openFolders.Add(folderId);
            return;
        }
        if (!_openFolders.Remove(folderId)) _openFolders.Add(folderId);
    }

    // 사이드바 화면 잎 클릭 — MesNavTree의 OnNavigate 콜백 진입점.
    private void OnNavigateNode(MesMenuNode node) => NavigateTo(node.UiId, node.Name);

    private void NavigateTo(string uiId, string title)
    {
        if (string.IsNullOrWhiteSpace(uiId)) return;
        Opened.Open(uiId, title);
        Nav.NavigateTo(MetaHref(uiId), forceLoad: false);
    }

    // P3-10 — 탭 드래그 순서 변경 상태(드래그 시작 탭). drop 시 대상 탭 앞으로 이동.
    private string? _dragTabUiId;

    private void DropTab(string targetUiId)
    {
        if (_dragTabUiId is { } dragged) Opened.Move(dragged, targetUiId);
        _dragTabUiId = null;
    }

    private void CloseTab(string uiId)
    {
        var next = Opened.Close(uiId);
        // 활성 탭을 닫았으면 인접 탭으로 이동, 인접 탭도 없으면 기본 화면(DEMO_GRID)으로.
        var curUi = ActiveUiId();
        if (string.Equals(curUi, uiId, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(MetaHref(next ?? "DEMO_GRID"), forceLoad: false);
    }

    // ── MDI 탭 우클릭 컨텍스트 메뉴(P3-10) ─────────────────────────────────────
    private string? _tabMenuUiId;
    private double _tabMenuX;
    private double _tabMenuY;

    private void OpenTabMenu(MouseEventArgs e, string uiId)
    {
        _tabMenuUiId = uiId;
        _tabMenuX = e.ClientX;
        _tabMenuY = e.ClientY;
    }

    private void CloseTabMenu() => _tabMenuUiId = null;

    private void TabMenuClose()
    {
        var target = _tabMenuUiId;
        CloseTabMenu();
        if (target is not null) CloseTab(target);
    }

    private void TabMenuCloseOthers()
    {
        var target = _tabMenuUiId;
        CloseTabMenu();
        if (target is null) return;
        Opened.CloseOthers(target);
        // 남긴 탭이 현재 화면이 아니면 그 탭으로 이동한다.
        if (!string.Equals(ActiveUiId(), target, StringComparison.OrdinalIgnoreCase))
        {
            var title = _uiToTitle.TryGetValue(target, out var t) ? t : target;
            NavigateTo(target, title);
        }
    }

    private void TabMenuCloseAll()
    {
        CloseTabMenu();
        Opened.CloseAll();
        Nav.NavigateTo(MetaHref("DEMO_GRID"), forceLoad: false);
    }

    private static string MetaHref(string uiId) => $"/meta/{uiId}";

    // 현재 라우트의 uiId(/meta/{uiId}) — 활성 강조·MDI 동기화 기준. 비-meta 경로면 null.
    private string? ActiveUiId()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        if (rel.StartsWith("meta/", StringComparison.OrdinalIgnoreCase))
        {
            var ui = rel.Substring("meta/".Length).Split('/')[0];
            return string.IsNullOrWhiteSpace(ui) ? null : ui;
        }
        return null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _userMenuOpen = false;   // 화면 이동 시 열린 드롭다운 정리
        _alertsOpen = false;
        SyncCurrentRoute();
        // 트리가 60초 이상 오래됐으면 이동 시 백그라운드 재조회 — 메뉴-역할 매핑/메뉴 변경이
        // 재로그인 없이 다음 화면 이동에서 반영된다(이동마다 조회하지 않는 스테일네스 게이트).
        if (!_treeRefreshing && DateTime.UtcNow - _treeLoadedAt > TimeSpan.FromSeconds(60))
        {
            _treeRefreshing = true;
            _ = InvokeAsync(async () =>
            {
                try { await BuildTreeAsync(); }
                finally { _treeRefreshing = false; }
                StateHasChanged();
            });
            return;
        }
        InvokeAsync(StateHasChanged);
    }

    // 현재 라우트를 MDI 탭/활성 폴더에 반영한다(직접 URL 진입·뒤로가기 포함). 제목은 메뉴명 우선, 없으면 uiId.
    // 활성 화면의 모든 조상 폴더를 펼쳐 깊은 트리에서도 현재 위치가 사이드바에 드러나게 한다.
    private void SyncCurrentRoute()
    {
        var ui = ActiveUiId();
        if (string.IsNullOrWhiteSpace(ui)) return;
        var title = _uiToTitle.TryGetValue(ui, out var t) ? t : ui;
        Opened.Open(ui, title);
        if (_uiToAncestors.TryGetValue(ui, out var ancestors))
            foreach (var fid in ancestors) _openFolders.Add(fid);

        // §20.12 — 화면 사용을 부수 기록(사이드바 클릭·직접 URL·뒤로가기 공통 경로). 실패는 조용히 무시.
        if (_uiToMenuId.TryGetValue(ui, out var menuId))
            _ = RecordRecentAndRefreshAsync(menuId);
    }

    private async Task RecordRecentAndRefreshAsync(string menuId)
    {
        try
        {
            if (await Api.RecordRecentMenuAsync(menuId))
            {
                _recents = await Api.GetRecentMenusAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* 탐색 부수 기록 실패는 셸 동작에 영향 없음 */ }
    }

    private void OnOpenedChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Opened.Changed -= OnOpenedChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _alertSubscription?.Dispose();
        _selfRef?.Dispose();
    }

    // 셸이 절대 빈 사이드바가 되지 않도록 — 게이트웨이 실패/공백 시의 최소 정적 트리(데모 화면으로 매핑).
    private static List<MenuNode> FallbackNodes() => new()
    {
        new("M_STD", "기준정보", null, 10, "Folder", ""),
        new("M_STD_PLANT", "공장 관리", "M_STD", 10, "Screen", "DEMO_GRID"),
        new("M_PRD", "생산관리", null, 20, "Folder", ""),
        new("M_PRD_STATUS", "생산 현황", "M_PRD", 10, "Screen", "DEMO_LAYOUT"),
        new("M_SYS", "시스템관리", null, 90, "Folder", ""),
        new("M_SYS_MENU", "메뉴 관리", "M_SYS", 10, "Screen", "SYS_MENU_MGMT"),
    };
}
