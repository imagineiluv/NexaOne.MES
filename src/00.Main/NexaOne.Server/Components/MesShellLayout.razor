@inherits LayoutComponentBase
@implements IDisposable
@inject NexaOne.Web.Services.Api.IApiClient Api
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject NexaOne.Server.Services.OpenedScreensState Opened
@inject Microsoft.Extensions.Logging.ILogger<MesShellLayout> Logger
@inject NexaOne.Web.Services.Auth.AuthTokenService TokenService
@inject NexaOne.Web.Services.Auth.JwtAuthStateProvider AuthState
@inject NexaOne.Web.Services.Meta.IRealtimeAlertFeed AlertFeed

@* SmartUX(:9020) 레퍼런스 셸 재현 — 네이비 사이드바(계층 아코디언) + 화이트 상단바 + 본문(메타 화면) + 하단 MDI 탭.
   사이드바는 SYS.MenuTree(게이트웨이)로 데이터 주도 구축한다(대분류 Folder → 하위 Screen). 쿼리 실패/공백 시
   최소 정적 폴백으로 셸이 절대 빈 화면이 되지 않게 한다. /meta 화면(HostRoutes의 DefaultLayout). *@
<div class="mes-shell @(_navCollapsed ? "nav-collapsed" : "")">
    <aside class="mes-sidebar">
        <div class="mes-logo">
            <svg class="cube" viewBox="0 0 24 24" fill="none" stroke="#15b89a" stroke-width="1.8" stroke-linejoin="round">
                <path d="M12 2 3 7v10l9 5 9-5V7z" /><path d="M3 7l9 5 9-5" /><path d="M12 12v10" />
            </svg>
            <span class="brand">NexaOne<small>MES</small></span>
        </div>
        <nav class="mes-nav">
            @* §20.12 — 즐겨찾기/최근 메뉴(개인화). 서버 영속이라 어느 브라우저에서 접속해도 동일하다. *@
            @if (_favorites.Count > 0)
            {
                <div style="padding:0.375rem 0.875rem 0.125rem; font-size:0.688rem; color:#8ea0b8; letter-spacing:0.05em;">★ 즐겨찾기</div>
                @for (var i = 0; i < _favorites.Count; i++)
                {
                    var idx = i;                      @* 람다 캡처용 로컬 복사(루프 변수 직접 캡처 금지) *@
                    var fav = _favorites[idx];
                    <div @key="fav.MenuId" class="fav-item" style="display:flex; align-items:center; gap:0.25rem; padding:0.3rem 0.75rem 0.3rem 1.25rem; font-size:0.813rem; color:#d2dcea;"
                         title="@fav.MenuName">
                        <span style="flex:1; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                              @onclick="() => NavigateTo(fav.UiId, fav.MenuName)">@fav.MenuName</span>
                        @* §20.12 순서 변경 — ▲▼로 이웃과 교환(행 hover 시에만 노출, P3-18), 성공 시에만 캐시 반영. *@
                        @if (idx > 0)
                        {
                            <span class="fav-move" style="cursor:pointer; color:#8ea0b8; font-size:0.625rem;" title="위로"
                                  @onclick="() => MoveFavoriteAsync(idx, -1)">▲</span>
                        }
                        @if (idx < _favorites.Count - 1)
                        {
                            <span class="fav-move" style="cursor:pointer; color:#8ea0b8; font-size:0.625rem;" title="아래로"
                                  @onclick="() => MoveFavoriteAsync(idx, +1)">▼</span>
                        }
                    </div>
                }
            }
            @if (_recents.Count > 0)
            {
                <div style="padding:0.375rem 0.875rem 0.125rem; font-size:0.688rem; color:#8ea0b8; letter-spacing:0.05em;">최근 사용</div>
                @foreach (var recent in _recents)
                {
                    <div style="padding:0.3rem 1.25rem; font-size:0.813rem; color:#aebccd; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"
                         title="@recent.MenuName" @onclick="() => NavigateTo(recent.UiId, recent.MenuName)">
                        @recent.MenuName
                    </div>
                }
            }
            @if (_favorites.Count > 0 || _recents.Count > 0)
            {
                <div style="margin:0.375rem 0.875rem; border-top:1px solid rgba(255,255,255,0.08);"></div>
            }
            @* 트리 필터(P3-11) — 메뉴명/UI_ID 부분일치 잎+조상 폴더만 표시, 필터 중엔 전부 펼침. *@
            <div class="mes-navfilter">
                <input placeholder="메뉴 필터…" value="@_navFilter" @oninput="OnNavFilterInput" aria-label="메뉴 필터" />
            </div>
            <MesNavTree Nodes="VisibleForest" Depth="0" Open="EffectiveOpenFolders"
                        ActiveUiId="@ActiveUiId()"
                        OnToggle="ToggleFolder" OnNavigate="OnNavigateNode" />
        </nav>
        <div class="mes-pin">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 17v5M5 9h14l-1.5 8h-11z M8 9V5a4 4 0 0 1 8 0v4"/></svg>
            메뉴 고정 기능
        </div>
    </aside>

    <div class="mes-main">
        <header class="mes-topbar">
            @* 사이드바 접기 토글(P3-11/16) — 좁은 화면에선 사이드바가 오버레이로 뜬다(CSS 미디어쿼리). *@
            <span class="tb-ico" role="button" tabindex="0" aria-label="메뉴 접기/펼치기" title="메뉴 접기/펼치기"
                  style="cursor:pointer;" @onclick="() => _navCollapsed = !_navCollapsed">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </span>
            @* §20.12 — 활성 화면 즐겨찾기 토글(★=등록됨). 메뉴 매핑이 없는 화면(직접 라우트 등)은 표시만 한다. *@
            <span class="star" role="button" tabindex="0" aria-label="@(IsActiveFavorite() ? "즐겨찾기 해제" : "즐겨찾기 등록")"
                  style="cursor:pointer; color:@(IsActiveFavorite() ? "#f59e0b" : "inherit")"
                  title="@(IsActiveFavorite() ? "즐겨찾기 해제" : "즐겨찾기 등록")"
                  @onclick="ToggleActiveFavoriteAsync">@(IsActiveFavorite() ? "★" : "☆")</span>
            <span class="tb-title">제조실행시스템 (NexaOne MES)</span>
            @* Quick Menu — 사이드바 트리 인덱스(_uiToTitle) 기반 타이프어헤드 점프(레거시 퀵메뉴 미러, 서버 호출 없음). *@
            <div class="mes-quickmenu">
                <input placeholder="Quick Menu" value="@_quickQuery"
                       @oninput="OnQuickInput" @onkeydown="OnQuickKeyDown" />
                @if (_quickMatches.Count > 0)
                {
                    <div class="quick-results">
                        @foreach (var m in _quickMatches)
                        {
                            <div class="quick-item" @key="m.UiId" @onclick="() => QuickGo(m)">
                                <span>@m.Title</span><small>@m.UiId</small>
                            </div>
                        }
                    </div>
                }
            </div>
            @* 알림 센터(P3-20) — 버스 알림성 이벤트(알람/인터락/작업지시)의 벨 아이콘+최근 목록.
               열면 미읽음 뱃지 초기화. 피드는 회로 밖 스레드에서 콜백하므로 InvokeAsync로 전환한다. *@
            <div class="mes-alertmenu">
                <span class="tb-ico" role="button" tabindex="0" aria-label="알림" title="알림"
                      style="cursor:pointer; position:relative;" @onclick="ToggleAlerts">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    @if (_alertUnread > 0)
                    {
                        <span class="alert-badge">@(_alertUnread > 99 ? "99+" : _alertUnread.ToString())</span>
                    }
                </span>
                @if (_alertsOpen)
                {
                    <div class="alert-dropdown">
                        <div class="alert-dd-head">알림</div>
                        @if (_alerts.Count == 0)
                        {
                            <div class="alert-dd-empty">알림이 없습니다.</div>
                        }
                        @foreach (var alert in _alerts)
                        {
                            <div class="alert-dd-item">
                                <span class="alert-cat">@alert.Category</span>
                                <span class="alert-title">@alert.Title</span>
                                <small>@alert.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</small>
                            </div>
                        }
                    </div>
                }
            </div>
            @* 사용자 메뉴 — ID 표시·비밀번호 변경·로그아웃(리프레시 토큰 폐기 후 세션 종료).
               (구 톱니 아이콘은 연결 기능이 없어 제거 — 장식 UI를 두지 않는다) *@
            <div class="mes-usermenu">
                <span class="tb-ico" role="button" tabindex="0" aria-label="사용자 메뉴" title="사용자 메뉴"
                      style="cursor:pointer;" @onclick="() => _userMenuOpen = !_userMenuOpen">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                </span>
                @if (_userMenuOpen)
                {
                    <div class="user-dropdown">
                        <div class="user-dd-id">@(_userId.Length > 0 ? _userId : "(사용자)")</div>
                        <a class="user-dd-item" href="/change-password">비밀번호 변경</a>
                        <div class="user-dd-item" @onclick="HandleLogoutAsync">로그아웃</div>
                    </div>
                }
            </div>
        </header>

        @* MDI 탭 — 열린 /meta 화면들. 활성 강조 + X로 닫기 + 우클릭 컨텍스트(닫기/다른 탭/모두, P3-10).
           탭이 많으면 가로 스크롤(오버플로). 탭이 없으면 바를 숨긴다. *@
        @if (Opened.Screens.Count > 0)
        {
            <div class="mes-mditabs">
                @foreach (var tab in Opened.Screens)
                {
                    var tabActive = string.Equals(tab.UiId, Opened.ActiveUiId, StringComparison.OrdinalIgnoreCase);
                    <div class="mes-mditab @(tabActive ? "active" : "")" @onclick="() => NavigateTo(tab.UiId, tab.Title)"
                         @oncontextmenu="e => OpenTabMenu(e, tab.UiId)" @oncontextmenu:preventDefault="true">
                        <span class="mes-mditab-label">@tab.Title</span>
                        <span class="close" @onclick="() => CloseTab(tab.UiId)" @onclick:stopPropagation="true">&times;</span>
                    </div>
                }
            </div>
        }

        @* 탭 우클릭 컨텍스트 메뉴 — 투명 백드롭 클릭으로 닫힘. *@
        @if (_tabMenuUiId is not null)
        {
            <div class="tabmenu-backdrop" @onclick="CloseTabMenu" @oncontextmenu="CloseTabMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="tabmenu" style="left:@(_tabMenuX)px; top:@(_tabMenuY)px;">
                <div class="tabmenu-item" @onclick="() => TabMenuClose()">닫기</div>
                <div class="tabmenu-item" @onclick="() => TabMenuCloseOthers()">다른 탭 모두 닫기</div>
                <div class="tabmenu-item" @onclick="() => TabMenuCloseAll()">모두 닫기</div>
            </div>
        }

        <section class="mes-content">
            @Body
        </section>
    </div>

    @* 전역 API 토스트(403/5xx/검증 실패) — ApiNotificationService의 유일한 소비자(P1-4). *@
    <NexaOne.Web.Components.ApiToastHost />
</div>

@code {
    // 사이드바 트리(N단계: 대분류 → 중분류 → … → 화면) 및 펼침 상태. OnInitialized에서 SYS.MenuTree로 1회 구축.
    private sealed record MenuNode(string Id, string Name, string? ParentId, int Seq, string Type, string UiId);

    private List<MesMenuNode> _forest = new();
    private readonly HashSet<string> _openFolders = new(StringComparer.OrdinalIgnoreCase);
    // uiId → 메뉴명(MDI 탭 제목). 트리에서 파생.
    private Dictionary<string, string> _uiToTitle = new(StringComparer.OrdinalIgnoreCase);
    // uiId → 조상 폴더 id 목록(활성 화면의 모든 상위 폴더 자동 펼침용).
    private Dictionary<string, IReadOnlyList<string>> _uiToAncestors = new(StringComparer.OrdinalIgnoreCase);
    // uiId → menuId — §20.12 즐겨찾기/최근 기록의 키는 MENU_ID다(같은 화면을 여러 잎이 가리키면 마지막 잎).
    private Dictionary<string, string> _uiToMenuId = new(StringComparer.OrdinalIgnoreCase);
    // §20.12 — 즐겨찾기/최근 메뉴(서버 영속). 실패는 빈 목록으로 흡수돼 셸을 깨지 않는다.
    private List<FavoriteMenuDto> _favorites = new();
    private List<RecentMenuDto> _recents = new();
    // 사이드바 트리 스테일네스 게이트 — 이동 시 60초 초과면 재조회(메뉴-역할 변경 반영).
    private DateTime _treeLoadedAt = DateTime.MinValue;
    private bool _treeRefreshing;

    // ── 사이드바 접기/트리 필터(P3-11) ──────────────────────────────────────
    private bool _navCollapsed;
    private string _navFilter = string.Empty;

    private void OnNavFilterInput(ChangeEventArgs e) => _navFilter = e.Value?.ToString() ?? string.Empty;

    // 필터 중엔 매칭 잎+조상 폴더만 남긴 트리(폴더명 매칭은 하위 전체 유지). 필터 없으면 원본.
    private List<MesMenuNode> VisibleForest
        => string.IsNullOrWhiteSpace(_navFilter) ? _forest : FilterForest(_forest, _navFilter.Trim());

    // 필터 중엔 남은 폴더를 전부 펼쳐 매칭 잎이 바로 보이게 한다(수동 펼침 상태는 비필터 시 복원).
    private HashSet<string> EffectiveOpenFolders
        => string.IsNullOrWhiteSpace(_navFilter) ? _openFolders : CollectFolderIds(VisibleForest);

    private static List<MesMenuNode> FilterForest(List<MesMenuNode> nodes, string query)
    {
        var result = new List<MesMenuNode>();
        foreach (var node in nodes)
        {
            if (node.IsFolder)
            {
                if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                {
                    result.Add(node);   // 폴더명 매칭 = 하위 전체 유지
                    continue;
                }
                var kids = FilterForest(node.Children.ToList(), query);
                if (kids.Count > 0) result.Add(node with { Children = kids });
            }
            else if (node.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                  || node.UiId.Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                result.Add(node);
            }
        }
        return result;
    }

    private static HashSet<string> CollectFolderIds(List<MesMenuNode> nodes)
    {
        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Walk(IReadOnlyList<MesMenuNode> list)
        {
            foreach (var n in list)
            {
                if (!n.IsFolder) continue;
                ids.Add(n.Id);
                Walk(n.Children);
            }
        }
        Walk(nodes);
        return ids;
    }

    protected override async Task OnInitializedAsync()
    {
        await BuildTreeAsync();
        await ReloadPersonalizationAsync();
        _userId = await TokenService.GetUserIdAsync() ?? string.Empty;
        // 알림 센터(P3-20) — 최근 스냅숏 + 신규 알림 구독.
        _alerts = AlertFeed.Recent.ToList();
        _alertSubscription = AlertFeed.Subscribe(OnAlertAsync);
        Opened.Changed += OnOpenedChanged;
        Nav.LocationChanged += OnLocationChanged;
        SyncCurrentRoute();
    }

    // ── 알림 센터(P3-20) ─────────────────────────────────────────────────────
    private List<NexaOne.Web.Services.Meta.RealtimeAlert> _alerts = new();
    private IDisposable? _alertSubscription;
    private bool _alertsOpen;
    private int _alertUnread;

    private void ToggleAlerts()
    {
        _alertsOpen = !_alertsOpen;
        if (_alertsOpen) _alertUnread = 0;   // 열람 = 미읽음 초기화
    }

    private async Task OnAlertAsync(NexaOne.Web.Services.Meta.RealtimeAlert alert)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _alerts.Insert(0, alert);
                if (_alerts.Count > 50) _alerts.RemoveAt(_alerts.Count - 1);
                if (!_alertsOpen) _alertUnread++;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* 회로 폐기 경합 — 무시 */ }
        catch (InvalidOperationException) { /* 회로 미부착 — 무시 */ }
    }

    // ── 상단바: Quick Menu(타이프어헤드 점프) + 사용자 메뉴(로그아웃) ─────────
    private string _quickQuery = string.Empty;
    private List<QuickMatch> _quickMatches = new();
    private bool _userMenuOpen;
    private string _userId = string.Empty;

    private sealed record QuickMatch(string UiId, string Title);

    private void OnQuickInput(ChangeEventArgs e)
    {
        _quickQuery = e.Value?.ToString() ?? string.Empty;
        var q = _quickQuery.Trim();
        _quickMatches = q.Length == 0
            ? new List<QuickMatch>()
            : _uiToTitle
                .Where(kv => kv.Value.Contains(q, StringComparison.OrdinalIgnoreCase)
                          || kv.Key.Contains(q, StringComparison.OrdinalIgnoreCase))
                .OrderBy(kv => kv.Value, StringComparer.Ordinal)
                .Take(8)
                .Select(kv => new QuickMatch(kv.Key, kv.Value))
                .ToList();
    }

    private void OnQuickKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _quickQuery = string.Empty; _quickMatches.Clear(); }
        else if (e.Key == "Enter" && _quickMatches.Count > 0) QuickGo(_quickMatches[0]);
    }

    private void QuickGo(QuickMatch m)
    {
        _quickQuery = string.Empty;
        _quickMatches.Clear();
        NavigateTo(m.UiId, m.Title);
    }

    // 로그아웃 — 서버 리프레시 토큰 폐기(실패해도 로컬 세션은 종료) → 토큰 클리어 → 로그인으로.
    private async Task HandleLogoutAsync()
    {
        _userMenuOpen = false;
        try
        {
            var userId = await TokenService.GetUserIdAsync();
            var refresh = await TokenService.GetRefreshTokenAsync();
            if (userId is not null && refresh is not null)
                await Api.LogoutAsync(userId, refresh);
        }
        catch { /* 서버 폐기 실패(오프라인 등)여도 로컬 종료는 진행한다 */ }
        await TokenService.ClearAsync();
        AuthState.NotifyAuthChanged(null);
        Nav.NavigateTo("/login", forceLoad: true);
    }

    // §20.12 순서 변경 — 이웃과 교환한 전체 순서를 서버에 재부여(PUT favorites/order), 성공 시에만 캐시 갱신.
    private async Task MoveFavoriteAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _favorites.Count) return;
        var reordered = new List<FavoriteMenuDto>(_favorites);
        (reordered[index], reordered[target]) = (reordered[target], reordered[index]);
        if (await Api.ReorderFavoriteMenusAsync(reordered.Select(f => f.MenuId).ToList()))
            _favorites = reordered;
    }

    private async Task ReloadPersonalizationAsync()
    {
        try
        {
            _favorites = await Api.GetFavoriteMenusAsync();
            _recents = await Api.GetRecentMenusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "개인화 메뉴 조회 실패 — 빈 목록으로 대체합니다.");
            _favorites = new();
            _recents = new();
        }
    }

    private bool IsActiveFavorite()
    {
        var ui = ActiveUiId();
        return ui is not null
            && _uiToMenuId.TryGetValue(ui, out var menuId)
            && _favorites.Any(f => string.Equals(f.MenuId, menuId, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ToggleActiveFavoriteAsync()
    {
        var ui = ActiveUiId();
        if (ui is null || !_uiToMenuId.TryGetValue(ui, out var menuId)) return;
        var ok = IsActiveFavorite()
            ? await Api.RemoveFavoriteMenuAsync(menuId)
            : await Api.AddFavoriteMenuAsync(menuId);
        if (ok) _favorites = await Api.GetFavoriteMenusAsync();   // 실패 시 캐시 미갱신(§20.8 원칙)
    }

    private async Task BuildTreeAsync()
    {
        List<MenuNode> nodes;
        try
        {
            // 역할 필터 트리(GET /api/v1/sys/menu-tree) — 미매핑 메뉴=공개, 매핑 메뉴=역할 일치 시만.
            // @currentUser 바인딩이 필요해 SYS.MenuTree 직접 조회 대신 호스트 엔드포인트를 쓴다.
            var rows = await Api.GetMenuTreeAsync();
            nodes = rows.Select(ToNode).ToList();
            if (nodes.Count == 0)
            {
                Logger.LogWarning("메뉴 트리가 0행 — 정적 폴백 메뉴를 사용합니다.");
                nodes = FallbackNodes();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "메뉴 트리 조회 실패 — 정적 폴백 메뉴를 사용합니다.");
            nodes = FallbackNodes();
        }

        _forest = PruneEmptyFolders(BuildForest(nodes));
        _treeLoadedAt = DateTime.UtcNow;

        // 파생 인덱스 — uiId→제목, uiId→조상 폴더 목록(활성 화면 진입 시 모든 상위 폴더 자동 펼침).
        _uiToTitle = new(StringComparer.OrdinalIgnoreCase);
        _uiToAncestors = new(StringComparer.OrdinalIgnoreCase);
        foreach (var root in _forest) IndexNode(root, Array.Empty<string>());
    }

    // 평면 노드 → 부모-자식 N단계 포레스트. 형제는 DISPLAY_SEQUENCE → MENU_ID 순. 순환 데이터는 visited로 무한재귀 차단.
    private static List<MesMenuNode> BuildForest(List<MenuNode> nodes)
    {
        var childrenByParent = nodes
            .Where(n => !string.IsNullOrWhiteSpace(n.ParentId))
            .GroupBy(n => n.ParentId!, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key,
                g => g.OrderBy(n => n.Seq).ThenBy(n => n.Id, StringComparer.Ordinal).ToList(),
                StringComparer.OrdinalIgnoreCase);
        var visited = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        MesMenuNode Build(MenuNode n)
        {
            IReadOnlyList<MesMenuNode> kids = Array.Empty<MesMenuNode>();
            if (visited.Add(n.Id) && childrenByParent.TryGetValue(n.Id, out var list))
                kids = list.Select(Build).ToList();
            return new MesMenuNode(n.Id, n.Name, n.ParentId, n.Seq, n.Type, n.UiId, kids);
        }

        return nodes.Where(n => string.IsNullOrWhiteSpace(n.ParentId))
                    .OrderBy(n => n.Seq).ThenBy(n => n.Id, StringComparer.Ordinal)
                    .Select(Build).ToList();
    }

    // 역할 필터로 화면 잎이 모두 숨은 폴더는 표시하지 않는다(빈 폴더 방지). 잎은 그대로 통과.
    private static List<MesMenuNode> PruneEmptyFolders(List<MesMenuNode> nodes)
    {
        var result = new List<MesMenuNode>();
        foreach (var n in nodes)
        {
            if (!n.IsFolder) { result.Add(n); continue; }
            var kids = PruneEmptyFolders(n.Children.ToList());
            if (kids.Count > 0) result.Add(n with { Children = kids });
        }
        return result;
    }

    // 트리 1회 순회로 화면 잎의 제목·조상 인덱스를 채운다(폴더는 조상 경로에 누적).
    private void IndexNode(MesMenuNode node, IReadOnlyList<string> ancestors)
    {
        if (node.IsFolder)
        {
            var next = new List<string>(ancestors) { node.Id };
            foreach (var c in node.Children) IndexNode(c, next);
        }
        else if (!string.IsNullOrWhiteSpace(node.UiId))
        {
            _uiToTitle[node.UiId] = node.Name;
            _uiToAncestors[node.UiId] = ancestors;
            _uiToMenuId[node.UiId] = node.Id;
        }
    }

    // 게이트웨이 행 → 노드. 방언 값 타입 정규화: 문자열/숫자 모두 안전 변환, PARENT_MENU_ID는 null/공백 허용.
    private static MenuNode ToNode(IReadOnlyDictionary<string, object?> r) => new(
        Id: Str(r, "MENU_ID"),
        Name: Str(r, "MENU_NAME"),
        ParentId: NullableStr(r, "PARENT_MENU_ID"),
        Seq: Int(r, "DISPLAY_SEQUENCE"),
        Type: Str(r, "MENU_TYPE"),
        UiId: Str(r, "UI_ID"));

    private static string Str(IReadOnlyDictionary<string, object?> r, string key)
        => r.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";

    private static string? NullableStr(IReadOnlyDictionary<string, object?> r, string key)
    {
        if (!r.TryGetValue(key, out var v) || v is null) return null;
        var s = v.ToString();
        return string.IsNullOrWhiteSpace(s) ? null : s;
    }

    private static int Int(IReadOnlyDictionary<string, object?> r, string key)
    {
        if (!r.TryGetValue(key, out var v) || v is null) return 0;
        return v switch
        {
            int i => i,
            long l => (int)l,
            _ => int.TryParse(v.ToString(), out var p) ? p : 0
        };
    }

    private void ToggleFolder(string folderId)
    {
        if (!_openFolders.Remove(folderId)) _openFolders.Add(folderId);
    }

    // 사이드바 화면 잎 클릭 — MesNavTree의 OnNavigate 콜백 진입점.
    private void OnNavigateNode(MesMenuNode node) => NavigateTo(node.UiId, node.Name);

    private void NavigateTo(string uiId, string title)
    {
        if (string.IsNullOrWhiteSpace(uiId)) return;
        Opened.Open(uiId, title);
        Nav.NavigateTo(MetaHref(uiId), forceLoad: false);
    }

    private void CloseTab(string uiId)
    {
        var next = Opened.Close(uiId);
        // 활성 탭을 닫았으면 인접 탭으로 이동, 인접 탭도 없으면 기본 화면(DEMO_GRID)으로.
        var curUi = ActiveUiId();
        if (string.Equals(curUi, uiId, StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo(MetaHref(next ?? "DEMO_GRID"), forceLoad: false);
    }

    // ── MDI 탭 우클릭 컨텍스트 메뉴(P3-10) ─────────────────────────────────────
    private string? _tabMenuUiId;
    private double _tabMenuX;
    private double _tabMenuY;

    private void OpenTabMenu(MouseEventArgs e, string uiId)
    {
        _tabMenuUiId = uiId;
        _tabMenuX = e.ClientX;
        _tabMenuY = e.ClientY;
    }

    private void CloseTabMenu() => _tabMenuUiId = null;

    private void TabMenuClose()
    {
        var target = _tabMenuUiId;
        CloseTabMenu();
        if (target is not null) CloseTab(target);
    }

    private void TabMenuCloseOthers()
    {
        var target = _tabMenuUiId;
        CloseTabMenu();
        if (target is null) return;
        Opened.CloseOthers(target);
        // 남긴 탭이 현재 화면이 아니면 그 탭으로 이동한다.
        if (!string.Equals(ActiveUiId(), target, StringComparison.OrdinalIgnoreCase))
        {
            var title = _uiToTitle.TryGetValue(target, out var t) ? t : target;
            NavigateTo(target, title);
        }
    }

    private void TabMenuCloseAll()
    {
        CloseTabMenu();
        Opened.CloseAll();
        Nav.NavigateTo(MetaHref("DEMO_GRID"), forceLoad: false);
    }

    private static string MetaHref(string uiId) => $"/meta/{uiId}";

    // 현재 라우트의 uiId(/meta/{uiId}) — 활성 강조·MDI 동기화 기준. 비-meta 경로면 null.
    private string? ActiveUiId()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
        if (rel.StartsWith("meta/", StringComparison.OrdinalIgnoreCase))
        {
            var ui = rel.Substring("meta/".Length).Split('/')[0];
            return string.IsNullOrWhiteSpace(ui) ? null : ui;
        }
        return null;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _userMenuOpen = false;   // 화면 이동 시 열린 드롭다운 정리
        _alertsOpen = false;
        SyncCurrentRoute();
        // 트리가 60초 이상 오래됐으면 이동 시 백그라운드 재조회 — 메뉴-역할 매핑/메뉴 변경이
        // 재로그인 없이 다음 화면 이동에서 반영된다(이동마다 조회하지 않는 스테일네스 게이트).
        if (!_treeRefreshing && DateTime.UtcNow - _treeLoadedAt > TimeSpan.FromSeconds(60))
        {
            _treeRefreshing = true;
            _ = InvokeAsync(async () =>
            {
                try { await BuildTreeAsync(); }
                finally { _treeRefreshing = false; }
                StateHasChanged();
            });
            return;
        }
        InvokeAsync(StateHasChanged);
    }

    // 현재 라우트를 MDI 탭/활성 폴더에 반영한다(직접 URL 진입·뒤로가기 포함). 제목은 메뉴명 우선, 없으면 uiId.
    // 활성 화면의 모든 조상 폴더를 펼쳐 깊은 트리에서도 현재 위치가 사이드바에 드러나게 한다.
    private void SyncCurrentRoute()
    {
        var ui = ActiveUiId();
        if (string.IsNullOrWhiteSpace(ui)) return;
        var title = _uiToTitle.TryGetValue(ui, out var t) ? t : ui;
        Opened.Open(ui, title);
        if (_uiToAncestors.TryGetValue(ui, out var ancestors))
            foreach (var fid in ancestors) _openFolders.Add(fid);

        // §20.12 — 화면 사용을 부수 기록(사이드바 클릭·직접 URL·뒤로가기 공통 경로). 실패는 조용히 무시.
        if (_uiToMenuId.TryGetValue(ui, out var menuId))
            _ = RecordRecentAndRefreshAsync(menuId);
    }

    private async Task RecordRecentAndRefreshAsync(string menuId)
    {
        try
        {
            if (await Api.RecordRecentMenuAsync(menuId))
            {
                _recents = await Api.GetRecentMenusAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* 탐색 부수 기록 실패는 셸 동작에 영향 없음 */ }
    }

    private void OnOpenedChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Opened.Changed -= OnOpenedChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _alertSubscription?.Dispose();
    }

    // 셸이 절대 빈 사이드바가 되지 않도록 — 게이트웨이 실패/공백 시의 최소 정적 트리(데모 화면으로 매핑).
    private static List<MenuNode> FallbackNodes() => new()
    {
        new("M_STD", "기준정보", null, 10, "Folder", ""),
        new("M_STD_PLANT", "공장 관리", "M_STD", 10, "Screen", "DEMO_GRID"),
        new("M_PRD", "생산관리", null, 20, "Folder", ""),
        new("M_PRD_STATUS", "생산 현황", "M_PRD", 10, "Screen", "DEMO_LAYOUT"),
        new("M_SYS", "시스템관리", null, 90, "Folder", ""),
        new("M_SYS_MENU", "메뉴 관리", "M_SYS", 10, "Screen", "SYS_MENU_MGMT"),
    };
}
