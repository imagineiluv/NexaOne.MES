<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NexaOne (통합 호스트)</title>
    <base href="/" />
    @* P3-17 다크 모드 — 첫 페인트 전에 저장된 테마를 적용해 깜빡임을 막는다. 토글은 셸 사용자 메뉴. *@
    <script>
        document.documentElement.dataset.theme = localStorage.getItem('nx-theme') || 'light';
        window.nxSetTheme = function (t) {
            localStorage.setItem('nx-theme', t);
            document.documentElement.dataset.theme = t;
        };
        window.nxGetTheme = function () { return document.documentElement.dataset.theme || 'light'; };
        /* P3-9 셀 복사 — clipboard 미지원(비보안 컨텍스트 등)이면 조용히 no-op. */
        window.nxCopy = function (t) {
            return navigator.clipboard && navigator.clipboard.writeText
                ? navigator.clipboard.writeText(t) : Promise.resolve();
        };
        /* 그리드 CSV 내보내기 — 문자열 CSV를 Blob으로 다운로드. UTF-8 BOM으로 Excel 한글 깨짐 방지. */
        window.nxDownloadCsv = function (filename, csv) {
            var blob = new Blob(["﻿" + csv], { type: "text/csv;charset=utf-8;" });
            var url = URL.createObjectURL(blob);
            var a = document.createElement("a");
            a.href = url; a.download = filename || "export.csv";
            document.body.appendChild(a); a.click();
            document.body.removeChild(a); URL.revokeObjectURL(url);
        };
        /* P3-11 사이드바 폭 드래그 — 핸들 드래그로 --mes-nav-width 조절, localStorage 저장. */
        window.nxGetNavWidth = function () { return parseInt(localStorage.getItem('nx-nav-width') || '0', 10) || 0; };
        window.nxSidebarResizeInit = function (handle, dotnet) {
            if (!handle || handle.__nxResize) return;
            handle.__nxResize = true;
            var shell = handle.closest('.mes-shell');
            var dragging = false;
            handle.addEventListener('pointerdown', function (e) {
                dragging = true; handle.setPointerCapture(e.pointerId); e.preventDefault();
            });
            handle.addEventListener('pointermove', function (e) {
                if (!dragging || !shell) return;
                var w = Math.min(420, Math.max(180, e.clientX - shell.getBoundingClientRect().left));
                shell.style.setProperty('--mes-nav-width', w + 'px');
                handle.__nxW = w;
            });
            handle.addEventListener('pointerup', function () {
                if (!dragging) return;
                dragging = false;
                if (handle.__nxW) {
                    localStorage.setItem('nx-nav-width', String(handle.__nxW));
                    if (dotnet) dotnet.invokeMethodAsync('OnNavResized', handle.__nxW);
                }
            });
        };
        /* 반응형 — 좁은 화면(≤1100px) 진입/이탈을 .NET에 보고해 사이드바를 자동 접기/복원.
           경계 교차 시에만 통지(같은 구간 내 사용자 토글 보존). 로드 시 1회 초기 보고. */
        window.nxViewportWatch = function (dotnet) {
            if (window.__nxVpWatch || !dotnet) return;
            window.__nxVpWatch = true;
            var narrow = null, t;
            function report() {
                var isNarrow = window.innerWidth <= 1100;
                if (isNarrow !== narrow) { narrow = isNarrow; dotnet.invokeMethodAsync('OnViewportChanged', isNarrow); }
            }
            window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(report, 150); });
            report();
        };
    </script>
    @* Radzen Blazor 테마(구조+CSS 변수) — nexaone.css '앞'에 두어, nexaone.css의 --rz-* → --nx-* 브리지
       매핑이 뒤에서 이겨 NAF 브랜드/다크 토큰을 따르게 한다. *@
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" />
    <link rel="stylesheet" href="css/nexaone.css" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    @* prerender:false 필수(설계 §4) — 화면 인증은 클라이언트 JWT(JwtAuthStateProvider)가 담당한다. SSR 프리렌더
       단계엔 클라이언트 토큰을 알 수 없어 [Authorize] 화면이 미인증으로 판정→로그인 무한루프가 생긴다. 컴포넌트는
       서킷 연결(클라이언트) 이후에만 렌더해 실제 인증 상태로 평가되게 한다. *@
    <HostRoutes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>
