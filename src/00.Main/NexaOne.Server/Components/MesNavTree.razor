@namespace NexaOne.Server.Components
@inject IServiceProvider Services

@* SmartUX 사이드바의 계층 메뉴를 재귀 렌더한다(대분류 → 중분류 → … → 화면, N단계).
   Folder: 클릭=토글(자식 펼침). Screen: /meta/{UiId} 이동(부모가 OnNavigate 처리).
   깊이별 좌패딩으로 들여쓰기를 표현한다(인라인 padding-left가 CSS shorthand의 left만 덮어씀).
   '준비 중' 잎(화면 정의 미등록)은 회색+표시 — 시드에 박제하지 않는 렌더 시점 판정이라
   화면이 점등되면 별도 조치 없이 정상 표시로 돌아온다(죽은 클릭 사전 안내). *@
@foreach (var node in Nodes)
{
    var display = DisplayName?.Invoke(node) ?? node.Name;
    if (node.IsFolder)
    {
        var isOpen = Open.Contains(node.Id);
        <div class="mes-nav-folder @(isOpen ? "open" : "")">
            <div class="mes-nav-item mes-folder-head @(isOpen ? "open" : "")"
                 style="padding-left:@(Pad)px" role="button" tabindex="0" title="@display" aria-expanded="@isOpen"
                 @onclick="() => OnToggle.InvokeAsync(node.Id)"
                 @onkeydown="async e => { if (IsActivateKey(e)) await OnToggle.InvokeAsync(node.Id); }">
                @if (Depth == 0)
                {
                    @((MarkupString)Icon(IconFor(node.Name)))
                }
                else
                {
                    <span class="dot"></span>
                }
                <span>@display</span>
                <svg class="chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </div>
            <div class="mes-nav-sub @(isOpen ? "expanded" : "collapsed")">
                @if (node.Children.Count > 0)
                {
                    <MesNavTree Nodes="node.Children" Depth="Depth + 1" Open="Open"
                                ActiveUiId="ActiveUiId" OnToggle="OnToggle" OnNavigate="OnNavigate"
                                DisplayName="DisplayName" KnownScreenUiIds="KnownScreenUiIds" />
                }
                else
                {
                    <span class="mes-nav-subitem mes-empty" style="padding-left:@(Pad + Indent)px">@T("shell.noSubmenu", "하위 메뉴 없음")</span>
                }
            </div>
        </div>
    }
    else
    {
        var isActive = string.Equals(node.UiId, ActiveUiId, StringComparison.OrdinalIgnoreCase);
        // 점등 = 메타 정의 등록 '또는' 호스트 리터럴 라우트(@page "/meta/리터럴") — 후자 누락 시
        // 동작하는 화면 4종(권한/신청승인/S O/레이아웃편집)이 회색 오표시되는 실사고가 있었다.
        var isPending = !KnownScreenUiIds.Contains(node.UiId)
            && !NexaOne.Server.Services.HostLiteralMetaRoutes.Contains(node.UiId);
        <a class="mes-nav-subitem @(isActive ? "active" : "") @(isPending ? "pending" : "")"
           style="padding-left:@(Pad)px"
           href="@($"/meta/{node.UiId}")" title="@(isPending ? string.Format(T("shell.pendingNamed", "{0} — 준비 중"), display) : display)"
           aria-label="@(isPending ? string.Format(T("shell.pendingNamedAria", "{0}, 준비 중"), display) : display)" aria-current="@(isActive ? "page" : null)"
           @onclick="() => OnNavigate.InvokeAsync(node)" @onclick:preventDefault="true">
            <span class="dot"></span>
            <span>@display</span>
        </a>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MesMenuNode> Nodes { get; set; } = Array.Empty<MesMenuNode>();
    [Parameter] public int Depth { get; set; }
    [Parameter, EditorRequired] public HashSet<string> Open { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public string? ActiveUiId { get; set; }
    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback<MesMenuNode> OnNavigate { get; set; }
    [Parameter, EditorRequired]
    public IReadOnlySet<string> KnownScreenUiIds { get; set; }
        = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    // 다국어(P3-14 v2) — 표시명 변환(menu.{MENU_ID} 리소스). null이면 원본 메뉴명.
    [Parameter] public Func<MesMenuNode, string>? DisplayName { get; set; }

    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
        }
        return _uiText?.T(key, fallback) ?? fallback;
    }

    // 접근성(P3-15) — 폴더 헤드(div)의 키보드 활성화 판정(Enter/Space).
    private static bool IsActivateKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
        => e.Key is "Enter" or " " or "Spacebar";

    private const int Indent = 16;
    // 깊이별 좌패딩 — depth0은 18px(기존 .mes-nav-item과 정렬), 이후 14px씩 들여쓴다.
    private int Pad => 16 + Depth * Indent;

    // 대분류(depth0) 폴더 아이콘 — 메뉴명 키워드로 SmartUX풍 라인 아이콘 선택(없으면 그리드 기본).
    // 구체 키워드 우선(위→아래) — 과거 '관리' 광역 규칙이 출하/구매 관리를 렌치로 삼키고 PPM=WPM,
    // EMS=EPT=FDC가 같은 아이콘을 받아 스캔성이 떨어지던 문제 교정(대분류마다 고유 아이콘).
    private static string IconFor(string name) => name switch
    {
        var n when n.Contains("대시보드") => "chart",
        var n when n.Contains("영업") || n.Contains("판매") => "briefcase",
        var n when n.Contains("레시피") => "flask",
        var n when n.Contains("출하") => "truck",
        var n when n.Contains("구매") => "cart",
        var n when n.Contains("창고") || n.Contains("재고") || n.Contains("자재") => "box",
        var n when n.Contains("QCA") => "target",
        var n when n.Contains("품질") || n.Contains("QMS") => "shield",
        var n when n.Contains("EMS") || n.Contains("보전") => "hammer",
        var n when n.Contains("EPT") || n.Contains("상태") => "monitor",
        var n when n.Contains("FDC") || n.Contains("수집") || n.Contains("설비") => "activity",
        var n when n.Contains("PPM") || n.Contains("생산") => "factory",
        var n when n.Contains("WPM") || n.Contains("작업") => "clipboard",
        var n when n.Contains("기준") || n.Contains("MDM") || n.Contains("정보") => "db",
        var n when n.Contains("시스템") || n.Contains("관리") => "wrench",
        _ => "grid",
    };

    // 사이드바 라인 아이콘(stroke=currentColor — CSS가 색 제어). 정적 입력이라 MarkupString 안전.
    private static string Icon(string key)
    {
        const string open = "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">";
        var body = key switch
        {
            "grid"      => "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/>",
            "gear"      => "<circle cx='12' cy='12' r='3'/><path d='M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2'/>",
            "shield"    => "<path d='M12 3l8 3v6c0 5-4 8-8 9-4-1-8-4-8-9V6z'/><path d='M9 12l2 2 4-4'/>",
            "wrench"    => "<path d='M21 4a5 5 0 0 1-6.5 6.5L5 20l-1-1 9.5-9.5A5 5 0 0 1 20 3z'/>",
            "db"        => "<ellipse cx='12' cy='5' rx='8' ry='3'/><path d='M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5'/><path d='M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3'/>",
            "box"       => "<path d='M21 8l-9-5-9 5 9 5 9-5z'/><path d='M3 8v8l9 5 9-5V8'/><path d='M12 13v8'/>",
            "activity"  => "<path d='M3 12h4l3 8 4-16 3 8h4'/>",
            "chart"     => "<path d='M3 21h18'/><path d='M6 21v-6M11 21V9M16 21v-4M21 21V5'/>",
            "briefcase" => "<rect x='3' y='7' width='18' height='13' rx='2'/><path d='M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2'/><path d='M3 13h18'/>",
            "flask"     => "<path d='M10 3v6L4.5 19a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 9V3'/><path d='M8 3h8'/><path d='M7 15h10'/>",
            "truck"     => "<rect x='2' y='7' width='12' height='9'/><path d='M14 10h4l3 3v3h-3'/><circle cx='6.5' cy='18.5' r='1.8'/><circle cx='17.5' cy='18.5' r='1.8'/>",
            "cart"      => "<circle cx='9' cy='20' r='1.6'/><circle cx='17' cy='20' r='1.6'/><path d='M3 4h2l2.5 12h11L21 8H7'/>",
            "target"    => "<circle cx='12' cy='12' r='8'/><circle cx='12' cy='12' r='4'/><circle cx='12' cy='12' r='1'/>",
            "hammer"    => "<path d='M15 12l-8.5 8.5a2.1 2.1 0 0 1-3-3L12 9'/><path d='M17.6 4.4l2 2a2 2 0 0 1 0 2.8l-1.4 1.4-4.8-4.8 1.4-1.4a2 2 0 0 1 2.8 0z'/>",
            "monitor"   => "<rect x='3' y='4' width='18' height='12' rx='2'/><path d='M8 20h8M12 16v4'/><path d='M7 12l2-3 2 2 3-4 2 3'/>",
            "factory"   => "<path d='M3 21V9l6 4V9l6 4V5h6v16z'/><path d='M7 17h2M12 17h2M17 17h2'/>",
            "clipboard" => "<rect x='5' y='4' width='14' height='17' rx='2'/><path d='M9 4a3 3 0 0 1 6 0'/><path d='M9 11h6M9 15h4'/>",
            _           => "<rect x='4' y='4' width='16' height='16' rx='2'/>",
        };
        return open + body + "</svg>";
    }
}
