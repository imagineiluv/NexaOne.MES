@page "/meta/SYS_USER_REQUESTS"
@attribute [Authorize]
@inject IApiClient Api
@using System.Security.Claims
@using NexaOne.Common.Security

@* §19.3.4/5/6 — 사용자 등록 신청 승인 화면. 리터럴 라우트가 MetaScreen(/meta/{UiId})보다 우선하므로
   메뉴/MDI 탭에 메타 화면처럼 통합된다. 승인/반려는 브리지 REST(임시 비밀번호 발급)라 메타 커맨드로는
   표현 불가 — 전용 페이지가 정당하다. 임시 비밀번호는 승인 직후 1회만 표시된다(재조회 불가). *@
<PageTitle>사용자 신청 승인</PageTitle>

@if (!_canManage)
{
    <div style="padding:2rem; text-align:center; color:#6b7280;">
        <h1 style="font-size:1.125rem; font-weight:600; color:#1f2937;">사용자 신청 승인</h1>
        <p style="margin-top:0.5rem; font-size:0.875rem;">이 화면은 sys:manage 권한이 필요합니다.</p>
    </div>
}
else
{
    <div style="padding:1rem;">
        <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
            <h1 style="font-size:1.125rem; font-weight:700; color:#111827; margin:0;">사용자 신청 승인</h1>
            <select @bind="_statusFilter" @bind:after="ReloadAsync"
                    style="padding:0.375rem 0.5rem; border:1px solid #d1d5db; border-radius:0.375rem; font-size:0.813rem;">
                <option value="Request">대기(Request)</option>
                <option value="Approved">승인됨</option>
                <option value="Rejected">반려됨</option>
                <option value="">전체</option>
            </select>
            <button @onclick="ReloadAsync" style="padding:0.375rem 0.75rem; background:#f3f4f6; border:1px solid #d1d5db; border-radius:0.375rem; font-size:0.813rem; cursor:pointer;">
                새로고침
            </button>
        </div>

        @if (_approvedResult is not null)
        {
            <div style="margin-bottom:0.75rem; padding:0.875rem 1rem; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:0.375rem; font-size:0.875rem; color:#065f46;">
                <strong>'@_approvedResult.Request.UserId'</strong> 승인 완료 — 임시 비밀번호:
                <code style="font-size:0.938rem; font-weight:700; background:#d1fae5; padding:0.125rem 0.375rem; border-radius:0.25rem;">@_approvedResult.TempPassword</code>
                <span style="display:block; margin-top:0.25rem; font-size:0.75rem;">
                    지금만 표시됩니다 — 사용자에게 전달하세요. 최초 로그인 시 비밀번호 변경이 강제됩니다.
                </span>
            </div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="margin-bottom:0.75rem; color:#dc2626; font-size:0.875rem;">@_error</div>
        }

        <table style="width:100%; border-collapse:collapse; font-size:0.813rem;">
            <thead>
                <tr style="background:#f9fafb; text-align:left;">
                    <th style="@Th">신청일</th><th style="@Th">ID</th><th style="@Th">이름</th><th style="@Th">이메일</th>
                    <th style="@Th">부서/직위</th><th style="@Th">공장</th><th style="@Th">상태</th><th style="@Th">처리</th>
                </tr>
            </thead>
            <tbody>
                @if (_requests.Count == 0)
                {
                    <tr><td colspan="8" style="padding:1.5rem; text-align:center; color:#9ca3af;">@(_loading ? "불러오는 중…" : "신청이 없습니다.")</td></tr>
                }
                @foreach (var r in _requests)
                {
                    <tr style="border-bottom:1px solid #f3f4f6;">
                        <td style="@Td">@r.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="@Td"><strong>@r.UserId</strong>@(r.RequestVersion > 1 ? $" (재신청 v{r.RequestVersion})" : "")</td>
                        <td style="@Td">@r.UserName</td>
                        <td style="@Td">@r.Email</td>
                        <td style="@Td">@r.Department / @r.Position</td>
                        <td style="@Td">@r.PlantId</td>
                        <td style="@Td">
                            @if (r.Status == "Request") { <span style="color:#d97706;">대기</span> }
                            else if (r.Status == "Approved") { <span style="color:var(--nx-teal-d);">승인(@r.ApprovedBy)</span> }
                            else { <span style="color:#dc2626;" title="@r.RejectReason">반려(@r.RejectedBy)</span> }
                        </td>
                        <td style="@Td">
                            @if (r.Status == "Request")
                            {
                                <button @onclick="() => _actionTarget = (_actionTarget == r.RequestId ? null : r.RequestId)"
                                        style="padding:0.25rem 0.625rem; background:#eff6ff; border:1px solid #bfdbfe; color:#1d4ed8; border-radius:0.25rem; cursor:pointer;">
                                    처리
                                </button>
                            }
                        </td>
                    </tr>
                    @if (_actionTarget == r.RequestId)
                    {
                        <tr style="background:#f9fafb;">
                            <td colspan="8" style="padding:0.625rem 0.75rem;">
                                <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                    <label style="font-size:0.813rem; color:#374151;">부여 역할</label>
                                    <select @bind="_selectedRoleId" style="padding:0.375rem 0.5rem; border:1px solid #d1d5db; border-radius:0.375rem;">
                                        @foreach (var role in _roles)
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                    <button @onclick="() => ApproveAsync(r.RequestId)" disabled="@_busy"
                                            style="padding:0.375rem 0.875rem; background:var(--nx-teal-d); color:#fff; border:none; border-radius:0.375rem; cursor:pointer;">
                                        승인
                                    </button>
                                    <span style="color:#d1d5db;">|</span>
                                    <input @bind="_rejectReason" placeholder="반려 사유(필수)"
                                           style="flex:1; min-width:12rem; padding:0.375rem 0.5rem; border:1px solid #d1d5db; border-radius:0.375rem;" />
                                    <button @onclick="() => RejectAsync(r.RequestId)" disabled="@(_busy || string.IsNullOrWhiteSpace(_rejectReason))"
                                            style="padding:0.375rem 0.875rem; background:#dc2626; color:#fff; border:none; border-radius:0.375rem; cursor:pointer;">
                                        반려
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private const string Th = "padding:0.5rem 0.75rem; border-bottom:1px solid #e5e7eb; font-weight:600; color:#374151;";
    private const string Td = "padding:0.5rem 0.75rem; color:#1f2937;";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canManage;
    private bool _loading;
    private bool _busy;
    private string _statusFilter = "Request";
    private string? _error;
    private string? _actionTarget;
    private string _selectedRoleId = "VIEWER";
    private string _rejectReason = string.Empty;
    private List<UserRequestDto> _requests = new();
    private List<string> _roles = new();
    private UserRequestApprovalDto? _approvedResult;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _canManage = user.HasPermission(Permissions.SysManage);
        }
        if (!_canManage) return;

        // 승인 역할 드롭다운 — SYS_ROLE 실데이터(명명 쿼리). 실패/공백이면 표준 역할 시드(V063) 폴백.
        var roleRows = await Api.ExecuteQueryAsync("SYS.ListRoles");
        _roles = roleRows
            .Select(row => row.TryGetValue("ROLE_ID", out var v) ? v?.ToString() ?? "" : "")
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToList();
        if (_roles.Count == 0) _roles = new List<string> { "VIEWER", "OPERATOR", "ADMIN" };
        if (!_roles.Contains(_selectedRoleId)) _selectedRoleId = _roles[0];

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _requests = await Api.GetUserRequestsAsync(
                status: string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter);
        }
        finally { _loading = false; }
    }

    private async Task ApproveAsync(string requestId)
    {
        _busy = true;
        _error = null;
        _approvedResult = null;
        try
        {
            var (approval, error) = await Api.ApproveUserRequestAsync(requestId, _selectedRoleId);
            if (approval is null) { _error = error ?? "승인에 실패했습니다."; return; }
            _approvedResult = approval;   // 임시 비밀번호 1회 표시
            _actionTarget = null;
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RejectAsync(string requestId)
    {
        _busy = true;
        _error = null;
        try
        {
            var (request, error) = await Api.RejectUserRequestAsync(requestId, _rejectReason.Trim());
            if (request is null) { _error = error ?? "반려에 실패했습니다."; return; }
            _actionTarget = null;
            _rejectReason = string.Empty;
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
