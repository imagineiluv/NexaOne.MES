@page "/change-password"
@layout HostLayout
@inject IApiClient Api
@inject NavigationManager Nav

@* §20.10 강제 비밀번호 변경 — 임시 비밀번호(승인 발급) 로그인 직후 진입한다(HostLogin이 리다이렉트).
   pwdChange 토큰은 업무 API가 차단되지만 auth 경로(change-password)는 허용되므로 이 화면에서 자기해제한다:
   변경 성공 시 ApiClient가 새 토큰(클레임 없음)으로 즉시 교체하고 셸로 이동한다. 일반 사용자의 수동
   비밀번호 변경 진입점으로도 동작한다(인증 토큰만 있으면 됨). *@
<div class="host-card">
    <h1 class="host-title">비밀번호 변경</h1>
    <p class="host-sub">
        임시 비밀번호로 로그인한 경우 새 비밀번호로 변경해야 업무 화면을 사용할 수 있습니다
    </p>

    <EditForm Model="@_model" OnValidSubmit="HandleChange">
        <DataAnnotationsValidator />

        <div class="host-field">
            <label>현재 비밀번호</label>
            <input class="host-input" @bind="_model.CurrentPassword" type="password" placeholder="현재(임시) 비밀번호" />
        </div>

        <div class="host-field">
            <label>새 비밀번호</label>
            <input class="host-input" @bind="_model.NewPassword" type="password" placeholder="새 비밀번호" />
        </div>

        <div class="host-field">
            <label>새 비밀번호 확인</label>
            <input class="host-input" @bind="_model.ConfirmPassword" type="password" placeholder="새 비밀번호 다시 입력" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="host-error">@_error</div>
        }

        <button type="submit" class="host-btn" disabled="@_loading">
            @(_loading ? "변경 중…" : "비밀번호 변경")
        </button>
    </EditForm>

    <p class="host-help">
        <a href="/login" class="host-link">로그인으로</a>
    </p>
</div>

@code {
    private ChangeFormModel _model = new();
    private string? _error;
    private bool _loading;

    private async Task HandleChange()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_model.CurrentPassword) || string.IsNullOrWhiteSpace(_model.NewPassword))
        {
            _error = "현재 비밀번호와 새 비밀번호를 입력해 주세요.";
            return;
        }
        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _error = "새 비밀번호와 확인 입력이 일치하지 않습니다.";
            return;
        }

        _loading = true;
        try
        {
            // 실패 사유(정책 미달·현재 비밀번호 불일치)는 서버 Error.Description을 그대로 노출한다.
            var (ok, error) = await Api.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword, _model.ConfirmPassword);
            if (!ok)
            {
                _error = error ?? "비밀번호 변경에 실패했습니다.";
                return;
            }
            // 성공 — ApiClient가 새 토큰(pwdChange 클레임 없음)으로 교체 완료. 업무 셸로 진입한다.
            Nav.NavigateTo("/meta/DEMO_GRID", forceLoad: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class ChangeFormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword     { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
