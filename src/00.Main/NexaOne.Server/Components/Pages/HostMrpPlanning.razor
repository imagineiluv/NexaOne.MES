@page "/meta/NX_MRP_PLANNING"
@attribute [Authorize]
@inject IApiClient Api
@inject DialogService Dialogs
@using NexaOne.Web.Pages.Meta

@* 자재 소요 계획(MRP v1) + 실행 툴바 — 실행은 브리지 REST(pom:manage, POM 모듈 IMrpPlanner 경유)라
   메타 커맨드로 표현 불가 → 리터럴 라우트로 툴바만 감싸고 본문(계획오더 제안+실행 이력)은 MetaScreen
   자식 렌더로 메타 정의를 그대로 재사용한다(VE 관리 규약 1호). 실행 성공 시 @key 갱신으로 재조회. *@
<PageTitle>자재 소요 계획(MRP)</PageTitle>

<div class="mes-card host-toolbar">
    <strong>MRP 실행</strong>
    <RadzenButton Icon="calculate" Click="RunAsync" Disabled="@(_busy || _converting)" class="layout-command"
                  ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small"
                  Text="@(_busy ? "전개 중…" : "소요량 전개 실행")" />
    @* v2 3단 — 기간 버킷(주간×8) 시간위상 전개: 제안이 품목×버킷 다행, DUE=버킷 시작일. *@
    <RadzenButton Icon="calendar_view_week" Click="RunBucketedAsync" Disabled="@(_busy || _converting)" class="layout-command"
                  ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Small"
                  Text="@(_busy ? "전개 중…" : "주간 버킷 전개")" />
    @* 구매 제안은 구매오더, 생산 제안은 생산계획+생산관리오더로 전환하며 생산 설비를 명시한다. *@
    <RadzenButton Icon="published_with_changes" Click="ConvertAsync" Disabled="@(_busy || _converting)" class="layout-command"
                  ButtonStyle="Radzen.ButtonStyle.Secondary" Size="Radzen.ButtonSize.Small"
                  Text="@(_converting ? "전환 중…" : "실오더 전환")" />
    <span class="host-desc">수요 → BOM 전개 → 계획오더 제안 → 구매오더 또는 생산계획·생산관리오더 전환</span>
    @if (_result is not null)
    {
        @if (_result.Status == "Success")
        {
            <span class="host-chip ok">수요 @(_result.DemandCount)건 → 제안 @(_result.PlannedOrderCount)건 (@_result.RunId)</span>
        }
        else
        {
            <span class="host-chip bad" title="@_result.Message">실패 — @_result.Message</span>
        }
    }
    @if (_convert is not null)
    {
        @if (_convert.Message is null)
        {
            <span class="host-chip ok">전환 @(_convert.Converted)건 — 구매오더 @(_convert.PurchaseOrders)·생산계획/오더 @(_convert.ProductionOrders)</span>
        }
        else
        {
            <span class="host-chip bad" title="@_convert.Message">@_convert.Message</span>
        }
    }
</div>

<MetaScreen UiId="NX_MRP_PLANNING" BridgeBulkHandler="OnBridgeBulkAsync" @key="_refreshSeq" />

@code {
    private bool _busy;
    private bool _converting;
    private int _refreshSeq;
    private MrpRunResultDto? _result;
    private MrpConvertResultDto? _convert;

    private Task RunAsync() => RunCoreAsync(null, null);

    private Task RunBucketedAsync() => RunCoreAsync(7, 8);   // 주간×8버킷(스펙 기본값)

    private async Task RunCoreAsync(int? bucketDays, int? horizonBuckets)
    {
        _busy = true;
        try
        {
            // 403/모듈 OFF/5xx는 null — 사유는 전역 토스트가 알린다(ApiClient 규약).
            _result = await Api.RunMrpAsync(bucketDays, horizonBuckets);
            _convert = null;   // 새 런 기준으로 전환 칩 초기화
            if (_result is { Status: "Success" }) _refreshSeq++;   // 자식 MetaScreen 재생성 = 제안/이력 재조회
        }
        finally { _busy = false; }
    }

    // 브리지 일괄명령(bridge:pom.mrp.convert) — 선택 행의 PLANNED_ORDER_ID만 원자 전환.
    private async Task<bool> OnBridgeBulkAsync(BulkCommandDefinition cmd, List<Dictionary<string, object?>> rows)
    {
        // 이 호스트는 MRP 일괄 전환 계약만 소유한다. 다른 bridge 명령을 MRP 전환으로 오인하지 않고
        // 해당 명령의 전용 드라이버 또는 호스트가 처리하도록 정확한 명령 ID만 허용한다.
        if (!HandlesBridgeBulkCommand(cmd.CommandQueryId))
            return false;

        if (_converting) return false;
        _converting = true;
        try
        {
            var converted = await ConvertRowsAsync(rows);
            StateHasChanged();
            return converted;
        }
        finally
        {
            _converting = false;
        }
    }

    /// <summary>전달된 일괄 bridge 명령을 이 MRP 호스트가 소유하는지 확인합니다.</summary>
    internal static bool HandlesBridgeBulkCommand(string commandId)
        => string.Equals(
            commandId,
            MrpConversionMetaCommands.Convert,
            StringComparison.OrdinalIgnoreCase);

    private async Task ConvertAsync()
    {
        _converting = true;
        try
        {
            var rows = await Api.ExecuteQueryAsync("POM.MrpPlannedOrderList", new { runId = _result?.RunId });
            await ConvertRowsAsync(rows);
        }
        finally { _converting = false; }
    }

    private async Task<bool> ConvertRowsAsync(IReadOnlyList<Dictionary<string, object?>> sourceRows)
    {
        var rows = sourceRows
            .Where(r => Cell(r, "STATUS").Equals("Proposed", StringComparison.OrdinalIgnoreCase))
            .Where(r => !string.IsNullOrWhiteSpace(Cell(r, "PLANNED_ORDER_ID")))
            .ToList();

        if (rows.Count == 0)
        {
            SetConversionError("전환할 Proposed 제안이 없습니다.");
            return false;
        }

        var runIds = rows.Select(r => Cell(r, "RUN_ID"))
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (runIds.Count != 1)
        {
            SetConversionError("서로 다른 MRP 실행의 제안을 함께 전환할 수 없습니다.");
            return false;
        }

        var production = rows
            .Where(r => Cell(r, "ORDER_TYPE").Equals("Production", StringComparison.OrdinalIgnoreCase))
            .Select(r => new MrpProductionProposalDto(
                Cell(r, "PLANNED_ORDER_ID"),
                Cell(r, "PLANT_ID"),
                Cell(r, "ITEM_ID"),
                DecimalCell(r, "SUGGESTED_QTY"),
                DateCell(r, "RELEASE_DATE"),
                DateCell(r, "DUE_DATE")))
            .ToList();

        var dialogResult = await Dialogs.OpenAsync<MrpConversionDialog>(
            "MRP 실오더 전환",
            new Dictionary<string, object?>
            {
                [nameof(MrpConversionDialog.ProductionProposals)] = production,
                [nameof(MrpConversionDialog.PurchaseProposalCount)] = rows.Count - production.Count
            },
            new DialogOptions
            {
                Width = "920px",
                CloseDialogOnOverlayClick = false,
                Resizable = true,
                Draggable = true
            });

        if (dialogResult is not List<MrpProductionAssignmentDto> assignments)
            return false;

        var ids = rows.Select(r => Cell(r, "PLANNED_ORDER_ID")).ToList();
        _convert = await Api.ConvertMrpAsync(runIds[0], ids, assignments);
        if (_convert is { Message: null, Converted: > 0 })
        {
            _refreshSeq++;
            return true;
        }
        return false;
    }

    private void SetConversionError(string message)
        => _convert = new MrpConvertResultDto(string.Empty, 0, 0, 0, message);

    private static string Cell(IReadOnlyDictionary<string, object?> row, string key)
        => row.TryGetValue(key, out var value) ? value?.ToString()?.Trim() ?? string.Empty : string.Empty;

    private static decimal DecimalCell(IReadOnlyDictionary<string, object?> row, string key)
        => decimal.TryParse(Cell(row, key), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : 0m;

    private static DateTime? DateCell(IReadOnlyDictionary<string, object?> row, string key)
        => DateTime.TryParse(Cell(row, key), System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeUniversal, out var value) ? value : null;
}
