@page "/meta/NX_EXPENSE_WORKSPACE"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using NexaFramework.Service
@using NexaFramework.Service.Erp
@using NexaOne.Common.Security
@using NexaOne.ServiceContracts.Erp
@using NexaOne.ServiceContracts.Sys
@inject IApiClient Api
@inject UiTextService Ui
@inject AuthenticationStateProvider Authentication
@inject IJSRuntime JS

<PageTitle>@T("expenseWorkspace.title", "비용 작업 공간", "Expense workspace")</PageTitle>
<div class="expense-workspace">
    <header>
        <p class="expense-eyebrow">@T("expenseWorkspace.eyebrow", "ERP · 비용 통제", "ERP · Expense control")</p>
        <h1>@T("expenseWorkspace.title", "비용 작업 공간", "Expense workspace")</h1>
        <p>@T("expenseWorkspace.intro", "조직별 비용 기준정보를 관리하고 비용을 등록해 청구·지급·환급·취소 상태를 추적합니다.", "Manage expense directories by organization and track each expense through billing, payment, reimbursement, and cancellation.")</p>
        <a class="expense-back" href="/meta/NX_BILLING_WORKSPACE">@T("expenseWorkspace.backBilling", "청구 작업 공간으로 돌아가기", "Back to billing workspace")</a>
    </header>

    @if (_identityLoading)
    {
        <p role="status">@T("inventory.loading", "불러오는 중…", "Loading…")</p>
    }
    else if (!_authenticated)
    {
        <p role="status">@T("inventory.signIn", "인증 상태를 확인하고 다시 로그인해 주세요.", "Check your session and sign in again.")</p>
    }
    else
    {
        <div class="expense-message" aria-live="polite">
            @if (_busy) { <p role="status">@T("inventory.loading", "불러오는 중…", "Loading…")</p> }
            @if (_error is not null) { <p role="alert">@_error</p> }
            @if (_notice is not null) { <p role="status">@_notice</p> }
        </div>
        <section aria-labelledby="expense-scope-heading">
            <div class="expense-heading"><div><p class="expense-kicker">01</p><h2 id="expense-scope-heading">@T("expenseWorkspace.scopes", "내 비용 범위", "My expense scopes")</h2></div><button id="expense-scopes-refresh" type="button" disabled="@_busy" @onclick="ReloadScopesAsync">@T("inventory.refreshScopes", "범위 새로고침", "Refresh scopes")</button></div>
            @if (_scopes is not null)
            {
                @if (_scopes.Items.Count == 0) { <p data-empty="true">@T("expenseWorkspace.noScopes", "현재 접근 가능한 비용 범위가 없습니다.", "No expense scopes are currently accessible.")</p> }
                else
                {
                    <ul class="expense-scopes">@foreach (var scope in _scopes.Items) { <li @key="ScopeKey(scope)"><button type="button" data-scope="@ScopeKey(scope)" aria-pressed="@((SelectedKey == ScopeKey(scope)).ToString().ToLowerInvariant())" disabled="@_busy" @onclick="() => SelectScopeAsync(scope)"><strong>@T("inventory.organization", "조직", "Organization") @Short(scope.OrganizationId)</strong><span>@scope.TenantId.ToString("D") · @string.Join(", ", scope.Permissions)</span></button></li> }</ul>
                }
            }
        </section>

        @if (_scope is not null)
        {
            <div class="expense-scope-summary" role="status"><span>@T("expenseWorkspace.selectedScope", "선택 범위", "Selected scope")</span><strong>@SelectedKey</strong></div>
            @if (!Can("expense.read") && !Can("expense.directory.read"))
            {
                <p role="status">@T("expenseWorkspace.noRead", "이 범위에는 현재 비용 또는 기준정보 조회 권한이 없습니다.", "You currently have no expense or directory read permission in this scope.")</p>
            }

            @if (Can("expense.directory.read"))
            {
                <section aria-labelledby="expense-directory-heading">
                    <div class="expense-heading"><div><p class="expense-kicker">02</p><h2 id="expense-directory-heading">@T("expenseWorkspace.directory", "비용 기준정보", "Expense directory")</h2></div><button id="expense-directory-refresh" type="button" disabled="@_busy" @onclick="LoadDirectoriesAsync">@T("expenseWorkspace.refresh", "새로고침", "Refresh")</button></div>
                    @if (Can("expense.directory.write"))
                    {
                        <div class="expense-directory-create">
                            <div class="expense-directory-entry"><label for="expense-category-name">@T("expenseWorkspace.categoryName", "새 카테고리 이름", "New category name")</label><div><input id="expense-category-name" aria-label="@T("expenseWorkspace.categoryName", "새 카테고리 이름", "New category name")" @bind="_categoryName" disabled="@_busy" maxlength="255" /><button id="expense-category-create" type="button" disabled="@_busy" @onclick="CreateCategoryAsync">@T("expenseWorkspace.addCategory", "카테고리 추가", "Add category")</button></div></div>
                            <div class="expense-directory-entry"><label for="expense-vendor-name">@T("expenseWorkspace.vendorName", "새 거래처 이름", "New vendor name")</label><div><input id="expense-vendor-name" aria-label="@T("expenseWorkspace.vendorName", "새 거래처 이름", "New vendor name")" @bind="_vendorName" disabled="@_busy" maxlength="255" /><button id="expense-vendor-create" type="button" disabled="@_busy" @onclick="CreateVendorAsync">@T("expenseWorkspace.addVendor", "거래처 추가", "Add vendor")</button></div></div>
                            <div class="expense-directory-entry"><label for="expense-tag-name">@T("expenseWorkspace.tagName", "새 태그 이름", "New tag name")</label><div><input id="expense-tag-name" aria-label="@T("expenseWorkspace.tagName", "새 태그 이름", "New tag name")" @bind="_tagName" disabled="@_busy" maxlength="255" /><button id="expense-tag-create" type="button" disabled="@_busy" @onclick="CreateTagAsync">@T("expenseWorkspace.addTag", "태그 추가", "Add tag")</button></div></div>
                        </div>
                    }
                    <div class="expense-directory-grid">
                        <div>
                            <h3>@T("expenseWorkspace.categories", "카테고리", "Categories")</h3>
                            @if (_directoryCategories is { } categories)
                            {
                                @if (categories.Items.Count == 0) { <p data-empty="true">@T("expenseWorkspace.noDirectoryCategories", "카테고리가 없습니다.", "No categories.")</p> }
                                else
                                {
                                    <ul class="expense-pills">
                                        @foreach (var item in categories.Items)
                                        {
                                            <li @key="item.Id" class="@(!item.Active ? "is-inactive" : null)">
                                                <div><strong>@item.Input.Name</strong><span>@Short(item.Id) · @DirectoryState(item.Active)</span></div>
                                                @if (Can("expense.directory.write")) { <button type="button" data-edit-category="@item.Id" aria-pressed="@((_selectedCategory?.Id == item.Id).ToString().ToLowerInvariant())" disabled="@_busy" @onclick="() => SelectCategory(item)">@T("expenseWorkspace.edit", "편집", "Edit")</button> }
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            @if (_selectedCategory is not null && Can("expense.directory.write"))
                            {
                                <form class="expense-directory-editor" @onsubmit="UpdateCategoryAsync" @onsubmit:preventDefault>
                                    <h4>@T("expenseWorkspace.editCategory", "카테고리 편집", "Edit category")</h4>
                                    <label for="expense-category-edit-name">@T("expenseWorkspace.name", "이름", "Name")<input id="expense-category-edit-name" aria-label="@T("expenseWorkspace.name", "이름", "Name")" maxlength="255" required autocomplete="off" @bind="_categoryEditName" disabled="@_busy" /></label>
                                    <p id="expense-category-lifecycle-help">@T("expenseWorkspace.inactiveHistoryHelp", "비활성화해도 기존 비용의 참조와 감사 이력은 유지되며 새 비용에서는 선택할 수 없습니다.", "Deactivation preserves existing expense references and audit history but prevents selection for new expenses.")</p>
                                    <div class="expense-directory-actions">
                                        <button id="expense-category-save" type="submit" disabled="@_busy">@T("expenseWorkspace.save", "변경 저장", "Save changes")</button>
                                        <button id="expense-category-active" class="@(_selectedCategory.Active ? "danger" : null)" type="button" aria-describedby="expense-category-lifecycle-help" disabled="@_busy" @onclick="SetCategoryActiveAsync">@(_selectedCategory.Active ? T("expenseWorkspace.deactivate", "비활성화", "Deactivate") : T("expenseWorkspace.reactivate", "재활성화", "Reactivate"))</button>
                                        <button id="expense-category-edit-cancel" type="button" disabled="@_busy" @onclick="() => SetSelectedCategory(null)">@T("expenseWorkspace.cancelEdit", "편집 닫기", "Close editor")</button>
                                    </div>
                                </form>
                            }
                        </div>
                        <div>
                            <h3>@T("expenseWorkspace.vendors", "거래처", "Vendors")</h3>
                            @if (_directoryVendors is { } vendors)
                            {
                                @if (vendors.Items.Count == 0) { <p data-empty="true">@T("expenseWorkspace.noDirectoryVendors", "거래처가 없습니다.", "No vendors.")</p> }
                                else
                                {
                                    <ul class="expense-pills">
                                        @foreach (var item in vendors.Items)
                                        {
                                            <li @key="item.Id" class="@(!item.Active ? "is-inactive" : null)">
                                                <div><strong>@item.Input.Name</strong><span>@Short(item.Id) · @DirectoryState(item.Active)</span></div>
                                                @if (Can("expense.directory.write")) { <button type="button" data-edit-vendor="@item.Id" aria-pressed="@((_selectedVendor?.Id == item.Id).ToString().ToLowerInvariant())" disabled="@_busy" @onclick="() => SelectVendor(item)">@T("expenseWorkspace.edit", "편집", "Edit")</button> }
                                            </li>
                                        }
                                    </ul>
                                }
                            }
                            @if (_selectedVendor is not null && Can("expense.directory.write"))
                            {
                                <form class="expense-directory-editor" @onsubmit="UpdateVendorAsync" @onsubmit:preventDefault>
                                    <h4>@T("expenseWorkspace.editVendor", "거래처 편집", "Edit vendor")</h4>
                                    <label for="expense-vendor-edit-name">@T("expenseWorkspace.name", "이름", "Name")<input id="expense-vendor-edit-name" aria-label="@T("expenseWorkspace.name", "이름", "Name")" maxlength="255" required autocomplete="organization" @bind="_vendorEditName" disabled="@_busy" /></label>
                                    <label for="expense-vendor-edit-phone">@T("expenseWorkspace.phone", "전화", "Phone")<input id="expense-vendor-edit-phone" aria-label="@T("expenseWorkspace.phone", "전화", "Phone")" type="tel" maxlength="64" autocomplete="tel" @bind="_vendorEditPhone" disabled="@_busy" /></label>
                                    <label for="expense-vendor-edit-website">@T("expenseWorkspace.website", "웹사이트", "Website")<input id="expense-vendor-edit-website" aria-label="@T("expenseWorkspace.website", "웹사이트", "Website")" type="url" maxlength="2048" autocomplete="url" @bind="_vendorEditWebsite" disabled="@_busy" /></label>
                                    <label for="expense-vendor-edit-email">@T("expenseWorkspace.email", "이메일", "Email")<input id="expense-vendor-edit-email" aria-label="@T("expenseWorkspace.email", "이메일", "Email")" type="email" maxlength="320" autocomplete="email" @bind="_vendorEditEmail" disabled="@_busy" /></label>
                                    <p id="expense-vendor-lifecycle-help">@T("expenseWorkspace.inactiveHistoryHelp", "비활성화해도 기존 비용의 참조와 감사 이력은 유지되며 새 비용에서는 선택할 수 없습니다.", "Deactivation preserves existing expense references and audit history but prevents selection for new expenses.")</p>
                                    <div class="expense-directory-actions">
                                        <button id="expense-vendor-save" type="submit" disabled="@_busy">@T("expenseWorkspace.save", "변경 저장", "Save changes")</button>
                                        <button id="expense-vendor-active" class="@(_selectedVendor.Active ? "danger" : null)" type="button" aria-describedby="expense-vendor-lifecycle-help" disabled="@_busy" @onclick="SetVendorActiveAsync">@(_selectedVendor.Active ? T("expenseWorkspace.deactivate", "비활성화", "Deactivate") : T("expenseWorkspace.reactivate", "재활성화", "Reactivate"))</button>
                                        <button id="expense-vendor-edit-cancel" type="button" disabled="@_busy" @onclick="() => SetSelectedVendor(null)">@T("expenseWorkspace.cancelEdit", "편집 닫기", "Close editor")</button>
                                    </div>
                                </form>
                            }
                        </div>
                        <div>
                            <h3>@T("expenseWorkspace.tags", "태그", "Tags")</h3>
                            @if (_directoryTags is { } tags)
                            {
                                @if (tags.Items.Count == 0) { <p data-empty="true">@T("expenseWorkspace.noDirectoryTags", "태그가 없습니다.", "No tags.")</p> }
                                else
                                {
                                    <ul class="expense-pills">
                                        @foreach (var item in tags.Items)
                                        {
                                            <li @key="item.Id" class="@(!item.Active ? "is-inactive" : null)">
                                                <div><strong>@item.Input.Name</strong><span>@Short(item.Id) · @DirectoryState(item.Active)</span></div>
                                                @if (Can("expense.directory.write")) { <button type="button" data-edit-tag="@item.Id" aria-pressed="@((_selectedTag?.Id == item.Id).ToString().ToLowerInvariant())" disabled="@_busy" @onclick="() => SelectTag(item)">@T("expenseWorkspace.edit", "편집", "Edit")</button> }
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (Can("expense.directory.write"))
                                {
                                    <nav class="expense-choice-pages" aria-label="@T("expenseWorkspace.tagPages", "태그 페이지", "Tag pages")">
                                        <button id="expense-directory-tags-previous" type="button" disabled="@(_busy || !HasPreviousDirectoryTagPage)" @onclick="() => MoveDirectoryTagPageAsync(-1)">@T("inventory.previous", "이전 페이지", "Previous page")</button>
                                        <span>@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.choicePage", "{0}–{1} / {2}", "{0}–{1} of {2}"), tags.Total == 0 ? 0 : _directoryTagOffset + 1, _directoryTagOffset + tags.Items.Count, tags.Total)</span>
                                        <button id="expense-directory-tags-next" type="button" disabled="@(_busy || !HasNextDirectoryTagPage)" @onclick="() => MoveDirectoryTagPageAsync(1)">@T("inventory.next", "다음 페이지", "Next page")</button>
                                    </nav>
                                }
                            }
                            @if (_selectedTag is not null && Can("expense.directory.write"))
                            {
                                <form class="expense-directory-editor" @onsubmit="UpdateTagAsync" @onsubmit:preventDefault>
                                    <h4>@T("expenseWorkspace.editTag", "태그 편집", "Edit tag")</h4>
                                    <label for="expense-tag-edit-name">@T("expenseWorkspace.name", "이름", "Name")<input id="expense-tag-edit-name" aria-label="@T("expenseWorkspace.name", "이름", "Name")" maxlength="255" required autocomplete="off" @bind="_tagEditName" disabled="@_busy" /></label>
                                    <p id="expense-tag-lifecycle-help">@T("expenseWorkspace.inactiveHistoryHelp", "비활성화해도 기존 비용의 참조와 감사 이력은 유지되며 새 비용에서는 선택할 수 없습니다.", "Deactivation preserves existing expense references and audit history but prevents selection for new expenses.")</p>
                                    <div class="expense-directory-actions">
                                        <button id="expense-tag-save" type="submit" disabled="@_busy">@T("expenseWorkspace.save", "변경 저장", "Save changes")</button>
                                        <button id="expense-tag-active" class="@(_selectedTag.Active ? "danger" : null)" type="button" aria-describedby="expense-tag-lifecycle-help" disabled="@_busy" @onclick="SetTagActiveAsync">@(_selectedTag.Active ? T("expenseWorkspace.deactivate", "비활성화", "Deactivate") : T("expenseWorkspace.reactivate", "재활성화", "Reactivate"))</button>
                                        <button id="expense-tag-edit-cancel" type="button" disabled="@_busy" @onclick="() => SetSelectedTag(null)">@T("expenseWorkspace.cancelEdit", "편집 닫기", "Close editor")</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </section>
            }

            @if (Can("expense.write") && Can("expense.directory.read"))
            {
                <section aria-labelledby="expense-create-heading">
                    <div class="expense-heading"><div><p class="expense-kicker">03</p><h2 id="expense-create-heading">@T("expenseWorkspace.create", "비용 등록", "Record expense")</h2></div></div>
                    <form class="expense-form" @onsubmit="CreateExpenseAsync" @onsubmit:preventDefault>
                        <label for="expense-amount">@T("expenseWorkspace.amount", "금액", "Amount")<input id="expense-amount" aria-label="@T("expenseWorkspace.amount", "금액", "Amount")" type="number" min="0.000001" step="0.000001" @bind="_draft.Amount" disabled="@CreateLocked" /></label>
                        <label for="expense-currency">@T("expenseWorkspace.currency", "통화", "Currency")<input id="expense-currency" aria-label="@T("expenseWorkspace.currency", "통화", "Currency")" maxlength="3" @bind="_draft.Currency" disabled="@CreateLocked" /></label>
                        <label for="expense-date">@T("expenseWorkspace.valueDate", "귀속일", "Value date")<InputDate id="expense-date" aria-label="@T("expenseWorkspace.valueDate", "귀속일", "Value date")" @bind-Value="_draft.ValueDate" disabled="@CreateLocked" /></label>
                        <label for="expense-type">@T("expenseWorkspace.type", "비용 유형", "Expense type")<select id="expense-type" aria-label="@T("expenseWorkspace.type", "비용 유형", "Expense type")" @bind="_draft.Type" disabled="@CreateLocked">@foreach (var type in Enum.GetValues<ExpenseType>()) { <option value="@type">@TypeName(type)</option> }</select></label>
                        <label for="expense-category">@T("expenseWorkspace.category", "카테고리", "Category")<select id="expense-category" aria-label="@T("expenseWorkspace.category", "카테고리", "Category")" @bind="_draft.CategoryId" disabled="@CreateLocked"><option value="@Guid.Empty">@T("expenseWorkspace.chooseCategory", "카테고리 선택", "Choose category")</option>@foreach (var item in ActiveCategories) { <option value="@item.Id">@item.Input.Name</option> }</select></label>
                        <label for="expense-vendor">@T("expenseWorkspace.vendor", "거래처", "Vendor")<select id="expense-vendor" aria-label="@T("expenseWorkspace.vendor", "거래처", "Vendor")" @bind="_draft.VendorId" disabled="@CreateLocked"><option value="@Guid.Empty">@T("expenseWorkspace.chooseVendor", "거래처 선택", "Choose vendor")</option>@foreach (var item in ActiveVendors) { <option value="@item.Id">@item.Input.Name</option> }</select></label>
                        <fieldset class="expense-tags expense-wide" disabled="@CreateLocked">
                            <legend>@T("expenseWorkspace.tagSelector", "태그 (선택)", "Tags (optional)")</legend>
                            <p id="expense-tag-selection-help">@T("expenseWorkspace.tagSelectionHelp", "여러 태그를 선택할 수 있으며 페이지를 이동해도 선택이 유지됩니다.", "Select multiple tags; selections remain while you browse pages.")</p>
                            @if (_draft.TagIds.Count > 0)
                            {
                                <div class="expense-selected-tag-list" aria-label="@T("expenseWorkspace.selectedTags", "선택한 태그", "Selected tags")">
                                    @foreach (var id in _draft.TagIds.OrderBy(TagLabel, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <span @key="id">@TagLabel(id)<button type="button" data-remove-expense-tag="@id" aria-label="@string.Format(CultureInfo.CurrentCulture, T("expenseWorkspace.removeTag", "태그 {0} 선택 해제", "Remove tag {0}"), TagLabel(id))" @onclick="() => RemoveTag(id)">@T("expenseWorkspace.removeTagAction", "선택 해제", "Remove")</button></span>
                                    }
                                </div>
                            }
                            @if (_tags is { } tagPage)
                            {
                                @if (tagPage.Items.Count == 0) { <p data-empty="true">@T("expenseWorkspace.noTags", "선택할 수 있는 활성 태그가 없습니다.", "No active tags are available.")</p> }
                                else
                                {
                                    <div class="expense-tag-options" aria-describedby="expense-tag-selection-help">
                                        @foreach (var item in tagPage.Items)
                                        {
                                            <label @key="item.Id"><input type="checkbox" data-expense-tag="@item.Id" aria-label="@item.Input.Name" checked="@_draft.TagIds.Contains(item.Id)" @onchange="() => ToggleTag(item.Id)" /><span>@item.Input.Name</span></label>
                                        }
                                    </div>
                                }
                                <nav class="expense-choice-pages" aria-label="@T("expenseWorkspace.tagPages", "태그 페이지", "Tag pages")">
                                    <button id="expense-tags-previous" type="button" disabled="@(!HasPreviousTagPage)" @onclick="() => MoveTagPageAsync(-1)">@T("inventory.previous", "이전 페이지", "Previous page")</button>
                                    <span>@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.choicePage", "{0}–{1} / {2}", "{0}–{1} of {2}"), tagPage.Total == 0 ? 0 : _tagOffset + 1, _tagOffset + tagPage.Items.Count, tagPage.Total)</span>
                                    <button id="expense-tags-next" type="button" disabled="@(!HasNextTagPage)" @onclick="() => MoveTagPageAsync(1)">@T("inventory.next", "다음 페이지", "Next page")</button>
                                </nav>
                            }
                        </fieldset>
                        <div class="expense-choice">
                            <label for="expense-employee">@T("expenseWorkspace.employee", "담당 직원 (선택)", "Employee (optional)")
                                <select id="expense-employee" aria-label="@T("expenseWorkspace.employee", "담당 직원 (선택)", "Employee (optional)")" @bind="_draft.EmployeeId" disabled="@(CreateLocked || _draft.SplitAcrossEmployees)">
                                    <option value="@Guid.Empty">@T("expenseWorkspace.noEmployee", "직원 지정 안 함", "No employee")</option>
                                    @if (_employees is not null) { @foreach (var item in _employees.Items) { <option value="@item.Id">@item.UserId · @Short(item.Id)</option> } }
                                </select>
                            </label>
                            @if (_employees is { } employeePage)
                            {
                                <nav class="expense-choice-pages" aria-label="@T("expenseWorkspace.employeePages", "직원 선택 페이지", "Employee choice pages")"><button type="button" disabled="@(CreateLocked || !HasPreviousEmployeePage)" @onclick="() => MoveEmployeePageAsync(-1)">@T("inventory.previous", "이전 페이지", "Previous page")</button><span>@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.choicePage", "{0}–{1} / {2}", "{0}–{1} of {2}"), employeePage.Total == 0 ? 0 : _employeeOffset + 1, _employeeOffset + employeePage.Items.Count, employeePage.Total)</span><button type="button" disabled="@(CreateLocked || !HasNextEmployeePage)" @onclick="() => MoveEmployeePageAsync(1)">@T("inventory.next", "다음 페이지", "Next page")</button></nav>
                            }
                        </div>
