                                @if (_confirmReceiptDelete)
                                {
                                    <div class="expense-receipt-delete-confirm" role="group" aria-labelledby="expense-receipt-delete-question">
                                        <p id="expense-receipt-delete-question">@T("expenseWorkspace.deleteReceiptConfirm", "저장된 영수증 파일을 영구 삭제할까요? 비용 기록은 유지됩니다.", "Permanently delete the stored receipt file? The expense record will remain.")</p>
                                        <div class="expense-actions"><button id="expense-receipt-delete-confirm" class="danger" type="button" disabled="@_busy" @onclick="DeleteReceiptAsync">@T("expenseWorkspace.confirmDeleteReceipt", "영수증 파일 삭제", "Delete receipt file")</button><button id="expense-receipt-delete-cancel" type="button" disabled="@_busy" @onclick="CancelReceiptDelete">@T("expenseWorkspace.keepReceipt", "파일 유지", "Keep file")</button></div>
                                    </div>
                                }
                                else
                                {
                                    <button id="expense-receipt-delete" class="danger expense-receipt-delete" type="button" disabled="@_busy" @onclick="RequestReceiptDelete">@T("expenseWorkspace.deleteReceipt", "영수증 삭제", "Delete receipt")</button>
                                }
                            }
                        }
                        else
                        {
                            <p role="status">@T("expenseWorkspace.receiptReadOnly", "이 범위에서는 영수증을 조회하고 다운로드할 수만 있습니다.", "In this scope, you can only view and download receipts.")</p>
                        }
                    </div>
                    @if (_selected.Allocations.Count > 0) { <ul class="expense-allocations">@foreach (var allocation in _selected.Allocations) { <li><span>@allocation.EmployeeId.ToString("D")</span><strong>@Amount(allocation.Amount) @_selected.Input.Currency</strong></li> }</ul> }
