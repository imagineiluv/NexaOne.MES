                            <h3 id="expense-ledger-filters-heading">@T("expenseWorkspace.ledgerFilters", "원장 필터", "Ledger filters")</h3>
                            <p id="expense-ledger-date-help">@T("expenseWorkspace.ledgerDateHelp", "날짜는 시작일과 종료일을 함께 입력하며 최대 366일까지 조회할 수 있습니다.", "Enter both dates; a range can cover up to 366 days.")</p>
                        </div>
                        <label for="expense-ledger-start">@T("expenseWorkspace.fromDate", "시작일", "From date")<input id="expense-ledger-start" type="date" aria-label="@T("expenseWorkspace.fromDate", "시작일", "From date")" aria-describedby="expense-ledger-date-help" value="@_ledgerStart" @onchange="eventValue => _ledgerStart = eventValue.Value?.ToString() ?? string.Empty" disabled="@LedgerLocked" /></label>
                        <label for="expense-ledger-end">@T("expenseWorkspace.toDate", "종료일", "To date")<input id="expense-ledger-end" type="date" aria-label="@T("expenseWorkspace.toDate", "종료일", "To date")" aria-describedby="expense-ledger-date-help" value="@_ledgerEnd" @onchange="eventValue => _ledgerEnd = eventValue.Value?.ToString() ?? string.Empty" disabled="@LedgerLocked" /></label>
                        @if (Can("expense.directory.read"))
                        {
                            <label for="expense-ledger-category">@T("expenseWorkspace.category", "카테고리", "Category")<select id="expense-ledger-category" aria-label="@T("expenseWorkspace.category", "카테고리", "Category")" @bind="_ledgerCategory" disabled="@LedgerLocked"><option value="">@T("expenseWorkspace.allCategories", "모든 카테고리", "All categories")</option>@foreach (var item in _directoryCategories?.Items ?? []) { <option value="@item.Id">@item.Input.Name@(!item.Active ? $" · {DirectoryState(false)}" : "")</option> }</select></label>
                            <label for="expense-ledger-vendor">@T("expenseWorkspace.vendor", "거래처", "Vendor")<select id="expense-ledger-vendor" aria-label="@T("expenseWorkspace.vendor", "거래처", "Vendor")" @bind="_ledgerVendor" disabled="@LedgerLocked"><option value="">@T("expenseWorkspace.allVendors", "모든 거래처", "All vendors")</option>@foreach (var item in _directoryVendors?.Items ?? []) { <option value="@item.Id">@item.Input.Name@(!item.Active ? $" · {DirectoryState(false)}" : "")</option> }</select></label>
                        }
                        <label for="expense-ledger-type">@T("expenseWorkspace.type", "비용 유형", "Expense type")<select id="expense-ledger-type" aria-label="@T("expenseWorkspace.type", "비용 유형", "Expense type")" @bind="_ledgerType" disabled="@LedgerLocked"><option value="">@T("expenseWorkspace.allTypes", "모든 유형", "All types")</option>@foreach (var type in Enum.GetValues<ExpenseType>()) { <option value="@type">@TypeName(type)</option> }</select></label>
                        <label for="expense-ledger-status">@T("expenseWorkspace.status", "처리 상태", "Status")<select id="expense-ledger-status" aria-label="@T("expenseWorkspace.status", "처리 상태", "Status")" @bind="_ledgerStatus" disabled="@LedgerLocked"><option value="">@T("expenseWorkspace.allStatuses", "모든 처리 상태", "All statuses")</option>@foreach (var status in Enum.GetValues<ExpenseStatus>()) { <option value="@status">@StatusName(status)</option> }</select></label>
                        <label for="expense-ledger-state">@T("expenseWorkspace.recordState", "기록 상태", "Record state")<select id="expense-ledger-state" aria-label="@T("expenseWorkspace.recordState", "기록 상태", "Record state")" @bind="_ledgerState" disabled="@LedgerLocked"><option value="">@T("inventory.allStates", "모든 상태", "All states")</option>@foreach (var state in Enum.GetValues<ExpenseState>()) { <option value="@state">@StateName(state)</option> }</select></label>
                        <div class="expense-ledger-filter-actions">
                            <button id="expense-ledger-search" type="submit" disabled="@LedgerLocked">@T("inventory.search", "조회", "Search")</button>
                            <button id="expense-ledger-clear" type="button" disabled="@(LedgerLocked || (!HasLedgerDraft && !HasLedgerFilters))" @onclick="ClearExpenseFiltersAsync">@T("expenseWorkspace.clearFilters", "필터 초기화", "Clear filters")</button>
                        </div>
                    </form>
                    @if (_ledgerValidation is not null) { <p class="expense-ledger-validation" role="alert">@_ledgerValidation</p> }
                    @if (_expenses is { } expenses)
                    {
                        @if (expenses.Items.Count == 0) { <p data-empty="true">@(HasLedgerFilters ? T("expenseWorkspace.noMatchingExpenses", "조건에 맞는 비용이 없습니다.", "No expenses match these filters.") : T("expenseWorkspace.noExpenses", "등록된 비용이 없습니다.", "No expenses have been recorded."))</p> }
                        else { <div class="expense-table-scroll" tabindex="0" role="region" aria-label="@T("expenseWorkspace.list", "비용 원장", "Expense ledger")"><table><thead><tr><th>@T("expenseWorkspace.valueDate", "귀속일", "Value date")</th><th>@T("expenseWorkspace.purpose", "사용 목적", "Purpose")</th><th>@T("expenseWorkspace.type", "비용 유형", "Expense type")</th><th>@T("expenseWorkspace.status", "처리 상태", "Status")</th><th>@T("expenseWorkspace.amount", "금액", "Amount")</th><th>@T("inventory.write.actions", "작업", "Actions")</th></tr></thead><tbody>@foreach (var item in expenses.Items) { <tr @key="item.Id" class="@(item.State == ExpenseState.Cancelled ? "is-cancelled" : null)"><td>@item.Input.ValueDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td><td>@(item.Input.Purpose ?? "—")</td><td>@TypeName(item.Input.Type)</td><td>@StatusName(item)</td><td>@Amount(item.Amounts.Gross) @item.Input.Currency</td><td><button type="button" data-select-expense="@item.Id" disabled="@(_busy || _pendingInvoice is not null)" @onclick="() => SelectExpenseAsync(item)">@T("crm.select", "선택", "Select")</button></td></tr> }</tbody></table></div> }
                        <nav class="expense-ledger-pages" aria-label="@T("expenseWorkspace.list", "비용 원장", "Expense ledger")">
                            <button id="expense-ledger-previous" type="button" disabled="@(LedgerLocked || !HasPreviousExpensePage)" @onclick="() => MoveExpensePageAsync(-1)">@T("inventory.previous", "이전 페이지", "Previous page")</button>
                            <span data-total="@expenses.Total">@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.ledgerPage", "{0}–{1} / {2}", "{0}–{1} of {2}"), expenses.Total == 0 ? 0 : _expenseOffset + 1, _expenseOffset + expenses.Items.Count, expenses.Total)</span>
                            <button id="expense-ledger-next" type="button" disabled="@(LedgerLocked || !HasNextExpensePage)" @onclick="() => MoveExpensePageAsync(1)">@T("inventory.next", "다음 페이지", "Next page")</button>
                        </nav>
                    }
                </section>
            }

            @if (_selected is not null)
            {
                <section class="expense-selected" aria-labelledby="expense-selected-heading"><div class="expense-heading"><div><p class="expense-kicker">05</p><h2 id="expense-selected-heading">@T("expenseWorkspace.selected", "선택한 비용", "Selected expense")</h2></div><span class="expense-state">@StatusName(_selected)</span></div><p class="expense-id">@_selected.Id.ToString("D")</p>
                    <dl><div><dt>@T("expenseWorkspace.net", "공급가", "Net")</dt><dd>@Amount(_selected.Amounts.Net) @_selected.Input.Currency</dd></div><div><dt>@T("expenseWorkspace.tax", "포함 세금", "Included tax")</dt><dd>@Amount(_selected.Amounts.Tax) @_selected.Input.Currency</dd></div><div><dt>@T("expenseWorkspace.createdBy", "등록자", "Created by")</dt><dd>@_selected.CreatedBy</dd></div></dl>
                    <dl class="expense-selected-metadata">
                        @if (_selected.Input.EmployeeId is { } employeeId) { <div><dt>@T("expenseWorkspace.employeeDetail", "담당 직원", "Employee")</dt><dd>@Short(employeeId)</dd></div> }
                        @if (_selected.Input.ContactId is { } contactId) { <div><dt>@T("expenseWorkspace.contact", "청구 고객", "Billing contact")</dt><dd>@Short(contactId)</dd></div> }
                        @if (_selected.Input.ProjectId is { } projectId) { <div><dt>@T("expenseWorkspace.projectDetail", "프로젝트", "Project")</dt><dd>@Short(projectId)</dd></div> }
                        @if (_selected.Input.Tax is { } tax) { <div><dt>@T("expenseWorkspace.taxRule", "세금 규칙", "Tax rule")</dt><dd>@TaxName(tax)</dd></div> }
                        @if (_selected.Allocations.Count > 0) { <div><dt>@T("expenseWorkspace.allocations", "직원 분할", "Employee allocations")</dt><dd>@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.allocationCount", "{0}명", "{0} employees"), _selected.Allocations.Count)</dd></div> }
                        @if (_selected.Input.Reference is not null) { <div><dt>@T("expenseWorkspace.referenceDetail", "외부 참조", "External reference")</dt><dd>@_selected.Input.Reference</dd></div> }
                        @if ((_selected.Input.TagIds?.Count ?? 0) > 0) { <div class="expense-selected-tags"><dt>@T("expenseWorkspace.tagsDetail", "태그", "Tags")</dt><dd>@string.Join(", ", _selected.Input.TagIds!.Select(TagLabel))</dd></div> }
                    </dl>
                    @if (_selected.Input.Purpose is not null) { <p><strong>@T("expenseWorkspace.purpose", "사용 목적", "Purpose"):</strong> @_selected.Input.Purpose</p> }
                    @if (_selected.Input.Notes is not null) { <p class="expense-long-text"><strong>@T("expenseWorkspace.notesDetail", "업무 메모", "Business notes"):</strong> @_selected.Input.Notes</p> }
                    @if (_selected.Input.Receipt is not null) { <p class="expense-long-text"><strong>@T("expenseWorkspace.receipt", "영수증 위치", "Receipt locator"):</strong> @_selected.Input.Receipt</p> }
                    <div class="expense-receipt" aria-labelledby="expense-receipt-heading">
                        <div class="expense-heading">
                            <div>
                                <h3 id="expense-receipt-heading">@T("expenseWorkspace.receiptFile", "영수증 파일", "Receipt file")</h3>
                                <p>@T("expenseWorkspace.receiptFileHelp", "PDF·JPG·PNG·WebP 파일을 10MB까지 보관합니다. 비용을 취소해도 파일은 명시적으로 삭제할 때까지 유지됩니다.", "Store a PDF, JPG, PNG, or WebP file up to 10 MB. Cancelling the expense keeps the file until it is explicitly deleted.")</p>
                            </div>
                        </div>
                        @if (_receipt is null)
                        {
                            <p class="expense-receipt-empty" data-receipt-empty="true">@T("expenseWorkspace.noReceiptFile", "저장된 영수증 파일이 없습니다.", "No receipt file is stored.")</p>
                        }
                        else
                        {
                            <div class="expense-receipt-current">
                                <div>
                                    <strong title="@_receipt.FileName">@_receipt.FileName</strong>
                                    <div class="expense-receipt-meta">
                                        <span>@ReceiptSize(_receipt.Size)</span>
                                        <span>@_receipt.ContentType</span>
                                        <span>@_receipt.UploadedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</span>
                                    </div>
                                </div>
                                <button id="expense-receipt-download" type="button" disabled="@_busy" @onclick="DownloadReceiptAsync">@T("expenseWorkspace.downloadReceipt", "영수증 다운로드", "Download receipt")</button>
                            </div>
                        }
                        @if (Can("expense.write"))
                        {
                            <div class="expense-receipt-upload">
                                <label for="expense-receipt-file">@(_receipt is null ? T("expenseWorkspace.chooseReceipt", "업로드할 파일", "File to upload") : T("expenseWorkspace.chooseReplacementReceipt", "교체할 파일", "Replacement file"))</label>
                                <InputFile @key="_receiptInputKey" id="expense-receipt-file" OnChange="SelectReceiptFile" accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" disabled="@_busy" aria-describedby="expense-receipt-constraints" />
                                <p id="expense-receipt-constraints">@T("expenseWorkspace.receiptConstraints", "허용 형식: PDF, JPG, PNG, WebP · 최대 10MB", "Accepted: PDF, JPG, PNG, WebP · 10 MB maximum")</p>
                                @if (_receiptFile is not null)
                                {
                                    <div class="expense-receipt-pending" role="status"><span>@_receiptFile.Name</span><strong>@ReceiptSize(_receiptFile.Size)</strong></div>
                                    <button id="expense-receipt-upload" type="button" disabled="@_busy" @onclick="UploadReceiptAsync">@(_receipt is null ? T("expenseWorkspace.uploadReceipt", "영수증 업로드", "Upload receipt") : T("expenseWorkspace.replaceReceipt", "영수증 교체", "Replace receipt"))</button>
                                }
                            </div>
                            @if (_receipt is not null)
