                                }
                                else { <p role="status">@T("expenseWorkspace.billingReadForContact", "청구 고객을 선택하려면 billing.read 권한이 필요합니다.", "The billing.read permission is required to choose a billing contact.")</p> }
                            </div>
                        }
                        @if (Can("crm.project.read"))
                        {
                            <div class="expense-choice">
                                <label for="expense-project">@T("expenseWorkspace.project", "프로젝트 (선택)", "Project (optional)")
                                    <select id="expense-project" aria-label="@T("expenseWorkspace.project", "프로젝트 (선택)", "Project (optional)")" @bind="_draft.ProjectId" disabled="@CreateLocked"><option value="@Guid.Empty">@T("expenseWorkspace.noProject", "프로젝트 지정 안 함", "No project")</option>@if (_projects is not null) { @foreach (var item in _projects.Items) { <option value="@item.Id">@item.Values.Name@(item.Values.Code is null ? "" : " · " + item.Values.Code)</option> } }</select>
                                </label>
                                @if (_projects is { } projectPage) { <nav class="expense-choice-pages" aria-label="@T("expenseWorkspace.projectPages", "프로젝트 선택 페이지", "Project choice pages")"><button type="button" disabled="@(CreateLocked || !HasPreviousProjectPage)" @onclick="() => MoveProjectPageAsync(-1)">@T("inventory.previous", "이전 페이지", "Previous page")</button><span>@string.Format(CultureInfo.InvariantCulture, T("expenseWorkspace.choicePage", "{0}–{1} / {2}", "{0}–{1} of {2}"), projectPage.Total == 0 ? 0 : _projectOffset + 1, _projectOffset + projectPage.Items.Count, projectPage.Total)</span><button type="button" disabled="@(CreateLocked || !HasNextProjectPage)" @onclick="() => MoveProjectPageAsync(1)">@T("inventory.next", "다음 페이지", "Next page")</button></nav> }
                            </div>
                        }
                        <label for="expense-tax-type">@T("expenseWorkspace.taxType", "포함 세금 방식", "Included tax method")<select id="expense-tax-type" aria-label="@T("expenseWorkspace.taxType", "포함 세금 방식", "Included tax method")" @bind="_draft.TaxType" disabled="@CreateLocked"><option value="">@T("expenseWorkspace.noTax", "세금 없음", "No included tax")</option><option value="@ExpenseTaxType.Percentage">@T("expenseWorkspace.taxPercentage", "비율", "Percentage")</option><option value="@ExpenseTaxType.Flat">@T("expenseWorkspace.taxFlat", "정액", "Flat amount")</option></select></label>
                        @if (_draft.TaxType.Length > 0)
                        {
                            <label for="expense-tax-value">@T("expenseWorkspace.taxValue", "세율 또는 세액", "Tax rate or amount")<input id="expense-tax-value" aria-label="@T("expenseWorkspace.taxValue", "세율 또는 세액", "Tax rate or amount")" type="number" min="0" step="0.000001" @bind="_draft.TaxValue" disabled="@CreateLocked" /></label>
                            <label for="expense-tax-label">@T("expenseWorkspace.taxLabel", "세금 표기 (선택)", "Tax label (optional)")<input id="expense-tax-label" aria-label="@T("expenseWorkspace.taxLabel", "세금 표기 (선택)", "Tax label (optional)")" maxlength="64" @bind="_draft.TaxLabel" disabled="@CreateLocked" /></label>
                        }
                        <label class="expense-wide" for="expense-purpose">@T("expenseWorkspace.purpose", "사용 목적", "Purpose")<input id="expense-purpose" aria-label="@T("expenseWorkspace.purpose", "사용 목적", "Purpose")" maxlength="255" @bind="_draft.Purpose" disabled="@CreateLocked" /></label>
                        <label class="expense-wide" for="expense-reference">@T("expenseWorkspace.reference", "외부 참조 (선택)", "External reference (optional)")<input id="expense-reference" aria-label="@T("expenseWorkspace.reference", "외부 참조 (선택)", "External reference (optional)")" maxlength="255" @bind="_draft.Reference" disabled="@CreateLocked" /></label>
                        <label class="expense-wide" for="expense-notes">@T("expenseWorkspace.notes", "업무 메모 (선택)", "Business notes (optional)")<textarea id="expense-notes" aria-label="@T("expenseWorkspace.notes", "업무 메모 (선택)", "Business notes (optional)")" maxlength="4000" rows="3" @bind="_draft.Notes" disabled="@CreateLocked"></textarea></label>
                        <label class="expense-wide" for="expense-receipt">@T("expenseWorkspace.receipt", "영수증 위치", "Receipt locator")<input id="expense-receipt" aria-label="@T("expenseWorkspace.receipt", "영수증 위치", "Receipt locator")" maxlength="2048" @bind="_draft.Receipt" disabled="@CreateLocked" /></label>
                        <button id="expense-create" type="submit" disabled="@_busy">@(_pendingCreate is null ? T("expenseWorkspace.record", "비용 등록", "Record expense") : T("expenseWorkspace.retryCreate", "같은 요청으로 결과 확인", "Retry same request"))</button>
                    </form>
                </section>
            }

            @if (Can("expense.read"))
            {
                <section aria-labelledby="expense-list-heading">
                    <div class="expense-heading"><div><p class="expense-kicker">04</p><h2 id="expense-list-heading">@T("expenseWorkspace.list", "비용 원장", "Expense ledger")</h2></div><button id="expense-list-refresh" type="button" disabled="@_busy" @onclick="LoadExpensesAsync">@T("expenseWorkspace.refresh", "새로고침", "Refresh")</button></div>
                    <form class="expense-ledger-filters" aria-labelledby="expense-ledger-filters-heading" @onsubmit="SearchExpensesAsync" @onsubmit:preventDefault>
