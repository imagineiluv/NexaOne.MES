@page "/meta/SYSTEM_2_SO_MANAGEMENT"
@attribute [Authorize]
@inject IApiClient Api
@using System.Security.Claims
@using NexaOne.Common.Security

@* SmartUX 'S/O 관리'(ServiceObject 메타 카탈로그) 적응 점등 — 레거시 SYS_TB_OBJECT(엔티티+속성 레지스트리)의
   통합 호스트 대응물은 명명 쿼리 레지스트리(config/db/queries) + 화면 정의(SYS_SCREEN_DEFINITION)다.
   본 페이지는 그 카탈로그 조회: 등록 쿼리(id/kind/권한, SQL 비노출) + 화면 정의 목록. 리터럴 라우트 우선. *@
<PageTitle>S/O 관리(메타 카탈로그)</PageTitle>

@if (!_canManage)
{
    <div class="mes-empty-state">
        <p class="es-title">S/O 관리(메타 카탈로그)</p>
        <p class="es-sub">이 화면은 sys:manage 권한이 필요합니다.</p>
    </div>
}
else
{
    <div class="host-page">
        <h1 class="page-title">S/O 관리 — 메타 카탈로그</h1>
        <p class="host-desc">
            레거시 ServiceObject(SYS_TB_OBJECT) 카탈로그의 통합 호스트 대응 — 시스템에 등록된
            명명 쿼리(단일 데이터 경로)와 화면 정의를 조회합니다. SQL 본문은 노출하지 않습니다.
        </p>

        <div class="host-toolbar">
            <h2 class="host-card-title">명명 쿼리 (@Filtered.Count)</h2>
            <select class="meta-cond-select" @bind="_kindFilter">
                <option value="">전체</option>
                <option value="read">read(조회)</option>
                <option value="write">write(커맨드)</option>
            </select>
            <input class="host-input inline" @bind="_search" @bind:event="oninput" placeholder="ID 필터…" />
        </div>
        <table class="host-table host-gap-b">
            <thead>
                <tr>
                    <th>쿼리 ID</th><th>종류</th><th>요구 권한</th>
                </tr>
            </thead>
            <tbody>
                @if (Filtered.Count == 0)
                {
                    <tr><td colspan="3" class="empty">@(_loading ? "불러오는 중…" : "결과 없음")</td></tr>
                }
                @foreach (var q in Filtered)
                {
                    <tr>
                        <td><code>@q.Id</code></td>
                        <td>
                            @if (q.IsWrite) { <span class="host-chip write">write</span> }
                            else { <span class="host-chip read">read</span> }
                        </td>
                        <td>@(string.IsNullOrEmpty(q.RequiredPermission) ? "-" : q.RequiredPermission)</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2 class="host-card-title">화면 정의 (@_screens.Count)</h2>
        <table class="host-table">
            <thead>
                <tr>
                    <th>UI_ID</th><th>제목</th><th>런타임</th>
                </tr>
            </thead>
            <tbody>
                @if (_screens.Count == 0)
                {
                    <tr><td colspan="3" class="empty">DB 저장 화면 정의 없음(인메모리 시드 화면은 코드 소유)</td></tr>
                }
                @foreach (var s in _screens)
                {
                    <tr>
                        <td><strong>@s.UiId</strong></td>
                        <td>@s.Title</td>
                        <td><a class="host-actionlink" href="/meta/@s.UiId">/meta/@s.UiId</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canManage;
    private bool _loading;
    private string _kindFilter = string.Empty;
    private string _search = string.Empty;
    private List<QueryCatalogItemDto> _queries = new();
    private List<ScreenDefinitionRecordDto> _screens = new();

    private List<QueryCatalogItemDto> Filtered => _queries
        .Where(q => _kindFilter switch { "read" => !q.IsWrite, "write" => q.IsWrite, _ => true })
        .Where(q => string.IsNullOrWhiteSpace(_search) || q.Id.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _canManage = (await AuthState).User.HasPermission(Permissions.SysManage);
        if (!_canManage) return;

        _loading = true;
        try
        {
            _queries = await Api.GetQueryCatalogAsync();
            _screens = await Api.GetScreenDefinitionsAsync();
        }
        finally { _loading = false; }
    }
}
