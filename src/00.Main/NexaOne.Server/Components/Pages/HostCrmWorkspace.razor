    private async Task SavePipelineAsync()
    {
        if (_scope is null || _currentUserId is null || !CanManagePipelines || _writing) return;
        var names = _pipelineStages.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (string.IsNullOrWhiteSpace(_pipelineName) || names.Length == 0)
        { _writeError = T("crm.pipelineInputRequired", "Pipeline 이름과 단계가 필요합니다.", "A pipeline name and at least one stage are required."); return; }
        var existing = _editingPipeline?.Stages.OrderBy(stage => stage.Index).ToArray() ?? [];
        var stages = names.Select((name, index) => new StageInput(index < existing.Length ? existing[index].Id : null, name)).ToArray();
        var input = new PipelineInput(_pipelineName.Trim(), Empty(_pipelineDescription), stages);
        _writing = true; _writeMessage = _writeError = null;
        try
        {
            var result = _editingPipeline is null
                ? await Api.WriteInventoryAsync<PipelineDetails>(HttpMethod.Post, $"{Root}/pipelines", input, _currentUserId)
                : await Api.WriteInventoryAsync<PipelineDetails>(HttpMethod.Put, $"{Root}/pipelines/{_editingPipeline.Pipeline.Id:D}",
                    new { version = _editingPipeline.Pipeline.Version, input, removal = DealRemoval.RejectIfReferenced }, _currentUserId);
            if (Successful(result))
            {
                _writeMessage = T("crm.pipelineSaved", "Pipeline을 저장했습니다.", "Pipeline saved.");
                ResetPipelineEditor(); ResetDealEditor(); _selected = null; _offsets[Pane.Pipelines] = 0;
                await Task.WhenAll(LoadPaneAsync(Pane.Pipelines), LoadPaneAsync(Pane.Deals));
            }
            else _writeError = ErrorMessage(result.StatusCode, result.Code, result.Error);
        }
        finally { _writing = false; }
    }

