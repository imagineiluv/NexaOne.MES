    private bool Has(string permission) => _scope?.Permissions.Contains(permission, StringComparer.Ordinal) == true;
    private bool CanReadPane(Pane pane) => pane switch
    {
        Pane.Customers or Pane.Pipelines or Pane.Deals => Has("crm.read"),
        Pane.Projects => Has("crm.project.read"),
        Pane.Teams => Has("crm.team.read"),
        _ => true
    };

    private Task LoadPaneAsync(Pane pane)
    {
        if (_scope is null || !CanReadPane(pane) || _disposed) return Task.CompletedTask;
        var root = $"api/v1/crm/{_scope.TenantId:D}/{_scope.OrganizationId:D}";
        var page = $"offset={_offsets[pane]}&limit={PageSize}";
        return pane switch
        {
            Pane.Customers => ReadAsync<CrmCustomerEnrollment, CrmCustomerEnrollmentPage>(pane,
                $"{root}/customer-enrollments?{page}", value => { _customers = value; return value?.Total; }),
            Pane.Pipelines => ReadAsync<Pipeline, CrmPage<Pipeline>>(pane,
                $"{root}/pipelines?{page}", value => { _pipelines = value; return value?.Total; }),
            Pane.Deals => ReadAsync<Deal, CrmPage<Deal>>(pane,
                $"{root}/deals?{page}", value => { _deals = value; return value?.Total; }),
            Pane.Projects => ReadAsync<Project, WorkPage<Project>>(pane,
                $"{root}/projects?{page}", value => { _projects = value; return value?.Total; }),
            Pane.Teams => ReadAsync<Team, WorkPage<Team>>(pane,
                $"{root}/teams?{page}", value => { _teams = value; return value?.Total; }),
            _ => Task.CompletedTask
        };
    }

    private async Task ReadAsync<TItem, TPage>(Pane pane, string path, Func<TPage?, long?> apply)
        where TPage : class
    {
        Cancel(pane);
        var request = new CancellationTokenSource();
        _requests[pane] = request;
        apply(null); _totals.Remove(pane); _errors.Remove(pane);
        try
        {
            var result = await Api.ReadInventoryAsync<TPage>(path, request.Token);
            if (!Owns(pane, request)) return;
            var total = result.Value is null ? null : apply(result.Value);
            if (result.StatusCode is >= 200 and < 300 && result.Error is null && total is >= 0)
                _totals[pane] = total.Value;
            else
            {
                apply(null);
                _errors[pane] = (result.StatusCode, result.Code, result.Error);
            }
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally
        {
            if (Owns(pane, request)) { _requests.Remove(pane); StateHasChanged(); }
            request.Dispose();
        }
    }

