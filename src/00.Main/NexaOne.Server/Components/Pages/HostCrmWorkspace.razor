        [Field(T("inventory.name", "이름", "Name"), project.Values.Name), Field(T("crm.status", "상태", "Status"), StatusName(project.Values.Status)),
         Field(T("crm.client", "고객", "Client"), project.Links.CustomerId?.ToString("D") ?? "—", true), Field(T("crm.members", "멤버", "Members"), string.Join(", ", project.Links.Members.Select(member => member.EmployeeId)), true),
         Field(T("crm.teams", "팀", "Teams"), string.Join(", ", project.Links.TeamIds), true), Field("ID", project.Id.ToString("D"), true)]);
    });

    private Task SelectTeamAsync(Team value) => LoadDetailAsync<Team>(Pane.Teams, $"teams/{value.Id:D}", team =>
    {
        _editingTeam = team; _teamName = team.Values.Name; _teamPrefix = team.Values.Prefix ?? "";
        _teamPublic = team.Values.Public; _teamShareProfile = team.Values.ShareProfileView; _teamRequirePlan = team.Values.RequirePlanToTrack;
        _teamMemberIds = Guids(team.Members.Where(member => !member.IsManager).Select(member => member.EmployeeId));
        _teamManagerIds = Guids(team.Members.Where(member => member.IsManager).Select(member => member.EmployeeId));
        return new(T("crm.team", "팀", "Team"),
        [Field(T("inventory.name", "이름", "Name"), team.Values.Name), Field(T("crm.members", "멤버", "Members"), string.Join(", ", team.Members.Select(member => member.EmployeeId)), true), Field("ID", team.Id.ToString("D"), true)]);
    });

    private async Task LoadDetailAsync<TValue>(Pane pane, string relative, Func<TValue, SelectedRecord> map) where TValue : class
    {
        if (_scope is null || !CanReadPane(pane)) return;
        _detailRequest?.Cancel(); _detailRequest?.Dispose();
        var request = new CancellationTokenSource(); _detailRequest = request; _selected = null;
        try
        {
            var root = $"api/v1/crm/{_scope.TenantId:D}/{_scope.OrganizationId:D}";
            var result = await Api.ReadInventoryAsync<TValue>($"{root}/{relative}", request.Token);
            if (!ReferenceEquals(_detailRequest, request)) return;
            if (result.StatusCode is >= 200 and < 300 && result.Value is not null && result.Error is null)
                _selected = map(result.Value);
            else _selected = new(T("crm.details", "선택한 레코드", "Selected record"),
                [Field(T("inventory.state", "상태", "State"), ErrorMessage(result.StatusCode, result.Code, result.Error))]);
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(_detailRequest, request)) { _detailRequest = null; StateHasChanged(); }
            request.Dispose();
        }
    }

    private bool Owns(Pane pane, CancellationTokenSource request)
        => !_disposed && _requests.TryGetValue(pane, out var current) && ReferenceEquals(current, request);
    private void Cancel(Pane pane) { if (_requests.Remove(pane, out var request)) request.Cancel(); }
    private bool Busy(Pane pane) => _requests.ContainsKey(pane);
    private static string ScopeKey(BusinessMembership scope) => $"{scope.TenantId:D}/{scope.OrganizationId:D}";
    private static string Utc(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private static string Date(DateTimeOffset? value) => value?.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";
    private static string Guids(IEnumerable<Guid> values) => string.Join(", ", values.Select(value => value.ToString("D")));
    private string T(string key, string ko, string en) => Ui.T(key, Ui.Language == "EnUs" ? en : ko);
    private string PaneTitle(Pane pane) => pane switch
    {
        Pane.Customers => T("crm.customerEnrollments", "CRM 고객", "CRM customers"), Pane.Pipelines => T("crm.pipelines", "Pipeline", "Pipelines"),
        Pane.Deals => T("crm.deals", "거래", "Deals"), Pane.Projects => T("crm.projects", "프로젝트", "Projects"),
        Pane.Teams => T("crm.teams", "팀", "Teams"), _ => T("crm.scope", "내 CRM 범위", "My CRM scopes")
    };
    private string StatusName(ProjectStatus status) => status switch
    {
        ProjectStatus.Open => T("crm.projectOpen", "열림", "Open"), ProjectStatus.InProgress => T("crm.projectInProgress", "진행 중", "In progress"),
        ProjectStatus.Completed => T("crm.projectCompleted", "완료", "Completed"), ProjectStatus.Cancelled => T("crm.projectCancelled", "취소", "Cancelled"), _ => status.ToString()
    };
    private string BudgetTypeName(ProjectBudgetType type) => type switch
    {
        ProjectBudgetType.Hours => T("crm.budgetHours", "시간", "Hours"),
        ProjectBudgetType.Cost => T("crm.budgetCost", "비용", "Cost"),
        _ => type.ToString()
    };

    private string ErrorMessage(int status, string? code = null, string? error = null)
        => (status switch
        {
            401 => Expired,
            403 => T("inventory.forbidden", "현재 조회 권한이 없습니다. 범위를 새로고침해 접근 상태를 확인하세요.", "You no longer have access. Refresh scopes to check access."),
            404 => T("crm.notFound", "레코드를 찾을 수 없습니다. 목록을 새로고침하세요.", "The record was not found. Refresh the list."),
            409 => T("crm.conflict", "현재 상태와 충돌했습니다. 목록을 새로고침하세요.", "The operation conflicts with the current state. Refresh the list."),
            503 => T("inventory.unavailable", "서비스를 사용할 수 없습니다. 잠시 후 다시 조회해 주세요.", "The service is unavailable. Retry shortly."),
            _ => T("inventory.readFailed", "요청을 완료하지 못했습니다. 다시 시도해 주세요.", "The request could not be completed. Retry.")
        }) + (string.IsNullOrWhiteSpace(code) ? "" : $" [{code}]") + (string.IsNullOrWhiteSpace(error) ? "" : $" {error}");

    private RenderFragment PaneStatus(Pane pane) => @<div class="cw-status" aria-live="polite">
        @if (Busy(pane)) { <p role="status">@Loading</p> }
        else if (_errors.TryGetValue(pane, out var error)) { <p role="alert">@ErrorMessage(error.Status, error.Code, error.Error)</p> }
        else if (_totals.TryGetValue(pane, out var total) && total == 0)
        { <p data-empty="true">@(pane == Pane.Scopes ? T("crm.noScopes", "현재 접근 가능한 CRM 범위가 없습니다.", "No CRM scopes are currently accessible.") : T("crm.empty", "이 페이지에 표시할 결과가 없습니다.", "No results on this page."))</p> }
    </div>;

    private RenderFragment DataSection<TValue>(Pane pane, IReadOnlyList<TValue>? items, Func<TValue, string> title,
        Func<TValue, string?> summary, Func<TValue, Guid> id, Func<TValue, Task> select) => @<text>
        @if (CanReadPane(pane))
        {
            <section id="@($"crm-{pane.ToString().ToLowerInvariant()}")" aria-labelledby="@($"crm-{pane.ToString().ToLowerInvariant()}-heading")" aria-busy="@Busy(pane).ToString().ToLowerInvariant()">
                <h2 id="@($"crm-{pane.ToString().ToLowerInvariant()}-heading")">@PaneTitle(pane)</h2>
                @PaneStatus(pane)
                @if (items is not null && items.Count > 0)
                {
                    <ul class="cw-records">
                        @foreach (var item in items)
                        {
                            <li class="cw-record" @key="id(item)"><strong>@title(item)</strong><p>@summary(item)</p><button type="button" data-select="@id(item)" @onclick="() => select(item)">@T("crm.select", "선택", "Select")</button></li>
                        }
                    </ul>
                }
                @Pager(pane)
            </section>
        }
    </text>;

    private bool CanNext(Pane pane) => !Busy(pane) && _totals.TryGetValue(pane, out var total)
        && (long)_offsets[pane] + PageSize < total && _offsets[pane] <= int.MaxValue - PageSize;
    private async Task MovePageAsync(Pane pane, int direction)
    {
        if (Busy(pane) || direction > 0 && !CanNext(pane) || direction < 0 && _offsets[pane] == 0) return;
        _offsets[pane] = Math.Max(0, _offsets[pane] + direction * PageSize);
        if (pane == Pane.Scopes) await LoadScopesAsync(); else await LoadPaneAsync(pane);
    }
    private RenderFragment Pager(Pane pane) => @<nav class="cw-pager" aria-label="@PaneTitle(pane)">
        <button type="button" disabled="@(Busy(pane) || _offsets[pane] == 0)" @onclick="() => MovePageAsync(pane, -1)">@T("inventory.previous", "이전 페이지", "Previous page")</button>
        @if (_totals.TryGetValue(pane, out var total)) { <span>@T("inventory.total", "전체", "Total") @total · @T("inventory.page", "페이지", "Page") @(_offsets[pane] / PageSize + 1)</span> }
        <button type="button" disabled="@(!CanNext(pane))" @onclick="() => MovePageAsync(pane, 1)">@T("inventory.next", "다음 페이지", "Next page")</button>
    </nav>;

    private static SelectedField Field(string label, string? value, bool identifier = false) => new(label, string.IsNullOrWhiteSpace(value) ? "—" : value, identifier);
    private sealed record SelectedField(string Label, string Value, bool Identifier);
    private sealed record SelectedRecord(string Kind, IReadOnlyList<SelectedField> Fields);

    public void Dispose()
    {
        _disposed = true; ++_identityVersion;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        Ui.Changed -= LanguageChanged;
        foreach (var pane in _requests.Keys.ToArray()) Cancel(pane);
        _detailRequest?.Cancel(); _detailRequest?.Dispose();
    }
}
