    private bool TryProjectInput(out ProjectInput? input)
    {
        input = null;
        if (string.IsNullOrWhiteSpace(_projectName)
            || !TryDate(_projectStartDate, out var start) || !TryDate(_projectEndDate, out var end)
            || start.HasValue && end.HasValue && end < start
            || !TryBudget(_projectBudget, out var budget))
        {
            _writeError = T("crm.projectInputRequired", "프로젝트 이름, 날짜와 예산을 확인하세요.", "Check the project name, dates and budget.");
            return false;
        }
        input = new(_projectName.Trim(), Empty(_projectDescription), Empty(_projectCode), _projectStatus,
            start, end, _projectBillable, _projectPublic, budget, _projectBudgetType);
        return true;
    }

    private bool TryProjectLinks(out ProjectLinks? links)
    {
        links = null;
        Guid? customer = _editingProject?.Links.CustomerId;
        if (CanEditProjectCustomer)
        {
            if (!TryOptionalGuid(_projectClientId, out customer)) return InvalidRelations(out links);
        }
        if (!TryMembers(_projectMemberIds, _projectManagerIds, out var members)
            || !TryGuidList(_projectTeamIds, out var teams)) return InvalidRelations(out links);
        links = new(customer, members, teams);
        return true;
    }

    private bool InvalidRelations(out ProjectLinks? links)
    {
        links = null;
        _writeError = T("crm.relationIdsInvalid", "관계 ID는 쉼표로 구분한 올바른 GUID여야 합니다.", "Relationship IDs must be valid comma-separated GUIDs.");
        return false;
    }

    private bool TryMembers(string memberText, string managerText, out IReadOnlyList<ProjectMember> members)
    {
        members = [];
        if (!TryGuidList(memberText, out var memberIds) || !TryGuidList(managerText, out var managerIds))
        {
            _writeError = T("crm.relationIdsInvalid", "관계 ID는 쉼표로 구분한 올바른 GUID여야 합니다.", "Relationship IDs must be valid comma-separated GUIDs.");
            return false;
        }
        var managers = managerIds.ToHashSet();
        members = memberIds.Concat(managerIds).Distinct().Select(id => new ProjectMember(id, managers.Contains(id))).ToArray();
        return true;
    }

    private static bool TryGuidList(string text, out IReadOnlyList<Guid> values)
    {
        values = [];
        if (string.IsNullOrWhiteSpace(text)) return true;
        var parsed = new List<Guid>();
        foreach (var item in text.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        {
            if (!Guid.TryParseExact(item, "D", out var value) || value == Guid.Empty) return false;
            if (!parsed.Contains(value)) parsed.Add(value);
        }
        values = parsed;
        return true;
    }

    private static bool TryOptionalGuid(string text, out Guid? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(text)) return true;
        if (!Guid.TryParseExact(text.Trim(), "D", out var parsed) || parsed == Guid.Empty) return false;
        value = parsed;
        return true;
    }

    private static bool TryDate(string text, out DateTimeOffset? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(text)) return true;
        if (!DateTimeOffset.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var parsed)) return false;
        value = parsed;
        return true;
    }

    private static bool TryBudget(string text, out decimal? value)
    {
        value = null;
        if (string.IsNullOrWhiteSpace(text)) return true;
        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) || parsed < 0) return false;
        value = parsed;
        return true;
    }

    private bool TryDealInput(out DealInput? input)
    {
        input = null;
        if (string.IsNullOrWhiteSpace(_dealTitle) || _dealStageId == Guid.Empty || _dealProbability is < 0 or > 5)
        { _writeError = T("crm.dealInputRequired", "거래명, 0~5 확률과 단계를 확인하세요.", "Check the deal title, 0–5 probability and stage."); return false; }
        Guid? client = null;
        if (!string.IsNullOrWhiteSpace(_dealClientId))
        {
            if (!Guid.TryParse(_dealClientId, out var parsed) || parsed == Guid.Empty)
            { _writeError = T("crm.clientInvalid", "고객 ID는 올바른 GUID여야 합니다.", "Client ID must be a valid GUID."); return false; }
            client = parsed;
        }
        input = new(_dealTitle.Trim(), _dealProbability, _dealStageId, client);
        return true;
    }

