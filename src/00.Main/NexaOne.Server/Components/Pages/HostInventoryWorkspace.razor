@page "/meta/NX_INVENTORY_WORKSPACE"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using NexaFramework.Service
@using NexaFramework.Service.Inventory
@using NexaOne.ServiceContracts.Ivt
@using WorkerDto = NexaOne.ServiceContracts.Mdm.WorkerDto
@inject IApiClient Api
@inject UiTextService Ui
@inject AuthenticationStateProvider Authentication

<PageTitle>@T("title", "재고 작업 공간", "Inventory workspace")</PageTitle>
<div class="inventory-workspace">
    <header>
        <h1>@T("title", "재고 작업 공간", "Inventory workspace")</h1>
        <p>@T("intro", "접근 가능한 범위를 선택해 등록 품목, 창고, 공유 장비와 예약을 조회합니다.", "Choose an accessible scope to browse enrolled products, warehouses, shared equipment and bookings.")</p>
    </header>
    @if (_identityLoading)
    {
        <p role="status">@T("loading", "불러오는 중…", "Loading…")</p>
    }
    else if (!_authenticated)
    {
        <p role="status">@T("signIn", "인증 상태를 확인하고 다시 로그인해 주세요.", "Check your session and sign in again.")</p>
    }
    else
    {
        <section id="inventory-scopes" aria-labelledby="scope-heading" aria-busy="@Busy(Pane.Scopes).ToString().ToLowerInvariant()">
            <div class="iw-heading">
                <h2 id="scope-heading">@T("scopes", "내 재고 범위", "My inventory scopes")</h2>
                <RadzenButton id="scope-refresh" Text="@T("refreshScopes", "범위 새로고침", "Refresh scopes")" Click="ReloadScopesAsync" Disabled="@Busy(Pane.Scopes)" ButtonStyle="ButtonStyle.Light" />
            </div>
            @Status(Pane.Scopes)
            @if (_scopes is not null)
            {
                <ul class="iw-scopes">
                    @foreach (var scope in _scopes.Items)
                    {
                        <li @key="ScopeKey(scope)">
                            <button type="button" class="iw-choice" data-scope="@ScopeKey(scope)" aria-pressed="@((ScopeKey(scope) == SelectedKey).ToString().ToLowerInvariant())"
                                    disabled="@Busy(Pane.Scopes)" @onclick="() => SelectScopeAsync(scope)">
                                <strong>@scope.Plant.PlantName <span class="iw-id">@scope.Plant.PlantId</span></strong>
                                <span class="iw-scope-keys">@T("tenant", "테넌트", "Tenant"): @scope.Membership.TenantId.ToString("D") · @T("organization", "조직", "Organization"): @scope.Membership.OrganizationId.ToString("D")</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            @Pager(Pane.Scopes)
        </section>

        @if (_scope is null)
        {
            <p class="iw-note">@T("chooseScope", "범위를 선택하면 현재 조회 권한이 있는 목록이 표시됩니다.", "Select a scope to see the lists you currently have permission to read.")</p>
        }
        else
        {
            <div id="selected-inventory-scope" class="iw-selected" role="status">
                <strong>@_scope.Plant.PlantName · @_scope.Plant.PlantId</strong>
                <span class="iw-scope-keys">@SelectedKey</span>
            </div>
            @if (!DataPanes.Any(CanRead))
            {
                <p id="inventory-no-read-access" role="status">@T("noReadAccess", "이 범위는 접근 가능하지만 현재 목록 조회 또는 작업자 선택 권한이 없습니다.", "This scope is accessible, but you currently have no list-reading or worker-selection permission.")</p>
            }
            @foreach (var pane in DataPanes.Where(CanRead))
            {
                <section id="@PaneId(pane)" @key="pane" aria-labelledby="@(PaneId(pane) + "-heading")" aria-busy="@Busy(pane).ToString().ToLowerInvariant()">
                    <h2 id="@(PaneId(pane) + "-heading")">@Title(pane)</h2>
                    @if (pane == Pane.Products)
                    {
                        <p class="iw-note">@T("productNote", "등록된 품목의 마스터 활성 상태입니다. 현재고나 단위 적합성을 나타내지 않습니다.", "Enrolled products show master activity, not stock quantity or unit eligibility.")</p>
                    }
                    @if (pane == Pane.Bookings)
                    {
                        <p class="iw-note">@T("bookingNote", "예약의 장비·작업자·요청자는 저장된 식별자로 표시합니다.", "Booking equipment, employees and requesters are shown by their stored identifiers.")</p>
                    }
                    @if (pane == Pane.Workers)
                    {
                        <p class="iw-note">@T("workerNote", "현재 연결된 공장의 활성 작업자입니다. 여기서 선택해도 예약은 생성되거나 저장되지 않습니다.", "Active workers in the bound plant. Selecting a worker here does not create or save a booking.")</p>
                        @if (_worker is not null)
                        {
                            <p id="inventory-worker-selection" role="status">@T("selectedWorker", "조회용 선택", "Selected for browsing"): @_worker.WorkerName · @_worker.WorkerId</p>
                        }
                    }
                    <form class="iw-filters" @onsubmit="() => SearchAsync(pane)" @onsubmit:preventDefault>
                        @if (pane == Pane.Bookings)
                        {
                            <label for="booking-state">@T("state", "상태", "State")</label>
                            <select id="booking-state" @bind="_draftBookingState" disabled="@Busy(pane)">
                                <option value="">@T("allStates", "모든 상태", "All states")</option>
                                @foreach (var state in Enum.GetValues<EquipmentBookingState>())
                                {
                                    <option value="@state">@BookingState(state)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <label for="@(PaneId(pane) + "-text")">@T("searchText", "코드·이름 검색", "Search code or name")</label>
                            <input id="@(PaneId(pane) + "-text")" type="search" @bind="_draftText[pane]" @bind:event="oninput" maxlength="@(pane == Pane.Workers ? 256 : 255)" disabled="@Busy(pane)" />
                            @if (pane != Pane.Workers)
                            {
                                <label class="iw-check"><input type="checkbox" @bind="_draftInactive[pane]" disabled="@Busy(pane)" />@T("includeInactive", "비활성 포함", "Include inactive")</label>
                            }
                        }
                        <RadzenButton id="@(PaneId(pane) + "-search")" ButtonType="ButtonType.Submit" Text="@T("search", "조회", "Search")" Disabled="@Busy(pane)" />
                    </form>
                    @Status(pane)
                    @if (_totals.ContainsKey(pane))
                    {
                        <div class="iw-table-scroll" tabindex="0" role="region" aria-label="@Title(pane)">
                            <table>
                                <caption class="iw-sr-only">@Title(pane)</caption>
                                @switch (pane)
                                {
                                    case Pane.Products:
                                        <thead><tr><th>@T("code", "코드", "Code")</th><th>@T("name", "이름", "Name")</th><th>@T("activity", "활성 상태", "Activity")</th></tr></thead>
                                        <tbody>@foreach (var item in _products!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Input.Code</td><td>@item.Input.Name</td><td>@Activity(item.Active)</td></tr> }</tbody>
                                        break;
                                    case Pane.Warehouses:
                                        <thead><tr><th>@T("code", "코드", "Code")</th><th>@T("name", "이름", "Name")</th><th>@T("activity", "활성 상태", "Activity")</th></tr></thead>
                                        <tbody>@foreach (var item in _warehouses!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Code</td><td>@item.Name</td><td>@Activity(item.Active)</td></tr> }</tbody>
                                        break;
                                    case Pane.Assets:
                                        <thead><tr><th>@T("code", "코드", "Code")</th><th>@T("name", "이름", "Name")</th><th>@T("capacity", "정원", "Capacity")</th><th>@T("approval", "승인 필요", "Approval required")</th><th>@T("activity", "활성 상태", "Activity")</th></tr></thead>
                                        <tbody>@foreach (var item in _assets!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Code</td><td>@item.Name</td><td>@item.Capacity</td><td>@(item.RequiresApproval ? T("yes", "예", "Yes") : T("no", "아니요", "No"))</td><td>@Activity(item.Active)</td></tr> }</tbody>
                                        break;
                                    case Pane.Bookings:
                                        <thead><tr><th>@T("bookingId", "예약 ID", "Booking ID")</th><th>@T("equipmentId", "장비 ID", "Equipment ID")</th><th>@T("employeeId", "작업자 ID", "Employee ID")</th><th>@T("requesterId", "요청자 ID", "Requester ID")</th><th>@T("start", "시작 (UTC)", "Start (UTC)")</th><th>@T("end", "종료 (UTC)", "End (UTC)")</th><th>@T("quantity", "수량", "Quantity")</th><th>@T("state", "상태", "State")</th></tr></thead>
                                        <tbody>@foreach (var item in _bookings!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Id</td><td class="iw-id">@item.EquipmentId</td><td class="iw-id">@item.EmployeeId</td><td class="iw-id">@item.RequestedBy</td><td>@Utc(item.Start)</td><td>@Utc(item.End)</td><td>@item.Quantity</td><td>@BookingState(item.State)</td></tr> }</tbody>
                                        break;
                                    case Pane.Workers:
                                        <thead><tr><th>@T("workerId", "작업자 코드", "Worker code")</th><th>@T("name", "이름", "Name")</th><th>@T("selection", "선택", "Selection")</th></tr></thead>
                                        <tbody>@foreach (var item in _workers!.Items) { <tr @key="item.WorkerId"><td class="iw-id">@item.WorkerId</td><td>@item.WorkerName</td><td><button type="button" class="iw-choice" data-worker="@item.WorkerId" aria-pressed="@((_worker?.WorkerId == item.WorkerId).ToString().ToLowerInvariant())" @onclick="() => _worker = item">@T("selectWorker", "조회용 선택", "Select for browsing")</button></td></tr> }</tbody>
                                        break;
                                }
                            </table>
                        </div>
                    }
                    @Pager(pane)
                </section>
            }
        }
    }
</div>

@code {
    private enum Pane { Scopes, Products, Warehouses, Assets, Bookings, Workers }
    private static readonly Pane[] DataPanes = [Pane.Products, Pane.Warehouses, Pane.Assets, Pane.Bookings, Pane.Workers];
    private const int PageSize = 50;
    private readonly Dictionary<Pane, int> _offsets = Enum.GetValues<Pane>().ToDictionary(p => p, _ => 0);
    private readonly Dictionary<Pane, long> _totals = new();
    private readonly Dictionary<Pane, CancellationTokenSource> _requests = new();
    private readonly Dictionary<Pane, (int Status, string? Code, string? Error)> _errors = new();
    private readonly Dictionary<Pane, string> _draftText = DataPanes.ToDictionary(p => p, _ => "");
    private readonly Dictionary<Pane, string> _text = DataPanes.ToDictionary(p => p, _ => "");
    private readonly Dictionary<Pane, bool> _draftInactive = DataPanes.ToDictionary(p => p, _ => false);
    private readonly Dictionary<Pane, bool> _inactive = DataPanes.ToDictionary(p => p, _ => false);
    private BusinessPage<InventoryAccessScope>? _scopes;
    private BusinessPage<Product>? _products;
    private BusinessPage<Warehouse>? _warehouses;
    private BusinessPage<SharedEquipment>? _assets;
    private BusinessPage<EquipmentBooking>? _bookings;
    private BusinessPage<WorkerDto>? _workers;
    private InventoryAccessScope? _scope;
    private WorkerDto? _worker;
    private string _draftBookingState = "", _bookingState = "";
    private bool _authenticated, _disposed, _interactive;
    private bool _identityLoading = true;
    private Task<AuthenticationState>? _pendingAuthentication;
    private int _identityVersion;

    protected override void OnInitialized()
    {
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        Ui.Changed += LanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        // ProtectedSessionStorage requires an interactive render. HostApp also disables
        // prerender; keeping the first token read here preserves that lifecycle boundary.
        _interactive = true;
        await ChangeIdentityAsync(_pendingAuthentication ?? Authentication.GetAuthenticationStateAsync());
        _pendingAuthentication = null;
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        if (!_interactive) { _pendingAuthentication = state; return; }
        if (!_disposed) _ = InvokeAsync(() => ChangeIdentityAsync(state));
    }
    private void LanguageChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    private async Task ChangeIdentityAsync(Task<AuthenticationState> state)
    {
        if (_disposed) return;
        var version = ++_identityVersion;
        ClearScoped();
        Cancel(Pane.Scopes);
        _scopes = null; _totals.Clear(); _errors.Clear(); _offsets[Pane.Scopes] = 0;
        _authenticated = false; _identityLoading = true;
        StateHasChanged();
        var auth = await state;
        if (_disposed || version != _identityVersion) return;
        _authenticated = auth.User.Identity?.IsAuthenticated == true; _identityLoading = false;
        if (_authenticated)
        {
            var loading = LoadScopesAsync();
            StateHasChanged();
            await loading;
        }
        if (!_disposed && version == _identityVersion) StateHasChanged();
    }

    private Task LoadScopesAsync() => ReadAsync<InventoryAccessScope>(Pane.Scopes,
        $"api/v1/ivt/scopes/me?offset={_offsets[Pane.Scopes]}&limit={PageSize}", value => _scopes = value);

    private async Task ReloadScopesAsync()
    {
        ClearScoped(); _offsets[Pane.Scopes] = 0;
        await LoadScopesAsync();
    }

    private async Task SelectScopeAsync(InventoryAccessScope scope)
    {
        ClearScoped(); _scope = scope;
        await Task.WhenAll(DataPanes.Where(CanRead).Select(LoadPaneAsync));
    }

    private void ClearScoped()
    {
        foreach (var pane in DataPanes)
        {
            Cancel(pane); _offsets[pane] = 0; _totals.Remove(pane); _errors.Remove(pane);
            _draftText[pane] = _text[pane] = ""; _draftInactive[pane] = _inactive[pane] = false;
        }
        _scope = null; _worker = null;
        _products = null; _warehouses = null; _assets = null; _bookings = null; _workers = null;
        _draftBookingState = _bookingState = "";
    }

    private bool CanRead(Pane pane) => _scope?.Membership.Permissions.Contains(pane switch
    {
        Pane.Products => "stock.read", Pane.Warehouses => "stock.warehouse.read", Pane.Assets => "equipment.read",
        Pane.Bookings => "equipment.booking.read", Pane.Workers => "equipment.booking.request", _ => ""
    }, StringComparer.Ordinal) == true;

    private async Task SearchAsync(Pane pane)
    {
        if (Busy(pane) || !CanRead(pane)) return;
        _text[pane] = _draftText[pane]; _inactive[pane] = _draftInactive[pane]; _offsets[pane] = 0;
        if (pane == Pane.Bookings) _bookingState = _draftBookingState;
        await LoadPaneAsync(pane);
    }

    private Task LoadPaneAsync(Pane pane)
    {
        if (_scope is null || !CanRead(pane) || _disposed) return Task.CompletedTask;
        var pair = ScopeKey(_scope);
        var page = $"offset={_offsets[pane]}&limit={PageSize}";
        var filter = $"text={Uri.EscapeDataString(_text[pane])}&includeInactive={_inactive[pane].ToString().ToLowerInvariant()}&{page}";
        return pane switch
        {
            Pane.Products => ReadAsync<Product>(pane, $"api/v1/ivt/stock/{pair}/products?{filter}", value => _products = value),
            Pane.Warehouses => ReadAsync<Warehouse>(pane, $"api/v1/ivt/stock/{pair}/warehouses?{filter}", value => _warehouses = value),
            Pane.Assets => ReadAsync<SharedEquipment>(pane, $"api/v1/ivt/shared-equipment/{pair}/assets?{filter}", value => _assets = value),
            Pane.Bookings => ReadAsync<EquipmentBooking>(pane, $"api/v1/ivt/shared-equipment/{pair}/bookings?{page}" + (_bookingState.Length == 0 ? "" : $"&state={_bookingState}"), value => _bookings = value),
            Pane.Workers => ReadAsync<WorkerDto>(pane, $"api/v1/ivt/shared-equipment/{pair}/workers?text={Uri.EscapeDataString(_text[pane])}&{page}", value => _workers = value),
            _ => Task.CompletedTask
        };
    }

    // The request object owns both its result and busy state. Cancellation alone cannot
    // prevent a transport that has already completed from publishing an old scope's data.
    private async Task ReadAsync<T>(Pane pane, string path, Action<BusinessPage<T>?> apply)
    {
        Cancel(pane);
        var request = new CancellationTokenSource();
        _requests[pane] = request;
        apply(null); _totals.Remove(pane); _errors.Remove(pane);
        if (pane == Pane.Workers) _worker = null;
        try
        {
            var result = await Api.ReadInventoryAsync<BusinessPage<T>>(path, request.Token);
            if (!OwnsRequest(pane, request)) return;
            if (result.StatusCode is >= 200 and < 300 && result.Error is null && result.Value is { Items: not null, Total: >= 0 })
            {
                apply(result.Value); _totals[pane] = result.Value.Total;
            }
            else _errors[pane] = (result.StatusCode, result.Code, result.Error);
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally
        {
            if (OwnsRequest(pane, request))
            {
                _requests.Remove(pane);
                StateHasChanged();
            }
            request.Dispose();
        }
    }

    private bool OwnsRequest(Pane pane, CancellationTokenSource request)
        => !_disposed && _requests.TryGetValue(pane, out var current) && ReferenceEquals(current, request);
    private void Cancel(Pane pane) { if (_requests.Remove(pane, out var request)) request.Cancel(); }
    private bool Busy(Pane pane) => _requests.ContainsKey(pane);
    private static string ScopeKey(InventoryAccessScope scope) => $"{scope.Membership.TenantId:D}/{scope.Membership.OrganizationId:D}";
    private string? SelectedKey => _scope is null ? null : ScopeKey(_scope);
    private static string PaneId(Pane pane) => "inventory-" + pane.ToString().ToLowerInvariant();
    private static string Utc(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private string T(string key, string ko, string en) => Ui.T("inventory." + key, Ui.Language == "EnUs" ? en : ko);
    private string Activity(bool active) => active ? T("active", "활성", "Active") : T("inactive", "비활성", "Inactive");
    private string Title(Pane pane) => pane switch
    {
        Pane.Products => T("products", "등록 품목", "Enrolled products"), Pane.Warehouses => T("warehouses", "창고", "Warehouses"),
        Pane.Assets => T("assets", "공유 장비", "Shared equipment"), Pane.Bookings => T("bookings", "예약 이력", "Booking history"),
        Pane.Workers => T("workers", "작업자 조회·선택", "Worker lookup and selection"), _ => T("scopes", "내 재고 범위", "My inventory scopes")
    };
    private string BookingState(EquipmentBookingState state) => state switch
    {
        EquipmentBookingState.Requested => T("requested", "요청됨", "Requested"), EquipmentBookingState.Approved => T("approved", "승인됨", "Approved"),
        EquipmentBookingState.CheckedOut => T("checkedOut", "대여 중", "Checked out"), EquipmentBookingState.Returned => T("returned", "반납됨", "Returned"),
        EquipmentBookingState.Denied => T("denied", "거절됨", "Denied"), EquipmentBookingState.Cancelled => T("cancelled", "취소됨", "Cancelled"), _ => state.ToString()
    };

    private RenderFragment Status(Pane pane) => @<div class="iw-status" aria-live="polite">
        @if (Busy(pane)) { <p role="status">@T("loading", "불러오는 중…", "Loading…")</p> }
        else if (_errors.TryGetValue(pane, out var error))
        {
            <div role="alert" data-status="@error.Status">
                <p>@ErrorMessage(error.Status)</p>
                @if (!string.IsNullOrEmpty(error.Code)) { <span class="iw-id">@error.Code</span> }
                @if (!string.IsNullOrEmpty(error.Error)) { <p>@error.Error</p> }
                <RadzenButton id="@(PaneId(pane) + "-retry")" Text="@T("retry", "다시 조회", "Retry read")" Click="() => RetryAsync(pane)" ButtonStyle="ButtonStyle.Light" />
            </div>
        }
        else if (_totals.TryGetValue(pane, out var total) && (total == 0 || _offsets[pane] >= total))
        {
            <p data-empty="true">@(pane == Pane.Scopes && total == 0
                ? T("noScopes", "현재 접근 가능한 재고 범위가 없습니다.", "No inventory scopes are currently accessible.")
                : T("empty", "이 페이지에 표시할 결과가 없습니다.", "No results on this page."))</p>
        }
    </div>;

    private string ErrorMessage(int status) => status switch
    {
        401 => T("unauthorized", "인증이 만료되었습니다. 다시 로그인해 주세요.", "Your session expired. Sign in again."),
        403 => T("forbidden", "현재 조회 권한이 없습니다. 범위를 새로고침해 접근 상태를 확인하세요.", "You no longer have access to this read. Refresh scopes to check access."),
        503 => T("unavailable", "서비스를 사용할 수 없습니다. 잠시 후 다시 조회해 주세요.", "The service is unavailable. Retry the read shortly."),
        400 => T("invalidQuery", "조회 조건을 확인하고 다시 조회해 주세요.", "Check the search criteria and retry."),
        _ => T("readFailed", "목록을 불러오지 못했습니다. 다시 조회해 주세요.", "The list could not be loaded. Retry the read.")
    };
    private Task RetryAsync(Pane pane) => pane == Pane.Scopes ? LoadScopesAsync() : LoadPaneAsync(pane);
    private bool CanNext(Pane pane) => !Busy(pane) && _totals.TryGetValue(pane, out var total)
        && (long)_offsets[pane] + PageSize < total && _offsets[pane] <= int.MaxValue - PageSize;
    private async Task MovePageAsync(Pane pane, int direction)
    {
        if (Busy(pane) || direction > 0 && !CanNext(pane) || direction < 0 && _offsets[pane] == 0) return;
        _offsets[pane] = Math.Max(0, _offsets[pane] + direction * PageSize);
        if (pane == Pane.Scopes) await LoadScopesAsync(); else await LoadPaneAsync(pane);
    }
    private RenderFragment Pager(Pane pane) => @<nav class="iw-pager" aria-label="@Title(pane)">
        <RadzenButton id="@(PaneId(pane) + "-previous")" Text="@T("previous", "이전 페이지", "Previous page")" Disabled="@(Busy(pane) || _offsets[pane] == 0)" Click="() => MovePageAsync(pane, -1)" ButtonStyle="ButtonStyle.Light" />
        @if (_totals.TryGetValue(pane, out var total)) { <span data-total="@total">@T("total", "전체", "Total") @total.ToString(CultureInfo.InvariantCulture) · @T("page", "페이지", "Page") @(_offsets[pane] / PageSize + 1)</span> }
        <RadzenButton id="@(PaneId(pane) + "-next")" Text="@T("next", "다음 페이지", "Next page")" Disabled="@(!CanNext(pane))" Click="() => MovePageAsync(pane, 1)" ButtonStyle="ButtonStyle.Light" />
    </nav>;

    public void Dispose()
    {
        _disposed = true; ++_identityVersion;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        Ui.Changed -= LanguageChanged;
        foreach (var pane in _requests.Keys.ToArray()) Cancel(pane);
    }
}
