@page "/meta/NX_INVENTORY_WORKSPACE"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using NexaFramework.Service
@using NexaFramework.Service.Inventory
@using NexaOne.ServiceContracts.Ivt
@using NexaOne.Common.Security
@using WorkerDto = NexaOne.ServiceContracts.Mdm.WorkerDto
@inject IApiClient Api
@inject UiTextService Ui
@inject AuthenticationStateProvider Authentication

<PageTitle>@T("inventory.title", "재고 작업 공간", "Inventory workspace")</PageTitle>
<div class="inventory-workspace">
    <header>
        <h1>@T("inventory.title", "재고 작업 공간", "Inventory workspace")</h1>
        <p>@T("inventory.intro", "접근 가능한 범위를 선택해 등록 품목, 창고, 공유 장비와 예약을 조회합니다.", "Choose an accessible scope to browse enrolled products, warehouses, shared equipment and bookings.")</p>
    </header>
    @if (_identityLoading)
    {
        <p role="status">@T("inventory.loading", "불러오는 중…", "Loading…")</p>
    }
    else if (!_authenticated)
    {
        <p role="status">@T("inventory.signIn", "인증 상태를 확인하고 다시 로그인해 주세요.", "Check your session and sign in again.")</p>
    }
    else
    {
        <section id="inventory-scopes" aria-labelledby="scope-heading" aria-busy="@Busy(Pane.Scopes).ToString().ToLowerInvariant()">
            <div class="iw-heading">
                <h2 id="scope-heading">@T("inventory.scopes", "내 재고 범위", "My inventory scopes")</h2>
                <RadzenButton id="scope-refresh" Text="@T("inventory.refreshScopes", "범위 새로고침", "Refresh scopes")" Click="ReloadScopesAsync" Disabled="@Busy(Pane.Scopes)" ButtonStyle="ButtonStyle.Light" />
            </div>
            @Status(Pane.Scopes)
            @if (_scopes is not null)
            {
                <ul class="iw-scopes">
                    @foreach (var scope in _scopes.Items)
                    {
                        <li @key="ScopeKey(scope)">
                            <button type="button" class="iw-choice" data-scope="@ScopeKey(scope)" aria-pressed="@((ScopeKey(scope) == SelectedKey).ToString().ToLowerInvariant())"
                                    disabled="@Busy(Pane.Scopes)" @onclick="() => SelectScopeAsync(scope)">
                                <strong>@scope.Plant.PlantName <span class="iw-id">@scope.Plant.PlantId</span></strong>
                                <span class="iw-scope-keys">@T("inventory.tenant", "테넌트", "Tenant"): @scope.Membership.TenantId.ToString("D") · @T("inventory.organization", "조직", "Organization"): @scope.Membership.OrganizationId.ToString("D")</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            @Pager(Pane.Scopes)
        </section>

        @if (_scope is null)
        {
            <p class="iw-note">@T("inventory.chooseScope", "범위를 선택하면 현재 조회 권한이 있는 목록이 표시됩니다.", "Select a scope to see the lists you currently have permission to read.")</p>
        }
        else
        {
            <div id="selected-inventory-scope" class="iw-selected" role="status">
                <strong>@_scope.Plant.PlantName · @_scope.Plant.PlantId</strong>
                <span class="iw-scope-keys">@SelectedKey</span>
            </div>
            @if (_scope.Membership.Permissions.Any(grant => grant.StartsWith("stock.", StringComparison.Ordinal)))
            {
                <StockWorkflowPanel @key="@("stock/" + SelectedKey)" @ref="_stock" Scope="_scope" UserId="@_currentUserId" Warehouses="_warehouses?.Items" Saved="RefreshStockAsync" VariantChanged="VariantChangedAsync" WarehouseChanged="WarehouseChangedAsync" />
            }
            @if (_scope.Membership.Permissions.Any(grant => grant.StartsWith("equipment.", StringComparison.Ordinal)))
            {
                <EquipmentWorkflowPanel @key="@("equipment/" + SelectedKey)" @ref="_workflow" Scope="_scope" UserId="@_currentUserId" Worker="_worker" Saved="RefreshEquipmentAsync" />
            }
            @if (!DataPanes.Any(CanRead))
            {
                <p id="inventory-no-read-access" role="status">@T("inventory.noReadAccess", "이 범위는 접근 가능하지만 현재 목록 조회 또는 작업자 선택 권한이 없습니다.", "This scope is accessible, but you currently have no list-reading or worker-selection permission.")</p>
            }
            @foreach (var pane in DataPanes.Where(CanRead))
            {
                <section id="@PaneId(pane)" @key="pane" aria-labelledby="@(PaneId(pane) + "-heading")" aria-busy="@Busy(pane).ToString().ToLowerInvariant()">
                    <h2 id="@(PaneId(pane) + "-heading")">@Title(pane)</h2>
                    @if (pane == Pane.Products)
                    {
                        <p class="iw-note">@T("inventory.productNote", "등록된 품목의 마스터 활성 상태입니다. 현재고나 단위 적합성을 나타내지 않습니다.", "Enrolled products show master activity, not stock quantity or unit eligibility.")</p>
                    }
                    @if (pane == Pane.Movements && _variant is { } listedVariant)
                    {
                        <p class="iw-note" id="inventory-movements-variant">@T("inventory.stock.movementNote", "선택한 품목 변형의 전표 이력입니다. 창고와 반제 상태는 저장된 식별자로 표시합니다.", "Ledger entries of the selected product variant. Warehouses and reversal state are shown by stored identifiers."): @listedVariant.Sku</p>
                    }
                    @if (pane == Pane.Balances && _balanceWarehouse is { } balanceWarehouse)
                    {
                        <p class="iw-note" id="inventory-balances-warehouse">@T("inventory.stock.balanceListNote", "선택한 창고에 기록된 잔고입니다. 전표가 닿은 뒤 0이 된 잔고도 남고, 전표가 없는 품목은 나타나지 않습니다. 변형은 저장된 식별자로 표시합니다.", "Balances recorded for the selected warehouse. A balance that reached zero stays listed; a product with no ledger entry here is not shown. Variants are shown by their stored identifiers."): @balanceWarehouse.Code · @balanceWarehouse.Name</p>
                    }
                    @if (pane == Pane.Reservations && _variant is { } reservedVariant)
                    {
                        <p class="iw-note" id="inventory-reservations-variant">@T("inventory.stock.reservationListNote", "선택한 품목 변형의 예약입니다. 정렬은 예약 ID 기준이며 생성 순서가 아닙니다. 행을 선택해 재고 작업에서 해제·소비합니다.", "Reservations of the selected product variant, ordered by reservation ID rather than creation time. Select a row to release or consume it in Stock actions."): @reservedVariant.Sku</p>
                    }
                    @if (pane == Pane.Bookings)
                    {
                        <p class="iw-note">@T("inventory.bookingNote", "예약의 장비·작업자·요청자는 저장된 식별자로 표시합니다.", "Booking equipment, employees and requesters are shown by their stored identifiers.")</p>
                    }
                    @if (pane == Pane.Workers)
                    {
                        <p class="iw-note">@T("inventory.write.workerNote", "현재 공장의 활성 작업자를 선택한 뒤 장비 작업에서 예약을 요청합니다. 선택만으로는 저장되지 않습니다.", "Select an active worker in the current plant, then request a booking in Equipment actions. Selection alone does not save anything.")</p>
                        @if (_worker is not null)
                        {
                            <p id="inventory-worker-selection" role="status">@T("inventory.write.workerSelected", "예약 작업자 선택", "Selected booking worker"): @_worker.WorkerName · @_worker.WorkerId</p>
                        }
                    }
                    @if (pane is not Pane.Movements and not Pane.Balances)
                    {
                    <form class="iw-filters" @onsubmit="() => SearchAsync(pane)" @onsubmit:preventDefault>
                        @if (pane == Pane.Reservations)
                        {
                            <label for="reservation-state">@T("inventory.state", "상태", "State")</label>
                            <select id="reservation-state" @bind="_draftReservationState" disabled="@Busy(pane)">
                                <option value="">@T("inventory.allStates", "모든 상태", "All states")</option>
                                @foreach (var state in Enum.GetValues<StockReservationState>())
                                {
                                    <option value="@state">@ReservationState(state)</option>
                                }
                            </select>
                        }
                        else if (pane == Pane.Bookings)
                        {
                            <label for="booking-state">@T("inventory.state", "상태", "State")</label>
                            <select id="booking-state" @bind="_draftBookingState" disabled="@Busy(pane)">
                                <option value="">@T("inventory.allStates", "모든 상태", "All states")</option>
                                @foreach (var state in Enum.GetValues<EquipmentBookingState>())
                                {
                                    <option value="@state">@BookingState(state)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <label for="@(PaneId(pane) + "-text")">@T("inventory.searchText", "코드·이름 검색", "Search code or name")</label>
                            <input id="@(PaneId(pane) + "-text")" type="search" @bind="_draftText[pane]" @bind:event="oninput" maxlength="@(pane == Pane.Workers ? 256 : 255)" disabled="@Busy(pane)" />
                            @if (pane != Pane.Workers)
                            {
                                <label class="iw-check"><input type="checkbox" @bind="_draftInactive[pane]" disabled="@Busy(pane)" />@T("inventory.includeInactive", "비활성 포함", "Include inactive")</label>
                            }
                        }
                        <RadzenButton id="@(PaneId(pane) + "-search")" ButtonType="ButtonType.Submit" Text="@T("inventory.search", "조회", "Search")" Disabled="@Busy(pane)" />
                    </form>
                    }
                    @Status(pane)
                    @if (_totals.ContainsKey(pane))
                    {
                        <div class="iw-table-scroll" tabindex="0" role="region" aria-label="@Title(pane)">
                            <table>
                                <caption class="iw-sr-only">@Title(pane)</caption>
                                @switch (pane)
                                {
                                    case Pane.Products:
                                        <thead><tr><th>@T("inventory.code", "코드", "Code")</th><th>@T("inventory.name", "이름", "Name")</th><th>@T("inventory.activity", "활성 상태", "Activity")</th>@if (HasStockPanel) { <th>@T("inventory.write.actions", "작업", "Actions")</th> }</tr></thead>
                                        <tbody>@foreach (var item in _products!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Input.Code</td><td>@item.Input.Name</td><td>@Activity(item.Active)</td>@if (HasStockPanel) { <td><button class="iw-choice" type="button" data-manage-product="@item.Id" @onclick="() => SelectProductAsync(item)">@T("inventory.stock.chooseProduct", "품목 선택", "Select product")</button></td> }</tr> }</tbody>
                                        break;
                                    case Pane.Warehouses:
                                        <thead><tr><th>@T("inventory.code", "코드", "Code")</th><th>@T("inventory.name", "이름", "Name")</th><th>@T("inventory.activity", "활성 상태", "Activity")</th>@if (HasStockPanel) { <th>@T("inventory.write.actions", "작업", "Actions")</th> }</tr></thead>
                                        <tbody>@foreach (var item in _warehouses!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Code</td><td>@item.Name</td><td>@Activity(item.Active)</td>@if (HasStockPanel) { <td><button class="iw-choice" type="button" data-manage-warehouse="@item.Id" @onclick="() => SelectWarehouseAsync(item)">@T("inventory.stock.chooseWarehouse", "창고 선택", "Select warehouse")</button></td> }</tr> }</tbody>
                                        break;
                                    case Pane.Balances:
                                        <thead><tr><th>@T("inventory.stock.variantId", "변형 ID", "Variant ID")</th><th>@T("inventory.stock.onHand", "현재고", "On hand")</th><th>@T("inventory.stock.reserved", "예약", "Reserved")</th><th>@T("inventory.stock.available", "가용", "Available")</th></tr></thead>
                                        <tbody>@foreach (var item in _balances!.Items) { <tr @key="item.Id"><td class="iw-id">@item.VariantId</td><td>@item.OnHand.ToString(CultureInfo.InvariantCulture)</td><td>@item.Reserved.ToString(CultureInfo.InvariantCulture)</td><td>@item.Available.ToString(CultureInfo.InvariantCulture)</td></tr> }</tbody>
                                        break;
                                    case Pane.Reservations:
                                        <thead><tr><th>@T("inventory.stock.reservationId", "예약 ID", "Reservation ID")</th><th>@T("inventory.stock.warehouse", "창고", "Warehouse")</th><th>@T("inventory.quantity", "수량", "Quantity")</th><th>@T("inventory.stock.reference", "참조", "Reference")</th><th>@T("inventory.state", "상태", "State")</th><th>@T("inventory.write.actions", "작업", "Actions")</th></tr></thead>
                                        <tbody>@foreach (var item in _reservations!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Id</td><td class="iw-id">@item.WarehouseId</td><td>@item.Quantity.ToString(CultureInfo.InvariantCulture)</td><td>@item.Reference</td><td>@ReservationState(item.State)</td><td><button class="iw-choice" type="button" data-manage-reservation="@item.Id" @onclick="() => SelectReservationAsync(item)">@T("inventory.stock.chooseReservation", "예약 선택", "Select reservation")</button></td></tr> }</tbody>
                                        break;
                                    case Pane.Movements:
                                        <thead><tr><th>@T("inventory.stock.movementId", "전표 ID", "Movement ID")</th><th>@T("inventory.stock.kind", "전표 종류", "Movement kind")</th><th>@T("inventory.stock.fromWarehouse", "출고 창고", "From warehouse")</th><th>@T("inventory.stock.toWarehouse", "입고 창고", "To warehouse")</th><th>@T("inventory.quantity", "수량", "Quantity")</th><th>@T("inventory.stock.reference", "참조", "Reference")</th><th>@T("inventory.stock.reversalState", "반제 상태", "Reversal state")</th><th>@T("inventory.write.actions", "작업", "Actions")</th></tr></thead>
                                        <tbody>@foreach (var item in _movements!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Id</td><td>@KindName(item.Posting.Kind)</td><td class="iw-id">@item.Posting.FromWarehouseId</td><td class="iw-id">@item.Posting.ToWarehouseId</td><td>@item.Posting.Quantity.ToString(CultureInfo.InvariantCulture)</td><td>@item.Posting.Reference</td><td>@ReversalState(item)</td><td><button class="iw-choice" type="button" data-manage-movement="@item.Id" @onclick="() => SelectMovementAsync(item)">@T("inventory.stock.chooseMovement", "전표 선택", "Select movement")</button></td></tr> }</tbody>
                                        break;
                                    case Pane.Assets:
                                        <thead><tr><th>@T("inventory.code", "코드", "Code")</th><th>@T("inventory.name", "이름", "Name")</th><th>@T("inventory.capacity", "정원", "Capacity")</th><th>@T("inventory.approval", "승인 필요", "Approval required")</th><th>@T("inventory.activity", "활성 상태", "Activity")</th><th>@T("inventory.write.actions", "작업", "Actions")</th></tr></thead>
                                        <tbody>@foreach (var item in _assets!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Code</td><td>@item.Name</td><td>@item.Capacity</td><td>@(item.RequiresApproval ? T("inventory.yes", "예", "Yes") : T("inventory.no", "아니요", "No"))</td><td>@Activity(item.Active)</td><td><button class="iw-choice" type="button" data-manage-equipment="@item.Id" @onclick="() => SelectEquipmentAsync(item)">@T("inventory.write.chooseAsset", "장비 선택", "Select equipment")</button></td></tr> }</tbody>
                                        break;
                                    case Pane.Bookings:
                                        <thead><tr><th>@T("inventory.bookingId", "예약 ID", "Booking ID")</th><th>@T("inventory.equipmentId", "장비 ID", "Equipment ID")</th><th>@T("inventory.employeeId", "작업자 ID", "Employee ID")</th><th>@T("inventory.requesterId", "요청자 ID", "Requester ID")</th><th>@T("inventory.start", "시작 (UTC)", "Start (UTC)")</th><th>@T("inventory.end", "종료 (UTC)", "End (UTC)")</th><th>@T("inventory.quantity", "수량", "Quantity")</th><th>@T("inventory.state", "상태", "State")</th><th>@T("inventory.write.actions", "작업", "Actions")</th></tr></thead>
                                        <tbody>@foreach (var item in _bookings!.Items) { <tr @key="item.Id"><td class="iw-id">@item.Id</td><td class="iw-id">@item.EquipmentId</td><td class="iw-id">@item.EmployeeId</td><td class="iw-id">@item.RequestedBy</td><td>@Utc(item.Start)</td><td>@Utc(item.End)</td><td>@item.Quantity</td><td>@BookingState(item.State)</td><td><button class="iw-choice" type="button" data-manage-booking="@item.Id" @onclick="() => SelectBookingAsync(item)">@T("inventory.write.chooseBooking", "예약 선택", "Select booking")</button></td></tr> }</tbody>
                                        break;
                                    case Pane.Workers:
                                        <thead><tr><th>@T("inventory.workerId", "작업자 코드", "Worker code")</th><th>@T("inventory.name", "이름", "Name")</th><th>@T("inventory.selection", "선택", "Selection")</th></tr></thead>
                                        <tbody>@foreach (var item in _workers!.Items) { <tr @key="item.WorkerId"><td class="iw-id">@item.WorkerId</td><td>@item.WorkerName</td><td><button type="button" class="iw-choice" data-worker="@item.WorkerId" aria-pressed="@((_worker?.WorkerId == item.WorkerId).ToString().ToLowerInvariant())" @onclick="() => _worker = item">@T("inventory.write.chooseWorkerAction", "예약 작업자 선택", "Select booking worker")</button></td></tr> }</tbody>
                                        break;
                                }
                            </table>
                        </div>
                    }
                    @Pager(pane)
                </section>
            }
        }
    }
</div>

@code {
    private enum Pane { Scopes, Products, Warehouses, Balances, Movements, Reservations, Assets, Bookings, Workers }
    private static readonly Pane[] DataPanes = [Pane.Products, Pane.Warehouses, Pane.Balances, Pane.Movements, Pane.Reservations, Pane.Assets, Pane.Bookings, Pane.Workers];
    private const int PageSize = 50;
    private readonly Dictionary<Pane, int> _offsets = Enum.GetValues<Pane>().ToDictionary(p => p, _ => 0);
    private readonly Dictionary<Pane, long> _totals = new();
    private readonly Dictionary<Pane, CancellationTokenSource> _requests = new();
    private readonly Dictionary<Pane, (int Status, string? Code, string? Error)> _errors = new();
    private readonly Dictionary<Pane, string> _draftText = DataPanes.ToDictionary(p => p, _ => "");
    private readonly Dictionary<Pane, string> _text = DataPanes.ToDictionary(p => p, _ => "");
    private readonly Dictionary<Pane, bool> _draftInactive = DataPanes.ToDictionary(p => p, _ => false);
    private readonly Dictionary<Pane, bool> _inactive = DataPanes.ToDictionary(p => p, _ => false);
    private BusinessPage<InventoryAccessScope>? _scopes;
    private BusinessPage<Product>? _products;
    private BusinessPage<Warehouse>? _warehouses;
    private BusinessPage<StockMovement>? _movements;
    private BusinessPage<StockReservation>? _reservations;
    private BusinessPage<StockBalance>? _balances;
    private Warehouse? _balanceWarehouse;
    private ProductVariant? _variant;
    private BusinessPage<SharedEquipment>? _assets;
    private BusinessPage<EquipmentBooking>? _bookings;
    private BusinessPage<WorkerDto>? _workers;
    private InventoryAccessScope? _scope;
    private WorkerDto? _worker;
    private EquipmentWorkflowPanel? _workflow;
    private StockWorkflowPanel? _stock;
    private string? _currentUserId;
    private string _draftBookingState = "", _bookingState = "";
    private string _draftReservationState = "", _reservationState = "";
    private bool _authenticated, _disposed, _interactive;
    private bool _identityLoading = true;
    private Task<AuthenticationState>? _pendingAuthentication;
    private int _identityVersion;

    protected override void OnInitialized()
    {
        Authentication.AuthenticationStateChanged += AuthenticationChanged;
        Ui.Changed += LanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        // ProtectedSessionStorage requires an interactive render. HostApp also disables
        // prerender; keeping the first token read here preserves that lifecycle boundary.
        _interactive = true;
        await ChangeIdentityAsync(_pendingAuthentication ?? Authentication.GetAuthenticationStateAsync());
        _pendingAuthentication = null;
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        if (!_interactive) { _pendingAuthentication = state; return; }
        if (!_disposed) _ = InvokeAsync(() => ChangeIdentityAsync(state));
    }
    private void LanguageChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }

    private async Task ChangeIdentityAsync(Task<AuthenticationState> state)
    {
        if (_disposed) return;
        var version = ++_identityVersion;
        ClearScoped();
        Cancel(Pane.Scopes);
        _scopes = null; _totals.Clear(); _errors.Clear(); _offsets[Pane.Scopes] = 0;
        _authenticated = false; _identityLoading = true; _currentUserId = null;
        StateHasChanged();
        var auth = await state;
        if (_disposed || version != _identityVersion) return;
        _authenticated = auth.User.Identity?.IsAuthenticated == true; _identityLoading = false;
        _currentUserId = _authenticated ? auth.User.CurrentUserId() : null;
        if (_authenticated)
        {
            var loading = LoadScopesAsync();
            StateHasChanged();
            await loading;
        }
        if (!_disposed && version == _identityVersion) StateHasChanged();
    }

    private Task LoadScopesAsync() => ReadAsync<InventoryAccessScope>(Pane.Scopes,
        $"api/v1/ivt/scopes/me?offset={_offsets[Pane.Scopes]}&limit={PageSize}", value => _scopes = value);

    private async Task ReloadScopesAsync()
    {
        ClearScoped(); _offsets[Pane.Scopes] = 0;
        await LoadScopesAsync();
    }

    private async Task SelectScopeAsync(InventoryAccessScope scope)
    {
        // Retain the keyed panel and its pending request when the selected row is clicked again.
        if (SelectedKey == ScopeKey(scope)) return;
        ClearScoped(); _scope = scope;
        await Task.WhenAll(DataPanes.Where(CanRead).Select(LoadPaneAsync));
    }

    private void ClearScoped()
    {
        foreach (var pane in DataPanes)
        {
            Cancel(pane); _offsets[pane] = 0; _totals.Remove(pane); _errors.Remove(pane);
            _draftText[pane] = _text[pane] = ""; _draftInactive[pane] = _inactive[pane] = false;
        }
        _scope = null; _worker = null; _workflow = null; _stock = null; _variant = null; _balanceWarehouse = null;
        _products = null; _warehouses = null; _balances = null; _movements = null; _reservations = null; _assets = null; _bookings = null; _workers = null;
        _draftBookingState = _bookingState = ""; _draftReservationState = _reservationState = "";
    }

    private bool HasStockPanel => _scope?.Membership.Permissions.Any(grant => grant.StartsWith("stock.", StringComparison.Ordinal)) == true;
    private Task SelectProductAsync(Product value) => _stock?.SelectProductAsync(value) ?? Task.CompletedTask;
    private Task SelectWarehouseAsync(Warehouse value) => _stock?.SelectWarehouseAsync(value) ?? Task.CompletedTask;
    private Task SelectMovementAsync(StockMovement value) => _stock?.SelectMovementAsync(value) ?? Task.CompletedTask;
    private Task SelectReservationAsync(StockReservation value) => _stock?.SelectReservationAsync(value) ?? Task.CompletedTask;
    private Task VariantChangedAsync(ProductVariant? variant)
    {
        // The movement ledger and reservation list are keyed by the variant the panel resolved; a new selection restarts their paging.
        foreach (var pane in new[] { Pane.Movements, Pane.Reservations })
        { Cancel(pane); _totals.Remove(pane); _errors.Remove(pane); _offsets[pane] = 0; }
        _movements = null; _reservations = null; _draftReservationState = _reservationState = "";
        _variant = variant;
        return _variant is null ? Task.CompletedTask : Task.WhenAll(LoadPaneAsync(Pane.Movements), LoadPaneAsync(Pane.Reservations));
    }
    private Task WarehouseChangedAsync(Warehouse? warehouse)
    {
        // The balance list is keyed by the warehouse the panel selected or saved. The same warehouse (a rename or
        // activity change) only refreshes the caption; the Saved callback reloads the rows once.
        if (warehouse is not null && _balanceWarehouse?.Id == warehouse.Id) { _balanceWarehouse = warehouse; return Task.CompletedTask; }
        Cancel(Pane.Balances); _balances = null; _totals.Remove(Pane.Balances); _errors.Remove(Pane.Balances); _offsets[Pane.Balances] = 0;
        _balanceWarehouse = warehouse;
        return _balanceWarehouse is null ? Task.CompletedTask : LoadPaneAsync(Pane.Balances);
    }
    private Task RefreshStockAsync() => Task.WhenAll(new[] { Pane.Products, Pane.Warehouses, Pane.Balances, Pane.Movements, Pane.Reservations }.Where(CanRead).Select(LoadPaneAsync));
    private Task SelectEquipmentAsync(SharedEquipment value) => _workflow?.SelectEquipmentAsync(value) ?? Task.CompletedTask;
    private Task SelectBookingAsync(EquipmentBooking value) => _workflow?.SelectBookingAsync(value) ?? Task.CompletedTask;
    private Task RefreshEquipmentAsync() => Task.WhenAll(new[] { Pane.Assets, Pane.Bookings }.Where(CanRead).Select(LoadPaneAsync));

    private bool CanRead(Pane pane) => _scope?.Membership.Permissions.Contains(pane switch
    {
        Pane.Products => "stock.read", Pane.Warehouses => "stock.warehouse.read", Pane.Assets => "equipment.read",
        Pane.Bookings => "equipment.booking.read", Pane.Workers => "equipment.booking.request",
        Pane.Movements or Pane.Reservations when _variant is not null => "stock.read",
        Pane.Balances when _balanceWarehouse is not null => "stock.read", _ => ""
    }, StringComparer.Ordinal) == true;

    private async Task SearchAsync(Pane pane)
    {
        if (Busy(pane) || !CanRead(pane)) return;
        _text[pane] = _draftText[pane]; _inactive[pane] = _draftInactive[pane]; _offsets[pane] = 0;
        if (pane == Pane.Bookings) _bookingState = _draftBookingState;
        if (pane == Pane.Reservations) _reservationState = _draftReservationState;
        await LoadPaneAsync(pane);
    }

    private Task LoadPaneAsync(Pane pane)
    {
        if (_scope is null || !CanRead(pane) || _disposed) return Task.CompletedTask;
        var pair = ScopeKey(_scope);
        var page = $"offset={_offsets[pane]}&limit={PageSize}";
        var filter = $"text={Uri.EscapeDataString(_text[pane])}&includeInactive={_inactive[pane].ToString().ToLowerInvariant()}&{page}";
        return pane switch
        {
            Pane.Products => ReadAsync<Product>(pane, $"api/v1/ivt/stock/{pair}/products?{filter}", value => _products = value),
            Pane.Warehouses => ReadAsync<Warehouse>(pane, $"api/v1/ivt/stock/{pair}/warehouses?{filter}", value => _warehouses = value),
            Pane.Balances => ReadAsync<StockBalance>(pane, $"api/v1/ivt/stock/{pair}/warehouses/{_balanceWarehouse!.Id:D}/balances?{page}", value => _balances = value),
            Pane.Movements => ReadAsync<StockMovement>(pane, $"api/v1/ivt/stock/{pair}/movements?variantId={_variant!.Id:D}&{page}", value => _movements = value),
            Pane.Reservations => ReadAsync<StockReservation>(pane, $"api/v1/ivt/stock/{pair}/reservations?variantId={_variant!.Id:D}&{page}" + (_reservationState.Length == 0 ? "" : $"&state={_reservationState}"), value => _reservations = value),
            Pane.Assets => ReadAsync<SharedEquipment>(pane, $"api/v1/ivt/shared-equipment/{pair}/assets?{filter}", value => _assets = value),
            Pane.Bookings => ReadAsync<EquipmentBooking>(pane, $"api/v1/ivt/shared-equipment/{pair}/bookings?{page}" + (_bookingState.Length == 0 ? "" : $"&state={_bookingState}"), value => _bookings = value),
            Pane.Workers => ReadAsync<WorkerDto>(pane, $"api/v1/ivt/shared-equipment/{pair}/workers?text={Uri.EscapeDataString(_text[pane])}&{page}", value => _workers = value),
            _ => Task.CompletedTask
        };
    }

    // The request object owns both its result and busy state. Cancellation alone cannot
    // prevent a transport that has already completed from publishing an old scope's data.
    private async Task ReadAsync<T>(Pane pane, string path, Action<BusinessPage<T>?> apply)
    {
        Cancel(pane);
        var request = new CancellationTokenSource();
        _requests[pane] = request;
        apply(null); _totals.Remove(pane); _errors.Remove(pane);
        if (pane == Pane.Workers) _worker = null;
        try
        {
            var result = await Api.ReadInventoryAsync<BusinessPage<T>>(path, request.Token);
            if (!OwnsRequest(pane, request)) return;
            if (result.StatusCode is >= 200 and < 300 && result.Error is null && result.Value is { Items: not null, Total: >= 0 })
            {
                apply(result.Value); _totals[pane] = result.Value.Total;
            }
            else _errors[pane] = (result.StatusCode, result.Code, result.Error);
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        finally
        {
            if (OwnsRequest(pane, request))
            {
                _requests.Remove(pane);
                StateHasChanged();
            }
            request.Dispose();
        }
    }

    private bool OwnsRequest(Pane pane, CancellationTokenSource request)
        => !_disposed && _requests.TryGetValue(pane, out var current) && ReferenceEquals(current, request);
    private void Cancel(Pane pane) { if (_requests.Remove(pane, out var request)) request.Cancel(); }
    private bool Busy(Pane pane) => _requests.ContainsKey(pane);
    private static string ScopeKey(InventoryAccessScope scope) => $"{scope.Membership.TenantId:D}/{scope.Membership.OrganizationId:D}";
    private string? SelectedKey => _scope is null ? null : ScopeKey(_scope);
    private static string PaneId(Pane pane) => "inventory-" + pane.ToString().ToLowerInvariant();
    private static string Utc(DateTimeOffset value) => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private string T(string key, string ko, string en) => Ui.T(key, Ui.Language == "EnUs" ? en : ko);
    private string Activity(bool active) => active ? T("inventory.active", "활성", "Active") : T("inventory.inactive", "비활성", "Inactive");
    private string Title(Pane pane) => pane switch
    {
        Pane.Products => T("inventory.products", "등록 품목", "Enrolled products"), Pane.Warehouses => T("inventory.warehouses", "창고", "Warehouses"),
        Pane.Movements => T("inventory.stock.movements", "전표 이력", "Movement history"), Pane.Reservations => T("inventory.stock.reservations", "예약 목록", "Reservations"),
        Pane.Balances => T("inventory.stock.balances", "창고 잔고", "Warehouse balances"),
        Pane.Assets => T("inventory.assets", "공유 장비", "Shared equipment"), Pane.Bookings => T("inventory.bookings", "예약 이력", "Booking history"),
        Pane.Workers => T("inventory.workers", "작업자 조회·선택", "Worker lookup and selection"), _ => T("inventory.scopes", "내 재고 범위", "My inventory scopes")
    };
    private string BookingState(EquipmentBookingState state) => state switch
    {
        EquipmentBookingState.Requested => T("inventory.requested", "요청됨", "Requested"), EquipmentBookingState.Approved => T("inventory.approved", "승인됨", "Approved"),
        EquipmentBookingState.CheckedOut => T("inventory.checkedOut", "대여 중", "Checked out"), EquipmentBookingState.Returned => T("inventory.returned", "반납됨", "Returned"),
        EquipmentBookingState.Denied => T("inventory.denied", "거절됨", "Denied"), EquipmentBookingState.Cancelled => T("inventory.cancelled", "취소됨", "Cancelled"), _ => state.ToString()
    };

    private string KindName(StockMovementKind kind) => kind switch
    {
        StockMovementKind.Receipt => T("inventory.stock.receipt", "입고", "Receipt"), StockMovementKind.Issue => T("inventory.stock.issue", "출고", "Issue"),
        StockMovementKind.Transfer => T("inventory.stock.transfer", "이동", "Transfer"), StockMovementKind.Adjustment => T("inventory.stock.adjustment", "조정", "Adjustment"),
        StockMovementKind.Reversal => T("inventory.stock.reversal", "반제", "Reversal"), _ => kind.ToString()
    };
    private string ReservationState(StockReservationState state) => state switch
    {
        StockReservationState.Active => T("inventory.stock.reservationActive", "활성", "Active"), StockReservationState.Consumed => T("inventory.stock.reservationConsumed", "소비됨", "Consumed"),
        StockReservationState.Released => T("inventory.stock.reservationReleased", "해제됨", "Released"), _ => state.ToString()
    };
    private string ReversalState(StockMovement movement) => movement.ReversalOfId is not null ? T("inventory.stock.reversalEntry", "반제 전표", "Reversal entry")
        : movement.ReversedById is not null ? T("inventory.stock.reversed", "반제됨", "Reversed") : T("inventory.stock.open", "유효", "Open");
    private RenderFragment Status(Pane pane) => @<div class="iw-status" aria-live="polite">
        @if (Busy(pane)) { <p role="status">@T("inventory.loading", "불러오는 중…", "Loading…")</p> }
        else if (_errors.TryGetValue(pane, out var error))
        {
            <div role="alert" data-status="@error.Status">
                <p>@ErrorMessage(error.Status)</p>
                @if (!string.IsNullOrEmpty(error.Code)) { <span class="iw-id">@error.Code</span> }
                @if (!string.IsNullOrEmpty(error.Error)) { <p>@error.Error</p> }
                <RadzenButton id="@(PaneId(pane) + "-retry")" Text="@T("inventory.retry", "다시 조회", "Retry read")" Click="() => RetryAsync(pane)" ButtonStyle="ButtonStyle.Light" />
            </div>
        }
        else if (_totals.TryGetValue(pane, out var total) && (total == 0 || _offsets[pane] >= total))
        {
            <p data-empty="true">@(pane == Pane.Scopes && total == 0
                ? T("inventory.noScopes", "현재 접근 가능한 재고 범위가 없습니다.", "No inventory scopes are currently accessible.")
                : T("inventory.empty", "이 페이지에 표시할 결과가 없습니다.", "No results on this page."))</p>
        }
    </div>;

    private string ErrorMessage(int status) => status switch
    {
        401 => T("inventory.unauthorized", "인증이 만료되었습니다. 다시 로그인해 주세요.", "Your session expired. Sign in again."),
        403 => T("inventory.forbidden", "현재 조회 권한이 없습니다. 범위를 새로고침해 접근 상태를 확인하세요.", "You no longer have access to this read. Refresh scopes to check access."),
        503 => T("inventory.unavailable", "서비스를 사용할 수 없습니다. 잠시 후 다시 조회해 주세요.", "The service is unavailable. Retry the read shortly."),
        400 => T("inventory.invalidQuery", "조회 조건을 확인하고 다시 조회해 주세요.", "Check the search criteria and retry."),
        _ => T("inventory.readFailed", "목록을 불러오지 못했습니다. 다시 조회해 주세요.", "The list could not be loaded. Retry the read.")
    };
    private Task RetryAsync(Pane pane) => pane == Pane.Scopes ? LoadScopesAsync() : LoadPaneAsync(pane);
    private bool CanNext(Pane pane) => !Busy(pane) && _totals.TryGetValue(pane, out var total)
        && (long)_offsets[pane] + PageSize < total && _offsets[pane] <= int.MaxValue - PageSize;
    private async Task MovePageAsync(Pane pane, int direction)
    {
        if (Busy(pane) || direction > 0 && !CanNext(pane) || direction < 0 && _offsets[pane] == 0) return;
        _offsets[pane] = Math.Max(0, _offsets[pane] + direction * PageSize);
        if (pane == Pane.Scopes) await LoadScopesAsync(); else await LoadPaneAsync(pane);
    }
    private RenderFragment Pager(Pane pane) => @<nav class="iw-pager" aria-label="@Title(pane)">
        <RadzenButton id="@(PaneId(pane) + "-previous")" Text="@T("inventory.previous", "이전 페이지", "Previous page")" Disabled="@(Busy(pane) || _offsets[pane] == 0)" Click="() => MovePageAsync(pane, -1)" ButtonStyle="ButtonStyle.Light" />
        @if (_totals.TryGetValue(pane, out var total)) { <span data-total="@total">@T("inventory.total", "전체", "Total") @total.ToString(CultureInfo.InvariantCulture) · @T("inventory.page", "페이지", "Page") @(_offsets[pane] / PageSize + 1)</span> }
        <RadzenButton id="@(PaneId(pane) + "-next")" Text="@T("inventory.next", "다음 페이지", "Next page")" Disabled="@(!CanNext(pane))" Click="() => MovePageAsync(pane, 1)" ButtonStyle="ButtonStyle.Light" />
    </nav>;

    public void Dispose()
    {
        _disposed = true; ++_identityVersion;
        Authentication.AuthenticationStateChanged -= AuthenticationChanged;
        Ui.Changed -= LanguageChanged;
        foreach (var pane in _requests.Keys.ToArray()) Cancel(pane);
    }
}
