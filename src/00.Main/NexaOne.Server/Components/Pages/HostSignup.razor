@page "/signup"
@layout HostLayout
@inject IApiClient Api
@inject NavigationManager Nav

@* §19.3.2/3 — 가입 신청(익명). 비밀번호는 받지 않는다 — 관리자 승인 시 임시 비밀번호가 발급되고 최초 로그인에서
   변경이 강제된다(PasswordState=Create). 아이디 중복확인은 익명 진입점(레이트리밋)을 호출한다. *@
<div style="max-width:26rem; margin:3rem auto; padding:2rem; border:1px solid #e5e7eb; border-radius:0.5rem;">
    <h1 style="font-size:1.25rem; font-weight:700; text-align:center; color:#111827;">가입 신청</h1>
    <p style="text-align:center; font-size:0.813rem; color:#6b7280; margin-bottom:1.5rem;">
        관리자 승인 후 임시 비밀번호가 발급됩니다
    </p>

    @if (_submitted)
    {
        <div style="padding:1rem; background:#ecfdf5; border:1px solid #a7f3d0; border-radius:0.375rem; font-size:0.875rem; color:#065f46;">
            <strong>신청이 접수되었습니다.</strong><br />
            관리자 승인 후 임시 비밀번호를 전달받아 로그인할 수 있습니다.
            최초 로그인 시 비밀번호 변경이 필요합니다.
        </div>
        <a href="/login" style="margin-top:1rem; display:inline-block; font-size:0.875rem; color:#2563eb;">로그인으로</a>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <div style="margin-bottom:0.75rem;">
                <label style="@LabelStyle">사용자 ID *</label>
                <div style="display:flex; gap:0.5rem;">
                    <input @bind="_model.UserId" @bind:after="ResetAvailability" placeholder="사용할 ID"
                           style="flex:1; padding:0.5rem; border:1px solid #d1d5db; border-radius:0.375rem;" />
                    <button type="button" @onclick="CheckAvailability" disabled="@(_checking || string.IsNullOrWhiteSpace(_model.UserId))"
                            style="padding:0.5rem 0.75rem; background:#f3f4f6; border:1px solid #d1d5db; border-radius:0.375rem; cursor:pointer; white-space:nowrap;">
                        중복확인
                    </button>
                </div>
                @if (_available is true)
                {
                    <span style="font-size:0.75rem; color:#059669;">사용 가능한 ID입니다.</span>
                }
                else if (_available is false)
                {
                    <span style="font-size:0.75rem; color:#dc2626;">이미 사용 중이거나 처리 대기 중인 ID입니다.</span>
                }
            </div>

            <div style="margin-bottom:0.75rem;">
                <label style="@LabelStyle">이름 *</label>
                <input @bind="_model.UserName" style="@InputStyle" />
            </div>
            <div style="margin-bottom:0.75rem;">
                <label style="@LabelStyle">이메일 *</label>
                <input @bind="_model.Email" type="email" style="@InputStyle" />
            </div>
            <div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
                <div style="flex:1;">
                    <label style="@LabelStyle">부서 *</label>
                    <input @bind="_model.Department" style="@InputStyle" />
                </div>
                <div style="flex:1;">
                    <label style="@LabelStyle">직위 *</label>
                    <input @bind="_model.Position" style="@InputStyle" />
                </div>
            </div>
            <div style="margin-bottom:0.75rem;">
                <label style="@LabelStyle">공장 ID *</label>
                <input @bind="_model.PlantId" placeholder="예: DEFAULT" style="@InputStyle" />
            </div>

            <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.813rem; color:#374151; margin-bottom:1rem;">
                <input type="checkbox" @bind="_model.TermsAccepted" />
                이용약관 및 개인정보 처리에 동의합니다 *
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="color:#dc2626; font-size:0.875rem; margin-bottom:1rem;">@_error</div>
            }

            <button type="submit" disabled="@(_loading || !CanSubmit)"
                    style="width:100%; padding:0.5rem; background:#2563eb; color:#fff; border:none; border-radius:0.375rem; cursor:pointer;">
                @(_loading ? "신청 중…" : "가입 신청")
            </button>
        </EditForm>
        <a href="/login" style="margin-top:1rem; display:inline-block; font-size:0.813rem; color:#6b7280;">이미 계정이 있으신가요? 로그인</a>
    }
</div>

@code {
    private const string LabelStyle = "display:block; font-size:0.813rem; font-weight:500; color:#374151; margin-bottom:0.25rem;";
    private const string InputStyle = "width:100%; padding:0.5rem; border:1px solid #d1d5db; border-radius:0.375rem;";

    private readonly SignupModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _checking;
    private bool _submitted;
    private bool? _available;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_model.UserId) && !string.IsNullOrWhiteSpace(_model.UserName)
        && !string.IsNullOrWhiteSpace(_model.Email) && !string.IsNullOrWhiteSpace(_model.Department)
        && !string.IsNullOrWhiteSpace(_model.Position) && !string.IsNullOrWhiteSpace(_model.PlantId)
        && _model.TermsAccepted;

    private void ResetAvailability() => _available = null;

    private async Task CheckAvailability()
    {
        _checking = true;
        try { _available = await Api.CheckUserIdAvailableAsync(_model.UserId.Trim()); }
        finally { _checking = false; }
        if (_available is null) _error = "중복확인에 실패했습니다. 잠시 후 다시 시도하세요.";
        else _error = null;
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _loading = true;
        try
        {
            var (request, error) = await Api.RegisterUserAsync(new
            {
                userId = _model.UserId.Trim(),
                userName = _model.UserName.Trim(),
                email = _model.Email.Trim(),
                department = _model.Department.Trim(),
                position = _model.Position.Trim(),
                plantId = _model.PlantId.Trim(),
                termsAccepted = _model.TermsAccepted,
            });
            if (request is null)
            {
                _error = error ?? "신청에 실패했습니다.";
                return;
            }
            _submitted = true;
        }
        catch
        {
            _error = "서버 연결에 실패했습니다.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class SignupModel
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Position { get; set; } = string.Empty;
        public string PlantId { get; set; } = "DEFAULT";
        public bool TermsAccepted { get; set; }
    }
}
