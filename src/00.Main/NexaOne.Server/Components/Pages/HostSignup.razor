@page "/signup"
@layout HostLayout
@inject IApiClient Api
@inject NavigationManager Nav

@* §19.3.2/3 — 가입 신청(익명). 비밀번호는 받지 않는다 — 관리자 승인 시 임시 비밀번호가 발급되고 최초 로그인에서
   변경이 강제된다(PasswordState=Create). 아이디 중복확인은 익명 진입점(레이트리밋)을 호출한다. *@
<div class="host-card">
    <h1 class="host-title">가입 신청</h1>
    <p class="host-sub">
        관리자 승인 후 임시 비밀번호가 발급됩니다
    </p>

    @if (_submitted)
    {
        <div class="host-help">
            <strong>신청이 접수되었습니다.</strong><br />
            관리자 승인 후 임시 비밀번호를 전달받아 로그인할 수 있습니다.
            최초 로그인 시 비밀번호 변경이 필요합니다.
        </div>
        <p class="host-help"><a href="/login" class="host-link">로그인으로</a></p>
    }
    else
    {
        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <div class="host-field">
                <label>사용자 ID *</label>
                <div class="host-toolbar">
                    <input @bind="_model.UserId" @bind:after="ResetAvailability" placeholder="사용할 ID"
                           class="host-input" />
                    <button type="button" @onclick="CheckAvailability" disabled="@(_checking || string.IsNullOrWhiteSpace(_model.UserId))"
                            class="host-btn-secondary">
                        중복확인
                    </button>
                </div>
                @if (_available is true)
                {
                    <span class="host-help">사용 가능한 ID입니다.</span>
                }
                else if (_available is false)
                {
                    <span class="host-error">이미 사용 중이거나 처리 대기 중인 ID입니다.</span>
                }
            </div>

            <div class="host-field">
                <label>이름 *</label>
                <input @bind="_model.UserName" class="host-input" />
            </div>
            <div class="host-field">
                <label>이메일 *</label>
                <input @bind="_model.Email" type="email" class="host-input" />
            </div>
            <div>
                <div class="host-field">
                    <label>부서 *</label>
                    <input @bind="_model.Department" class="host-input" />
                </div>
                <div class="host-field">
                    <label>직위 *</label>
                    <input @bind="_model.Position" class="host-input" />
                </div>
            </div>
            <div class="host-field">
                <label>공장 ID *</label>
                <input @bind="_model.PlantId" placeholder="예: DEFAULT" class="host-input" />
            </div>

            <div class="host-field">
                <label>
                    <input type="checkbox" @bind="_model.TermsAccepted" />
                    이용약관 및 개인정보 처리에 동의합니다 *
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="host-error">@_error</div>
            }

            <button type="submit" class="host-btn" disabled="@(_loading || !CanSubmit)">
                @(_loading ? "신청 중…" : "가입 신청")
            </button>
        </EditForm>
        <p class="host-help"><a href="/login" class="host-link">이미 계정이 있으신가요? 로그인</a></p>
    }
</div>

@code {
    private const string LabelStyle = "display:block; font-size:0.813rem; font-weight:500; color:#44506a; margin-bottom:0.25rem;";
    private const string InputStyle = "width:100%; padding:0.5rem; border:1px solid var(--nx-border); border-radius:4px; box-sizing:border-box;";

    private readonly SignupModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _checking;
    private bool _submitted;
    private bool? _available;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_model.UserId) && !string.IsNullOrWhiteSpace(_model.UserName)
        && !string.IsNullOrWhiteSpace(_model.Email) && !string.IsNullOrWhiteSpace(_model.Department)
        && !string.IsNullOrWhiteSpace(_model.Position) && !string.IsNullOrWhiteSpace(_model.PlantId)
        && _model.TermsAccepted;

    private void ResetAvailability() => _available = null;

    private async Task CheckAvailability()
    {
        _checking = true;
        try { _available = await Api.CheckUserIdAvailableAsync(_model.UserId.Trim()); }
        finally { _checking = false; }
        if (_available is null) _error = "중복확인에 실패했습니다. 잠시 후 다시 시도하세요.";
        else _error = null;
    }

    private async Task HandleSubmit()
    {
        _error = null;
        _loading = true;
        try
        {
            var (request, error) = await Api.RegisterUserAsync(new
            {
                userId = _model.UserId.Trim(),
                userName = _model.UserName.Trim(),
                email = _model.Email.Trim(),
                department = _model.Department.Trim(),
                position = _model.Position.Trim(),
                plantId = _model.PlantId.Trim(),
                termsAccepted = _model.TermsAccepted,
            });
            if (request is null)
            {
                _error = error ?? "신청에 실패했습니다.";
                return;
            }
            _submitted = true;
        }
        catch
        {
            _error = "서버 연결에 실패했습니다.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class SignupModel
    {
        public string UserId { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Position { get; set; } = string.Empty;
        public string PlantId { get; set; } = "DEFAULT";
        public bool TermsAccepted { get; set; }
    }
}
