@page "/meta/FACTORY_DASHBOARD_LAYOUT_EDIT"
@attribute [Authorize]
@inject IApiClient Api
@using System.Security.Claims
@using NexaOne.Common.Security

@* SmartUX '대시보드 레이아웃 관리' 점등 — 레거시 위젯 배치 편집기의 현대 대응은 GrapesJS 디자이너
   (SPA /spa/designer/{uiId}) + SYS_SCREEN_DEFINITION + Phase-2 위젯(KPI/StatusBadge)이다.
   본 페이지는 그 진입점: DB 저장 화면 목록 + 편집/신규 링크. 리터럴 라우트가 MetaScreen보다 우선. *@
<PageTitle>대시보드 레이아웃 관리</PageTitle>

@if (!_canManage)
{
    <div class="host-page">
        <h1 class="page-title">대시보드 레이아웃 관리</h1>
        <p class="host-desc">화면 편집(디자이너 저장)은 sys:manage 권한이 필요합니다.</p>
    </div>
}
else
{
    <div class="host-page">
        <h1 class="page-title">대시보드 레이아웃 관리</h1>
        <p class="host-desc">
            화면은 GrapesJS 디자이너에서 위젯(그리드/폼/KPI/상태 뱃지)을 배치해 편집합니다.
            저장된 정의는 즉시 <code>/meta/@("{UI_ID}")</code> 런타임으로 렌더됩니다.
            디자이너는 새 탭에서 열리며 별도 로그인(동일 계정)이 필요할 수 있습니다.
        </p>

        <div class="host-toolbar">
            <input @bind="_newUiId" placeholder="새 화면 UI_ID (예: DASHBOARD_LINE1)"
                   class="host-input inline" />
            <a href="@DesignerHref(_newUiId)" target="_blank"
               class="host-btn inline @(string.IsNullOrWhiteSpace(_newUiId) ? "is-disabled" : "")">
                새 화면 디자인
            </a>
            <button @onclick="ReloadAsync" class="host-btn-secondary">
                새로고침
            </button>
        </div>

        <table class="host-table">
            <thead>
                <tr>
                    <th>UI_ID</th><th>제목</th><th>열기</th>
                </tr>
            </thead>
            <tbody>
                @if (_screens.Count == 0)
                {
                    <tr><td colspan="3" class="empty">
                        @(_loading ? "불러오는 중…" : "디자이너로 저장된 화면이 아직 없습니다 — 위에서 새 화면을 만들어 보세요.")
                    </td></tr>
                }
                @foreach (var s in _screens)
                {
                    <tr>
                        <td><strong>@s.UiId</strong></td>
                        <td>@s.Title</td>
                        <td>
                            <a href="@DesignerHref(s.UiId)" target="_blank" class="host-actionlink">디자이너에서 편집</a>
                            <span class="host-sep">|</span>
                            <a href="/meta/@s.UiId" class="host-actionlink">런타임 보기</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _canManage;
    private bool _loading;
    private string _newUiId = string.Empty;
    private List<ScreenDefinitionRecordDto> _screens = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _canManage = (await AuthState).User.HasPermission(Permissions.SysManage);
        if (_canManage) await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _screens = await Api.GetScreenDefinitionsAsync(); }
        finally { _loading = false; }
    }

    private static string DesignerHref(string? uiId)
        => string.IsNullOrWhiteSpace(uiId) ? "#" : $"/spa/designer/{Uri.EscapeDataString(uiId.Trim())}";
}
