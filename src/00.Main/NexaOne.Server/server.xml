<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== WorkflowManager ===== -->

  <object id="workflowManagerPolicy" type="NexusFramework.Workflow.Tooling.ManagerExecutionPolicy, NexusFramework">
    <property name="Mode" value="Parallel" />
    <property name="GlobalMaxConcurrency" value="4" />
    <property name="QueueCapacity" value="1024" />
  </object>

  <object id="workflowRejectedHandler" type="NexusFramework.Concurrent.CallerRunsPolicy, NexusFramework" />

  <object id="workflowExecutionExecutor" type="NexusFramework.Concurrent.ThreadPoolExecutor, NexusFramework">
    <property name="CorePoolSize" value="4" />
    <property name="MaxPoolSize" value="8" />
    <property name="KeepAliveTime" value="00:00:30" />
    <property name="QueueCapacity" value="1024" />
    <property name="RejectedHandler" ref="workflowRejectedHandler" />
  </object>

  <object id="workflowManager" type="NexusFramework.Workflow.Tooling.WorkflowManager, NexusFramework">
    <constructor-arg ref="workflowManagerPolicy" />
    <constructor-arg ref="workflowExecutionExecutor" />
  </object>

  <!-- ===== Database =====
       DB 전환은 이 파일'만' 바꾸면 된다(코드 재빌드 불필요). 아래 [MSSQL] / [SQLite] 두 블록 중
       하나만 활성화하고 나머지는 주석 처리한다. 세 객체 id(dbProvider / eesDialect / eesDataSource)는
       양쪽 블록에서 동일하므로 nexaone.xml의 참조(ref="eesDataSource", ref="eesDialect")는 그대로 유지된다.
       - dbProvider   : IDatabaseProvider(연결 생성·실행). 자식 컨텍스트(nexaone.xml)가 eesDataSource로 공유.
       - eesDialect   : INexaOneEESDbCapability(SQL 방언). nexaone.xml의 리포지토리가 parent 참조로 주입받는다.
       - eesDataSource: EesDataSource(Provider + ConnectionString).
       SQLite로 전환하면 NexaOne.Server 기동 시 db/migrations를 SQLite 방언으로 변환해 스키마를 자동 생성한다
       (SqliteSchemaInitializer, 빈 DB일 때만). 외부 DB 설치가 필요 없어 로컬/테스트에 적합하다. -->

  <!-- [MSSQL] 기본(운영) -->
  <object id="dbProvider" type="NexusCom.Data.MsSql.MsSqlProvider, NexusCom.Data.MsSql" />
  <object id="eesDialect" type="NexusCom.Data.MsSql.MsSqlProvider, NexusCom.Data.MsSql" />
  <object id="eesDataSource" type="NexaOne.Infrastructure.Persistence.EesDataSource, NexaOne.Infrastructure">
    <property name="Provider" ref="dbProvider" />
    <property name="ConnectionString" value="Server=localhost;Database=NexaOneEES;Integrated Security=true;TrustServerCertificate=true" />
  </object>

  <!-- [SQLite] 로컬/테스트 — 위 [MSSQL] 3개 객체를 주석 처리하고 아래 주석을 해제한다.
       SqliteProvider는 무인자 ctor가 없어(전 선택적 파라미터) Spring이 직접 생성하지 못하므로
       SqliteProviderFactory.Create()(factory-method)로 생성한다. MsSqlProvider는 무인자 ctor가 있어 직접 지정한다.
  <object id="dbProvider" type="NexaOne.Infrastructure.Persistence.SqliteProviderFactory, NexaOne.Infrastructure" factory-method="Create" />
  <object id="eesDialect" type="NexaOne.Infrastructure.Persistence.SqliteEesDbCapability, NexaOne.Infrastructure" />
  <object id="eesDataSource" type="NexaOne.Infrastructure.Persistence.EesDataSource, NexaOne.Infrastructure">
    <property name="Provider" ref="dbProvider" />
    <property name="ConnectionString" value="Data Source=nexaone.db;Foreign Keys=False" />
  </object>
  -->

</objects>
