<?xml version="1.0" encoding="utf-8"?>
<Application>
  <Services>
    <!-- 모듈 독립 구조: 도메인 모듈 11개를 각각 독립 Service로 등록한다. Service당 모듈 DLL 1개(classPaths)와
         그 모듈의 빈을 담은 모듈 xml 1개(configFiles)를 짝짓는다. ClassLoader가 classPaths의 DLL을 plugin
         ALC(AssemblyLoader)로 로드하고, configFiles의 xml이 해당 모듈 빈을 등록한다. 공통 서버 빈
         (eesDataSource·appConfiguration·eesDialect·opcUaDriver·messageBus·plantController)은 server.xml
         (부모 컨텍스트)에 있고 모듈 xml은 이를 ref로만 참조한다. DLL은 빌드 시 CopyDomainModulePlugins
         타깃이 ./Modules/로 복사한다(NexaOne.Server.csproj). -->
    <!-- configFiles는 작업 디렉터리 기준 상대경로다. 모듈 컨텍스트 xml은 config/modules/ 폴더로 정리했고
         (csproj가 출력의 config/ 로 복사), DLL(classPaths)은 ./Modules/ 에 그대로 둔다. -->
    <Service name="Mdm"  classPaths="./Modules/NexaOne.MDM.dll"  configFiles="config/modules/mdm.xml" />
    <Service name="Est"  classPaths="./Modules/NexaOne.EST.dll"  configFiles="config/modules/est.xml" />
    <Service name="Fdc"  classPaths="./Modules/NexaOne.FDC.dll"  configFiles="config/modules/fdc.xml" />
    <Service name="Rms"  classPaths="./Modules/NexaOne.RMS.dll"  configFiles="config/modules/rms.xml" />
    <Service name="Qms"  classPaths="./Modules/NexaOne.QMS.dll"  configFiles="config/modules/qms.xml" />
    <Service name="Ems" classPaths="./Modules/NexaOne.EMS.dll" configFiles="config/modules/ems.xml" />
    <Service name="Ivt" classPaths="./Modules/NexaOne.IVT.dll" configFiles="config/modules/ivt.xml" />
    <Service name="Pom"  classPaths="./Modules/NexaOne.POM.dll"  configFiles="config/modules/pom.xml" />
    <Service name="Prc"  classPaths="./Modules/NexaOne.PRC.dll"  configFiles="config/modules/prc.xml" />
    <Service name="Shp"  classPaths="./Modules/NexaOne.SHP.dll"  configFiles="config/modules/shp.xml" />
    <Service name="Sys"  classPaths="./Modules/NexaOne.SYS.dll"  configFiles="config/modules/sys.xml" />
  </Services>
</Application>
