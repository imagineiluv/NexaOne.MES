<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ERP owns estimates, invoices and payments over the Framework billing service. The XML surface is
       one module composition root plus its public bridge; scope is SYS membership, not an IVT plant binding. -->
  <object id="erpModule" type="NexaOne.ERP.Module, NexaOne.ERP">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="businessMembershipBridge" />
    <constructor-arg ref="businessMasterDirectory" />
    <constructor-arg ref="quartzScheduler" />
    <constructor-arg ref="deliveryProviderRegistry" />
  </object>

  <object id="billingBridge" factory-object="erpModule" factory-method="GetBillingBridge" />
  <object id="expenseBridge" factory-object="erpModule" factory-method="GetExpenseBridge" />
  <object id="financialReportBridge" factory-object="erpModule" factory-method="GetFinancialReportBridge" />
  <object id="businessReportBridge" factory-object="erpModule" factory-method="GetBusinessReportBridge" />
  <object id="recurringBridge" factory-object="erpModule" factory-method="GetRecurringBridge" />
  <object id="recurringAutomationBridge" factory-object="erpModule" factory-method="GetRecurringAutomationBridge" />
  <object id="deliveryBridge" factory-object="erpModule" factory-method="GetDeliveryBridge" />
  <object id="deliveryAutomationBridge" factory-object="erpModule" factory-method="GetDeliveryAutomationBridge" />
  <object id="recurringAutomationWorker" factory-object="erpModule" factory-method="GetRecurringAutomationWorker" />
  <object id="deliveryDispatchWorker" factory-object="erpModule" factory-method="GetDeliveryDispatchWorker" />

</objects>
