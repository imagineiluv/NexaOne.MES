<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <object id="estModule" type="NexaOne.EST.Module, NexaOne.EST">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="equipmentDirectory" />
    <constructor-arg ref="equipmentOutputMasterDirectory" />
    <constructor-arg ref="oeeEvidenceSource" />
    <constructor-arg ref="quartzScheduler" />
  </object>

  <object id="equipmentAlarmBridge" factory-object="estModule" factory-method="GetAlarmBridge" />
  <object id="equipmentStateBridge" factory-object="estModule" factory-method="GetStateBridge" />
  <object id="equipmentOutputBridge" factory-object="estModule" factory-method="GetOutputBridge" />
  <object id="utilityBridge" factory-object="estModule" factory-method="GetUtilityBridge" />
  <object id="oeeAggregationBridge" factory-object="estModule" factory-method="GetOeeBridge" />
  <object id="oeeAggregationWorker" factory-object="estModule" factory-method="GetOeeWorker" />

</objects>
