<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">
  <object id="hrModule" type="NexaOne.HR.Module, NexaOne.HR">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="businessMembershipBridge" />
    <constructor-arg ref="businessProjectDirectory" />
  </object>
  <object id="humanResourcesBridge" factory-object="hrModule" factory-method="GetHumanResourcesBridge" />
  <object id="timeBillingDirectory" factory-object="hrModule" factory-method="GetTimeBillingDirectory" />
</objects>
