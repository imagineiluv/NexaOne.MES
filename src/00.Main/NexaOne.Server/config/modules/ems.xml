<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- Worker:Ems:MaintenanceDue:*는 appConfiguration에서 바인딩한다. Enabled 기본값은 false이며,
       IntervalSeconds와 Topic을 Spring XML 정책 상수로 중복 선언하지 않는다. -->
  <object id="emsModule" type="NexaOne.EMS.Module, NexaOne.EMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="vendorDirectory" />
    <constructor-arg ref="equipmentDirectory" />
    <constructor-arg ref="equipmentOutputMasterDirectory" />
    <constructor-arg ref="maintenanceIdentityDirectory" />
    <constructor-arg ref="quartzScheduler" />
    <constructor-arg ref="messageBus" />
  </object>

  <object id="emsBridge" factory-object="emsModule" factory-method="GetEmsBridge" />
  <object id="maintenanceScheduleBridge" factory-object="emsModule" factory-method="GetScheduleBridge" />
  <object id="maintenanceExecutionBridge" factory-object="emsModule" factory-method="GetExecutionBridge" />
  <object id="sparePartBridge" factory-object="emsModule" factory-method="GetSparePartBridge" />
  <object id="toolBridge" factory-object="emsModule" factory-method="GetToolBridge" />
  <object id="maintenanceDueCheckWorker" factory-object="emsModule" factory-method="GetDueCheckWorker" />

</objects>
