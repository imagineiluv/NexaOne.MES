<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- Optional durable application runtime. The project policy must be declared by an earlier
       config file in the same service context (for Cleaner: config/projects/cleaner.xml). -->
  <object id="workScopeProjectionApplicationModule"
      type="NexaOne.POM.WorkScopeProjectionApplicationModule, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="workScopeProjectionPolicy" />
  </object>

  <!-- Both exports deliberately return the same singleton. The host validates their reference
       identity before HTTP readiness so a marker-only or lifecycle-only wiring cannot start. -->
  <object id="workScopeProjectionRuntime"
      factory-object="workScopeProjectionApplicationModule"
      factory-method="GetWorkScopeProjectionRuntime" />
  <object id="workScopeProjectionWorker"
      factory-object="workScopeProjectionApplicationModule"
      factory-method="GetWorkScopeProjectionWorker" />

</objects>
