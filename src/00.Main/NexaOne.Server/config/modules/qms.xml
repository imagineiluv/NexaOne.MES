<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <object id="qmsModule" type="NexaOne.QMS.Module, NexaOne.QMS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="productionLotDirectory" />
    <constructor-arg ref="materialLotDirectory" />
    <constructor-arg ref="equipmentDirectory" />
    <constructor-arg ref="processDirectory" />
    <constructor-arg ref="userDirectory" />
  </object>

  <object id="qmsBridge" factory-object="qmsModule" factory-method="GetQmsBridge" />
  <object id="qmsProductionQualityGateway" factory-object="qmsModule" factory-method="GetProductionQualityGateway" />
  <object id="trackingDefectDirectory" factory-object="qmsModule" factory-method="GetTrackingDefectDirectory" />

</objects>
