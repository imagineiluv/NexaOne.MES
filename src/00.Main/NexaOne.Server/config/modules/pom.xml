<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== POM (Production Order Management) ===== -->

  <object id="pomProductionPlanRepository" type="NexaOne.POM.Infrastructure.ProductionPlanRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="pomProductionOrderRepository" type="NexaOne.POM.Infrastructure.ProductionOrderRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="pomWorkOrderRepository" type="NexaOne.POM.Infrastructure.PomWorkOrderRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
  </object>
  <!-- POM-owned production LOT reference directory for sibling consumers such as QMS. -->
  <object id="productionLotDirectory" type="NexaOne.POM.Infrastructure.ProductionLotDirectory, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="pomService" type="NexaOne.POM.Application.Pom.PomService, NexaOne.POM">
    <constructor-arg ref="pomProductionPlanRepository" />
  </object>
  <object id="productionOrderService" type="NexaOne.POM.Application.Pom.ProductionOrderService, NexaOne.POM">
    <constructor-arg ref="pomProductionOrderRepository" />
  </object>
  <object id="pomWorkOrderService" type="NexaOne.POM.Application.WorkOrders.PomWorkOrderService, NexaOne.POM">
    <constructor-arg ref="pomWorkOrderRepository" />
    <constructor-arg ref="pomProductionOrderRepository" />
    <!-- 직접 W/O 완료도 연결 LOT 종결 상태와 호스트 QMS 게이트를 통과해야 한다. -->
    <constructor-arg ref="pomLotRepository" />
    <constructor-arg ref="productionQualityGateway" />
  </object>
  <object id="pomWorkOrderBridge" type="NexaOne.POM.Application.WorkOrders.PomWorkOrderBridge, NexaOne.POM">
    <constructor-arg ref="pomWorkOrderService" />
  </object>

  <!-- Lot 추적(TrackIn/TrackOut/Hold) 빈 — 기존에 미등록이라 브리지 노출과 함께 추가한다.
       LotHistoryRepository는 부모(server.xml) eesDialect(INexaOneEESDbCapability)를 cross-context ref로 주입한다(SearchAsync 페이징 방언). -->
  <object id="pomLotRepository" type="NexaOne.POM.Infrastructure.LotRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="pomLotHistoryRepository" type="NexaOne.POM.Infrastructure.LotHistoryRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>
  <object id="pomLotMixingRelationRepository" type="NexaOne.POM.Infrastructure.LotMixingRelationRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
  </object>
  <!-- 라우팅 통제 정책은 교체 가능한 드라이버로 등록해 업종별 정책을 POM 서비스 코드와 분리한다. -->
  <object id="routingPolicyEvaluator" type="NexaOne.POM.Domain.RoutingPolicyEvaluator, NexaOne.POM" />
  <!-- 교차 모듈 마스터 검증 포트(설계 19.4.2) — 이제 어댑터 구현은 호스트 server.xml의 trackingMasterGateway
       서버 빈이 소유한다(ADR-006: POM 플러그인은 MDM/RMS/QMS 스키마 미보유). lotTrackingService는 그 호스트
       빈을 cross-context ref로 주입받으며, 포트(ITrackingMasterGateway)는 ServiceContracts에 공유되어 타입 동일성이 유지된다. -->
  <object id="lotTrackingService" type="NexaOne.POM.Application.Lots.LotTrackingService, NexaOne.POM">
    <constructor-arg ref="pomLotRepository" />
    <!-- 동일 구현이 조회 포트와 원자적 전이 포트를 모두 제공한다. 원자적 포트는 필수 의존성이다. -->
    <constructor-arg ref="pomLotRepository" />
    <constructor-arg ref="pomLotHistoryRepository" />
    <constructor-arg ref="pomLotMixingRelationRepository" />
    <constructor-arg ref="pomWorkOrderRepository" />
    <constructor-arg ref="trackingMasterGateway" />
    <constructor-arg ref="productionQualityGateway" />
    <constructor-arg ref="routingPolicyEvaluator" />
  </object>

  <!-- ADR-008 얇은 브리지 어댑터 — 호스트가 GetBean("Pom","pomBridge")로 IPomBridge 캐스트.
       생산계획(PomService)·생산오더(ProductionOrderService)·Lot 추적(LotTrackingService) 단일 애그리거트 쓰기를 위임한다.
       Lot Mixing(다중 애그리거트)은 어댑터에서 노출하지 않는다(UnitOfWork 선결). -->
  <object id="pomBridge" type="NexaOne.POM.Application.Pom.PomBridge, NexaOne.POM">
    <constructor-arg ref="pomService" />
    <constructor-arg ref="productionOrderService" />
    <constructor-arg ref="lotTrackingService" />
  </object>

  <!-- 불량 관찰(Track-Out evidence)과 업무 처분(Scrap/Rework/Return/UseAsIs/Hold)을 분리한다. -->
  <object id="lotDispositionRepository" type="NexaOne.POM.Infrastructure.LotDispositionRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="lotDispositionService" type="NexaOne.POM.Application.Lots.LotDispositionService, NexaOne.POM">
    <constructor-arg ref="lotDispositionRepository" />
  </object>
  <object id="lotDispositionBridge" type="NexaOne.POM.Application.Pom.LotDispositionBridge, NexaOne.POM">
    <constructor-arg ref="lotDispositionService" />
  </object>

  <!-- MRP — POM 계산/원장과 owner bridge 입력을 조립한다. SLS만 ADR-0002의 임시 projection이다. -->
  <object id="salesOrderMrpDemandSource" type="NexaOne.POM.Infrastructure.LegacySalesOrderMrpProjection, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="mrpPlanningRepository" type="NexaOne.POM.Infrastructure.MrpPlanningRepository, NexaOne.POM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="salesOrderMrpDemandSource" />
    <constructor-arg ref="mrpMasterDirectory" />
    <constructor-arg ref="mrpInventoryDirectory" />
    <constructor-arg ref="purchaseOrderPlanningBridge" />
    <constructor-arg ref="equipmentDirectory" />
  </object>
  <object id="mrpBridge" type="NexaOne.POM.Application.Mrp.MrpBridge, NexaOne.POM">
    <constructor-arg ref="mrpPlanningRepository" />
  </object>

</objects>
