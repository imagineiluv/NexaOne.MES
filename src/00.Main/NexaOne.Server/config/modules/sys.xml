<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== SYS ===== -->

  <object id="userRepository" type="NexaOne.SYS.Infrastructure.UserRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <!-- SYS-owned login-user to maintenance-worker identity projection. EMS receives only the
       shared contract through the parent proxy and never imports SYS/MDM physical SQL. -->
  <object id="maintenanceIdentityDirectory" type="NexaOne.SYS.Infrastructure.MaintenanceIdentityDirectory, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="userDirectory" type="NexaOne.SYS.Infrastructure.UserDirectory, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="roleRepository" type="NexaOne.SYS.Infrastructure.RoleRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="multiLanguageResourceRepository" type="NexaOne.SYS.Infrastructure.MultiLanguageResourceRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="loginFailureHistoryRepository" type="NexaOne.SYS.Infrastructure.LoginFailureHistoryRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>
  <object id="userRequestRepository" type="NexaOne.SYS.Infrastructure.UserRequestRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="appConfiguration" />
  </object>
  <object id="menuRepository" type="NexaOne.SYS.Infrastructure.MenuRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="favoriteMenuRepository" type="NexaOne.SYS.Infrastructure.FavoriteMenuRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>
  <object id="recentMenuRepository" type="NexaOne.SYS.Infrastructure.RecentMenuRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>
  <object id="userService" type="NexaOne.SYS.Application.Users.UserService, NexaOne.SYS">
    <constructor-arg ref="userRepository" />
    <constructor-arg ref="roleRepository" />
    <constructor-arg ref="multiLanguageResourceRepository" />
    <constructor-arg ref="loginFailureHistoryRepository" />
  </object>
  <object id="userRegistrationService" type="NexaOne.SYS.Application.Users.UserRegistrationService, NexaOne.SYS">
    <constructor-arg ref="userRequestRepository" />
    <constructor-arg ref="userRepository" />
  </object>
  <object id="userMenuService" type="NexaOne.SYS.Application.Menus.UserMenuService, NexaOne.SYS">
    <constructor-arg ref="favoriteMenuRepository" />
    <constructor-arg ref="recentMenuRepository" />
    <constructor-arg ref="menuRepository" />
  </object>

  <!-- 배포(§20.11 클라이언트 자동 업데이트) — 메타=SYS_DEPLOY_FILE(eesDataSource), 바이너리=서버 디스크
       (data/deploy-files, 프로세스 작업 디렉터리 기준). 운영 시드/개발 시드 금지 — 메타 오염 시 클라이언트
       latest 선정이 깨진다(기록된 주의사항). -->
  <object id="deployFileRepository" type="NexaOne.SYS.Infrastructure.DeployFileRepository, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
  </object>
  <object id="deployFileStorage" type="NexaOne.SYS.Infrastructure.FileSystemDeployFileStorage, NexaOne.SYS">
    <constructor-arg value="data/deploy-files" />
  </object>
  <object id="deployService" type="NexaOne.SYS.Application.Deploys.DeployService, NexaOne.SYS">
    <constructor-arg ref="deployFileRepository" />
    <constructor-arg ref="deployFileStorage" />
  </object>
  <!-- ADR-008 얇은 브리지 — 호스트가 GetBean("Sys","deployBridge")로 IDeployBridge 캐스트. -->
  <object id="deployBridge" type="NexaOne.SYS.Application.Deploys.DeployBridge, NexaOne.SYS">
    <constructor-arg ref="deployService" />
  </object>

  <!-- ADR-008 얇은 브리지 어댑터 — 호스트가 GetBean("Sys","sysBridge")로 ISysBridge 캐스트.
       역할 관리(CreateRole/AddPermission/RemovePermission)·신청 반려(UserRegistrationService.Reject)·
       사용자 비활성(UserService.Deactivate) 단일 애그리거트 쓰기를 위임한다(비-자격증명).
       보안 가드(S7): 자격증명/비밀번호/로그인·승인(다중 애그리거트)·잠금 해제는 위임 대상이 아니다(인증 경로 소유). -->
  <object id="sysBridge" type="NexaOne.SYS.Application.Users.SysBridge, NexaOne.SYS">
    <constructor-arg ref="userService" />
    <constructor-arg ref="userRegistrationService" />
  </object>

  <!-- 로그인실패 이력 보존정리 워커(BackgroundService) — 모듈 소유 주기 작업. quartzScheduler는 부모(server.xml)
       빈을 cross-context ref로 주입한다. Program.cs가 IHostedService로 자동발견해 호스팅한다. messageBus 불필요(정리 작업).
       ctor: (IRecurringScheduler, ILoginFailureHistoryRepository, bool enabled, int intervalSeconds, int retentionDays). -->
  <object id="loginFailureRetentionWorker" type="NexaOne.SYS.Application.Users.LoginFailureRetentionWorker, NexaOne.SYS">
    <constructor-arg ref="quartzScheduler" />
    <constructor-arg ref="loginFailureHistoryRepository" />
    <!-- 보존정리 워커 enable 스위치(Worker:Sys:LoginFailureRetention:Enabled). 기본 false(추가형·게이트 OFF). -->
    <constructor-arg value="false" />
    <constructor-arg value="86400" />
    <constructor-arg value="90" />
  </object>

</objects>
