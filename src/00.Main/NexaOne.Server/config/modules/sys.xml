<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- Worker:Sys:LoginFailureRetention:*는 appConfiguration에서 바인딩한다. Enabled 기본값은 false이며,
       IntervalSeconds와 RetentionDays를 Spring XML 정책 상수로 중복 선언하지 않는다. -->
  <object id="sysModule" type="NexaOne.SYS.Module, NexaOne.SYS">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
    <constructor-arg ref="appConfiguration" />
    <constructor-arg ref="quartzScheduler" />
  </object>

  <object id="sysBridge" factory-object="sysModule" factory-method="GetSysBridge" />
  <object id="deployBridge" factory-object="sysModule" factory-method="GetDeployBridge" />
  <object id="maintenanceIdentityDirectory" factory-object="sysModule" factory-method="GetMaintenanceIdentityDirectory" />
  <object id="userDirectory" factory-object="sysModule" factory-method="GetUserDirectory" />
  <object id="releasedProgramArtifactDirectory" factory-object="sysModule" factory-method="GetReleasedProgramArtifactDirectory" />
  <object id="sysTrustedAuthoritySqliteSchemaContribution"
      factory-object="sysModule"
      factory-method="GetTrustedAuthoritySqliteSchemaContribution" />
  <object id="loginFailureRetentionWorker" factory-object="sysModule" factory-method="GetLoginFailureRetentionWorker" />

</objects>
