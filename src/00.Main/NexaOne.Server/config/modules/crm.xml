<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">
  <object id="crmModule" type="NexaOne.CRM.Module, NexaOne.CRM">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="businessMembershipBridge" />
    <constructor-arg ref="businessMasterDirectory" />
  </object>
  <object id="crmBridge" factory-object="crmModule" factory-method="GetCrmBridge" />
  <object id="crmSqliteSchemaContribution" factory-object="crmModule" factory-method="GetSqliteSchemaContribution" />
</objects>
