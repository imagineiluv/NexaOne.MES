<?xml version="1.0" encoding="utf-8"?>
<objects xmlns="http://www.springframework.net"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.net http://www.springframework.net/xsd/spring-objects.xsd">

  <!-- ===== WorkflowManager ===== -->

  <object id="workflowManagerPolicy" type="NexaFramework.Workflow.Tooling.ManagerExecutionPolicy, NexaFramework">
    <property name="Mode" value="Parallel" />
    <property name="GlobalMaxConcurrency" value="4" />
    <property name="QueueCapacity" value="1024" />
  </object>

  <object id="workflowRejectedHandler" type="NexaFramework.Concurrent.CallerRunsPolicy, NexaFramework" />

  <object id="workflowExecutionExecutor" type="NexaFramework.Concurrent.ThreadPoolExecutor, NexaFramework">
    <property name="CorePoolSize" value="4" />
    <property name="MaxPoolSize" value="8" />
    <property name="KeepAliveTime" value="00:00:30" />
    <property name="QueueCapacity" value="1024" />
    <property name="RejectedHandler" ref="workflowRejectedHandler" />
  </object>

  <object id="workflowManager" type="NexaFramework.Workflow.Tooling.WorkflowManager, NexaFramework">
    <constructor-arg ref="workflowManagerPolicy" />
    <constructor-arg ref="workflowExecutionExecutor" />
  </object>

  <!-- ===== 공통 서버 빈 (모든 서비스가 공통으로 호출) =====
       NexaOne.Server는 서비스 빈 컨테이너다(ADR-005). 모든 도메인 서비스가 공통으로 의존하는 빈은
       부모 컨텍스트(여기)에 두고, 자식 컨텍스트(nexaone.xml)의 서비스 빈이 ref로 공통 호출한다. -->

  <!-- 빈 ConfigurationManager(IConfiguration). 거의 모든 리포지토리가 outbox 게이트(config["Events:Outbox:Enabled"])
       판독에 공통 사용한다 — 빈 설정이라 null→off로 평가(이 호스트는 API 티어가 디스패처를 돌리므로 off가 올바른 기본, ADR-002). -->
  <!-- 호스트 IConfiguration 브리지 — 종전의 빈 ConfigurationManager 새 인스턴스는 모듈 설정 읽기
       (Events:Outbox:Enabled 등)를 무력화하는 실버그였다. Program.cs가 CreateServer 전에 Root를 설정한다. -->
  <object id="appConfiguration" type="NexaOne.Common.Configuration.SpringHostConfiguration, NexaOne.Common" />

  <!-- PLC 프로토콜 드라이버와 NexusLogic DriverFactory. FDC는 구체 드라이버를 참조하지 않고
       plcDriverFactory에서 엔드포인트의 PlcDriverKind에 맞는 구현을 선택한다. 연결은 Worker가 활성화되고
       엔드포인트가 있을 때만 수행하므로 Bean 생성 자체는 외부 PLC에 접속하지 않는다. -->
  <object id="opcUaDriver" type="NexusLogic.Plc.OpcUa.OpcUaDriver, NexusLogic.Plc.OpcUa" />
  <object id="modbusTcpDriver" type="NexusLogic.Plc.ModbusTcp.ModbusTcpDriver, NexusLogic.Plc.ModbusTcp">
    <constructor-arg><null /></constructor-arg>
    <constructor-arg><null /></constructor-arg>
  </object>
  <object id="siemensS7Driver" type="NexusLogic.Plc.SiemensS7.SiemensS7Driver, NexusLogic.Plc.SiemensS7">
    <constructor-arg><null /></constructor-arg>
    <constructor-arg><null /></constructor-arg>
  </object>
  <object id="mitsubishiMcDriver" type="NexusLogic.Plc.MitsubishiMc.MitsubishiMcDriver, NexusLogic.Plc.MitsubishiMc">
    <constructor-arg><null /></constructor-arg>
    <constructor-arg><null /></constructor-arg>
  </object>
  <object id="etherNetIpDriver" type="NexusLogic.Plc.AllenBradley.EtherNetIpDriver, NexusLogic.Plc.AllenBradley">
    <constructor-arg><null /></constructor-arg>
    <constructor-arg><null /></constructor-arg>
  </object>
  <object id="plcDriverFactory" type="NexusLogic.Plc.Hosting.PlcDriverFactory, NexusLogic.Plc.Hosting">
    <constructor-arg>
      <list element-type="NexusLogic.Plc.Abstractions.Interfaces.IPlcDriver, NexusLogic.Plc.Abstractions">
        <ref object="opcUaDriver" />
        <ref object="modbusTcpDriver" />
        <ref object="siemensS7Driver" />
        <ref object="mitsubishiMcDriver" />
        <ref object="etherNetIpDriver" />
      </list>
    </constructor-arg>
  </object>

  <!-- 설비 제어(PlantController). FDC 수집 워커(ADR-006 Phase 2)가 GetServerBean("plantController")로 당겨 Machine
       lifecycle을 수동 제어한다. 무인자 ctor(Spring property 주입). 부모 컨텍스트라 NexaFramework 타입 로드 가능. -->
  <object id="plantController" type="NexaFramework.PlantController, NexaFramework" />

  <!-- 캐시(ICacheService) — 읽기 빈도 높은 마스터/조회 캐시(인메모리, IMemoryCache 기반). FDC 수집 핫패스 등
       자식 컨텍스트 서비스가 cross-context ref="cacheService"로 공통 호출한다. 무인자 ctor가 기본 옵션
       MemoryCache를 자체 생성한다(API 티어는 MS DI로 동일 ICacheService 주입, ServiceCollectionExtensions). -->
  <object id="cacheService" type="NexaOne.Common.Caching.MemoryCacheService, NexaOne.Common" />

  <!-- ===== Outbox 디스패치 워커(스케줄러 구동, ADR-002·ADR-006) =====
       실 Quartz 반복 스케줄러로 구동되는 주기 워커. 기본 OFF — enabled="true"로만 기동한다(브로커/DB 없는 dev/CI 보호,
       그리고 API 티어 디스패처와의 동시 가동 회피). API의 OutboxDispatcherService와 디스패치 의미는 동일하다. -->

  <!-- 반복 스케줄러(IRecurringScheduler). Quartz 기본 RAMJobStore라 외부 인프라 없이 in-process 동작. 무인자 ctor. -->
  <object id="quartzScheduler" type="NexaFramework.Scheduling.QuartzScheduler, NexaFramework" />

  <!-- Outbox 저장소(IOutboxRepository). ctor(EesDataSource, INexaOneEESDbCapability) — 공통 빈 eesDataSource·eesDialect 주입. -->
  <object id="outboxRepository" type="NexaOne.Infrastructure.Persistence.OutboxRepository, NexaOne.Common">
    <constructor-arg ref="eesDataSource" />
    <constructor-arg ref="eesDialect" />
  </object>

  <!-- 교차 모듈 마스터 검증 어댑터(POM 포트 구현) — 호스트(Default ALC)가 소유, plugin POM이 cross-context ref로
       주입받는다(ADR-006: POM은 타 모듈 스키마 미보유). ITrackingMasterGateway 포트는 ServiceContracts에 공유되어
       plugin/Default ALC 간 타입 동일성이 유지되며, 구현(MDM/RMS/QMS read)은 호스트가 소유한다. -->
  <object id="trackingMasterGateway" type="NexaOne.Server.Gateway.TrackingMasterGateway, NexaOne.Server">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- POM-to-QMS sibling-context proxy. QMS owns evidence SQL and the completion decision. -->
  <object id="productionQualityGateway" type="NexaOne.Server.Gateway.ProductionQualityGatewayProxy, NexaOne.Server" />

  <!-- IVT-to-FDC sibling-context proxy. FDC owns persisted TRACE SQL and paging. -->
  <object id="fdcTraceSource" type="NexaOne.Server.Gateway.FdcTraceSourceProxy, NexaOne.Server" />

  <!-- 교차 모듈 설비 디렉터리 어댑터(EST 포트 구현) — 호스트(Default ALC)가 소유, plugin EST가 cross-context ref로
       주입받는다(ADR-006: EST는 MDM 스키마 미보유). IEquipmentDirectory 포트는 ServiceContracts에 공유되어
       plugin/Default ALC 간 타입 동일성이 유지되며, 구현(MDM_EQUIPMENT read)은 호스트가 소유한다. -->
  <object id="equipmentDirectory" type="NexaOne.Server.Gateway.EquipmentDirectory, NexaOne.Server">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- OEE 외부 증거 host orchestration adapter — MDM 계획/시간대와 legacy POM TrackOut을
       Common IOeeEvidenceSource snapshot으로 축약해 EST plugin에 주입한다. EST는 타 모듈 물리 테이블을 읽지 않는다. -->
  <object id="oeeEvidenceSource" type="NexaOne.Server.Gateway.OeeEvidenceSource, NexaOne.Server">
    <constructor-arg ref="eesDataSource" />
  </object>

  <!-- 스케줄러 구동 Outbox 디스패치 워커(IHostedService). enabled="false"가 기본 게이트 — 켜려면 "true"로 변경한다. -->
  <object id="scheduledOutboxDispatchWorker" type="NexaOne.Server.ScheduledOutboxDispatchWorker, NexaOne.Server">
    <constructor-arg ref="quartzScheduler" />
    <constructor-arg ref="outboxRepository" />
    <constructor-arg ref="messageBus" />
    <constructor-arg value="false" />        <!-- enabled — 기본 OFF. 워커 기동 스위치. -->
    <constructor-arg value="5" />            <!-- intervalSeconds -->
    <constructor-arg value="nexaone.events" /><!-- topic -->
    <constructor-arg value="100" />          <!-- batchSize -->
    <constructor-arg value="10" />           <!-- maxAttempts -->
  </object>

  <!-- 메시징 버스(IMessageBus). 드라이버처럼 server.xml 빈으로 두고, 워커(FDC)·Outbox 디스패처·구독자가
       GetBean으로 당겨 쓴다(ADR-006). DB 공급자(dbProvider)처럼 아래 두 줄 중 하나만 활성화해 전환한다.
       - [InMemory](기본): 단일 프로세스 dev/테스트. 같은 프로세스 내 구독자에게만 전달.
       - [Kafka]: 다중 프로세스 분리용. 워커 프로세스가 발행 → API가 구독 → SignalR. 실행 중인 브로커 필요. -->
  <object id="messageBus" type="NexaOne.Infrastructure.Messaging.InMemoryMessageBus, NexaOne.Infrastructure.Messaging" />
  <!-- <object id="messageBus" type="NexaOne.Infrastructure.Messaging.KafkaMessageBus, NexaOne.Infrastructure.Messaging">
         <constructor-arg value="localhost:9092" />
       </object> -->

  <!-- ===== Database (SQLite 변형 — 테스트/로컬 전용) =====
       운영 기본은 host/server.xml(MSSQL). 이 파일은 Server:SpringConfig=config/host/server.sqlite.xml 로 명시 지정될 때만 사용된다.
       동일 빈 id(dbProvider/eesDialect/eesDataSource)라 nexaone.xml 참조는 그대로 유지된다. NexaOne.Server 기동 시
       db/migrations를 SQLite 방언으로 변환해 스키마를 자동 생성한다(SqliteSchemaInitializer, 빈 DB일 때만). -->
  <object id="dbProvider" type="NexusCom.Data.Sqlite.SqliteProvider, NexusCom.Data.Sqlite" />
  <object id="eesDialect" type="NexaOne.Infrastructure.Persistence.SqliteEesDbCapability, NexaOne.Common" />
  <object id="eesDataSource" type="NexaOne.Infrastructure.Persistence.EesDataSource, NexaOne.Common">
    <property name="Provider" ref="dbProvider" />
    <property name="ConnectionString" value="Data Source=nexaone-modules-test.db;Foreign Keys=False" />
  </object>

</objects>
