# 운영 빌드 시 API 베이스 URL (예: https://api.nexames.example). 개발은 Vite 프록시를 쓰므로 비워둔다.
VITE_API_BASE_URL=

# SignalR 허브 경로 — Server의 NexaOneMesHostingOptions.RealtimeHubPath와 동일하게 맞춘다(`/` 필수).
VITE_REALTIME_HUB_PATH=/hubs/smartees

# 개발 프록시 대상 — NexaOne.Server launchSettings 기본 주소.
VITE_API_PROXY=http://localhost:5173
