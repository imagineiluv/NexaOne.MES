    private bool HasRequiredPermission(string? permission)
    {
        if (string.IsNullOrWhiteSpace(permission)) return true;
        var required = permission.Trim();
        return PermissionEvaluator?.HasPermission(_currentUser, required)
            ?? HasPermissionFallback(_currentUser, required);
    }

    // 독립 Web.Components 호스트용 폴백. NexaOne.Server에서는 IMetaPermissionEvaluator가
    // NexaOne.Common.ClaimsPrincipalExtensions를 호출하므로 서버 PEP가 단일 권위다.
    private static bool HasPermissionFallback(ClaimsPrincipal user, string requiredPermission)
    {
        var granted = user.FindAll("permission").Select(claim => claim.Value).ToArray();
        if (granted.Any(value => value == "*"
            || string.Equals(value, requiredPermission, StringComparison.OrdinalIgnoreCase)))
            return true;

        const string readSuffix = ":read";
        if (!requiredPermission.EndsWith(readSuffix, StringComparison.OrdinalIgnoreCase)) return false;
        var module = requiredPermission[..^readSuffix.Length];
        return granted.Any(value => string.Equals(
            value,
            $"{module}:manage",
            StringComparison.OrdinalIgnoreCase));
    }

    private readonly record struct BindingAccessDecision(bool Allowed, string? DeniedReason)
    {
        public static BindingAccessDecision AllowedAccess { get; } = new(true, null);
        public static BindingAccessDecision Denied(string reason) => new(false, reason);
    }

    /// <summary>
    /// 명시 권한과 서버 카탈로그 권한을 함께 적용합니다. 카탈로그가 아는 binding은 그 권한도 반드시
    /// 만족해야 하며, 알 수 없는 binding은 명시 권한이 있을 때만 사용자 정의 확장으로 허용합니다.
    /// </summary>
    private BindingAccessDecision GetBindingAccess(
        string? bindingId,
        string? declaredPermission,
        bool isWrite)
    {
        var declared = string.IsNullOrWhiteSpace(declaredPermission) ? null : declaredPermission.Trim();
        if (declared is not null && !HasRequiredPermission(declared))
            return BindingAccessDecision.Denied(PermissionDeniedReason(declared));

        if (string.IsNullOrWhiteSpace(bindingId)) return BindingAccessDecision.AllowedAccess;

        var catalog = PermissionCatalog;
        if (catalog is null)
            return BindingAccessDecision.AllowedAccess; // 재사용 호스트: 기존 명시 metadata 동작 유지

        var id = bindingId.Trim();
        var resolved = isWrite ? catalog.ResolveWrite(id) : catalog.ResolveRead(id);
        if (!resolved.IsKnown)
        {
            return declared is not null
                ? BindingAccessDecision.AllowedAccess
                : BindingAccessDecision.Denied(string.Format(
                    T("common.unknownPermissionBinding", "권한 카탈로그에 등록되지 않은 바인딩입니다: {0}"), id));
        }

        var catalogPermission = resolved.RequiredPermission;
        return string.IsNullOrWhiteSpace(catalogPermission) || HasRequiredPermission(catalogPermission)
            ? BindingAccessDecision.AllowedAccess
            : BindingAccessDecision.Denied(PermissionDeniedReason(catalogPermission));
    }

    private BindingAccessDecision GetNodeAccess(LayoutNode node) => node switch
    {
        GridWidget grid => GetBindingAccess(grid.QueryId, grid.RequiredPermission, isWrite: false),
        KpiWidget kpi => GetBindingAccess(kpi.QueryId, kpi.RequiredPermission, isWrite: false),
        BadgeWidget badge => GetBindingAccess(badge.QueryId, badge.RequiredPermission, isWrite: false),
        TrendChartWidget trend => GetBindingAccess(trend.QueryId, trend.RequiredPermission, isWrite: false),
        FieldWidget field => GetBindingAccess(
            field.Field?.OptionsQueryId,
            field.RequiredPermission,
            isWrite: false),
        FormWidget form => GetBindingAccess(form.SaveQueryId, form.RequiredPermission, isWrite: true),
        ButtonWidget button => GetBindingAccess(button.Command, button.RequiredPermission, isWrite: true),
        _ => GetBindingAccess(null, node.RequiredPermission, isWrite: false),
    };

    private bool CanAccessNode(LayoutNode node) => GetNodeAccess(node).Allowed;

    private string? NodeAccessDeniedReason(LayoutNode node) => GetNodeAccess(node).DeniedReason;

    private string PermissionDeniedReason(string? permission)
        => string.IsNullOrWhiteSpace(permission)
            ? T("common.permissionDenied", "이 작업을 실행할 권한이 없습니다.")
            : string.Format(T("common.permissionRequired", "필요 권한이 없습니다: {0}"), permission.Trim());

    private static string ActionAriaLabel(string label, string? disabledReason)
        => disabledReason is null ? label : $"{label} — {disabledReason}";

    private static IReadOnlyList<string> NonBlankPermissions(params string?[] permissions)
        => permissions.Where(permission => !string.IsNullOrWhiteSpace(permission))
            .Select(permission => permission!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static IReadOnlyList<string> PermissionPathTo(LayoutNode root, LayoutNode target)
    {
        var permissions = new List<string>();
        return Find(root) ? permissions.Distinct(StringComparer.OrdinalIgnoreCase).ToArray() : Array.Empty<string>();

        bool Find(LayoutNode node)
        {
            var count = permissions.Count;
            if (!string.IsNullOrWhiteSpace(node.RequiredPermission))
                permissions.Add(node.RequiredPermission.Trim());
            if (ReferenceEquals(node, target)) return true;

            var children = node switch
            {
                SectionNode section => section.Children,
                RowNode row => row.Children,
                ColumnNode column => column.Children,
                _ => null,
            };
            if (children is not null && children.Any(Find)) return true;
            permissions.RemoveRange(count, permissions.Count - count);
            return false;
        }
    }
