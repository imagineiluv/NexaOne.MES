@page "/meta/{UiId}"
@attribute [Authorize]
@implements IDisposable
@inject IScreenDefinitionProvider Definitions
@inject IApiClient Api
@inject IServiceProvider Services

@* Phase 3 — 메타데이터 주도 화면: 정적 @@page 컴파일 화면이 아니라 UiId로 ScreenDefinition을 해석해 동적 렌더. *@
<div class="page-header">
    @* 다국어(P3-14 v2) — 화면 제목은 screen.{UiId}.title 리소스, 미존재=정의 원문(한국어). *@
    <h1 class="page-title">@(_definition is null ? T("common.screenPending", "준비 중인 화면") : T($"screen.{_definition.UiId}.title", _definition.Title))</h1>
    @if (_definition is not null)
    {
        @* 수동 새로고침 — 자동 새로고침(RefreshIntervalSeconds) 없는 화면에서도 재조회할 수 있게 한다.
           데이터만 재조회(ReloadDataAsync)하므로 폼 입력 상태는 보존된다. *@
        <RadzenButton Click="ManualRefreshAsync" Disabled="@_refreshing" class="meta-refresh"
                      ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small">
            @if (_refreshing) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="refresh" /> }
            @(_refreshing ? T("common.refreshing", "새로고침 중…") : T("common.refresh", "새로고침"))
        </RadzenButton>
    }
</div>

@* 검색 조건 영역(SearchFields) — 레거시 SmartUX 표준 패턴(상단 조건+조회). §20.8 조건 저장/불러오기 통합:
   조회 시 '$latest' 자동 저장, 재진입 시 복원. 저장 조건 선택은 즉시 조회. *@
@if (_definition?.SearchFields is { Count: > 0 } && _searchDefinition is not null)
{
    <div class="mes-card meta-search">
        <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
            <MetaFormRenderer Definition="_searchDefinition" @bind-Model="_searchModel" />
        </CascadingValue>
        <div class="meta-search-actions">
            <RadzenButton Icon="search" Text="@T("common.search", "조회")" Click="RunSearchAsync" Disabled="@_refreshing"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small" class="layout-command" />
            <select class="meta-cond-select" @onchange="OnSavedConditionSelected">
                <option value="" selected="@(_selectedCondition.Length == 0)">@T("common.condSaved", "저장된 조건…")</option>
                @foreach (var c in _savedConditions)
                {
                    <option value="@c.Name" selected="@(c.Name == _selectedCondition)">@c.Name</option>
                }
            </select>
            @if (_selectedCondition.Length > 0)
            {
                <RadzenButton Icon="delete" Text="@T("common.condDelete", "조건 삭제")" Click="DeleteSelectedConditionAsync"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            }
            <input class="meta-cond-name" placeholder="@T("common.condName", "조건명")" @bind="_conditionName" />
            <RadzenButton Icon="bookmark_add" Text="@T("common.condSave", "조건 저장")" Click="SaveCurrentConditionAsync"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
        </div>
    </div>
}

@if (_definition is null)
{
    @* SmartUX 메뉴에는 있으나 아직 새 시스템에 이식되지 않은 화면 — 오류가 아니라 '준비 중' 안내로 보여준다.
       (모듈 백엔드 마이그레이션 순서에 따라 ScreenDefinition이 채워지면 자동으로 실제 화면이 렌더된다) *@
    <div class="mes-empty-state">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8M12 18v3"/>
        </svg>
        <p class="es-title">@T("common.notMigratedTitle", "이 화면은 아직 마이그레이션되지 않았습니다.")</p>
        <p class="es-sub">
            @T("common.notMigratedId", "SmartUX 메뉴에서 이전된 화면 식별자:") <code>@UiId</code><br />
            @T("common.notMigratedHint", "해당 업무 화면은 모듈 백엔드 마이그레이션 순서에 따라 순차 제공됩니다.")
        </p>
    </div>
}
else if (_definition.Layout is not null)
{
    @* 레이아웃 트리 화면 — 멀티 read 결과맵을 내려보내고, 명령/검증은 MetaScreen이 오케스트레이션한다.
       격리 폼(Isolated, Phase-2 멀티폼)은 폼별 모델(_formModels)에 바인딩된다. *@
    <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
        <CascadingValue Value="_fieldErrors" Name="MetaFieldErrors">
            <LayoutRenderer Node="_definition.Layout" @bind-Model="_model" ScreenKey="@UiId"
                            QueryResults="_queryResults" OnCommand="RunCommand"
                            FormModels="_formModels" OnFormModelChanged="OnFormModelChanged"
                            OnRowSelect="_rowSelect" LoadingData="_loadingData"
                            CanAdd="CanAddNew" OnAddNew="OnAddNewRequested"
                            CanDelete="@(_definition.DeleteQueryId is { Length: > 0 })" OnDeleteRows="OnDeleteRowsAsync" />
        </CascadingValue>
    </CascadingValue>

    @if (_errors.Count > 0)
    {
        <ul class="validation-errors">
            @foreach (var err in _errors) { <li>@err</li> }
        </ul>
    }

    @* 명령 버튼으로 커버되지 않은 폼 저장쿼리에 대해 암시적 저장 버튼을 렌더한다.
       (손코딩 save-less 레이아웃 보완 — 이미 버튼이 있으면 중복 생성하지 않는다) *@
    @foreach (var saveQuery in _uncoveredSaveQueries)
    {
        <div class="meta-actions">
            <RadzenButton Click="() => RunCommand(saveQuery)" class="layout-save"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                <RadzenIcon Icon="save" />
                @(_uncoveredSaveQueries.Count > 1 ? $"{T("common.save", "저장")}: {saveQuery}" : T("common.save", "저장"))
            </RadzenButton>
        </div>
    }

    @if (_saved) { <span class="save-ok">@T("common.savedMark", "저장됨")</span> }
}
else
{
    @* 폼(입력 필드)이 정의된 화면만 폼·저장 영역을 렌더한다 — 그리드 전용(조회) 화면은 폼이 비어 있을 수 있다. *@
    @if (_definition.Fields.Count > 0)
    {
        @* 폼 카드화(디자인 배치 3) — 그리드(목록 카드)와 동일한 카드 언어로 감싸 마스터-디테일 시각 분리.
           저장은 카드 푸터에 우측 정렬(주 행동의 자리를 고정). *@
        <div class="mes-card meta-form-card">
            <div class="mes-card-head"><span class="h-title">@T("common.detail", "상세 정보")</span></div>
            <div class="mes-card-body">
                <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
                    <CascadingValue Value="_fieldErrors" Name="MetaFieldErrors">
                        <MetaFormRenderer Definition="_definition" @bind-Model="_model" />
                    </CascadingValue>
                </CascadingValue>

                @if (_errors.Count > 0)
                {
                    <ul class="validation-errors">
                        @foreach (var err in _errors) { <li>@err</li> }
                    </ul>
                }
            </div>
            <div class="meta-form-foot">
                @if (_saved) { <span class="save-ok">@T("common.savedMark", "저장됨")</span> }
                <RadzenButton Click="Save" Disabled="@_saving" class="layout-save"
                              ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                    @if (_saving) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="save" /> }
                    @(_saving ? T("common.saving", "저장 중…") : T("common.save", "저장"))
                </RadzenButton>
            </div>
        </div>
    }

    @* 그리드(컬럼) 메타가 있으면 명명 쿼리 결과를 런타임 렌더한다 — 손코딩 없이 메타+파일쿼리로 조회 화면 구성.
       SmartUX 레퍼런스의 '리스트 카드'(헤더+그리드) 형태로 감싼다. *@
    @if (_definition.Columns is { Count: > 0 })
    {
        var serverPaged = !string.IsNullOrWhiteSpace(_definition.CountQueryId);
        var resultCount = serverPaged ? _serverTotal : _rows?.Count ?? 0;
        <div class="mes-card">
            <div class="mes-card-head">
                <span class="h-title">@T("common.list", "목록")</span>
                <span class="h-right">@T("common.searchResult", "검색 결과")@(resultCount > 0 ? $" ({resultCount})" : "")</span>
            </div>
            <div class="mes-card-body">
                <MetaGridRenderer Columns="_definition.Columns" Rows="_rows"
                                  Loading="_loadingData" OnRowSelect="_rowSelect" ScreenKey="@UiId"
                                  CanAdd="CanAddNew" OnAddNew="OnAddNewRequested"
                                  CanDelete="@(_definition.DeleteQueryId is { Length: > 0 })" OnDeleteRows="OnDeleteRowsAsync"
                                  ServerTotal="serverPaged ? _serverTotal : (int?)null"
                                  ServerPage="_serverPage" OnServerPageChange="OnServerPageChangeAsync" />
            </div>
        </div>
    }
}

@* 신규 등록 모달(그리드 '추가' 팝업) — 화면 폼과 독립된 모델(_addModel). 백드롭/×/취소=닫기, 저장=검증→커맨드→재조회. *@
@if (_addOpen && _addFormDef is not null)
{
    <div class="nx-modal-backdrop" @onclick="() => _addOpen = false"></div>
    <div class="nx-modal" role="dialog" aria-modal="true" aria-label="@T("common.addTitle", "신규 등록")">
        <div class="mes-card-head">
            <span class="h-title">@T("common.addTitle", "신규 등록")</span>
            <button class="nx-modal-close" title="@T("common.close", "닫기")" @onclick="() => _addOpen = false">×</button>
        </div>
        <div class="nx-modal-body">
            <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
                <CascadingValue Value="_addFieldErrors" Name="MetaFieldErrors">
                    <MetaFormRenderer Definition="_addFormDef" @bind-Model="_addModel" />
                </CascadingValue>
            </CascadingValue>
            @if (_addErrors.Count > 0)
            {
                <ul class="validation-errors">
                    @foreach (var err in _addErrors) { <li>@err</li> }
                </ul>
            }
        </div>
        <div class="meta-form-foot">
            <RadzenButton Text="@T("common.cancel", "취소")" Click="() => _addOpen = false"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            <RadzenButton Click="SaveAddAsync" Disabled="@_addSaving" class="layout-save nx-modal-save"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                @if (_addSaving) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="save" /> }
                @(_addSaving ? T("common.saving", "저장 중…") : T("common.save", "저장"))
            </RadzenButton>
        </div>
    </div>
}

@code {
    [Parameter] public string UiId { get; set; } = string.Empty;

    private ScreenDefinition? _definition;
    private Dictionary<string, object?> _model = new();
    private List<string> _errors = new();
    private IReadOnlyList<Dictionary<string, object?>>? _rows;   // 그리드 데이터(명명 쿼리 결과); null=미실행
    // 레이아웃 화면의 위젯별 read 결과(queryId→행). 평면 경로는 _rows를 쓴다.
    private IReadOnlyDictionary<string, IReadOnlyList<Dictionary<string, object?>>> _queryResults
        = new Dictionary<string, IReadOnlyList<Dictionary<string, object?>>>();
    private bool _saving;
    private bool _saved;

    // 다국어(P3-14) — 호스트 DI(UiTextService)가 있으면 번역, 없으면(테스트 등) 한국어 폴백.
    // 셸의 리소스 로드가 본문 첫 렌더보다 늦을 수 있어 Changed를 구독해 로드/전환 시 리렌더한다
    // (부모 리렌더가 자식 렌더러들도 갱신하므로 구독은 MetaScreen 한 곳이면 충분).
    private NexaOne.Web.Services.UiTextService? _uiTextResolved;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiTextResolved = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
            if (_uiTextResolved is not null) _uiTextResolved.Changed += OnUiTextChanged;
        }
        return _uiTextResolved?.T(key, fallback) ?? fallback;
    }

    private void OnUiTextChanged() => _ = InvokeAsync(StateHasChanged);
    // 레이아웃 트리에서 명령 버튼으로 커버되지 않은 폼 저장쿼리 — 암시적 저장 버튼 대상(공백/중복 제외).
    private IReadOnlyList<string> _uncoveredSaveQueries = Array.Empty<string>();
    // Phase-2 멀티폼 — 격리 폼(Isolated)의 스코프 키→폼별 모델. 로드 시 트리를 훑어 사전 시드한다
    // (렌더 중 생성하면 매 렌더 새 인스턴스가 되어 입력이 소실된다).
    private Dictionary<string, Dictionary<string, object?>> _formModels = new(StringComparer.Ordinal);
    // 스코프 키→격리 FormWidget — 명령 라우팅(SaveQueryId 매칭)·폼별 검증에 쓴다.
    private Dictionary<string, FormWidget> _isolatedForms = new(StringComparer.Ordinal);
    // 자동 새로고침(Phase-2 실시간 v2) 루프 취소 토큰 — 화면 이탈/정의 재로드 시 이전 루프를 반드시 끊는다.
    private CancellationTokenSource? _refreshCts;
    // 실시간 v3 — 이벤트 푸시 구독 핸들(화면 이탈/재로드 시 해지)과 스로틀 기준 시각.
    private IDisposable? _pushSubscription;
    private DateTime _lastPushRefresh;

    protected override async Task OnParametersSetAsync()
    {
        // 인메모리 캐시 우선, 없으면 DB 저장소(SYS_SCREEN_DEFINITION)에서 로드해 캐시 등록(Phase 4 후속)
        _definition = await Definitions.GetAsync(UiId);
        if (_definition is null)
        {
            var record = await Api.GetScreenDefinitionAsync(UiId);
            if (record is not null)
            {
                _definition = ScreenDefinitionJson.Deserialize(record.DefinitionJson);
                if (_definition is not null) Definitions.Register(_definition);
            }
        }

        // 동적 Select 옵션(OptionsQueryId) — 정의 로드 시 1회 조회(마스터 목록은 화면 수명 동안 안정).
        _dynamicOptions = await LoadDynamicOptionsAsync();

        // 그리드 '추가' 팝업 폼 구성 — 필드+저장쿼리가 있는 화면만(조회 전용은 추가 버튼 미노출).
        BuildAddForm();

        // 검색 조건 초기화(§20.8) — 저장 조건 목록과 '$latest'(마지막 조회 조건)를 복원한 뒤 조회한다.
        _searchModel = new(StringComparer.Ordinal);
        _searchDefinition = null;
        _savedConditions = new();
        _selectedCondition = string.Empty;
        _conditionName = string.Empty;
        if (_definition?.SearchFields is { Count: > 0 } sf)
        {
            _searchDefinition = new ScreenDefinition(string.Empty, string.Empty, sf);
            var setting = await Api.GetConditionSettingsAsync(UiId);
            if (setting is not null)
            {
                _savedConditions = setting.Items ?? new();
                if (setting.Latest is not null) ApplyConditionValues(setting.Latest.Values);
            }
        }

        // P1-1 — 폼 필드가 있는 화면만 그리드 행 선택(클릭=폼 로드)을 켠다(조회 전용 화면은 선택 불가).
        var hasFormFields = _definition is not null &&
            (_definition.Layout is not null ? CollectFields(_definition.Layout).Any() : _definition.Fields.Count > 0);
        _rowSelect = hasFormFields
            ? EventCallback.Factory.Create<Dictionary<string, object?>>(this, OnRowSelectedAsync)
            : default;

        // 데이터(그리드 행 + 레이아웃 결과맵) 조회 — 자동 새로고침과 공유하는 단일 경로.
        _serverPage = 0;   // 화면 전환 시 서버 페이징 상태 초기화(P3-9 v2)
        _serverTotal = 0;
        await ReloadDataAsync();

        // 레이아웃 화면: 저장 버튼/멀티폼 인덱스는 정의 로드 시 1회만 구성한다(새로고침이 폼 상태를 건드리지 않게).
        _uncoveredSaveQueries = Array.Empty<string>();
        _formModels = new(StringComparer.Ordinal);
        _isolatedForms = new(StringComparer.Ordinal);
        if (_definition?.Layout is not null)
        {
            // 명령 버튼이 커버하지 않는 폼 저장쿼리만 추려 암시적 저장 버튼을 렌더한다(중복 방지).
            var covered = new HashSet<string>(CollectButtonCommands(_definition.Layout), StringComparer.Ordinal);
            _uncoveredSaveQueries = CollectFormSaveQueries(_definition.Layout)
                .Where(q => !covered.Contains(q))
                .Distinct(StringComparer.Ordinal)
                .ToList();

            // Phase-2 멀티폼 — 격리 폼의 폼별 모델을 사전 시드(안정 인스턴스)하고 라우팅 인덱스를 만든다.
            foreach (var form in CollectForms(_definition.Layout).Where(f => f.Isolated))
            {
                var key = LayoutRenderer.FormScopeKey(form);
                if (key is null || _isolatedForms.ContainsKey(key)) continue;   // 키 없음=공유 저하, 중복 키=첫 폼 우선
                _isolatedForms[key] = form;
                _formModels[key] = new Dictionary<string, object?>();
            }
        }

        // 자동 새로고침(Phase-2 실시간 v2) — 정의의 RefreshIntervalSeconds>0면 주기 재조회(데이터만, 폼 상태 보존).
        // 실시간 v3 — 라이브 화면은 도메인 이벤트 푸시(IScreenRefreshNotifier)도 구독해 폴링 주기를 기다리지 않고
        // 즉시 재조회한다(1초 스로틀). 알림 포트 미등록 환경(테스트·modules OFF)은 폴링만 동작.
        _refreshCts?.Cancel();
        _refreshCts = null;
        _pushSubscription?.Dispose();
        _pushSubscription = null;
        if (_definition?.RefreshIntervalSeconds is int interval && interval > 0)
        {
            var cts = new CancellationTokenSource();
            _refreshCts = cts;
            _ = AutoRefreshLoopAsync(interval, cts.Token);
            _pushSubscription = (Services.GetService(typeof(IScreenRefreshNotifier)) as IScreenRefreshNotifier)
                ?.Subscribe(OnPushChangedAsync);
        }
    }

    // 동적 Select 옵션(필드 Key → 옵션 목록). 규약: OptionsQueryId 결과의 첫 컬럼=값, 둘째 컬럼=라벨 보조.
    private Dictionary<string, IReadOnlyList<MetaFieldOption>> _dynamicOptions = new(StringComparer.Ordinal);

    private async Task<Dictionary<string, IReadOnlyList<MetaFieldOption>>> LoadDynamicOptionsAsync()
    {
        var result = new Dictionary<string, IReadOnlyList<MetaFieldOption>>(StringComparer.Ordinal);
        if (_definition is null) return result;
        var fields = (_definition.Layout is not null
                ? CollectFields(_definition.Layout)
                : _definition.Fields.AsEnumerable())
            .Concat(_definition.SearchFields ?? Enumerable.Empty<FieldDefinition>());
        foreach (var field in fields.Where(f => !string.IsNullOrWhiteSpace(f.OptionsQueryId)))
        {
            if (result.ContainsKey(field.Key)) continue;   // 같은 Key 중복 정의는 첫 필드 우선
            var rows = await Api.ExecuteQueryAsync(field.OptionsQueryId!);
            var opts = new List<MetaFieldOption>();
            foreach (var row in rows)
            {
                var vals = row.Values.ToList();   // JSON 객체 순서 = SELECT 컬럼 순서
                var value = vals.Count > 0 ? vals[0]?.ToString() ?? "" : "";
                if (value.Length == 0) continue;
                var second = vals.Count > 1 ? vals[1]?.ToString() : null;
                opts.Add(new MetaFieldOption(value,
                    string.IsNullOrWhiteSpace(second) || second == value ? value : $"{value} — {second}"));
            }
            result[field.Key] = opts;
        }
        return result;
    }

    // 수동 새로고침 — 헤더 버튼. 진행 중 중복 클릭은 무시한다.
    private bool _refreshing;
    private async Task ManualRefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try { await ReloadDataAsync(); }
        finally { _refreshing = false; }
    }

    // ── 검색 조건(SearchFields) + §20.8 조건 저장/불러오기 ────────────────────
    private Dictionary<string, object?> _searchModel = new(StringComparer.Ordinal);
    private ScreenDefinition? _searchDefinition;     // SearchFields를 MetaFormRenderer로 렌더하기 위한 래퍼
    private List<ConditionItemDto> _savedConditions = new();
    private string _conditionName = string.Empty;
    private string _selectedCondition = string.Empty;

    // 비어있지 않은 조건 값만 파라미터로 보낸다 — 빈 값은 미전송(게이트웨이가 DBNull 보충 → NULL-가드 전체 조회).
    private Dictionary<string, object?>? BuildSearchParameters()
    {
        if (_definition?.SearchFields is not { Count: > 0 }) return null;
        var p = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in _searchModel)
            if (!string.IsNullOrWhiteSpace(v?.ToString())) p[k] = v;
        return p;
    }

    private async Task RunSearchAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            // 마지막 조회 조건($latest) 자동 저장 — 다음 진입 시 복원(§20.8). 저장 실패해도 조회는 진행.
            await Api.SaveLatestConditionAsync(UiId, ToConditionValues());
            _serverPage = 0;   // 조건 변경 = 첫 페이지부터(P3-9 v2)
            await ReloadDataAsync();
        }
        finally { _refreshing = false; }
    }

    private Dictionary<string, string?> ToConditionValues()
    {
        var values = new Dictionary<string, string?>(StringComparer.Ordinal);
        foreach (var f in _definition?.SearchFields ?? Array.Empty<FieldDefinition>())
            values[f.Key] = _searchModel.TryGetValue(f.Key, out var v) ? v?.ToString() : null;
        return values;
    }

    private void ApplyConditionValues(Dictionary<string, string?> values)
    {
        foreach (var (k, v) in values)
            _searchModel[k] = v;
    }

    private async Task SaveCurrentConditionAsync()
    {
        var name = _conditionName.Trim();
        if (name.Length == 0) return;
        var saved = await Api.SaveConditionAsync(UiId, name, ToConditionValues());
        if (saved is not null)
        {
            _conditionName = string.Empty;
            await ReloadSavedConditionsAsync();
            _selectedCondition = name;
        }
    }

    private async Task ReloadSavedConditionsAsync()
    {
        var setting = await Api.GetConditionSettingsAsync(UiId);
        _savedConditions = setting?.Items ?? new();
    }

    // 저장 조건 선택 → 값 적용 후 즉시 조회(레거시 SmartUX 동작 미러).
    private async Task OnSavedConditionSelected(ChangeEventArgs e)
    {
        _selectedCondition = e.Value?.ToString() ?? string.Empty;
        var item = _savedConditions.FirstOrDefault(c => c.Name == _selectedCondition);
        if (item is null) return;
        ApplyConditionValues(item.Values);
        await RunSearchAsync();
    }

    private async Task DeleteSelectedConditionAsync()
    {
        if (_selectedCondition.Length == 0) return;
        if (await Api.DeleteConditionAsync(UiId, _selectedCondition))
        {
            _selectedCondition = string.Empty;
            await ReloadSavedConditionsAsync();
        }
    }

    // 이벤트 푸시 재조회 — 버스 스레드에서 호출되므로 렌더 갱신은 InvokeAsync로 회로 컨텍스트에 태운다.
    private async Task OnPushChangedAsync()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastPushRefresh).TotalMilliseconds < 1000) return;   // 이벤트 폭주 스로틀(1초)
        _lastPushRefresh = now;
        try
        {
            await InvokeAsync(async () =>
            {
                await ReloadDataAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* 회로 폐기 경합 — 구독 해지 직전 이벤트, 무시 */ }
        catch (InvalidOperationException) { /* 회로 미부착 상태 — 무시 */ }
    }

    // 데이터 재조회(그리드 행 + 레이아웃 위젯 결과맵) — 초기 로드와 자동 새로고침이 공유한다.
    // 검색 조건(SearchFields)이 있으면 값을 모든 읽기쿼리에 바인딩한다 — SQL이 선언하지 않은 파라미터는
    // 게이트웨이가 무시하므로 화면 내 여러 쿼리에 같은 조건 딕셔너리를 안전하게 공유한다.
    // (403/5xx는 ApiClient가 빈 목록으로 흡수하고 전역 토스트가 사유를 알린다)
    private bool _loadingData;   // P1-3 — 그리드 '조회 중…' 표시

    // ── 서버측 페이징(P3-9 v2, CountQueryId 화면) ────────────────────────────
    private int _serverPage;
    private int _serverTotal;

    private async Task OnServerPageChangeAsync(int page)
    {
        if (page < 0 || page == _serverPage) return;
        _serverPage = page;
        await ReloadDataAsync();
    }

    // 총건수 조회 — count 쿼리(단일 행 첫 컬럼)를 본 쿼리와 같은 검색 조건으로 실행한다.
    private async Task<int> FetchCountAsync(string countQueryId, Dictionary<string, object?>? search)
    {
        var rows = await Api.ExecuteQueryAsync(countQueryId, search);
        var first = rows.FirstOrDefault()?.Values.FirstOrDefault();
        return first switch
        {
            int i => i,
            long l => (int)l,
            _ => int.TryParse(first?.ToString(), out var p) ? p : 0,
        };
    }

    private async Task ReloadDataAsync()
    {
        _loadingData = true;
        try
        {
            var search = BuildSearchParameters();
            _rows = null;
            if (_definition?.Columns is { Count: > 0 } && !string.IsNullOrWhiteSpace(_definition.QueryId))
            {
                if (_definition.CountQueryId is { Length: > 0 } countQueryId)
                {
                    // 서버측 페이징 — @limit/@offset을 검색 조건에 얹어 조회하고 총건수를 병행 조회한다.
                    _serverTotal = await FetchCountAsync(countQueryId, search);
                    var maxPage = _serverTotal > 0 ? (_serverTotal - 1) / MetaGridRenderer.PageSize : 0;
                    if (_serverPage > maxPage) _serverPage = maxPage;   // 조건 변경/삭제로 범위 밖이면 마지막 페이지로
                    var paged = search is null
                        ? new Dictionary<string, object?>(StringComparer.Ordinal)
                        : new Dictionary<string, object?>(search, StringComparer.Ordinal);
                    paged["limit"] = MetaGridRenderer.PageSize;
                    paged["offset"] = _serverPage * MetaGridRenderer.PageSize;
                    _rows = await Api.ExecuteQueryAsync(_definition.QueryId, paged);
                }
                else
                {
                    _rows = await Api.ExecuteQueryAsync(_definition.QueryId, search);
                }
            }

            if (_definition?.Layout is not null)
            {
                var map = new Dictionary<string, IReadOnlyList<Dictionary<string, object?>>>(StringComparer.Ordinal);
                foreach (var queryId in CollectQueryIds(_definition.Layout))
                    if (!map.ContainsKey(queryId))
                        map[queryId] = await Api.ExecuteQueryAsync(queryId, search);
                _queryResults = map;
            }
        }
        finally
        {
            _loadingData = false;
        }
    }

    // ── 그리드 표준 CRUD(추가/삭제) — 툴바 버튼은 그리드가, 실행·확인·재조회는 여기가 소유 ──────

    // ── 추가 = 팝업 등록 폼(사용자 요청) — 화면 폼과 독립된 모델로 신규 행을 입력·저장한다. ──────
    private bool _addOpen;
    private bool _addSaving;
    private Dictionary<string, object?> _addModel = new();
    private Dictionary<string, string> _addFieldErrors = new(StringComparer.Ordinal);
    private List<string> _addErrors = new();
    private ScreenDefinition? _addFormDef;     // 팝업 폼 정의 — 평면=필드 그대로, 레이아웃=트리 필드 수집 래퍼.
    private string? _addSaveQueryId;

    private bool CanAddNew => _addFormDef is not null;

    // 정의 로드 시 팝업 폼 구성(필드+저장쿼리). 조건 미충족(조회 전용)이면 추가 버튼 자체가 숨는다.
    private void BuildAddForm()
    {
        _addFormDef = null; _addSaveQueryId = null; _addOpen = false;
        if (_definition is null) return;
        if (_definition.Layout is null)
        {
            if (_definition.Fields.Count > 0 && !string.IsNullOrWhiteSpace(_definition.SaveQueryId))
            {
                _addFormDef = new ScreenDefinition(string.Empty, string.Empty, _definition.Fields);
                _addSaveQueryId = _definition.SaveQueryId;
            }
            return;
        }
        var fields = CollectFields(_definition.Layout).Where(f => f.Key.Length > 0).ToList();
        var save = CollectFormSaveQueries(_definition.Layout).FirstOrDefault();
        if (fields.Count > 0 && save is not null)
        {
            _addFormDef = new ScreenDefinition(string.Empty, string.Empty, fields);
            _addSaveQueryId = save;
        }
    }

    private void OnAddNewRequested()
    {
        _addModel = new Dictionary<string, object?>();
        _addFieldErrors = new(StringComparer.Ordinal);
        _addErrors = new();
        _addSaving = false;
        _addOpen = true;
    }

    private async Task SaveAddAsync()
    {
        if (_addFormDef is null || _addSaveQueryId is null) return;
        _addErrors = new();
        _addFieldErrors = ValidateFields(_addFormDef.Fields, _addModel);
        if (_addFieldErrors.Count > 0) return;
        _addSaving = true;
        try
        {
            if (await Api.ExecuteCommandAsync(_addSaveQueryId, _addModel))
            {
                _addOpen = false;
                await ReloadDataAsync();   // 신규 행을 그리드에 즉시 반영
            }
            else
            {
                _addErrors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
            }
        }
        finally { _addSaving = false; }
    }

    // 삭제 — 확인 다이얼로그(비블로킹 모달) 후 선택 행마다 DeleteQueryId 커맨드 실행, 완료 시 재조회.
    // 파라미터는 행 원본 키(UPPER_SNAKE) + camelCase 사본을 병행 전송 — 쿼리 @param(@plantId 등)이
    // 어느 관례든 자동 매칭된다(선언 안 된 파라미터는 게이트웨이/디스패처가 무시).
    private async Task OnDeleteRowsAsync(List<Dictionary<string, object?>> rows)
    {
        if (_definition?.DeleteQueryId is not { Length: > 0 } deleteQueryId || rows.Count == 0) return;

        // DialogService는 호스트 DI(테스트 등 미등록 환경은 확인 생략 — 서버 권한이 최종 게이트).
        var dialogs = Services.GetService(typeof(Radzen.DialogService)) as Radzen.DialogService;
        if (dialogs is not null)
        {
            var msg = string.Format(T("common.deleteConfirm", "선택한 {0}건을 삭제하시겠습니까? 되돌릴 수 없습니다."), rows.Count);
            var ok = await dialogs.Confirm(msg, T("common.deleteConfirmTitle", "삭제 확인"),
                new Radzen.ConfirmOptions { OkButtonText = T("common.delete", "삭제"), CancelButtonText = T("common.cancel", "취소") });
            if (ok != true) return;
        }

        var deleted = 0;
        foreach (var row in rows)
            if (await Api.ExecuteCommandAsync(deleteQueryId, BuildDeleteParameters(row))) deleted++;
        if (deleted > 0) await ReloadDataAsync();   // 실패는 ApiClient 전역 토스트가 사유(403 등)를 알린다.
    }

    private static Dictionary<string, object?> BuildDeleteParameters(Dictionary<string, object?> row)
    {
        var p = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in row)
        {
            p[k] = v;
            p.TryAdd(CamelizeKey(k), v);   // PLANT_ID → plantId(쿼리 파라미터 관례)
        }
        return p;
    }

    // UPPER_SNAKE → camelCase(VENDOR_ITEM_ID → vendorItemId). 구분자 없는 키는 소문자 시작만 보정.
    internal static string CamelizeKey(string key)
    {
        var parts = key.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return key;
        var head = parts[0].ToLowerInvariant();
        var tail = string.Concat(parts.Skip(1).Select(s =>
            char.ToUpperInvariant(s[0]) + (s.Length > 1 ? s[1..].ToLowerInvariant() : "")));
        return head + tail;
    }

    // ── P1-1 그리드 행 선택 → 폼 로드(레거시 표준 편집 흐름) ────────────────────
    // 컬럼 키(UPPER_SNAKE)와 필드 키(camel)는 구분자 제거·소문자 정규화로 매칭한다(BATCH_ID ↔ batchId).
    // 행 딕셔너리의 모든 컬럼(표시 안 되는 컬럼 포함)을 대상으로 하며, 격리 폼은 폼별 모델에 반영한다.
    private EventCallback<Dictionary<string, object?>> _rowSelect;

    private Task OnRowSelectedAsync(Dictionary<string, object?> row)
    {
        if (_definition is null) return Task.CompletedTask;
        var byNorm = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in row) byNorm[NormalizeRowKey(k)] = v;

        void Apply(IEnumerable<FieldDefinition> fields, Dictionary<string, object?> model)
        {
            foreach (var f in fields)
                if (byNorm.TryGetValue(NormalizeRowKey(f.Key), out var v))
                    model[f.Key] = CoerceForField(f, v);
        }

        if (_definition.Layout is not null)
        {
            Apply(CollectFields(_definition.Layout, skipIsolatedForms: true), _model);
            foreach (var (key, form) in _isolatedForms)
                if (_formModels.TryGetValue(key, out var m)) Apply(CollectFields(form), m);
        }
        else
        {
            Apply(_definition.Fields, _model);
        }
        return Task.CompletedTask;
    }

    private static string NormalizeRowKey(string key) => key.Replace("_", "").ToLowerInvariant();

    // Boolean 필드는 DB 표현(0/1·true) 정규화, 그 외는 입력 바인딩용 문자열.
    private static object? CoerceForField(FieldDefinition f, object? v)
        => f.Type == FieldType.Boolean
            ? v is bool b ? b : v?.ToString() is "1" or "true" or "True" or "TRUE"
            : v?.ToString();

    private async Task AutoRefreshLoopAsync(int intervalSeconds, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(2, intervalSeconds)));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await ReloadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* 화면 이탈/재로드 — 정상 종료 */ }
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts = null;
        _pushSubscription?.Dispose();
        _pushSubscription = null;
        if (_uiTextResolved is not null) _uiTextResolved.Changed -= OnUiTextChanged;
    }

    private void OnFormModelChanged((string Key, Dictionary<string, object?> Model) change)
        => _formModels[change.Key] = change.Model;

    private async Task Save()
    {
        _saved = false;
        _errors = new();
        _fieldErrors = Validate();
        if (_fieldErrors.Count > 0) return;

        // SaveQueryId(명명 쓰기쿼리)가 바인딩돼 있으면 폼 값(필드 Key→값)을 command 게이트웨이로 보내 저장한다.
        // 감사 컬럼(@currentUser/@utcNow)은 서버 게이트웨이가 토큰·UTC로 주입하므로 폼이 보낼 필요가 없다.
        if (string.IsNullOrWhiteSpace(_definition?.SaveQueryId))
        {
            _errors.Add(T("common.noSaveQuery", "이 화면에는 저장(쓰기) 쿼리가 바인딩돼 있지 않습니다."));
            return;
        }

        _saving = true;
        try
        {
            _saved = await Api.ExecuteCommandAsync(_definition.SaveQueryId, _model);
            if (!_saved) _errors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
            else await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영(리로드 없이 새 행 표시)
        }
        finally
        {
            _saving = false;
        }
    }

    // 공유 경로 검증 — 격리 폼(Isolated) 내부 필드는 제외한다(값이 폼별 모델에 있어 공유 모델 기준으론
    // 항상 미입력으로 오판된다). 격리 폼 검증은 RunCommand의 폼별 경로가 담당.
    // P2-7 — 검증 결과는 필드별 맵(_fieldErrors)으로 렌더러에 캐스케이드해 필드 아래 인라인 표시한다.
    private Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);

    private Dictionary<string, string> Validate()
    {
        if (_definition is null) return new(StringComparer.Ordinal);
        var fields = _definition.Layout is not null
            ? CollectFields(_definition.Layout, skipIsolatedForms: true)
            : _definition.Fields;
        return ValidateFields(fields, _model);
    }

    // 검증 메시지는 현재 언어의 템플릿({0}=필드 라벨)으로 조립한다(P3-14 v3, 클라이언트 대면 메시지 다국어).
    private Dictionary<string, string> ValidateFields(IEnumerable<FieldDefinition> fields, Dictionary<string, object?> model)
    {
        var template = T("common.requiredField", "{0}은(는) 필수입니다.");
        var errors = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var field in fields.Where(f => f.Required))
        {
            if (!model.TryGetValue(field.Key, out var v) || string.IsNullOrWhiteSpace(v?.ToString()))
                errors[field.Key] = string.Format(template, field.Label);
        }
        return errors;
    }

    // 레이아웃 명령 실행 — 커맨드가 격리 폼(Isolated)의 SaveQueryId면 그 폼의 모델·필드만으로 검증/전송하고
    // (Phase-2 멀티폼: 폼 간 값·검증이 섞이지 않는다), 그 외에는 기존대로 공유 Model을 쓴다(하위호환).
    private async Task RunCommand(string? command)
    {
        _saved = false;
        _errors = new();
        if (string.IsNullOrWhiteSpace(command)) return;

        var isolated = _isolatedForms.Values.FirstOrDefault(f =>
            string.Equals(f.SaveQueryId, command, StringComparison.Ordinal));
        if (isolated is not null && LayoutRenderer.FormScopeKey(isolated) is { } key)
        {
            var formModel = _formModels.TryGetValue(key, out var m) ? m : new Dictionary<string, object?>();
            _fieldErrors = ValidateFields(CollectFields(isolated), formModel);
            if (_fieldErrors.Count > 0) return;
            _saved = await Api.ExecuteCommandAsync(command, formModel);
            if (!_saved) _errors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
            else await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영
            return;
        }

        _fieldErrors = Validate();
        if (_fieldErrors.Count > 0) return;
        _saved = await Api.ExecuteCommandAsync(command, _model);
        if (!_saved) _errors.Add("저장에 실패했습니다(권한/입력 확인).");
        else await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영
    }

    // 트리에서 그리드 위젯의 distinct read 쿼리 id를 수집(빈/공백 제외).
    private static IEnumerable<string> CollectQueryIds(LayoutNode node)
    {
        switch (node)
        {
            case GridWidget g when !string.IsNullOrWhiteSpace(g.QueryId):
                yield return g.QueryId!;
                break;
            case KpiWidget k when !string.IsNullOrWhiteSpace(k.QueryId):
                yield return k.QueryId!;
                break;
            case BadgeWidget bw when !string.IsNullOrWhiteSpace(bw.QueryId):
                yield return bw.QueryId!;
                break;
            case TrendChartWidget tc when !string.IsNullOrWhiteSpace(tc.QueryId):
                yield return tc.QueryId!;
                break;
            case SectionNode s: foreach (var id in Children(s.Children)) yield return id; break;
            case RowNode r: foreach (var id in Children(r.Children)) yield return id; break;
            case ColumnNode c: foreach (var id in Children(c.Children)) yield return id; break;
        }
        static IEnumerable<string> Children(IReadOnlyList<LayoutNode>? children)
            => (children ?? Array.Empty<LayoutNode>()).SelectMany(CollectQueryIds);
    }

    // 트리에서 검증 대상 필드(FieldWidget)를 수집 — 검증의 단일 출처(평면 Fields 미러링 금지).
    // skipIsolatedForms=true면 격리 폼 내부 필드를 건너뛴다(공유 경로 검증용 — 값이 폼별 모델에 있음).
    private static IEnumerable<FieldDefinition> CollectFields(LayoutNode node, bool skipIsolatedForms = false)
    {
        switch (node)
        {
            case FieldWidget fw:
                yield return fw.Field ?? new FieldDefinition(fw.FieldKey ?? string.Empty, fw.FieldKey ?? string.Empty);
                break;
            case FormWidget f:
                if (skipIsolatedForms && f.Isolated) break;
                foreach (var child in f.Fields ?? Array.Empty<FieldWidget>())
                    foreach (var fd in CollectFields(child, skipIsolatedForms)) yield return fd;
                break;
            case SectionNode s: foreach (var fd in Children(s.Children)) yield return fd; break;
            case RowNode r: foreach (var fd in Children(r.Children)) yield return fd; break;
            case ColumnNode c: foreach (var fd in Children(c.Children)) yield return fd; break;
        }
        IEnumerable<FieldDefinition> Children(IReadOnlyList<LayoutNode>? children)
            => (children ?? Array.Empty<LayoutNode>()).SelectMany(n => CollectFields(n, skipIsolatedForms));
    }

    // 트리에서 FormWidget 전체를 수집 — 격리 폼 모델 시드/명령 라우팅 인덱스용.
    private static IEnumerable<FormWidget> CollectForms(LayoutNode node)
    {
        switch (node)
        {
            case FormWidget f: yield return f; break;
            case SectionNode s: foreach (var x in Children(s.Children)) yield return x; break;
            case RowNode r: foreach (var x in Children(r.Children)) yield return x; break;
            case ColumnNode c: foreach (var x in Children(c.Children)) yield return x; break;
        }
        static IEnumerable<FormWidget> Children(IReadOnlyList<LayoutNode>? children)
            => (children ?? Array.Empty<LayoutNode>()).SelectMany(CollectForms);
    }

    // 트리에서 폼 저장쿼리(FormWidget.SaveQueryId)를 수집(빈/공백 제외) — 암시적 저장 버튼 후보.
    private static IEnumerable<string> CollectFormSaveQueries(LayoutNode node)
    {
        switch (node)
        {
            case FormWidget f when !string.IsNullOrWhiteSpace(f.SaveQueryId):
                yield return f.SaveQueryId!;
                break;
            case SectionNode s: foreach (var id in Children(s.Children)) yield return id; break;
            case RowNode r: foreach (var id in Children(r.Children)) yield return id; break;
            case ColumnNode c: foreach (var id in Children(c.Children)) yield return id; break;
        }
        static IEnumerable<string> Children(IReadOnlyList<LayoutNode>? children)
            => (children ?? Array.Empty<LayoutNode>()).SelectMany(CollectFormSaveQueries);
    }

    // 트리에서 명령 버튼 커맨드(ButtonWidget.Command)를 수집(빈/공백 제외) — 커버된 저장쿼리 판정용.
    private static IEnumerable<string> CollectButtonCommands(LayoutNode node)
    {
        switch (node)
        {
            case ButtonWidget b when !string.IsNullOrWhiteSpace(b.Command):
                yield return b.Command!;
                break;
            case SectionNode s: foreach (var cmd in Children(s.Children)) yield return cmd; break;
            case RowNode r: foreach (var cmd in Children(r.Children)) yield return cmd; break;
            case ColumnNode c: foreach (var cmd in Children(c.Children)) yield return cmd; break;
        }
        static IEnumerable<string> Children(IReadOnlyList<LayoutNode>? children)
            => (children ?? Array.Empty<LayoutNode>()).SelectMany(CollectButtonCommands);
    }
}
