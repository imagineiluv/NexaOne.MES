    // 트리에서 검증 대상 필드(FieldWidget)를 수집 — 검증의 단일 출처(평면 Fields 미러링 금지).
    // skipIsolatedForms=true면 격리/업무 scope 폼 내부 필드를 건너뛴다(공유 경로 값과 섞이지 않게).
    private IEnumerable<FieldDefinition> CollectFields(
        LayoutNode node,
        bool skipIsolatedForms = false,
        bool enforcePermissions = true,
        bool includeCollectionFields = false)
    {
        if (enforcePermissions && !CanAccessNode(node)) yield break;
        switch (node)
        {
            case FieldWidget fw:
                yield return fw.Field ?? new FieldDefinition(fw.FieldKey ?? string.Empty, fw.FieldKey ?? string.Empty);
                break;
            case FormWidget f:
                if (skipIsolatedForms && (f.Isolated || LayoutRenderer.BindingScopeKey(f.BindingScope) is not null)) break;
                foreach (var child in f.Fields ?? Array.Empty<FieldWidget>())
                    foreach (var fd in CollectFields(child, skipIsolatedForms, enforcePermissions, includeCollectionFields)) yield return fd;
                break;
            case CollectionWidget collection when includeCollectionFields:
                foreach (var child in collection.Fields ?? Array.Empty<FieldWidget>())
                    foreach (var fd in CollectFields(child, skipIsolatedForms, enforcePermissions, includeCollectionFields)) yield return fd;
                break;
            case SectionNode s: foreach (var child in s.Children ?? []) foreach (var fd in CollectFields(child, skipIsolatedForms, enforcePermissions, includeCollectionFields)) yield return fd; break;
            case RowNode r: foreach (var child in r.Children ?? []) foreach (var fd in CollectFields(child, skipIsolatedForms, enforcePermissions, includeCollectionFields)) yield return fd; break;
            case ColumnNode c: foreach (var child in c.Children ?? []) foreach (var fd in CollectFields(child, skipIsolatedForms, enforcePermissions, includeCollectionFields)) yield return fd; break;
        }
    }

    /// <summary>공유 모델에 바인딩된 반복 입력 위젯만 별도로 수집해 루트 필드와 섞이지 않게 검증합니다.</summary>
    private IEnumerable<CollectionWidget> CollectCollections(LayoutNode node, bool enforcePermissions = true)
    {
        if (enforcePermissions && !CanAccessNode(node)) yield break;
        switch (node)
        {
            case CollectionWidget collection:
                yield return collection;
                break;
            case SectionNode section:
                foreach (var child in section.Children ?? [])
                    foreach (var collection in CollectCollections(child, enforcePermissions)) yield return collection;
                break;
            case RowNode row:
                foreach (var child in row.Children ?? [])
                    foreach (var collection in CollectCollections(child, enforcePermissions)) yield return collection;
                break;
            case ColumnNode column:
                foreach (var child in column.Children ?? [])
                    foreach (var collection in CollectCollections(child, enforcePermissions)) yield return collection;
                break;
        }
    }

    // 트리에서 FormWidget 전체를 수집 — 격리 폼 모델 시드/명령 라우팅 인덱스용.
    private IEnumerable<FormWidget> CollectForms(LayoutNode node, bool enforcePermissions = true)
    {
        if (enforcePermissions && !CanAccessNode(node)) yield break;
        switch (node)
        {
            case FormWidget f: yield return f; break;
            case SectionNode s: foreach (var child in s.Children ?? []) foreach (var form in CollectForms(child, enforcePermissions)) yield return form; break;
            case RowNode r: foreach (var child in r.Children ?? []) foreach (var form in CollectForms(child, enforcePermissions)) yield return form; break;
            case ColumnNode c: foreach (var child in c.Children ?? []) foreach (var form in CollectForms(child, enforcePermissions)) yield return form; break;
        }
    }

