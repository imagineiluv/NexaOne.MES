@page "/meta/{UiId}"
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@inject IScreenDefinitionProvider Definitions
@inject IApiClient Api
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Phase 3 — 메타데이터 주도 화면: 정적 @@page 컴파일 화면이 아니라 UiId로 ScreenDefinition을 해석해 동적 렌더. *@
@* 화면 목적을 루트 클래스/데이터 속성으로 노출한다. 등록·관리·조회·리포트·실행 화면은 같은
   렌더러를 재사용하면서도 목적별 정보 위계와 밀도를 CSS에서 안전하게 조정할 수 있다. *@
<div class="@ScreenCssClass" data-purpose="@PurposeCssName"
     aria-busy="@(_loadingData || _saving || _refreshing).ToString().ToLowerInvariant()">
<div class="page-header">
    <div class="meta-page-ident">
        <span class="meta-purpose-icon" aria-hidden="true"><RadzenIcon Icon="@PurposeIcon" /></span>
        <div class="meta-page-title-group">
            @* 다국어(P3-14 v2) — 화면 제목은 screen.{UiId}.title 리소스, 미존재=정의 원문(한국어). *@
            <h1 class="page-title">@(_definition is null ? T("common.screenPending", "준비 중인 화면") : T($"screen.{_definition.UiId}.title", _definition.Title))</h1>
            @if (_definition is { Purpose: not ScreenPurpose.Auto })
            {
                <span class="meta-purpose-label">화면 유형 · @PurposeLabel(_definition.Purpose)</span>
            }
        </div>
    </div>
    @if (_definition is not null)
    {
        <div class="meta-page-actions">
            @if (IsListFirstRegistration)
            {
                @if (_saved) { <span class="save-ok" role="status" aria-live="polite">@T("common.savedMark", "저장됨")</span> }
                <RadzenButton Icon="add_circle" Text="@T("common.addTitle", "신규 등록")" Click="OnAddNewRequested"
                              Disabled="@(!CanAddNew)" title="@AddDisabledReason"
                              aria-label="@ActionAriaLabel(T("common.addTitle", "신규 등록"), AddDisabledReason)"
                              class="meta-primary-action" ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small" />
            }
            @* 수동 새로고침 — 자동 새로고침(RefreshIntervalSeconds) 없는 화면에서도 재조회할 수 있게 한다.
               데이터만 재조회(ReloadDataAsync)하므로 폼 입력 상태는 보존된다. *@
            <RadzenButton Click="ManualRefreshAsync" Disabled="@_refreshing" class="meta-refresh"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small">
                @if (_refreshing) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="refresh" /> }
                @(_refreshing ? T("common.refreshing", "새로고침 중…") : T("common.refresh", "새로고침"))
            </RadzenButton>
        </div>
    }
</div>

@* 검색 조건 영역(SearchFields) — 레거시 SmartUX 표준 패턴(상단 조건+조회). §20.8 조건 저장/불러오기 통합:
   조회 시 '$latest' 자동 저장, 재진입 시 복원. 저장 조건 선택은 즉시 조회. *@
@if (_definition?.SearchFields is { Count: > 0 } && _searchDefinition is not null && CanReadFlat)
{
    <div class="mes-card meta-search">
        <div class="meta-search-heading">
            <RadzenIcon Icon="tune" aria-hidden="true" />
            <span>@T("common.searchConditions", "조회 조건")</span>
        </div>
        <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
            <MetaFormRenderer Definition="_searchDefinition" @bind-Model="_searchModel" />
        </CascadingValue>
        <div class="meta-search-actions">
            <RadzenButton Icon="search" Text="@T("common.search", "조회")" Click="RunSearchAsync" Disabled="@_refreshing"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small" class="layout-command" />
            <select class="meta-cond-select" aria-label="@T("common.condSaved", "저장된 조건")" @onchange="OnSavedConditionSelected">
                <option value="" selected="@(_selectedCondition.Length == 0)">@T("common.condSaved", "저장된 조건…")</option>
                @foreach (var c in _savedConditions)
                {
                    <option value="@c.Name" selected="@(c.Name == _selectedCondition)">@c.Name</option>
                }
            </select>
            @if (_selectedCondition.Length > 0)
            {
                <RadzenButton Icon="delete" Text="@T("common.condDelete", "조건 삭제")" Click="DeleteSelectedConditionAsync"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            }
            <input class="meta-cond-name" aria-label="@T("common.condName", "조건명")"
                   placeholder="@T("common.condName", "조건명")" @bind="_conditionName" />
            <RadzenButton Icon="bookmark_add" Text="@T("common.condSave", "조건 저장")" Click="SaveCurrentConditionAsync"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
        </div>
    </div>
}

@if (_definition is null)
{
    @* SmartUX 메뉴에는 있으나 아직 새 시스템에 이식되지 않은 화면 — 오류가 아니라 '준비 중' 안내로 보여준다.
       (모듈 백엔드 마이그레이션 순서에 따라 ScreenDefinition이 채워지면 자동으로 실제 화면이 렌더된다) *@
    <div class="mes-empty-state">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8M12 18v3"/>
        </svg>
        <p class="es-title">@T("common.notMigratedTitle", "이 화면은 아직 마이그레이션되지 않았습니다.")</p>
        <p class="es-sub">
            @T("common.notMigratedId", "SmartUX 메뉴에서 이전된 화면 식별자:") <code>@UiId</code><br />
            @T("common.notMigratedHint", "해당 업무 화면은 모듈 백엔드 마이그레이션 순서에 따라 순차 제공됩니다.")
        </p>
    </div>
}
else if (_definition.Layout is not null)
{
    @* 레이아웃 트리 화면 — 멀티 read 결과맵을 내려보내고, 명령/검증은 MetaScreen이 오케스트레이션한다.
       격리 폼(Isolated, Phase-2 멀티폼)은 폼별 모델(_formModels)에 바인딩된다. *@
    <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
        <CascadingValue Value="_fieldErrors" Name="MetaFieldErrors">
            <LayoutRenderer Node="_definition.Layout" @bind-Model="_model" ScreenKey="@UiId"
                            QueryResults="_queryResults" OnCommand="RunButtonCommand"
                            CommandDisabledReason="GetCommandDisabledReason"
                            NodeAccessGranted="CanAccessNode"
                            NodeAccessDeniedReason="NodeAccessDeniedReason"
                            PermissionGranted="HasRequiredPermission"
                            FormModels="_formModels" OnFormModelChanged="OnFormModelChanged"
                            ScopeModels="_scopeModels" OnScopeModelChanged="OnScopeModelChanged"
                            OnRowSelect="_rowSelect" OnScopedRowSelect="_scopedRowSelect" LoadingData="_loadingData"
                            EnableGridViewModes="@IsManageScreen"
                            CanAdd="CanUseGridAdd" OnAddNew="OnAddNewRequested" AddDisabledReason="@AddDisabledReason"
                            CanDelete="@(_definition.DeleteQueryId is { Length: > 0 })" OnDeleteRows="OnDeleteRowsAsync"
                            DeleteDisabledReason="@DeleteDisabledReason"
                            BulkCommands="_definition.BulkCommands" OnBulkCommand="OnBulkCommandAsync"
                            BulkCommandDisabledReason="GetBulkCommandDisabledReason"
                            GridPaging="LayoutGridPaging" OnGridPageChange="OnLayoutGridPageChangeAsync" />
        </CascadingValue>
    </CascadingValue>

    @if (_errors.Count > 0)
    {
        <ul class="validation-errors" role="alert" aria-label="@T("common.validationErrors", "입력 오류")">
            @foreach (var err in _errors) { <li>@err</li> }
        </ul>
    }

    @* 명령 버튼으로 커버되지 않은 폼 저장쿼리에 대해 암시적 저장 버튼을 렌더한다.
       (손코딩 save-less 레이아웃 보완 — 이미 버튼이 있으면 중복 생성하지 않는다) *@
    @foreach (var saveQuery in _uncoveredSaveQueries)
    {
        <div class="meta-actions">
            <RadzenButton Click="() => RunCommand(saveQuery)" class="layout-save"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                <RadzenIcon Icon="save" />
                @(_uncoveredSaveQueries.Count > 1 ? $"{T("common.save", "저장")}: {saveQuery}" : T("common.save", "저장"))
            </RadzenButton>
        </div>
    }

    @if (_saved) { <span class="save-ok" role="status" aria-live="polite">@T("common.savedMark", "저장됨")</span> }
    @if (_saved && !string.IsNullOrWhiteSpace(_commandMessage))
    {
        <div class="meta-command-feedback @(_commandMessageIsWarning ? "is-warning" : "is-info")"
             role="status" aria-live="polite">@_commandMessage</div>
    }
}
else
{
    @* 폼(입력 필드)이 정의된 화면만 폼·저장 영역을 렌더한다 — 그리드 전용(조회) 화면은 폼이 비어 있을 수 있다. *@
    @if (_definition.Fields.Count > 0 && !IsListFirstRegistration && !CanSaveFlat)
    {
        <div class="meta-permission-denied" role="note">@SaveDisabledReason</div>
    }
    @if (_definition.Fields.Count > 0 && !IsListFirstRegistration && CanSaveFlat)
    {
        @* 폼 카드화(디자인 배치 3) — 그리드(목록 카드)와 동일한 카드 언어로 감싸 마스터-디테일 시각 분리.
           저장은 카드 푸터에 우측 정렬(주 행동의 자리를 고정). *@
        <div class="mes-card meta-form-card" data-editor-mode="@FlatManageEditorMode">
            <div class="mes-card-head meta-editor-head">
                <div class="meta-editor-title">
                    <span class="h-title">@FormSectionTitle</span>
                    @if (IsFlatManageInlineEditor)
                    {
                        <span class="meta-editor-state @(_isFlatManageEditing ? "is-edit" : "is-new")"
                              role="status" aria-live="polite">
                            <RadzenIcon Icon="@(_isFlatManageEditing ? "edit" : "add_circle")" aria-hidden="true" />
                            @ManageEditorStateLabel
                        </span>
                    }
                </div>
                @if (IsFlatManageInlineEditor)
                {
                    <span class="h-right meta-editor-hint">@ManageEditorHint</span>
                }
            </div>
            <div class="mes-card-body">
                <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
                    <CascadingValue Value="_fieldErrors" Name="MetaFieldErrors">
                        <MetaFormRenderer Definition="_definition" @bind-Model="_model" />
                    </CascadingValue>
                </CascadingValue>

                @if (_errors.Count > 0)
                {
                    <ul class="validation-errors" role="alert" aria-label="@T("common.validationErrors", "입력 오류")">
                        @foreach (var err in _errors) { <li>@err</li> }
                    </ul>
                }
            </div>
            <div class="meta-form-foot">
                @if (_saved) { <span class="save-ok" role="status" aria-live="polite">@T("common.savedMark", "저장됨")</span> }
                @if (IsFlatManageInlineEditor)
                {
                    <RadzenButton Click="ResetFlatManageEditor" class="meta-editor-reset"
                                  ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small">
                        <RadzenIcon Icon="@(_isFlatManageEditing ? "close" : "restart_alt")" />
                        @ManageEditorResetLabel
                    </RadzenButton>
                }
                <RadzenButton Click="Save" Disabled="@(_saving || !CanSaveFlat)" title="@SaveDisabledReason"
                              aria-label="@ActionAriaLabel(FlatSaveLabel, SaveDisabledReason)" class="layout-save"
                              ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                    @if (_saving) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="save" /> }
                    @(_saving ? T("common.saving", "저장 중…") : FlatSaveLabel)
                </RadzenButton>
            </div>
        </div>
    }

    @* 그리드(컬럼) 메타가 있으면 명명 쿼리 결과를 런타임 렌더한다 — 손코딩 없이 메타+파일쿼리로 조회 화면 구성.
       SmartUX 레퍼런스의 '리스트 카드'(헤더+그리드) 형태로 감싼다. *@
    @if (_definition.Columns is { Count: > 0 } && !CanReadFlat)
    {
        <div class="meta-permission-denied" role="note">@ReadDisabledReason</div>
    }
    @if (_definition.Columns is { Count: > 0 } && CanReadFlat)
    {
        var serverPaged = !string.IsNullOrWhiteSpace(_definition.CountQueryId) || _hybridServer;
        var resultCount = serverPaged ? _serverTotal : _rows?.Count ?? 0;
        <section class="meta-result-card">
            <div class="mes-card-head">
                <span class="h-title">@ResultSectionTitle</span>
                <span class="h-right">@T("common.searchResult", "검색 결과")@(resultCount > 0 ? $" ({resultCount})" : "")</span>
            </div>
            <div class="mes-card-body">
                <MetaGridRenderer Columns="_definition.Columns" Rows="_rows"
                                  Loading="_loadingData" OnRowSelect="_rowSelect" ScreenKey="@UiId"
                                  EnableViewModes="@IsManageScreen"
                                  CanAdd="@CanUseGridAdd" OnAddNew="OnAddNewRequested"
                                  AddDisabledReason="@AddDisabledReason"
                                  CanDelete="@(_definition.DeleteQueryId is { Length: > 0 })" OnDeleteRows="OnDeleteRowsAsync"
                                  DeleteDisabledReason="@DeleteDisabledReason"
                                  BulkCommands="_definition.BulkCommands" OnBulkCommand="OnBulkCommandAsync"
                                  BulkCommandDisabledReason="GetBulkCommandDisabledReason"
                                  ServerTotal="serverPaged ? _serverTotal : (int?)null"
                                  ServerPage="_serverPage" OnServerPageChange="OnServerPageChangeAsync" />
            </div>
        </section>
    }
}

@* 신규 등록 모달(그리드 '추가' 팝업) — 화면 폼과 독립된 모델(_addModel). 백드롭/×/취소/Escape=닫기, 저장=검증→커맨드→재조회.
   포커스: 열릴 때 nxDialogOpen(첫 포커서블 이동+Tab 트랩), 닫힐 때 nxDialogClose(이전 포커스 복귀). *@
@if (_addOpen && _addFormDef is not null)
{
    <div class="nx-modal-backdrop" @onclick="CloseAddAsync"></div>
    <div class="nx-modal" role="dialog" aria-modal="true" aria-label="@T("common.addTitle", "신규 등록")"
         tabindex="-1" @ref="_modalRef" @onkeydown="OnModalKeyDownAsync">
        <div class="mes-card-head">
            <span class="h-title">@T("common.addTitle", "신규 등록")</span>
            <button type="button" class="nx-modal-close" title="@T("common.close", "닫기")"
                    aria-label="@T("common.close", "닫기")" @onclick="CloseAddAsync">×</button>
        </div>
        <div class="nx-modal-body">
            <CascadingValue Value="_dynamicOptions" Name="MetaDynamicOptions">
                <CascadingValue Value="_addFieldErrors" Name="MetaFieldErrors">
                    <MetaFormRenderer Definition="_addFormDef" @bind-Model="_addModel" />
                </CascadingValue>
            </CascadingValue>
            @if (_addErrors.Count > 0)
            {
                <ul class="validation-errors" role="alert" aria-label="@T("common.validationErrors", "입력 오류")">
                    @foreach (var err in _addErrors) { <li>@err</li> }
                </ul>
            }
        </div>
        <div class="meta-form-foot">
            <RadzenButton Text="@T("common.cancel", "취소")" Click="CloseAddAsync"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            <RadzenButton Click="SaveAddAsync" Disabled="@(_addSaving || !CanAddNew)" title="@AddDisabledReason"
                          aria-label="@ActionAriaLabel(T("common.save", "저장"), AddDisabledReason)" class="layout-save nx-modal-save"
                          ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small">
                @if (_addSaving) { <span class="nx-spin" aria-hidden="true"></span> } else { <RadzenIcon Icon="save" /> }
                @(_addSaving ? T("common.saving", "저장 중…") : T("common.save", "저장"))
            </RadzenButton>
        </div>
    </div>
}
</div>

@code {
    [Parameter] public string UiId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ClaimsPrincipal _currentUser = new(new ClaimsIdentity());

    // /meta는 MES가 기본이며 Mobile/POP 호스트가 실제 채널과 선택적 장치 ID를 명시적으로 넘긴다.
    // 이 값은 신뢰 경계가 아니라 실행 이력 문맥이고, 사용자/권한의 최종 권위는 REST API의 JWT 게이트다.
    [Parameter] public string ClientChannel { get; set; } = "MES";
    [Parameter, SupplyParameterFromQuery(Name = "deviceId")] public string? DeviceId { get; set; }

    // 브리지 일괄명령 핸들러(bridge: 접두 CommandQueryId 전용) — 호스트 리터럴 페이지가 배선한다.
    // 반환 true=성공(그리드 재조회). 계약(ScreenDefinition)엔 영향 없음 — SPA 드리프트 가드 무관.
    [Parameter] public Func<BulkCommandDefinition, List<Dictionary<string, object?>>, Task<bool>>? BridgeBulkHandler { get; set; }

    private ScreenDefinition? _definition;
    private Dictionary<string, object?> _model = new();
    private string? _modelUiId;
    private List<string> _errors = new();
    private IReadOnlyList<Dictionary<string, object?>>? _rows;   // 그리드 데이터(명명 쿼리 결과); null=미실행
    // 레이아웃 화면의 위젯별 read 결과(queryId→행). 평면 경로는 _rows를 쓴다.
    private IReadOnlyDictionary<string, IReadOnlyList<Dictionary<string, object?>>> _queryResults
        = new Dictionary<string, IReadOnlyList<Dictionary<string, object?>>>();
    private bool _saving;
    private bool _saved;
    private string? _commandMessage;
    private bool _commandMessageIsWarning;

    // 다국어(P3-14) — 호스트 DI(UiTextService)가 있으면 번역, 없으면(테스트 등) 한국어 폴백.
    // 셸의 리소스 로드가 본문 첫 렌더보다 늦을 수 있어 Changed를 구독해 로드/전환 시 리렌더한다
    // (부모 리렌더가 자식 렌더러들도 갱신하므로 구독은 MetaScreen 한 곳이면 충분).
    private NexaOne.Web.Services.UiTextService? _uiTextResolved;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiTextResolved = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
            if (_uiTextResolved is not null) _uiTextResolved.Changed += OnUiTextChanged;
        }
        return _uiTextResolved?.T(key, fallback) ?? fallback;
    }

    private void OnUiTextChanged() => _ = InvokeAsync(StateHasChanged);
    // 레이아웃 트리에서 명령 버튼으로 커버되지 않은 폼 저장쿼리 — 암시적 저장 버튼 대상(공백/중복 제외).
    private IReadOnlyList<string> _uncoveredSaveQueries = Array.Empty<string>();
    // Phase-2 멀티폼 — 격리 폼(Isolated)의 스코프 키→폼별 모델. 로드 시 트리를 훑어 사전 시드한다
    // (렌더 중 생성하면 매 렌더 새 인스턴스가 되어 입력이 소실된다).
    private Dictionary<string, Dictionary<string, object?>> _formModels = new(StringComparer.Ordinal);
    // 스코프 키→격리 FormWidget — 명령 라우팅(SaveQueryId 매칭)·폼별 검증에 쓴다.
    private Dictionary<string, FormWidget> _isolatedForms = new(StringComparer.Ordinal);
    // aggregate scope별 모델. 선택 행은 해당 scope 딕셔너리만 새 인스턴스로 교체하므로 LOT/W/O/예외가 섞이지 않는다.
    private Dictionary<string, Dictionary<string, object?>> _scopeModels = new(StringComparer.Ordinal);
    // 자동 새로고침(Phase-2 실시간 v2) 루프 취소 토큰 — 화면 이탈/정의 재로드 시 이전 루프를 반드시 끊는다.
    private CancellationTokenSource? _refreshCts;
    // 실시간 v3 — 이벤트 푸시 구독 핸들(화면 이탈/재로드 시 해지)과 스로틀 기준 시각.
    private IDisposable? _pushSubscription;
    private DateTime _lastPushRefresh;

    protected override async Task OnParametersSetAsync()
    {
        _currentUser = AuthenticationStateTask is null
            ? new ClaimsPrincipal(new ClaimsIdentity())
            : (await AuthenticationStateTask).User;

        // 인메모리 캐시 우선, 없으면 DB 저장소(SYS_SCREEN_DEFINITION)에서 로드해 캐시 등록(Phase 4 후속)
        _definition = await Definitions.GetAsync(UiId);
        if (_definition is null)
        {
            var record = await Api.GetScreenDefinitionAsync(UiId);
            if (record is not null)
            {
                _definition = ScreenDefinitionJson.Deserialize(record.DefinitionJson);
                if (_definition is not null) Definitions.Register(_definition);
            }
        }

        // 화면 전환 때만 입력 모델을 교체하고, 같은 화면의 재렌더에서는 기존 멱등키와 사용자 입력을 보존한다.
        if (!string.Equals(_modelUiId, UiId, StringComparison.OrdinalIgnoreCase))
        {
            _modelUiId = UiId;
            _model = new Dictionary<string, object?>(StringComparer.Ordinal);
            _isFlatManageEditing = false;
        }
        EnsureSharedModelDefaults();

        // 동적 Select 옵션(OptionsQueryId) — 정의 로드 시 1회 조회(마스터 목록은 화면 수명 동안 안정).
        _dynamicOptions = await LoadDynamicOptionsAsync();

        // 그리드 '추가' 팝업 폼 구성 — 필드+저장쿼리가 있는 화면만(조회 전용은 추가 버튼 미노출).
        BuildAddForm();

        // 검색 조건 초기화(§20.8) — 저장 조건 목록과 '$latest'(마지막 조회 조건)를 복원한 뒤 조회한다.
        _searchModel = new(StringComparer.Ordinal);
        _searchDefinition = null;
        _savedConditions = new();
        _selectedCondition = string.Empty;
        _conditionName = string.Empty;
        if (CanReadFlat && _definition?.SearchFields is { Count: > 0 } sf)
        {
            _searchDefinition = new ScreenDefinition(string.Empty, string.Empty, sf);
            var setting = await Api.GetConditionSettingsAsync(UiId);
            if (setting is not null)
            {
                _savedConditions = setting.Items ?? new();
                if (setting.Latest is not null) ApplyConditionValues(setting.Latest.Values);
            }
        }

        // P1-1 — 폼 필드가 있는 화면만 그리드 행 선택(클릭=폼 로드)을 켠다(조회 전용 화면은 선택 불가).
        var hasFormFields = _definition is not null && _definition.Purpose != ScreenPurpose.Register &&
            (_definition.Layout is not null
                ? CollectFields(_definition.Layout).Any()
                : CanSaveFlat && _definition.Fields.Count > 0);
        _rowSelect = hasFormFields
            ? EventCallback.Factory.Create<Dictionary<string, object?>>(this, OnRowSelectedAsync)
            : default;
        var hasScopedSelection = _definition?.Layout is not null
            && CollectGrids(_definition.Layout).Any(grid => !grid.SelectionDisabled
                && LayoutRenderer.BindingScopeKey(grid.SelectionScope) is not null);
        _scopedRowSelect = hasScopedSelection
            ? EventCallback.Factory.Create<(string Scope, Dictionary<string, object?> Row)>(this, OnScopedRowSelectedAsync)
            : default;

        // 데이터(그리드 행 + 레이아웃 결과맵) 조회 — 자동 새로고침과 공유하는 단일 경로.
        _serverPage = 0;   // 화면 전환 시 서버 페이징 상태 초기화(P3-9 v2)
        _serverTotal = 0;
        _hybridServer = false;   // 하이브리드 서버 페이징도 화면 전환 시 리셋(첫 조회가 재판정)
        _layoutPaging = new(StringComparer.Ordinal);   // 레이아웃 그리드 페이징 상태도 리셋
        await ReloadDataAsync();

        // 레이아웃 화면: 저장 버튼/멀티폼 인덱스는 정의 로드 시 1회만 구성한다(새로고침이 폼 상태를 건드리지 않게).
        _uncoveredSaveQueries = Array.Empty<string>();
        _formModels = new(StringComparer.Ordinal);
        _isolatedForms = new(StringComparer.Ordinal);
        _scopeModels = new(StringComparer.Ordinal);
        if (_definition?.Layout is not null)
        {
            // 명령 버튼이 커버하지 않는 폼 저장쿼리만 추려 암시적 저장 버튼을 렌더한다(중복 방지).
            var covered = new HashSet<string>(CollectButtonCommands(_definition.Layout), StringComparer.Ordinal);
            _uncoveredSaveQueries = CollectFormSaveQueries(_definition.Layout)
                .Where(q => !covered.Contains(q))
                .Distinct(StringComparer.Ordinal)
                .ToList();

            // Phase-2 멀티폼 — 격리 폼의 폼별 모델을 사전 시드(안정 인스턴스)하고 라우팅 인덱스를 만든다.
            foreach (var form in CollectForms(_definition.Layout).Where(f => f.Isolated))
            {
                var key = LayoutRenderer.FormScopeKey(form);
                if (key is null || _isolatedForms.ContainsKey(key)) continue;   // 키 없음=공유 저하, 중복 키=첫 폼 우선
                _isolatedForms[key] = form;
                var isolatedModel = new Dictionary<string, object?>(StringComparer.Ordinal);
                MetaModelDefaults.EnsureGeneratedValues(CollectFields(form), isolatedModel);
                _formModels[key] = isolatedModel;
            }

            // 선택 scope는 폼 여러 개가 하나의 aggregate 모델을 공유할 수 있다. 화면 로드 시 안정된 딕셔너리를
            // 한 번 만들고 모든 scoped 폼의 자동 생성 기본값을 합쳐 준비한다.
            var scopedForms = CollectForms(_definition.Layout)
                .Select(form => (Form: form, Scope: LayoutRenderer.BindingScopeKey(form.BindingScope)))
                .Where(item => item.Scope is not null)
                .ToList();
            var scopeKeys = scopedForms.Select(item => item.Scope!)
                .Concat(CollectGrids(_definition.Layout)
                    .Select(grid => LayoutRenderer.BindingScopeKey(grid.SelectionScope))
                    .OfType<string>())
                .Concat(CollectButtons(_definition.Layout)
                    .Select(button => LayoutRenderer.BindingScopeKey(button.BindingScope))
                    .OfType<string>())
                .Concat(CollectCollections(_definition.Layout)
                    .Select(collection => LayoutRenderer.BindingScopeKey(collection.BindingScope))
                    .OfType<string>())
                .Distinct(StringComparer.Ordinal);
            foreach (var scope in scopeKeys)
            {
                var model = new Dictionary<string, object?>(StringComparer.Ordinal);
                foreach (var (form, _) in scopedForms.Where(item => item.Scope == scope))
                    MetaModelDefaults.EnsureGeneratedValues(CollectFields(form), model);
                foreach (var collection in CollectCollections(_definition.Layout)
                             .Where(collection => LayoutRenderer.BindingScopeKey(collection.BindingScope) == scope))
                    MetaModelDefaults.EnsureLayoutDefaults(collection, model, CanAccessNode);
                _scopeModels[scope] = model;
            }
        }

        // 자동 새로고침(Phase-2 실시간 v2) — 정의의 RefreshIntervalSeconds>0면 주기 재조회(데이터만, 폼 상태 보존).
        // 실시간 v3 — 라이브 화면은 도메인 이벤트 푸시(IScreenRefreshNotifier)도 구독해 폴링 주기를 기다리지 않고
        // 즉시 재조회한다(1초 스로틀). 알림 포트 미등록 환경(테스트·modules OFF)은 폴링만 동작.
        _refreshCts?.Cancel();
        _refreshCts = null;
        _pushSubscription?.Dispose();
        _pushSubscription = null;
        if (_definition?.RefreshIntervalSeconds is int interval && interval > 0)
        {
            var cts = new CancellationTokenSource();
            _refreshCts = cts;
            _ = AutoRefreshLoopAsync(interval, cts.Token);
            _pushSubscription = (Services.GetService(typeof(IScreenRefreshNotifier)) as IScreenRefreshNotifier)
                ?.Subscribe(OnPushChangedAsync);
        }
    }

    // 동적 Select 옵션(필드 Key → 옵션 목록). 규약: OptionsQueryId 결과의 첫 컬럼=값, 둘째 컬럼=라벨 보조.
    private Dictionary<string, IReadOnlyList<MetaFieldOption>> _dynamicOptions = new(StringComparer.Ordinal);

    private async Task<Dictionary<string, IReadOnlyList<MetaFieldOption>>> LoadDynamicOptionsAsync()
    {
        var result = new Dictionary<string, IReadOnlyList<MetaFieldOption>>(StringComparer.Ordinal);
        if (_definition is null) return result;
        var layoutOwnsPermissions = _definition.Layout is not null;
        var fields = (layoutOwnsPermissions
                ? CollectFields(_definition.Layout!, includeCollectionFields: true)
                : CanSaveFlat ? _definition.Fields.AsEnumerable() : Enumerable.Empty<FieldDefinition>())
            .Concat(CanReadFlat
                ? _definition.SearchFields ?? Enumerable.Empty<FieldDefinition>()
                : Enumerable.Empty<FieldDefinition>());
        foreach (var field in fields.Where(f => !string.IsNullOrWhiteSpace(f.OptionsQueryId)))
        {
            // 레이아웃 필드는 CollectFields가 FieldWidget 권한과 옵션 쿼리 카탈로그를 이미 검사한다.
            // 평면 필드는 별도 노드가 없으므로 화면 read 힌트와 실제 옵션 쿼리 카탈로그를 여기서 결합한다.
            if (!layoutOwnsPermissions
                && !GetBindingAccess(
                    field.OptionsQueryId,
                    _definition.ReadRequiredPermission,
                    isWrite: false).Allowed)
                continue;
            if (result.ContainsKey(field.Key)) continue;   // 같은 Key 중복 정의는 첫 필드 우선
            var rows = await Api.ExecuteQueryAsync(field.OptionsQueryId!);
            var opts = new List<MetaFieldOption>();
            foreach (var row in rows)
            {
                var vals = row.Values.ToList();   // JSON 객체 순서 = SELECT 컬럼 순서
                var value = vals.Count > 0 ? vals[0]?.ToString() ?? "" : "";
                if (value.Length == 0) continue;
                var second = vals.Count > 1 ? vals[1]?.ToString() : null;
                opts.Add(new MetaFieldOption(value,
                    string.IsNullOrWhiteSpace(second) || second == value ? value : $"{value} — {second}"));
            }
            result[field.Key] = opts;
        }
        return result;
    }

    // 수동 새로고침 — 헤더 버튼. 진행 중 중복 클릭은 무시한다.
    private bool _refreshing;
    private async Task ManualRefreshAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try { await ReloadDataAsync(); }
        finally { _refreshing = false; }
    }

    // ── 검색 조건(SearchFields) + §20.8 조건 저장/불러오기 ────────────────────
    private Dictionary<string, object?> _searchModel = new(StringComparer.Ordinal);
    private ScreenDefinition? _searchDefinition;     // SearchFields를 MetaFormRenderer로 렌더하기 위한 래퍼
    private List<ConditionItemDto> _savedConditions = new();
    private string _conditionName = string.Empty;
    private string _selectedCondition = string.Empty;

    // 비어있지 않은 조건 값만 파라미터로 보낸다 — 빈 값은 미전송(게이트웨이가 DBNull 보충 → NULL-가드 전체 조회).
    private Dictionary<string, object?>? BuildSearchParameters()
    {
        if (_definition?.SearchFields is not { Count: > 0 }) return null;
        var p = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in _searchModel)
            if (!string.IsNullOrWhiteSpace(v?.ToString())) p[k] = v;
        return p;
    }

    private async Task RunSearchAsync()
    {
        if (_refreshing) return;
        _refreshing = true;
        try
        {
            // 마지막 조회 조건($latest) 자동 저장 — 다음 진입 시 복원(§20.8). 저장 실패해도 조회는 진행.
            await Api.SaveLatestConditionAsync(UiId, ToConditionValues());
            _serverPage = 0;   // 조건 변경 = 첫 페이지부터(P3-9 v2)
            await ReloadDataAsync();
        }
        finally { _refreshing = false; }
    }

    private Dictionary<string, string?> ToConditionValues()
    {
        var values = new Dictionary<string, string?>(StringComparer.Ordinal);
        foreach (var f in _definition?.SearchFields ?? Array.Empty<FieldDefinition>())
            values[f.Key] = _searchModel.TryGetValue(f.Key, out var v) ? v?.ToString() : null;
        return values;
    }

    private void ApplyConditionValues(Dictionary<string, string?> values)
    {
        foreach (var (k, v) in values)
            _searchModel[k] = v;
    }

    private async Task SaveCurrentConditionAsync()
    {
        var name = _conditionName.Trim();
        if (name.Length == 0) return;
        var saved = await Api.SaveConditionAsync(UiId, name, ToConditionValues());
        if (saved is not null)
        {
            _conditionName = string.Empty;
            await ReloadSavedConditionsAsync();
            _selectedCondition = name;
        }
    }

    private async Task ReloadSavedConditionsAsync()
    {
        var setting = await Api.GetConditionSettingsAsync(UiId);
        _savedConditions = setting?.Items ?? new();
    }

    // 저장 조건 선택 → 값 적용 후 즉시 조회(레거시 SmartUX 동작 미러).
    private async Task OnSavedConditionSelected(ChangeEventArgs e)
    {
        _selectedCondition = e.Value?.ToString() ?? string.Empty;
        var item = _savedConditions.FirstOrDefault(c => c.Name == _selectedCondition);
        if (item is null) return;
        ApplyConditionValues(item.Values);
        await RunSearchAsync();
    }

    private async Task DeleteSelectedConditionAsync()
    {
        if (_selectedCondition.Length == 0) return;
        if (await Api.DeleteConditionAsync(UiId, _selectedCondition))
        {
            _selectedCondition = string.Empty;
            await ReloadSavedConditionsAsync();
        }
    }

    // 이벤트 푸시 재조회 — 버스 스레드에서 호출되므로 렌더 갱신은 InvokeAsync로 회로 컨텍스트에 태운다.
    private async Task OnPushChangedAsync()
    {
        var now = DateTime.UtcNow;
        if ((now - _lastPushRefresh).TotalMilliseconds < 1000) return;   // 이벤트 폭주 스로틀(1초)
        _lastPushRefresh = now;
        try
        {
            await InvokeAsync(async () =>
            {
                await ReloadDataAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* 회로 폐기 경합 — 구독 해지 직전 이벤트, 무시 */ }
        catch (InvalidOperationException) { /* 회로 미부착 상태 — 무시 */ }
    }

    // 데이터 재조회(그리드 행 + 레이아웃 위젯 결과맵) — 초기 로드와 자동 새로고침이 공유한다.
    // 검색 조건(SearchFields)이 있으면 값을 모든 읽기쿼리에 바인딩한다 — SQL이 선언하지 않은 파라미터는
    // 게이트웨이가 무시하므로 화면 내 여러 쿼리에 같은 조건 딕셔너리를 안전하게 공유한다.
    // (403/5xx는 ApiClient가 빈 목록으로 흡수하고 전역 토스트가 사유를 알린다)
    private bool _loadingData;   // P1-3 — 그리드 '조회 중…' 표시

    // ── 서버측 페이징(P3-9 v2, CountQueryId 화면) ────────────────────────────
    private int _serverPage;
    private int _serverTotal;
    // 하이브리드 서버 페이징(DB-레벨 LIMIT) — CountQueryId 없는 화면이 첫 조회 total>상한이면 true로
    // 전환돼 페이지 단위 재조회(paged 게이트웨이). 상한 이하/미지원은 false(기존 클라 모드).
    private bool _hybridServer;

    // 레이아웃 그리드 위젯별 페이징 상태(queryId → 하이브리드 여부/총건수/현재 페이지) — 그리드마다 독립.
    private Dictionary<string, (bool Hybrid, int Total, int Page)> _layoutPaging = new(StringComparer.Ordinal);

    // LayoutRenderer에 내려보낼 서버 모드 그리드 맵(총건수·페이지) — 하이브리드 전환된 위젯만.
    private IReadOnlyDictionary<string, (int Total, int Page)> LayoutGridPaging
        => _layoutPaging.Where(kv => kv.Value.Hybrid)
            .ToDictionary(kv => kv.Key, kv => (kv.Value.Total, kv.Value.Page), StringComparer.Ordinal);

    private async Task OnLayoutGridPageChangeAsync((string QueryId, int Page) e)
    {
        if (e.Page < 0 || !_layoutPaging.TryGetValue(e.QueryId, out var st) || !st.Hybrid || st.Page == e.Page) return;
        _layoutPaging[e.QueryId] = (st.Hybrid, st.Total, e.Page);
        await ReloadDataAsync();
    }

    private async Task OnServerPageChangeAsync(int page)
    {
        if (page < 0 || page == _serverPage) return;
        _serverPage = page;
        await ReloadDataAsync();
    }

    // 총건수 조회 — count 쿼리(단일 행 첫 컬럼)를 본 쿼리와 같은 검색 조건으로 실행한다.
    private async Task<int> FetchCountAsync(string countQueryId, Dictionary<string, object?>? search)
    {
        var rows = await Api.ExecuteQueryAsync(countQueryId, search);
        var first = rows.FirstOrDefault()?.Values.FirstOrDefault();
        return first switch
        {
            int i => i,
            long l => (int)l,
            _ => int.TryParse(first?.ToString(), out var p) ? p : 0,
        };
    }

    private async Task ReloadDataAsync()
    {
        _loadingData = true;
        try
        {
            var search = BuildSearchParameters();
            _rows = null;
            // flat 조회는 실제 flat 그리드가 렌더링되는 경우에만 실행한다. layout 모드의 top-level
            // QueryId/CountQueryId/Columns는 비활성 호환 메타이므로 숨은 중복 조회를 만들지 않는다.
            if (CanReadFlat
                && _definition is { Layout: null, Columns.Count: > 0 } flatDefinition
                && !string.IsNullOrWhiteSpace(flatDefinition.QueryId))
            {
                if (flatDefinition.CountQueryId is { Length: > 0 } countQueryId)
                {
                    // 서버측 페이징 — @limit/@offset을 검색 조건에 얹어 조회하고 총건수를 병행 조회한다.
                    _serverTotal = await FetchCountAsync(countQueryId, search);
                    var maxPage = _serverTotal > 0 ? (_serverTotal - 1) / MetaGridRenderer.PageSize : 0;
                    if (_serverPage > maxPage) _serverPage = maxPage;   // 조건 변경/삭제로 범위 밖이면 마지막 페이지로
                    var paged = search is null
                        ? new Dictionary<string, object?>(StringComparer.Ordinal)
                        : new Dictionary<string, object?>(search, StringComparer.Ordinal);
                    paged["limit"] = MetaGridRenderer.PageSize;
                    paged["offset"] = _serverPage * MetaGridRenderer.PageSize;
                    _rows = await Api.ExecuteQueryAsync(flatDefinition.QueryId, paged);
                }
                else
                {
                    // 하이브리드 서버 페이징(DB-레벨 LIMIT) — 첫 조회는 클라 상한(MaxClientRows)창으로 요청:
                    // total ≤ 상한이면 전량 적재(클라 모드 — 빠른/컬럼 필터 유지), 초과면 서버 모드로 전환해
                    // 페이지 단위(PageSize)만 오간다. paged 미지원(자체 LIMIT 쿼리·구버전 서버)은 null →
                    // 기존 전량 경로 폴백(안전판). 검색 조건 변경은 RunSearchAsync가 _serverPage=0으로 재판정.
                    var cap = MetaGridRenderer.MaxClientRows;
                    var paged = _hybridServer
                        ? await Api.ExecuteQueryPagedAsync(flatDefinition.QueryId, search,
                              MetaGridRenderer.PageSize, _serverPage * MetaGridRenderer.PageSize)
                        : await Api.ExecuteQueryPagedAsync(flatDefinition.QueryId, search, cap, 0);
                    if (paged is null)
                    {
                        _hybridServer = false;
                        _rows = await Api.ExecuteQueryAsync(flatDefinition.QueryId, search);
                    }
                    else if (!_hybridServer && paged.Total > cap)
                    {
                        _hybridServer = true;
                        _serverTotal = paged.Total;
                        _serverPage = 0;
                        _rows = paged.Rows.Take(MetaGridRenderer.PageSize).ToList();
                    }
                    else if (_hybridServer)
                    {
                        _serverTotal = paged.Total;
                        var maxPage = paged.Total > 0 ? (paged.Total - 1) / MetaGridRenderer.PageSize : 0;
                        if (_serverPage > maxPage) _serverPage = maxPage;
                        _rows = paged.Rows;
                        if (paged.Total <= cap) _hybridServer = false;   // 줄어들면 다음 조회부터 클라 모드 복귀
                    }
                    else
                    {
                        _rows = paged.Rows;   // total ≤ 상한 — 전량(클라 모드)
                    }
                }
            }

            if (_definition?.Layout is not null)
            {
                // 레이아웃 그리드 하이브리드(위젯별 독립 페이징) — 그리드 '전용' 쿼리만 paged 게이트웨이로
                // 요청한다. KPI/배지/차트가 함께 쓰는 쿼리는 집계 의미(첫 행/시계열 전체)가 깨지므로 전량 유지.
                var map = new Dictionary<string, IReadOnlyList<Dictionary<string, object?>>>(StringComparer.Ordinal);
                var gridIds = new HashSet<string>(CollectGridQueryIds(_definition.Layout), StringComparer.Ordinal);
                var nonGridIds = new HashSet<string>(CollectNonGridQueryIds(_definition.Layout), StringComparer.Ordinal);
                var cap = MetaGridRenderer.MaxClientRows;
                foreach (var queryId in CollectQueryIds(_definition.Layout))
                {
                    if (map.ContainsKey(queryId)) continue;
                    var pageable = gridIds.Contains(queryId) && !nonGridIds.Contains(queryId);
                    if (!pageable)
                    {
                        map[queryId] = await Api.ExecuteQueryAsync(queryId, search);
                        continue;
                    }

                    var st = _layoutPaging.TryGetValue(queryId, out var s) ? s : (Hybrid: false, Total: 0, Page: 0);
                    var paged = st.Hybrid
                        ? await Api.ExecuteQueryPagedAsync(queryId, search,
                              MetaGridRenderer.PageSize, st.Page * MetaGridRenderer.PageSize)
                        : await Api.ExecuteQueryPagedAsync(queryId, search, cap, 0);
                    if (paged is null)
                    {
                        // paged 미지원(자체 LIMIT 쿼리 등) — 기존 전량 경로 폴백.
                        _layoutPaging.Remove(queryId);
                        map[queryId] = await Api.ExecuteQueryAsync(queryId, search);
                    }
                    else if (!st.Hybrid && paged.Total > cap)
                    {
                        _layoutPaging[queryId] = (true, paged.Total, 0);
                        map[queryId] = paged.Rows.Take(MetaGridRenderer.PageSize).ToList();
                    }
                    else if (st.Hybrid)
                    {
                        var maxPage = paged.Total > 0 ? (paged.Total - 1) / MetaGridRenderer.PageSize : 0;
                        _layoutPaging[queryId] = (paged.Total > cap, paged.Total, Math.Min(st.Page, maxPage));
                        map[queryId] = paged.Rows;
                    }
                    else
                    {
                        _layoutPaging.Remove(queryId);
                        map[queryId] = paged.Rows;   // total ≤ 상한 — 전량(클라 모드)
                    }
                }
                _queryResults = map;
            }
        }
        finally
        {
            _loadingData = false;
        }
    }

    // ── 그리드 표준 CRUD(추가/삭제) — 툴바 버튼은 그리드가, 실행·확인·재조회는 여기가 소유 ──────

    // ── 추가 = 팝업 등록 폼(사용자 요청) — 화면 폼과 독립된 모델로 신규 행을 입력·저장한다. ──────
    private bool _addOpen;
    private bool _addSaving;
    private Dictionary<string, object?> _addModel = new();
    private Dictionary<string, string> _addFieldErrors = new(StringComparer.Ordinal);
    private List<string> _addErrors = new();
    private ScreenDefinition? _addFormDef;     // 팝업 폼 정의 — 평면=필드 그대로, 레이아웃=트리 필드 수집 래퍼.
    private string? _addSaveQueryId;
    private IReadOnlyList<string> _addRequiredPermissions = Array.Empty<string>();
    private string? _addBindingDeclaredPermission;

    private bool HasAddForm => _addFormDef is not null;
    // 평면 Manage 화면은 본문의 인라인 편집기가 신규·수정을 모두 담당한다. 같은 SaveQueryId를 쓰는
    // 그리드 '추가' 모달까지 함께 열면 등록 경로가 둘로 갈라지므로 해당 조합에서는 한 경로만 남긴다.
    private bool IsFlatManageInlineEditor => _definition is
    {
        Purpose: ScreenPurpose.Manage,
        Layout: null,
        Fields.Count: > 0
    };

    // 레이아웃 Register 화면은 본문에 실제 등록 폼이 있으므로 최근 이력 그리드의 중복 '추가' 모달을 숨긴다.
    // 평면 Manage 화면도 위 인라인 편집기를 단일 등록·수정 진입점으로 사용한다.
    private bool CanUseGridAdd => HasAddForm
        && !IsListFirstRegistration
        && !IsFlatManageInlineEditor
        && _definition is not { Purpose: ScreenPurpose.Register, Layout: not null };
    private BindingAccessDecision AddBindingAccess
        => GetBindingAccess(_addSaveQueryId, _addBindingDeclaredPermission, isWrite: true);
    private bool CanAddNew => HasAddForm
        && _addRequiredPermissions.All(HasRequiredPermission)
        && AddBindingAccess.Allowed;
    private string? AddDisabledReason => CanAddNew
        ? null
        : _addRequiredPermissions.FirstOrDefault(permission => !HasRequiredPermission(permission)) is { } denied
            ? PermissionDeniedReason(denied)
            : AddBindingAccess.DeniedReason ?? T("common.addUnavailable", "신규 등록을 실행할 수 없습니다.");
    private BindingAccessDecision FlatReadAccess
    {
        get
        {
            if (_definition is null) return BindingAccessDecision.AllowedAccess;
            var primary = GetBindingAccess(
                _definition.QueryId, _definition.ReadRequiredPermission, isWrite: false);
            if (!primary.Allowed) return primary;
            return GetBindingAccess(
                _definition.CountQueryId, _definition.ReadRequiredPermission, isWrite: false);
        }
    }
    private bool CanReadFlat => FlatReadAccess.Allowed;
    private string? ReadDisabledReason => FlatReadAccess.DeniedReason;
    private BindingAccessDecision FlatSaveAccess => GetBindingAccess(
        _definition?.SaveQueryId, _definition?.SaveRequiredPermission, isWrite: true);
    private bool CanSaveFlat => FlatSaveAccess.Allowed;
    private string? SaveDisabledReason => FlatSaveAccess.DeniedReason;
    private BindingAccessDecision FlatDeleteAccess => GetBindingAccess(
        _definition?.DeleteQueryId, _definition?.DeleteRequiredPermission, isWrite: true);
    private string? DeleteDisabledReason => FlatDeleteAccess.Allowed ? null : FlatDeleteAccess.DeniedReason;

    // 등록 화면은 신규 입력과 최근 이력을 분리한다. 독립 등록 모델을 모달에서 사용하므로
    // 목록 행 클릭이 새 검사 입력을 덮어쓰거나 상단 중복 폼이 그리드 공간을 차지하지 않는다.
    private bool IsListFirstRegistration => _definition is
    {
        Purpose: ScreenPurpose.Register,
        Columns.Count: > 0
    } && HasAddForm;

    // 정의 로드 시 팝업 폼 구성(필드+저장쿼리). 조건 미충족(조회 전용)이면 추가 버튼 자체가 숨는다.
    private void BuildAddForm()
    {
        _addFormDef = null;
        _addSaveQueryId = null;
        _addRequiredPermissions = Array.Empty<string>();
        _addBindingDeclaredPermission = null;
        _addOpen = false;
        if (_definition is null) return;
        if (_definition.Layout is null)
        {
            if (_definition.Fields.Count > 0 && !string.IsNullOrWhiteSpace(_definition.SaveQueryId))
            {
                _addFormDef = new ScreenDefinition(string.Empty, string.Empty, _definition.Fields);
                _addSaveQueryId = _definition.SaveQueryId;
                _addRequiredPermissions = NonBlankPermissions(_definition.SaveRequiredPermission);
                _addBindingDeclaredPermission = _definition.SaveRequiredPermission;
            }
            return;
        }
        var fields = CollectFields(_definition.Layout, enforcePermissions: false).Where(f => f.Key.Length > 0).ToList();
        var saveForm = CollectForms(_definition.Layout, enforcePermissions: false)
            .FirstOrDefault(form => !string.IsNullOrWhiteSpace(form.SaveQueryId));
        if (fields.Count > 0 && saveForm?.SaveQueryId is { } save)
        {
            _addFormDef = new ScreenDefinition(string.Empty, string.Empty, fields);
            _addSaveQueryId = save;
            _addRequiredPermissions = PermissionPathTo(_definition.Layout, saveForm);
            _addBindingDeclaredPermission = saveForm.RequiredPermission;
        }
    }

    private void OnAddNewRequested()
    {
        if (!CanAddNew) return;
        _saved = false;
        _addModel = new Dictionary<string, object?>(StringComparer.Ordinal);
        if (_addFormDef is not null)
            MetaModelDefaults.EnsureGeneratedValues(_addFormDef.Fields, _addModel);
        _addFieldErrors = new(StringComparer.Ordinal);
        _addErrors = new();
        _addSaving = false;
        _addOpen = true;
        _modalFocusPending = true;   // 렌더 후 nxDialogOpen(첫 포커스 이동+Tab 트랩)
    }

    // 모달 포커스 관리 — JS interop은 렌더 이후에만 안전. try/catch는 bUnit(Loose JS) 보호 관례.
    private ElementReference _modalRef;
    private bool _modalFocusPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_modalFocusPending && _addOpen)
        {
            _modalFocusPending = false;
            try { await JS.InvokeVoidAsync("nxDialogOpen", _modalRef); } catch { /* JS 미탑재(테스트) */ }
        }
    }

    // 닫기 4경로(백드롭/×/취소/Escape) 단일화 — 요소가 아직 DOM에 있는 동안 트랩 해제+포커스 복귀 후 제거.
    private async Task CloseAddAsync()
    {
        try { await JS.InvokeVoidAsync("nxDialogClose", _modalRef); } catch { /* JS 미탑재(테스트) */ }
        _addOpen = false;
    }

    private async Task OnModalKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_addSaving) await CloseAddAsync();
    }

    private async Task SaveAddAsync()
    {
        if (_addFormDef is null || _addSaveQueryId is null || !CanAddNew) return;
        _addErrors = new();
        _addFieldErrors = ValidateFields(_addFormDef.Fields, _addModel);
        if (_addFieldErrors.Count > 0) return;
        _addSaving = true;
        try
        {
            var isBridge = _addSaveQueryId.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
            var saved = isBridge
                ? await ExecuteMetaCommandAsync(_addSaveQueryId, _addModel, _addErrors)
                : await Api.ExecuteCommandAsync(_addSaveQueryId, _addModel);
            if (saved)
            {
                _saved = true;
                await CloseAddAsync();
                await ReloadDataAsync();   // 신규 행을 그리드에 즉시 반영
            }
            else if (!isBridge)
            {
                _addErrors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
            }
        }
        finally { _addSaving = false; }
    }

    // 삭제 — 확인 다이얼로그(비블로킹 모달) 후 선택 행마다 DeleteQueryId 커맨드 실행, 완료 시 재조회.
    // 파라미터는 행 원본 키(UPPER_SNAKE) + camelCase 사본을 병행 전송 — 쿼리 @param(@plantId 등)이
    // 어느 관례든 자동 매칭된다(선언 안 된 파라미터는 게이트웨이/디스패처가 무시).
    private async Task OnDeleteRowsAsync(List<Dictionary<string, object?>> rows)
    {
        if (_definition?.DeleteQueryId is not { Length: > 0 } deleteQueryId
            || rows.Count == 0
            || !FlatDeleteAccess.Allowed)
            return;

        // DialogService는 호스트 DI(테스트 등 미등록 환경은 확인 생략 — 서버 권한이 최종 게이트).
        var dialogs = Services.GetService(typeof(Radzen.DialogService)) as Radzen.DialogService;
        if (dialogs is not null)
        {
            var msg = string.Format(T("common.deleteConfirm", "선택한 {0}건을 삭제하시겠습니까? 되돌릴 수 없습니다."), rows.Count);
            var ok = await dialogs.Confirm(msg, T("common.deleteConfirmTitle", "삭제 확인"),
                new Radzen.ConfirmOptions { OkButtonText = T("common.delete", "삭제"), CancelButtonText = T("common.cancel", "취소") });
            if (ok != true) return;
        }

        // 명명 삭제는 기존 쿼리 게이트웨이를 유지한다. bridge 삭제는 타입이 있는 애플리케이션 명령이므로
        // bridge 저장/버튼과 같은 드라이버 경로를 사용하고, 선택 행 하나를 명령 입력 하나로 전달한다.
        var isBridge = deleteQueryId.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
        var deleted = 0;
        foreach (var row in rows)
        {
            var parameters = BuildDeleteParameters(row);
            var succeeded = isBridge
                ? await ExecuteMetaCommandAsync(deleteQueryId, parameters)
                : await Api.ExecuteCommandAsync(deleteQueryId, parameters);
            if (succeeded) deleted++;
        }
        if (deleted > 0) await ReloadDataAsync();   // 실패는 ApiClient 전역 토스트가 사유(403 등)를 알린다.
    }

    // 일괄 명령(상태전이) — 확인 다이얼로그 후 선택 행마다 가드된 전이 커맨드 실행, 완료 시 재조회.
    // 소스 상태 밖 행은 쿼리 가드로 무영향(affected 0) — 혼합 선택도 안전하다.
    private async Task OnBulkCommandAsync((BulkCommandDefinition Command, List<Dictionary<string, object?>> Rows) e)
    {
        if (e.Rows.Count == 0
            || !GetBindingAccess(
                e.Command.CommandQueryId,
                e.Command.RequiredPermission,
                isWrite: true).Allowed)
            return;
        var dialogs = Services.GetService(typeof(Radzen.DialogService)) as Radzen.DialogService;
        if (dialogs is not null)
        {
            var msg = e.Command.ConfirmMessage
                ?? string.Format(T("common.bulkConfirm", "선택한 {0}건을 '{1}' 처리하시겠습니까?"), e.Rows.Count, e.Command.Label);
            var ok = await dialogs.Confirm(msg, e.Command.Label,
                new Radzen.ConfirmOptions { OkButtonText = e.Command.Label, CancelButtonText = T("common.cancel", "취소") });
            if (ok != true) return;
        }

        // 브리지 일괄명령(bridge: 접두) — 행 단위 커맨드가 아니라 호스트 페이지가 배선한 핸들러로
        // 선택 행 전체를 1회 위임한다(원자성 필요 명령: MRP 전환 등). 미배선이면 조용히 실패하지 않는다.
        if (e.Command.CommandQueryId.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase))
        {
            // 전용 호스트가 다중 행 집계/추가 입력 dialog를 제공하면 행 단위 catalog fallback보다 우선한다.
            // MRP 전환처럼 여러 제안을 한 트랜잭션으로 보내야 하는 명령을 행마다 쪼개 실행하지 않기 위함이다.
            if (BridgeBulkHandler is not null)
            {
                if (await BridgeBulkHandler(e.Command, e.Rows)) await ReloadDataAsync();
                return;
            }

            var drivers = CommandDrivers;
            if (drivers?.Contains(e.Command.CommandQueryId) == true)
            {
                var bridgeApplied = 0;
                foreach (var row in e.Rows)
                {
                    var result = await drivers.ExecuteAsync(
                        e.Command.CommandQueryId, row, CommandContext);
                    if (result.Success) bridgeApplied++;
                    else AddMetaCommandError(result);
                }
                if (bridgeApplied > 0) await ReloadDataAsync();
                return;
            }

            (Services.GetService(typeof(Radzen.NotificationService)) as Radzen.NotificationService)?.Notify(
                new Radzen.NotificationMessage
                {
                    Severity = Radzen.NotificationSeverity.Warning,
                    Summary = T("common.bridgeBulkUnwired", "이 명령은 전용 페이지에서만 실행할 수 있습니다."),
                    Duration = 3000,
                });
            return;
        }

        var applied = 0;
        foreach (var row in e.Rows)
            if (await Api.ExecuteCommandAsync(e.Command.CommandQueryId, BuildDeleteParameters(row))) applied++;
        if (applied > 0) await ReloadDataAsync();   // 실패는 ApiClient 전역 토스트가 사유를 알린다.
    }

    private static Dictionary<string, object?> BuildDeleteParameters(Dictionary<string, object?> row)
    {
        var p = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in row)
        {
            p[k] = v;
            p.TryAdd(CamelizeKey(k), v);   // PLANT_ID → plantId(쿼리 파라미터 관례)
        }
        return p;
    }

    // UPPER_SNAKE → camelCase(VENDOR_ITEM_ID → vendorItemId). 구분자 없는 키는 소문자 시작만 보정.
    internal static string CamelizeKey(string key)
    {
        var parts = key.Split('_', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return key;
        var head = parts[0].ToLowerInvariant();
        var tail = string.Concat(parts.Skip(1).Select(s =>
            char.ToUpperInvariant(s[0]) + (s.Length > 1 ? s[1..].ToLowerInvariant() : "")));
        return head + tail;
    }

    // ── P1-1 그리드 행 선택 → 폼 로드(레거시 표준 편집 흐름) ────────────────────
    // 컬럼 키(UPPER_SNAKE)와 필드 키(camel)는 구분자 제거·소문자 정규화로 매칭한다(BATCH_ID ↔ batchId).
    // 행 딕셔너리의 모든 컬럼(표시 안 되는 컬럼 포함)을 대상으로 하며, 격리 폼은 폼별 모델에 반영한다.
    private EventCallback<Dictionary<string, object?>> _rowSelect;
    private EventCallback<(string Scope, Dictionary<string, object?> Row)> _scopedRowSelect;
    private bool _isFlatManageEditing;

    private Task OnRowSelectedAsync(Dictionary<string, object?> row)
    {
        if (_definition is null) return Task.CompletedTask;

        // 관리 화면의 행 전환은 이전 행에서만 존재하던 값을 남기지 않도록 모델을 먼저 비운다.
        // 레이아웃/조회 화면의 기존 선택 동작은 그대로 유지한다.
        if (IsFlatManageInlineEditor)
        {
            _model = new Dictionary<string, object?>(StringComparer.Ordinal);
            _errors = new();
            _fieldErrors = new(StringComparer.Ordinal);
            _saved = false;
        }

        var byNorm = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var (k, v) in row) byNorm[NormalizeRowKey(k)] = v;

        void Apply(IEnumerable<FieldDefinition> fields, Dictionary<string, object?> model)
        {
            foreach (var f in fields)
            {
                var fieldKey = NormalizeRowKey(f.Key);
                if (byNorm.TryGetValue(fieldKey, out var v))
                    model[f.Key] = CoerceForField(f, v);
                // 작업실행 폼은 사용자 의미(GOOD/DEFECT)를 쓰고 조회 행은 DB 누계(COMPLETE/SCRAP)를 쓴다.
                // 선택 시 명시적 별칭만 적용해 다른 화면의 임의 컬럼을 섞지 않는다.
                else if (fieldKey == "goodqty" && byNorm.TryGetValue("completeqty", out var complete))
                    model[f.Key] = CoerceForField(f, complete);
                else if (fieldKey == "defectqty" && byNorm.TryGetValue("scrapqty", out var scrap))
                    model[f.Key] = CoerceForField(f, scrap);
            }

            // 버튼 상태/누계 상한 판정에 필요한 값은 화면에 입력 필드로 노출하지 않아도 실행 모델에 보존한다.
            // 고정 allow-list만 복사해 일반 조회 행 전체가 폼 모델로 새는 것을 막는다.
            foreach (var key in new[] { "IS_HOLD", "START_QTY", "PLAN_QTY" })
                if (byNorm.TryGetValue(NormalizeRowKey(key), out var value)) model[key] = value;
        }

        if (_definition.Layout is not null)
        {
            Apply(CollectFields(_definition.Layout, skipIsolatedForms: true), _model);
            foreach (var (key, form) in _isolatedForms)
                if (_formModels.TryGetValue(key, out var m)) Apply(CollectFields(form), m);
        }
        else
        {
            Apply(_definition.Fields, _model);
        }
        if (IsFlatManageInlineEditor) _isFlatManageEditing = true;
        return Task.CompletedTask;
    }

    /// <summary>
    /// scope 그리드 선택은 이전 선택/입력을 병합하지 않고 해당 aggregate 모델만 새 행으로 교체합니다.
    /// 다른 scope(LOT, 작업지시, 승인 예외)는 그대로 유지되어 서로의 식별자·버전이 명령 payload에 섞이지 않습니다.
    /// </summary>
    private Task OnScopedRowSelectedAsync((string Scope, Dictionary<string, object?> Row) selection)
    {
        if (_definition?.Layout is null
            || LayoutRenderer.BindingScopeKey(selection.Scope) is not { } scope)
            return Task.CompletedTask;

        var model = new Dictionary<string, object?>(selection.Row, StringComparer.Ordinal);
        var byNorm = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var pair in selection.Row)
            byNorm[NormalizeRowKey(pair.Key)] = pair.Value;
        foreach (var field in FieldsForBindingScope(scope))
        {
            var normalized = NormalizeRowKey(field.Key);
            if (byNorm.TryGetValue(normalized, out var value))
                model[field.Key] = CoerceForField(field, value);
            else if (normalized == "goodqty" && byNorm.TryGetValue("completeqty", out var complete))
                model[field.Key] = CoerceForField(field, complete);
            else if (normalized == "defectqty" && byNorm.TryGetValue("scrapqty", out var scrap))
                model[field.Key] = CoerceForField(field, scrap);
        }

        _scopeModels[scope] = model;
        _errors = new();
        _fieldErrors = new(StringComparer.Ordinal);
        _saved = false;
        return Task.CompletedTask;
    }

    /// <summary>평면 관리 편집기를 빈 신규 입력 상태로 되돌립니다.</summary>
    private void ResetFlatManageEditor()
    {
        if (!IsFlatManageInlineEditor) return;
        _model = new Dictionary<string, object?>(StringComparer.Ordinal);
        EnsureSharedModelDefaults();
        _isFlatManageEditing = false;
        _errors = new();
        _fieldErrors = new(StringComparer.Ordinal);
        _saved = false;
    }

    private static string NormalizeRowKey(string key) => key.Replace("_", "").ToLowerInvariant();

    // Boolean 필드는 DB 표현(0/1·true) 정규화, 그 외는 입력 바인딩용 문자열.
    private static object? CoerceForField(FieldDefinition f, object? v)
        => f.Type == FieldType.Boolean
            ? v is bool b ? b : v?.ToString() is "1" or "true" or "True" or "TRUE"
            : v?.ToString();

    private async Task AutoRefreshLoopAsync(int intervalSeconds, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(2, intervalSeconds)));
            while (await timer.WaitForNextTickAsync(ct))
            {
                await ReloadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { /* 화면 이탈/재로드 — 정상 종료 */ }
    }

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts = null;
        _pushSubscription?.Dispose();
        _pushSubscription = null;
        if (_uiTextResolved is not null) _uiTextResolved.Changed -= OnUiTextChanged;
    }

    private void OnFormModelChanged((string Key, Dictionary<string, object?> Model) change)
        => _formModels[change.Key] = change.Model;

    private void OnScopeModelChanged((string Key, Dictionary<string, object?> Model) change)
        => _scopeModels[change.Key] = change.Model;

    private async Task Save()
    {
        if (!CanSaveFlat) return;
        _saved = false;
        _errors = new();
        _commandMessage = null;
        _commandMessageIsWarning = false;
        _fieldErrors = Validate();
        if (_fieldErrors.Count > 0) return;

        // SaveQueryId(명명 쓰기쿼리)가 바인딩돼 있으면 폼 값(필드 Key→값)을 command 게이트웨이로 보내 저장한다.
        // 감사 컬럼(@currentUser/@utcNow)은 서버 게이트웨이가 토큰·UTC로 주입하므로 폼이 보낼 필요가 없다.
        if (string.IsNullOrWhiteSpace(_definition?.SaveQueryId))
        {
            _errors.Add(T("common.noSaveQuery", "이 화면에는 저장(쓰기) 쿼리가 바인딩돼 있지 않습니다."));
            return;
        }

        _saving = true;
        try
        {
            var isBridge = _definition.SaveQueryId.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
            _saved = isBridge
                ? await ExecuteMetaCommandAsync(_definition.SaveQueryId, _model)
                : await Api.ExecuteCommandAsync(_definition.SaveQueryId, _model);
            if (!_saved)
            {
                if (!isBridge) _errors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
            }
            else
            {
                if (_definition.Purpose == ScreenPurpose.Register) ResetRegistrationModel();
                // 신규 저장이 성공한 시점부터 같은 모델은 기존 항목이다. 이후 버튼을 '변경 저장'으로
                // 전환해 같은 키로 신규 등록을 반복하는 실수를 막는다.
                else if (IsFlatManageInlineEditor) _isFlatManageEditing = true;
                await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영(리로드 없이 새 행 표시)
            }
        }
        finally
        {
            _saving = false;
        }
    }

    // 공유 경로 검증 — 격리 폼(Isolated) 내부 필드는 제외한다(값이 폼별 모델에 있어 공유 모델 기준으론
    // 항상 미입력으로 오판된다). 격리 폼 검증은 RunCommand의 폼별 경로가 담당.
    // P2-7 — 검증 결과는 필드별 맵(_fieldErrors)으로 렌더러에 캐스케이드해 필드 아래 인라인 표시한다.
    private Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);

    /// <summary>현재 공유 모델의 자동 생성값과 컬렉션 최소 항목을 멱등하게 준비합니다.</summary>
    private void EnsureSharedModelDefaults()
    {
        if (_definition is null) return;
        if (_definition.Layout is null)
            MetaModelDefaults.EnsureGeneratedValues(_definition.Fields, _model);
        else
            MetaModelDefaults.EnsureLayoutDefaults(
                _definition.Layout,
                _model,
                CanAccessNode,
                skipIsolatedForms: true);
    }

    /// <summary>등록 성공 뒤에만 새 모델로 교체해 다음 요청의 UUID와 최소 반복 항목을 새로 준비합니다.</summary>
    private void ResetRegistrationModel()
    {
        _model = new Dictionary<string, object?>(StringComparer.Ordinal);
        EnsureSharedModelDefaults();
        _fieldErrors = new(StringComparer.Ordinal);

        foreach (var (key, form) in _isolatedForms)
        {
            var model = new Dictionary<string, object?>(StringComparer.Ordinal);
            MetaModelDefaults.EnsureGeneratedValues(CollectFields(form), model);
            _formModels[key] = model;
        }
    }

    private Dictionary<string, string> Validate()
    {
        if (_definition is null) return new(StringComparer.Ordinal);
        var fields = _definition.Layout is not null
            ? CollectFields(_definition.Layout, skipIsolatedForms: true)
            : _definition.Fields;
        var errors = ValidateFields(fields, _model);
        if (_definition.Layout is not null)
        {
            foreach (var collection in CollectCollections(_definition.Layout)
                         .Where(collection => LayoutRenderer.BindingScopeKey(collection.BindingScope) is null))
                ValidateCollection(collection, _model, errors);
        }
        return errors;
    }

    // 검증 메시지는 현재 언어의 템플릿({0}=필드 라벨)으로 조립한다(P3-14 v3, 클라이언트 대면 메시지 다국어).
    private Dictionary<string, string> ValidateFields(IEnumerable<FieldDefinition> fields, Dictionary<string, object?> model)
    {
        var template = T("common.requiredField", "{0}은(는) 필수입니다.");
        var errors = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var field in fields.Where(f => f.Required))
        {
            if (!model.TryGetValue(field.Key, out var v) || string.IsNullOrWhiteSpace(v?.ToString()))
                errors[field.Key] = string.Format(template, field.Label);
        }
        return errors;
    }

    /// <summary>
    /// 반복 항목은 루트 모델 필드와 분리해 개수와 항목 스키마를 검증합니다.
    /// 오류 키에는 <c>items[0].specId</c>처럼 컬렉션 키와 항목 인덱스를 포함해 인라인 표시 대상을 보존합니다.
    /// </summary>
    private void ValidateCollection(
        CollectionWidget collection,
        IReadOnlyDictionary<string, object?> model,
        Dictionary<string, string> errors)
    {
        if (string.IsNullOrWhiteSpace(collection.CollectionKey)) return;
        var items = MetaModelDefaults.GetCollectionItems(model, collection.CollectionKey);
        var label = string.IsNullOrWhiteSpace(collection.Label) ? collection.CollectionKey : collection.Label.Trim();
        var itemLabel = string.IsNullOrWhiteSpace(collection.ItemLabel) ? "항목" : collection.ItemLabel.Trim();
        var minimum = Math.Max(0, collection.MinItems);
        if (items.Count < minimum)
            errors[collection.CollectionKey] = $"{label}은(는) 최소 {minimum}개가 필요합니다.";
        if (collection.MaxItems is int maximum && maximum >= 0 && items.Count > maximum)
            errors[collection.CollectionKey] = $"{label}은(는) 최대 {maximum}개까지 입력할 수 있습니다.";

        var fields = (collection.Fields ?? [])
            .Where(CanAccessNode)
            .Select(field => field.Field
                ?? new FieldDefinition(field.FieldKey ?? string.Empty, field.FieldKey ?? string.Empty))
            .ToArray();
        for (var index = 0; index < items.Count; index++)
        {
            foreach (var (fieldKey, message) in ValidateFields(fields, items[index]))
                errors[$"{collection.CollectionKey}[{index}].{fieldKey}"] = $"{itemLabel} {index + 1}: {message}";
        }
    }

    // 레이아웃 명령 실행 — 커맨드가 격리 폼(Isolated)의 SaveQueryId면 그 폼의 모델·필드만으로 검증/전송하고
    // (Phase-2 멀티폼: 폼 간 값·검증이 섞이지 않는다), 그 외에는 기존대로 공유 Model을 쓴다(하위호환).
    private Task RunButtonCommand(ButtonWidget button)
        => CanAccessNode(button)
            ? RunCommand(button.Command, button.RequiredPermission, button.BindingScope)
            : Task.CompletedTask;

    private async Task RunCommand(
        string? command,
        string? requiredPermission = null,
        string? bindingScope = null)
    {
        _saved = false;
        _errors = new();
        _commandMessage = null;
        _commandMessageIsWarning = false;
        if (string.IsNullOrWhiteSpace(command)
            || !GetBindingAccess(command, requiredPermission, isWrite: true).Allowed)
            return;

        if (LayoutRenderer.BindingScopeKey(bindingScope) is { } scope)
        {
            var scopedModel = _scopeModels.TryGetValue(scope, out var found)
                ? found
                : new Dictionary<string, object?>(StringComparer.Ordinal);
            var scopedIsBridge = command.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
            // typed bridge driver가 명령별 필수값·상태를 판정한다. 같은 scope의 다른 폼 필수값까지 한꺼번에
            // 검증하면 Track-In과 예외 요청처럼 서로 다른 작업이 동시에 입력돼야 하는 역효과가 생긴다.
            _fieldErrors = scopedIsBridge
                ? new Dictionary<string, string>(StringComparer.Ordinal)
                : ValidateFields(FieldsForBindingScope(scope), scopedModel);
            if (_fieldErrors.Count > 0) return;

            _saved = scopedIsBridge
                ? await ExecuteMetaCommandAsync(command, scopedModel)
                : await Api.ExecuteCommandAsync(command, scopedModel);
            if (!_saved)
            {
                if (!scopedIsBridge) _errors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
                return;
            }

            if (scopedIsBridge)
                _scopeModels[scope] = new Dictionary<string, object?>(StringComparer.Ordinal);
            await ReloadDataAsync();
            return;
        }

        var isolated = _isolatedForms.Values.FirstOrDefault(f =>
            string.Equals(f.SaveQueryId, command, StringComparison.Ordinal));
        if (isolated is not null && LayoutRenderer.FormScopeKey(isolated) is { } key)
        {
            var formModel = _formModels.TryGetValue(key, out var m) ? m : new Dictionary<string, object?>();
            _fieldErrors = ValidateFields(CollectFields(isolated), formModel);
            if (_fieldErrors.Count > 0) return;
            var isBridge = command.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
            _saved = isBridge
                ? await ExecuteMetaCommandAsync(command, formModel)
                : await Api.ExecuteCommandAsync(command, formModel);
            if (!_saved)
            {
                if (!isBridge) _errors.Add(T("common.saveFailed", "저장에 실패했습니다(권한/입력 확인)."));
                return;
            }
            if (_definition?.Purpose == ScreenPurpose.Register)
            {
                var nextModel = new Dictionary<string, object?>(StringComparer.Ordinal);
                MetaModelDefaults.EnsureGeneratedValues(CollectFields(isolated), nextModel);
                _formModels[key] = nextModel;
            }
            else if (isBridge)
            {
                formModel.Clear(); // 재조회 전 이전 VERSION_NO로 다시 누르는 것을 막는다.
            }
            await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영
            return;
        }

        _fieldErrors = Validate();
        if (_fieldErrors.Count > 0) return;
        var sharedIsBridge = command.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase);
        _saved = sharedIsBridge
            ? await ExecuteMetaCommandAsync(command, _model)
            : await Api.ExecuteCommandAsync(command, _model);
        if (!_saved)
        {
            if (!sharedIsBridge) _errors.Add("저장에 실패했습니다(권한/입력 확인).");
            return;
        }
        if (_definition?.Purpose == ScreenPurpose.Register)
            ResetRegistrationModel();
        else if (sharedIsBridge)
            _model = new(); // 새 행을 다시 선택해 갱신된 상태/버전을 사용하게 한다.
        await ReloadDataAsync();   // 저장 결과를 그리드에 즉시 반영
    }

    private IMetaCommandDriverCatalog? _commandDrivers;
    private IMetaPermissionCatalog? _permissionCatalog;
    private bool _permissionCatalogResolved;
    private IMetaPermissionEvaluator? _permissionEvaluator;
    private bool _permissionEvaluatorResolved;

    /// <summary>호스트가 등록한 공통 브리지 드라이버 카탈로그를 회로 범위에서 한 번 찾습니다.</summary>
    private IMetaCommandDriverCatalog? CommandDrivers
        => _commandDrivers ??= Services.GetService(typeof(IMetaCommandDriverCatalog)) as IMetaCommandDriverCatalog;

    /// <summary>
    /// 화면 JSON의 선택적 권한 힌트보다 실제 QueryGateway/bridge 등록 정보를 우선 확인합니다.
    /// 다른 호스트가 이 서비스를 등록하지 않은 경우에는 명시 metadata만 쓰는 하위 호환 모드입니다.
    /// </summary>
    private IMetaPermissionCatalog? PermissionCatalog
    {
        get
        {
            if (_permissionCatalogResolved) return _permissionCatalog;
            _permissionCatalogResolved = true;
            _permissionCatalog = Services.GetService(typeof(IMetaPermissionCatalog)) as IMetaPermissionCatalog;
            return _permissionCatalog;
        }
    }

    private IMetaPermissionEvaluator? PermissionEvaluator
    {
        get
        {
            if (_permissionEvaluatorResolved) return _permissionEvaluator;
            _permissionEvaluatorResolved = true;
            _permissionEvaluator = Services.GetService(typeof(IMetaPermissionEvaluator)) as IMetaPermissionEvaluator;
            return _permissionEvaluator;
        }
    }

    private MetaCommandExecutionContext CommandContext
        => new(UiId, ClientChannel, DeviceId);

    /// <summary>일반/격리 폼의 bridge 명령을 raw SQL 대신 등록된 typed 드라이버로 실행합니다.</summary>
    private async Task<bool> ExecuteMetaCommandAsync(
        string command,
        IReadOnlyDictionary<string, object?> parameters,
        List<string>? errorTarget = null)
    {
        var errors = errorTarget ?? _errors;
        var drivers = CommandDrivers;
        if (drivers is null || !drivers.Contains(command))
        {
            errors.Add(string.Format(T("common.unregisteredBridgeCommand", "등록되지 않은 브리지 명령입니다: {0}"), command));
            return false;
        }

        var availability = drivers.CanExecute(command, parameters, CommandContext);
        if (!availability.CanExecute)
        {
            errors.Add(availability.DisabledReason ?? T("common.commandUnavailableInState", "현재 상태에서는 명령을 실행할 수 없습니다."));
            return false;
        }

        var result = await drivers.ExecuteAsync(command, parameters, CommandContext);
        if (!result.Success)
        {
            AddMetaCommandError(result, errors);
        }
        else if (!string.IsNullOrWhiteSpace(result.Message))
        {
            _commandMessage = result.Message;
            _commandMessageIsWarning = result.IsWarning;
        }
        return result.Success;
    }

    /// <summary>선택 작업지시의 상태에 맞지 않는 toolbar 액션은 사유와 함께 비활성화합니다.</summary>
    private string? GetBulkCommandDisabledReason(
        BulkCommandDefinition command,
        IReadOnlyList<Dictionary<string, object?>> rows)
    {
        var access = GetBindingAccess(command.CommandQueryId, command.RequiredPermission, isWrite: true);
        if (!access.Allowed) return access.DeniedReason;

        // 명시적 호스트 handler는 선택 행 전체를 검증하므로 행 단위 driver availability를 적용하지 않는다.
        if (BridgeBulkHandler is not null) return null;
        if (!command.CommandQueryId.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase)
            || CommandDrivers?.Contains(command.CommandQueryId) != true)
            return null;

        foreach (var row in rows)
        {
            var availability = CommandDrivers.CanExecute(command.CommandQueryId, row, CommandContext);
            if (!availability.CanExecute) return availability.DisabledReason;
        }
        return null;
    }

    /// <summary>ButtonWidget도 현재 선택 모델 또는 격리 폼 상태에 맞지 않는 액션을 사유와 함께 비활성화합니다.</summary>
    private string? GetCommandDisabledReason(ButtonWidget button)
    {
        var access = GetNodeAccess(button);
        if (!access.Allowed) return access.DeniedReason;

        var command = button.Command;
        if (string.IsNullOrWhiteSpace(command)
            || !command.StartsWith("bridge:", StringComparison.OrdinalIgnoreCase)
            || CommandDrivers?.Contains(command) != true)
            return null;

        IReadOnlyDictionary<string, object?> parameters = _model;
        if (LayoutRenderer.BindingScopeKey(button.BindingScope) is { } scope)
        {
            parameters = _scopeModels.TryGetValue(scope, out var scopedModel)
                ? scopedModel
                : new Dictionary<string, object?>();
        }
        else
        {
            var isolated = _isolatedForms.Values.FirstOrDefault(f =>
                string.Equals(f.SaveQueryId, command, StringComparison.Ordinal));
            if (isolated is not null && LayoutRenderer.FormScopeKey(isolated) is { } key
                && _formModels.TryGetValue(key, out var formModel))
                parameters = formModel;
        }

        var availability = CommandDrivers.CanExecute(command, parameters, CommandContext);
        return availability.CanExecute ? null : availability.DisabledReason;
    }

    private void AddMetaCommandError(MetaCommandResult result, List<string>? errorTarget = null)
    {
        var errors = errorTarget ?? _errors;
        var message = result.Error ?? T("common.commandFailed", "명령 실행에 실패했습니다.");
        errors.Add(result.StatusCode == 409
            ? string.Format(T("common.concurrencyConflict", "동시성 충돌(409): {0}"), message)
            : message);
    }

