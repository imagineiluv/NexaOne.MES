    // 그리드 위젯 '전용' 쿼리 id — 레이아웃 하이브리드 페이징 대상 판정용(GridWidget만).
    private IEnumerable<string> CollectGridQueryIds(LayoutNode node)
    {
        if (!CanAccessNode(node)) yield break;
        switch (node)
        {
            case GridWidget g when !string.IsNullOrWhiteSpace(g.QueryId):
                yield return g.QueryId!;
                break;
            case SectionNode s: foreach (var child in s.Children ?? []) foreach (var id in CollectGridQueryIds(child)) yield return id; break;
            case RowNode r: foreach (var child in r.Children ?? []) foreach (var id in CollectGridQueryIds(child)) yield return id; break;
            case ColumnNode c: foreach (var child in c.Children ?? []) foreach (var id in CollectGridQueryIds(child)) yield return id; break;
        }
    }

