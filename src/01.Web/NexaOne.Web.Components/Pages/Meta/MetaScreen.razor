    private IEnumerable<FieldDefinition> FieldsForBindingScope(string scope)
        => _definition?.Layout is null
            ? Enumerable.Empty<FieldDefinition>()
            : CollectForms(_definition.Layout)
                .Where(form => LayoutRenderer.BindingScopeKey(form.BindingScope) == scope)
                .SelectMany(form => CollectFields(form));

