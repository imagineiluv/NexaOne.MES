@* Low-Code 레이아웃 트리 렌더러(재귀). Section/Row/Column/Text는 직접, Grid/Form/Field는 기존 렌더러 위임,
   CommandButton은 콜백. 데이터(QueryResults)·콜백(OnCommand)·공유 Model은 부모(MetaScreen)가 주입한다. *@
@using NexaOne.Web.Services.Meta
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

@switch (Node)
{
    case SectionNode s:
        <section class="layout-section">
            @if (!string.IsNullOrWhiteSpace(s.Title)) { <h3 class="layout-section-title">@s.Title</h3> }
            @RenderChildren(s.Children)
        </section>
        break;

    case RowNode r:
        <div class="layout-row" style="display:flex; flex-wrap:wrap; gap:1rem;">
            @RenderChildren(r.Children)
        </div>
        break;

    case ColumnNode c:
        <div class="layout-column" style="@ColumnStyle(c.Span)">
            @RenderChildren(c.Children)
        </div>
        break;

    case GridWidget g:
        <MetaGridRenderer Columns="g.Columns ?? Array.Empty<GridColumnDefinition>()" Rows="RowsFor(g.QueryId)"
                          Loading="LoadingData" OnRowSelect="OnRowSelect" />
        break;

    @* Form/Field는 기본적으로 화면 공유 Model(동일 Dictionary 참조)에 바인딩한다 — 위젯 간 값 즉시 공유(의도된 설계).
       Isolated=true(Phase-2 멀티폼)면 폼 전용 모델(FormModels[key])에 바인딩해 폼 간 값이 섞이지 않는다. *@
    case FormWidget f:
    {
        var scopeKey = FormScopeKey(f);
        @if (f.Isolated && scopeKey is not null && FormModels.TryGetValue(scopeKey, out var formModel))
        {
            <MetaFormRenderer Definition="FormDefinition(f)" Model="formModel"
                              ModelChanged="m => OnFormModelChanged.InvokeAsync((scopeKey, m))" />
        }
        else
        {
            <MetaFormRenderer Definition="FormDefinition(f)" Model="Model" ModelChanged="OnModelChanged" />
        }
        break;
    }

    case FieldWidget fw:
        <MetaFormRenderer Definition="SingleFieldDefinition(fw)" Model="Model" ModelChanged="OnModelChanged" />
        break;

    case ButtonWidget b:
        <button class="layout-command" @onclick="() => RunButtonAsync(b)" disabled="@string.IsNullOrWhiteSpace(b.Command)">@b.Label</button>
        break;

    case TextWidget t:
        @if (t.IsLabel) { <label class="layout-text">@t.Text</label> }
        else { <span class="layout-text">@t.Text</span> }
        break;

    @* KPI 카드(Phase-2) — 바인딩 쿼리 첫 행의 ValueColumn 값을 큰 숫자로. 미실행/공백은 '—'(빈 카드 방지).
       스타일은 디자인 토큰 클래스(smartux.css --nx-*) 단일 출처. *@
    case KpiWidget k:
        @* LinkUiId(P3-12) — 지정 시 카드 클릭=관련 화면 드릴다운. *@
        <div class="layout-kpi @(string.IsNullOrWhiteSpace(k.LinkUiId) ? "" : "linked")"
             title="@(string.IsNullOrWhiteSpace(k.LinkUiId) ? null : "클릭하여 상세 화면으로 이동")"
             @onclick="() => KpiNavigate(k)">
            <div class="layout-kpi-label">@k.Label</div>
            <div class="layout-kpi-value">
                @KpiValue(k)@if (!string.IsNullOrWhiteSpace(k.Unit)) { <small class="layout-kpi-unit">@k.Unit</small> }
            </div>
        </div>
        break;

    @* 트렌드 차트(Phase-2 실시간 v2) — 네이티브 SVG 라인(외부 라이브러리 없음). 데이터 부재는 안내 문구. *@
    case TrendChartWidget tc:
    {
        var points = TrendPoints(tc);
        <div class="layout-kpi" style="min-width:16rem;">
            <div class="layout-kpi-label">@tc.Label</div>
            @if (points.Count < 2)
            {
                <div style="color:#9ca3af; font-size:0.75rem; padding:0.5rem 0;">표시할 데이터가 부족합니다.</div>
            }
            else
            {
                var (polyline, pts, min, max, last) = TrendGeometry(points);
                var firstTime = points[0].Time;
                var lastTime = points[^1].Time;
                @* P3-13 — 그리드라인(상/중/하) + 포인트 마커(네이티브 <title> 툴팁 = 값) + 마지막 점 강조. *@
                <svg viewBox="0 0 300 80" preserveAspectRatio="none" style="width:100%; height:80px; display:block;">
                    <line x1="0" y1="4" x2="300" y2="4" stroke="#eef1f4" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <line x1="0" y1="40" x2="300" y2="40" stroke="#e5e9ef" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
                    <line x1="0" y1="76" x2="300" y2="76" stroke="#eef1f4" stroke-width="1" vector-effect="non-scaling-stroke" />
                    <polyline points="@polyline" fill="none" stroke="#15b89a" stroke-width="2" vector-effect="non-scaling-stroke" />
                    @foreach (var pt in pts)
                    {
                        <circle cx="@pt.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                cy="@pt.Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                r="2" fill="#15b89a" opacity="0.85"><title>@pt.Tooltip</title></circle>
                    }
                    <circle cx="@pts[^1].X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                            cy="@pts[^1].Y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                            r="3.2" fill="#0fa085"><title>현재 @pts[^1].Tooltip</title></circle>
                </svg>
                <div style="display:flex; justify-content:space-between; font-size:0.688rem; color:#6b7280;">
                    <span>min @min</span><span>현재 @last</span><span>max @max</span>
                </div>
                @* 시간축 라벨(P3-13, TimeColumn 지정 시) — 표시 구간의 첫/마지막 표본 시각. *@
                @if (firstTime is not null || lastTime is not null)
                {
                    <div style="display:flex; justify-content:space-between; font-size:0.625rem; color:#9ca3af;">
                        <span>@firstTime</span><span>@lastTime</span>
                    </div>
                }
            }
        </div>
        break;
    }

    @* 상태 뱃지(Phase-2) — 값→심각도 규칙 매칭. 미매칭 값은 neutral 원문 표시(신규 상태가 화면을 깨지 않게). *@
    case BadgeWidget bw:
    {
        var (text, severity) = BadgeFor(bw);
        <div class="layout-badge">
            @if (!string.IsNullOrWhiteSpace(bw.Label)) { <span class="layout-badge-label">@bw.Label</span> }
            <span class="nx-badge nx-badge-@severity">@text</span>
        </div>
        break;
    }

    default:
        @* 알 수 없는 노드 종류는 아무것도 렌더하지 않는다(서버/역직렬화 상위에서 검증됨). *@
        break;
}

@code {
    [Parameter, EditorRequired] public LayoutNode Node { get; set; } = default!;
    [Parameter] public Dictionary<string, object?> Model { get; set; } = new();
    [Parameter] public EventCallback<Dictionary<string, object?>> ModelChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<Dictionary<string, object?>>> QueryResults { get; set; }
        = new Dictionary<string, IReadOnlyList<Dictionary<string, object?>>>();
    [Parameter] public EventCallback<string> OnCommand { get; set; }
    // Phase-2 멀티폼 — 격리 폼(Isolated)의 폼별 모델(스코프 키→모델). MetaScreen이 로드 시 사전 시드한다.
    [Parameter] public IReadOnlyDictionary<string, Dictionary<string, object?>> FormModels { get; set; }
        = new Dictionary<string, Dictionary<string, object?>>();
    [Parameter] public EventCallback<(string Key, Dictionary<string, object?> Model)> OnFormModelChanged { get; set; }
    // P1-1 — 그리드 행 클릭 콜백(MetaScreen이 폼에 로드). 미배선이면 그리드가 선택 불가로 렌더된다.
    [Parameter] public EventCallback<Dictionary<string, object?>> OnRowSelect { get; set; }
    // P1-3 — 조회 진행 중 표시 전달.
    [Parameter] public bool LoadingData { get; set; }

    // P1-2 — 파괴적 명령 보호: ConfirmMessage가 있으면 브라우저 confirm 통과 시에만 실행한다.
    private async Task RunButtonAsync(ButtonWidget b)
    {
        if (!string.IsNullOrWhiteSpace(b.ConfirmMessage)
            && !await JS.InvokeAsync<bool>("confirm", b.ConfirmMessage))
            return;
        await OnCommand.InvokeAsync(b.Command);
    }

    /// <summary>격리 폼 스코프 키 — Id 우선, 없으면 SaveQueryId, 둘 다 없으면 null(공유로 저하).</summary>
    internal static string? FormScopeKey(FormWidget f)
        => f.Id is { Length: > 0 } ? f.Id : (f.SaveQueryId is { Length: > 0 } ? f.SaveQueryId : null);

    // 자식은 재귀로 child LayoutRenderer를 그린다. 시퀀스 번호는 소스 위치당 상수(반복마다 동일)로 두고,
    // 노드 정체성(Id 우선)으로 SetKey 해 디자이너의 재정렬/삽입/삭제 시 Blazor가 인스턴스를 유지(중첩 폼
    // 포커스 보존)하게 한다 — 데이터 의존 시퀀스 번호는 diff 정합을 깨므로 사용하지 않는다.
    private RenderFragment RenderChildren(IReadOnlyList<LayoutNode>? children) => builder =>
    {
        if (children is null) return;
        foreach (var child in children)
        {
            builder.OpenComponent<LayoutRenderer>(0);
            builder.SetKey(child.Id is { Length: > 0 } id ? id : child);
            builder.AddAttribute(1, nameof(Node), child);
            builder.AddAttribute(2, nameof(Model), Model);
            builder.AddAttribute(3, nameof(ModelChanged), ModelChanged);
            builder.AddAttribute(4, nameof(QueryResults), QueryResults);
            builder.AddAttribute(5, nameof(OnCommand), OnCommand);
            builder.AddAttribute(6, nameof(FormModels), FormModels);
            builder.AddAttribute(7, nameof(OnFormModelChanged), OnFormModelChanged);
            builder.AddAttribute(8, nameof(OnRowSelect), OnRowSelect);
            builder.AddAttribute(9, nameof(LoadingData), LoadingData);
            builder.CloseComponent();
        }
    };

    // null = 미실행(MetaGridRenderer가 안내 문구), 그 외 = 행. queryId 미바인딩/결과맵 부재는 null.
    private IReadOnlyList<Dictionary<string, object?>>? RowsFor(string? queryId)
        => queryId is not null && QueryResults.TryGetValue(queryId, out var rows) ? rows : null;

    // KPI 값 — 바인딩 쿼리 첫 행의 ValueColumn. 미바인딩/0행/컬럼 부재는 '—'.
    private string KpiValue(KpiWidget k)
    {
        var rows = RowsFor(k.QueryId);
        if (rows is not { Count: > 0 } || string.IsNullOrWhiteSpace(k.ValueColumn)) return "—";
        return rows[0].TryGetValue(k.ValueColumn, out var v) && v is not null ? v.ToString() ?? "—" : "—";
    }

    // 트렌드 포인트 — 바인딩 쿼리 행에서 ValueColumn 수치를 추출(비수치는 건너뜀), 마지막 MaxPoints개.
    // 값(+선택적 시각) 수집 — TimeColumn(P3-13)이 있으면 표본 시각을 축 라벨/툴팁에 쓴다(HH:mm:ss 축약).
    private List<(decimal Value, string? Time)> TrendPoints(TrendChartWidget tc)
    {
        var rows = RowsFor(tc.QueryId);
        var points = new List<(decimal, string?)>();
        if (rows is null || string.IsNullOrWhiteSpace(tc.ValueColumn)) return points;
        foreach (var row in rows)
        {
            if (!row.TryGetValue(tc.ValueColumn, out var v) || v is null
                || !decimal.TryParse(v.ToString(), System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var d))
                continue;
            string? time = null;
            if (!string.IsNullOrWhiteSpace(tc.TimeColumn)
                && row.TryGetValue(tc.TimeColumn, out var t) && t is not null)
            {
                var raw = t.ToString() ?? "";
                time = DateTime.TryParse(raw, out var dt) ? dt.ToString("HH:mm:ss") : raw;
            }
            points.Add((d, time));
        }
        var max = Math.Max(2, tc.MaxPoints);
        return points.Count > max ? points.Skip(points.Count - max).ToList() : points;
    }

    // SVG 폴리라인 좌표(viewBox 300x80, 상하 4px 패딩) — min==max(평평한 선)는 중앙 수평선.
    // P3-13 — 포인트별 좌표+툴팁(값, 시각 있으면 병기)도 반환한다(마커·<title>·마지막 점 강조).
    private static (string Polyline, List<(double X, double Y, string Tooltip)> Points, decimal Min, decimal Max, decimal Last)
        TrendGeometry(List<(decimal Value, string? Time)> points)
    {
        var min = points.Min(p => p.Value);
        var max = points.Max(p => p.Value);
        var range = max - min;
        var sb = new System.Text.StringBuilder();
        var pts = new List<(double X, double Y, string Tooltip)>(points.Count);
        for (var i = 0; i < points.Count; i++)
        {
            var x = points.Count == 1 ? 0 : 300.0 * i / (points.Count - 1);
            var y = range == 0 ? 40.0 : 76.0 - (double)((points[i].Value - min) / range) * 72.0;
            var tooltip = points[i].Time is { } time ? $"{points[i].Value} ({time})" : points[i].Value.ToString();
            pts.Add((x, y, tooltip));
            if (i > 0) sb.Append(' ');
            sb.Append(x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(y.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        }
        return (sb.ToString(), pts, min, max, points[^1].Value);
    }

    // KPI 드릴다운(P3-12) — LinkUiId 지정 카드만 이동.
    private void KpiNavigate(KpiWidget k)
    {
        if (!string.IsNullOrWhiteSpace(k.LinkUiId))
            Nav.NavigateTo($"/meta/{k.LinkUiId}");
    }

    private static readonly HashSet<string> KnownSeverities =
        new(StringComparer.OrdinalIgnoreCase) { "success", "warning", "danger", "info", "neutral" };

    // 뱃지 표시값/심각도 — 규칙 매칭(대소문자 무시). 미매칭=neutral 원문, 데이터 부재='—'.
    // 심각도는 화이트리스트로 정규화한다(임의 문자열이 CSS 클래스로 새는 것 차단).
    private (string Text, string Severity) BadgeFor(BadgeWidget bw)
    {
        var rows = RowsFor(bw.QueryId);
        if (rows is not { Count: > 0 } || string.IsNullOrWhiteSpace(bw.ValueColumn)
            || !rows[0].TryGetValue(bw.ValueColumn, out var v) || v is null)
            return ("—", "neutral");

        var raw = v.ToString() ?? "—";
        var rule = bw.Styles?.FirstOrDefault(s => string.Equals(s.Value, raw, StringComparison.OrdinalIgnoreCase));
        if (rule is null) return (raw, "neutral");
        var severity = KnownSeverities.Contains(rule.Severity) ? rule.Severity.ToLowerInvariant() : "neutral";
        return (rule.DisplayText is { Length: > 0 } ? rule.DisplayText : raw, severity);
    }

    private static string ColumnStyle(int span)
    {
        var pct = Math.Clamp(span, 1, 12) / 12d * 100d;
        return $"flex:0 0 calc({pct:0.##}% - 1rem); min-width:0;";
    }

    // 폼 위젯의 FieldWidget들을 인메모리 ScreenDefinition으로 합성해 기존 MetaFormRenderer를 재사용한다.
    private static ScreenDefinition FormDefinition(FormWidget f)
        => new(string.Empty, string.Empty, (f.Fields ?? Array.Empty<FieldWidget>()).Select(ToField).ToList());

    private static ScreenDefinition SingleFieldDefinition(FieldWidget fw)
        => new(string.Empty, string.Empty, new[] { ToField(fw) });

    private static FieldDefinition ToField(FieldWidget fw)
        => fw.Field ?? new FieldDefinition(fw.FieldKey ?? string.Empty, fw.FieldKey ?? string.Empty);

    private Task OnModelChanged(Dictionary<string, object?> m) => ModelChanged.InvokeAsync(m);
}
