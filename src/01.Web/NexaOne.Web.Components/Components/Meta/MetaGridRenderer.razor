@* Phase 4 — ScreenDefinition.Columns(메타)를 받아 명명 쿼리 결과(Dictionary 행)를 런타임 렌더하는 그리드.
   렌더 엔진은 RadzenDataGrid(무료 MIT) — 딕셔너리 행을 IDictionary<string,object>로 변환해 정렬/페이징/
   리사이즈를 라이브러리에 위임한다. 서버측 페이징(CountQueryId)은 LoadData↔OnServerPageChange로 연결
   (클라/서버는 Radzen에서 LoadData 유무로 갈리는 배타 경로라 두 분기로 렌더, 컬럼은 공유 프래그먼트).
   심각도 값(Error/Warning 등)은 배지로, 타임스탬프 값은 사람이 읽는 형식으로 셀 템플릿에서 표시한다. *@
@using NexaOne.Web.Services.Meta
@implements IDisposable
@inject IServiceProvider Services
@inject Microsoft.JSInterop.IJSRuntime JS

@{
    // 메타상 보이는 컬럼 중 사용자가 컬럼 선택기로 숨긴 것(_hiddenKeys)을 제외해 렌더한다.
    var cols = Columns.Where(c => c.Visible && !_hiddenKeys.Contains(c.Key)).ToList();
    // 컬럼 정의 공유 프래그먼트 — 두 그리드 분기 중 하나에만 렌더되므로 중복 등록 없음.
    RenderFragment gridColumns =@<text>
        @if (_selectMode)
        {
            @* 다중선택 체크박스 컬럼(선택 모드에서만). 헤더=전체 선택(현재 뷰 기준), 셀=행 선택.
               체크박스 클릭은 행 선택(Radzen RowSelect)으로 전파되지 않게 stopPropagation. *@
            <RadzenDataGridColumn TItem="System.Dynamic.ExpandoObject" Sortable="false" Width="42px"
                                  TextAlign="Radzen.TextAlign.Center">
                <HeaderTemplate>
                    <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll"
                           title="@T("common.selectAll", "전체 선택")"
                           aria-label="@T("common.selectAll", "전체 선택")" />
                </HeaderTemplate>
                <Template Context="row">
                    <input type="checkbox" checked="@_selected.Contains(row)"
                           aria-label="@T("common.selectRow", "행 선택")"
                           @onchange="() => ToggleRowSelection(row)" @onclick:stopPropagation="true" />
                </Template>
            </RadzenDataGridColumn>
        }
        @foreach (var col in cols)
        {
            var key = col.Key;
            var kind = KindOf(key);   // 값 샘플로 추론한 컬럼 종류(숫자/시각/상태/불리언/빈/텍스트)
            var caption = ColumnCaption(col);
            @* Property는 지정하지 않는다 — Radzen의 Property 기반 정렬은 ExpandoObject에서 접근자 빌드가
               실패하므로, 정렬은 자체 헤더 클릭(HeaderTemplate)으로 처리하고 셀은 Template로 렌더한다.
               컬럼 종류로 폭·정렬·셀 표현을 결정한다(숫자=우측·tabular, 시각=포맷, 상태=배지, 불리언=아이콘). *@
            <RadzenDataGridColumn TItem="System.Dynamic.ExpandoObject" Title="@caption" Sortable="false"
                                  TextAlign="@(kind == ColumnKind.Numeric ? Radzen.TextAlign.Right : Radzen.TextAlign.Left)"
                                  Width="@(col.Width is > 0 ? $"{col.Width}px" : WidthFor(kind, key, caption))">
                <HeaderTemplate>
                    @* 헤더 정렬은 실제 button으로 제공해 키보드/스크린리더에서도 마우스와 같은 기능을 쓴다. *@
                    <button type="button" class="nx-sort" aria-pressed="@(_sortKey == key)"
                            aria-label="@SortAriaLabel(caption, key)" @onclick="() => SortBy(key)">
                        <span>@caption</span>
                        @if (_sortKey == key)
                        {
                            <span class="nx-sort-direction" aria-hidden="true">@(_sortDesc ? "▼" : "▲")</span>
                        }
                    </button>
                </HeaderTemplate>
                <Template Context="row">
                    @{ var raw = Cell(row, key); }
                    @if (kind == ColumnKind.Status)
                    {
                        <RadzenBadge Text="@StatusLabel(raw)" BadgeStyle="@StatusStyle(raw)" Variant="Variant.Flat"
                                     title="@raw" class="nx-status-badge" />
                    }
                    else if (kind == ColumnKind.Boolean && raw.Length > 0)
                    {
                        var booleanLabel = IsTruthy(raw) ? T("common.yes", "예") : T("common.no", "아니오");
                        <span class="nx-cell-bool @(IsTruthy(raw) ? "nx-cell-yes" : "nx-cell-no")"
                              role="img" aria-label="@booleanLabel" title="@booleanLabel">
                            <RadzenIcon Icon="@(IsTruthy(raw) ? "check" : "remove")" aria-hidden="true" />
                        </span>
                    }
                    else if (kind == ColumnKind.Numeric)
                    {
                        <span class="nx-cell-num" title="@raw" @ondblclick="() => CopyCellAsync(raw)">@raw</span>
                    }
                    else
                    {
                        @* title — 폭 제약으로 잘린 셀도 호버로 전체 값을 읽을 수 있게(밀도 높은 표의 가독성).
                           FormatCell은 순수·저비용이라 title/본문 두 번 호출해도 무방. *@
                        <span title="@FormatCell(raw)" @ondblclick="() => CopyCellAsync(raw)">@FormatCell(raw)</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        }
    </text>;
    @* 빈 결과 상태(P2 상태화면) — 두 그리드 분기 공용. 텍스트만 대신 아이콘+문구로. *@
    RenderFragment emptyState =@<div class="nx-grid-empty">
        <RadzenIcon Icon="inbox" />
        <strong>@T("common.noResult", "결과 없음")</strong>
        <span class="nx-grid-empty-hint">@EmptyHint</span>
    </div>;

    RenderFragment<int> serverPager = total => @<text>
        @if (PageCountOf(total) <= 1)
        {
            <p class="meta-grid-note">@total @T("common.rowsUnit", "행")</p>
        }
        else
        {
            <nav class="meta-grid-pager" aria-label="@T("common.pagination", "목록 페이지 이동")">
                <span class="meta-grid-note">@total @T("common.rowsUnit", "행")</span>
                <RadzenButton Icon="chevron_left" Text="@T("common.prev", "이전")" Disabled="@(ServerPage == 0)" class="pager-btn"
                              Click="() => OnServerPageChange.InvokeAsync(ServerPage - 1)"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
                <span class="meta-grid-note">@(ServerPage + 1) / @PageCountOf(total)</span>
                <RadzenButton Icon="chevron_right" Text="@T("common.next", "다음")" Disabled="@(ServerPage >= PageCountOf(total) - 1)" class="pager-btn"
                              Click="() => OnServerPageChange.InvokeAsync(ServerPage + 1)"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            </nav>
        }
    </text>;

    // 표준·밀집·분할 상세는 동일한 RadzenDataGrid 인스턴스 구성을 공유한다. 보기 모드는 표현만 바꾸고
    // 필터·정렬·선택·CRUD 상태는 이 컴포넌트의 단일 상태를 계속 사용한다.
    var view = SortedItems();
    RenderFragment tableContent =@<text>
        @if (ServerTotal is int tableTotal)
        {
            <RadzenDataGrid @key="GridRenderKey" TItem="System.Dynamic.ExpandoObject" Data="view" AllowPaging="false"
                            AllowSorting="false" AllowColumnResize="true"
                            Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                            SelectionMode="DataGridSelectionMode.Single"
                            RowSelect="OnRowSelectedInternal" RowRender="OnRowRender">
                <Columns>@gridColumns</Columns>
                <EmptyTemplate>@emptyState</EmptyTemplate>
            </RadzenDataGrid>
            @serverPager(tableTotal)
        }
        else
        {
            <RadzenDataGrid @key="GridRenderKey" TItem="System.Dynamic.ExpandoObject" Data="view"
                            AllowPaging="true" PageSize="PageSize" AllowSorting="false" AllowColumnResize="true"
                            Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                            SelectionMode="DataGridSelectionMode.Single"
                            RowSelect="OnRowSelectedInternal" RowRender="OnRowRender">
                <Columns>@gridColumns</Columns>
                <EmptyTemplate>@emptyState</EmptyTemplate>
            </RadzenDataGrid>
            <p class="meta-grid-note">@view.Count @(_filter is { Length: > 0 } || _colFilters.Count > 0 ? $"/ {_items.Count} " : "")@T("common.rowsUnit", "행")</p>
        }
    </text>;
}
<div class="@GridCssClass"
     role="region" aria-label="@GridAriaLabel" aria-busy="@Loading.ToString().ToLowerInvariant()"
     data-state="@GridState" data-view="@ViewStorageValue(EffectiveViewMode)">
    @* 툴바는 조회 실행 후(Rows 비null)면 항상 — 빈 결과에서도 '추가'가 가능해야 한다(표준 CRUD). *@
    @if (Rows is not null)
    {
        @if (EnableViewModes)
        {
            <div class="meta-grid-viewbar" role="toolbar" aria-label="@T("grid.viewAndSort", "보기 방식 및 정렬")">
                <div class="nx-view-segments" role="group" aria-label="@T("grid.viewMode", "목록 보기 방식")">
                    <button type="button" class="@ViewButtonCss(MetaGridViewMode.StandardTable)"
                            aria-pressed="@IsViewActive(MetaGridViewMode.StandardTable)" aria-controls="@GridContentId"
                            title="@T("grid.viewStandardHelp", "행 간격을 넉넉하게 표시합니다.")"
                            @onclick="() => SetViewModeAsync(MetaGridViewMode.StandardTable)">
                        <RadzenIcon Icon="table_rows" aria-hidden="true" />
                        <span>@T("grid.viewStandard", "표준 표")</span>
                    </button>
                    <button type="button" class="@ViewButtonCss(MetaGridViewMode.DenseTable)"
                            aria-pressed="@IsViewActive(MetaGridViewMode.DenseTable)" aria-controls="@GridContentId"
                            title="@T("grid.viewDenseHelp", "한 화면에 더 많은 행을 표시합니다.")"
                            @onclick="() => SetViewModeAsync(MetaGridViewMode.DenseTable)">
                        <RadzenIcon Icon="density_small" aria-hidden="true" />
                        <span>@T("grid.viewDense", "밀집 표")</span>
                    </button>
                    <button type="button" class="@ViewButtonCss(MetaGridViewMode.Card)"
                            aria-pressed="@IsViewActive(MetaGridViewMode.Card)" aria-controls="@GridContentId"
                            title="@T("grid.viewCardHelp", "주요 필드를 카드 단위로 표시합니다.")"
                            @onclick="() => SetViewModeAsync(MetaGridViewMode.Card)">
                        <RadzenIcon Icon="view_agenda" aria-hidden="true" />
                        <span>@T("grid.viewCard", "카드")</span>
                    </button>
                    <button type="button" class="@ViewButtonCss(MetaGridViewMode.SplitDetail)"
                            aria-pressed="@IsViewActive(MetaGridViewMode.SplitDetail)" aria-controls="@GridContentId"
                            title="@T("grid.viewSplitHelp", "목록과 선택 항목 상세를 함께 표시합니다.")"
                            @onclick="() => SetViewModeAsync(MetaGridViewMode.SplitDetail)">
                        <RadzenIcon Icon="vertical_split" aria-hidden="true" />
                        <span>@T("grid.viewSplit", "분할 상세")</span>
                    </button>
                </div>
                @if (EffectiveViewMode == MetaGridViewMode.Card && cols.Count > 0)
                {
                    <div class="nx-view-sort">
                        <label for="@ViewSortId">@T("common.sort", "정렬")</label>
                        <select id="@ViewSortId" value="@(_sortKey ?? string.Empty)" @onchange="SetCardSortColumn"
                                aria-label="@T("grid.cardSortColumn", "카드 정렬 기준")">
                            <option value="">@T("grid.sortNone", "정렬 없음")</option>
                            @foreach (var c in cols)
                            {
                                <option value="@c.Key">@ColumnCaption(c)</option>
                            }
                        </select>
                        <button type="button" class="nx-view-sort-direction" disabled="@(_sortKey is null)"
                                aria-pressed="@_sortDesc.ToString().ToLowerInvariant()"
                                aria-label="@CardSortDirectionLabel" @onclick="ToggleCardSortDirection">
                            <RadzenIcon Icon="@(_sortDesc ? "south" : "north")" aria-hidden="true" />
                        </button>
                    </div>
                }
                <span class="nx-view-saved-hint">@T("grid.viewSavedHint", "화면별 보기 설정 자동 저장")</span>
            </div>
        }
        <div class="meta-grid-toolbar" role="toolbar" aria-label="@T("common.gridTools", "목록 도구")">
            @* 그리드 표준 CRUD(좌측 데이터 조작 클러스터) — 추가=신규 입력 모드(폼 초기화),
               삭제=선택 행(일반=단일선택, 선택모드=체크 다중). 확인/실행은 MetaScreen이 소유. *@
            @if (CanAdd && OnAddNew.HasDelegate)
            {
                var addLabel = T("common.add", "추가");
                <RadzenButton Icon="add" Text="@T("common.add", "추가")" Click="OnAddNew"
                              Disabled="@(AddDisabledReason is not null)" title="@AddDisabledReason"
                              aria-label="@ActionAriaLabel(addLabel, AddDisabledReason)"
                              ButtonStyle="Radzen.ButtonStyle.Primary" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
            }
            @if (CanDelete && OnDeleteRows.HasDelegate)
            {
                var deleteLabel = T("common.delete", "삭제");
                var deleteDisabledReason = DeleteDisabledReason
                    ?? (SelectedCountForDelete == 0 ? T("common.deleteHint", "삭제할 행을 선택하세요") : null);
                <RadzenButton Icon="delete" Text="@T("common.delete", "삭제")" Click="DeleteSelectedAsync"
                              Disabled="@(deleteDisabledReason is not null)"
                              title="@deleteDisabledReason"
                              aria-label="@ActionAriaLabel(deleteLabel, deleteDisabledReason)"
                              ButtonStyle="Radzen.ButtonStyle.Danger" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
            }
            @* 일괄 명령(상태전이) — 선택 행 대상. 가드된 전이 쿼리라 소스 상태 밖 행은 무영향. *@
            @if (BulkCommands is { Count: > 0 } && OnBulkCommand.HasDelegate)
            {
                foreach (var cmd in BulkCommands)
                {
                    var c = cmd;
                    var selectedRows = SelectedOriginalRows();
                    // 권한/도메인 사유를 선택 안내보다 우선한다. 권한 없는 사용자가 행을 선택해야만
                    // 실제 차단 원인을 알 수 있게 되는 UX를 피하고, 모든 액션에서 같은 사유를 노출한다.
                    var commandDisabledReason = BulkCommandDisabledReason?.Invoke(c, selectedRows);
                    var disabledReason = commandDisabledReason
                        ?? (selectedRows.Count == 0 ? T("common.bulkHint", "대상 행을 선택하세요") : null);
                    <RadzenButton Icon="bolt" Text="@c.Label" Click="() => EmitBulkCommandAsync(c)"
                                  Disabled="@(disabledReason is not null)"
                                  title="@disabledReason"
                                  aria-label="@ActionAriaLabel(c.Label, disabledReason)"
                                  ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn nx-bulkcmd" />
                }
            }
            @* 빠른 필터 — 적재 행을 컬럼 무관 부분일치로 좁힌다(클라이언트 페이징 화면만; 서버 페이징은
               현재 페이지만 걸려 오해 소지가 있어 숨긴다). *@
            @if (ServerTotal is null && Rows.Count > 0)
            {
                @* P2 — 디바운스 필터: 입력은 즉시 반영(_filterInput), 실제 필터/재정렬은 타이핑이 멈춘 뒤에만. *@
                <input type="search" class="meta-grid-filter" placeholder="@T("common.filter", "필터…")"
                       aria-label="@T("common.filterRows", "현재 목록 빠른 필터")" autocomplete="off"
                       value="@_filterInput" @oninput="OnFilterInput" />
                @* 컬럼 필터 팝업(표준 CRUD) — 컬럼별 포함/일치 조건. 활성 수 배지 + 칩 표시. *@
                <div class="nx-colmenu-wrap">
                    <RadzenButton @ref="_filterTrigger" Icon="filter_alt" Click="OpenFilterMenu"
                                  title="@T("common.colFilter", "컬럼 필터")"
                                  aria-label="@T("common.colFilter", "컬럼 필터")"
                                  aria-haspopup="dialog" aria-expanded="@_showFilterMenu"
                                  aria-controls="@FilterMenuId"
                                  ButtonStyle="@(_colFilters.Count > 0 ? Radzen.ButtonStyle.Primary : Radzen.ButtonStyle.Light)"
                                  Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
                    @if (_showFilterMenu)
                    {
                        <div class="nx-colmenu-backdrop" @onclick="() => ClosePopup(PopupKind.Filter)"></div>
                        <div id="@FilterMenuId" class="nx-colmenu nx-filtermenu" role="dialog"
                             aria-modal="false" aria-label="@T("common.colFilter", "컬럼 필터")"
                             tabindex="-1" @ref="_filterMenuRef"
                             @onkeydown="e => HandlePopupKeyDown(PopupKind.Filter, e)" @onkeydown:stopPropagation="true">
                            <div class="nx-colmenu-head">
                                <span>@T("common.colFilter", "컬럼 필터")</span>
                                <button type="button" @onclick="ClearColumnFilters" class="nx-colmenu-reset">@T("common.reset", "초기화")</button>
                            </div>
                            @foreach (var c in cols)
                            {
                                var key = c.Key;
                                var caption = ColumnCaption(c);
                                <div class="nx-filtermenu-row">
                                    <span class="nx-filtermenu-cap" title="@caption">@caption</span>
                                    <select class="nx-filtermenu-op" value="@OpOf(key)"
                                            aria-label="@($"{caption} {T("common.filterOperator", "필터 방식")}")"
                                            @onchange="e => SetFilterOp(key, e)">
                                        <option value="contains">@T("common.opContains", "포함")</option>
                                        <option value="equals">@T("common.opEquals", "일치")</option>
                                    </select>
                                    <input class="nx-filtermenu-val" value="@ValOf(key)"
                                           aria-label="@($"{caption} {T("common.filter", "필터")}")"
                                           @oninput="e => SetFilterVal(key, e)" @onkeydown="OnFilterKeyDown" />
                                </div>
                            }
                            <div class="nx-filtermenu-foot">
                                <RadzenButton Text="@T("common.apply", "적용")" Click="ApplyColumnFilters"
                                              ButtonStyle="Radzen.ButtonStyle.Primary" Size="Radzen.ButtonSize.Small" />
                            </div>
                        </div>
                    }
                </div>
            }
            <span class="meta-grid-toolbar-spacer"></span>
            @* 선택 모드 토글 — 켜면 체크박스 컬럼 + 일괄 액션바. 단일선택(폼로드)과 배타. *@
            <RadzenButton Icon="checklist" Click="ToggleSelectModeAsync"
                          title="@(_selectMode ? T("common.selectModeOff", "선택 모드 끄기") : T("common.selectModeOn", "선택 모드"))"
                          aria-label="@(_selectMode ? T("common.selectModeOff", "선택 모드 끄기") : T("common.selectModeOn", "선택 모드"))"
                          ButtonStyle="@(_selectMode ? Radzen.ButtonStyle.Primary : Radzen.ButtonStyle.Light)"
                          Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
            @* 컬럼 선택기 — 보이는 컬럼을 체크박스로 숨기기/보이기(넓은 표 정돈). 화면별 localStorage 저장. *@
            <div class="nx-colmenu-wrap">
                <RadzenButton @ref="_columnTrigger" Icon="view_column" Click="ToggleColumnMenu"
                              title="@T("common.columns", "컬럼 선택")"
                              aria-label="@T("common.columns", "컬럼 선택")"
                              aria-haspopup="dialog" aria-expanded="@_showColMenu" aria-controls="@ColumnMenuId"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
                @if (_showColMenu)
                {
                    <div class="nx-colmenu-backdrop" @onclick="() => ClosePopup(PopupKind.Columns)"></div>
                    <div id="@ColumnMenuId" class="nx-colmenu" role="dialog" aria-modal="false"
                         aria-label="@T("common.columns", "컬럼 선택")" tabindex="-1" @ref="_columnMenuRef"
                         @onkeydown="e => HandlePopupKeyDown(PopupKind.Columns, e)" @onkeydown:stopPropagation="true">
                        <div class="nx-colmenu-head">
                            <span>@T("common.columns", "컬럼 선택")</span>
                            <button type="button" @onclick="ResetColumnsAsync" class="nx-colmenu-reset">@T("common.reset", "초기화")</button>
                        </div>
                        @foreach (var c in Columns.Where(c => c.Visible))
                        {
                            var key = c.Key;
                            var shown = !_hiddenKeys.Contains(key);
                            <label class="nx-colmenu-item">
                                <input type="checkbox" checked="@shown"
                                       disabled="@(shown && cols.Count <= 1)"
                                       @onchange="() => ToggleColumnAsync(key)" />
                                <span>@ColumnCaption(c)</span>
                            </label>
                        }
                    </div>
                }
            </div>
            @* '더보기' — 보조 액션(첫 컬럼 고정·밀도·CSV)을 접어 툴바 과밀 완화(UX 감사 4번 2단계).
               토글류(고정/밀도)는 클릭 후에도 메뉴를 유지해 라벨로 상태 변화를 확인하게 하고, CSV는 닫는다. *@
            <div class="nx-colmenu-wrap">
                <RadzenButton @ref="_moreTrigger" Icon="more_vert" Click="ToggleMoreMenu"
                              title="@T("common.more", "더보기")"
                              aria-label="@T("common.more", "더보기")"
                              aria-haspopup="menu" aria-expanded="@_showMoreMenu" aria-controls="@MoreMenuId"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
                @if (_showMoreMenu)
                {
                    <div class="nx-colmenu-backdrop" @onclick="() => ClosePopup(PopupKind.More)"></div>
                    <div id="@MoreMenuId" class="nx-colmenu nx-moremenu" role="menu" aria-label="@T("common.more", "더보기")"
                         tabindex="-1" @ref="_moreMenuRef"
                         @onkeydown="e => HandlePopupKeyDown(PopupKind.More, e)" @onkeydown:stopPropagation="true">
                        @if (cols.Count >= 6 && EffectiveViewMode != MetaGridViewMode.Card)
                        {
                            @* 첫 컬럼 고정 — 넓은 표(≥6열, 가로 스크롤 가능)에서만. 좌측 식별자 컬럼 유지. *@
                            <button type="button" role="menuitem" class="nx-moremenu-item @(_freezeFirst ? "active" : "")"
                                    @onclick="ToggleFreezeAsync">
                                <RadzenIcon Icon="push_pin" />
                                @(_freezeFirst ? T("common.unfreezeCol", "첫 컬럼 고정 해제") : T("common.freezeCol", "첫 컬럼 고정"))
                            </button>
                        }
                        @if (!EnableViewModes)
                        {
                            @* 보기 전환이 없는 일반 화면은 기존 밀도 개인화 토글을 유지한다. 관리 화면은
                               표준/밀집 세그먼트가 같은 기능을 더 명확하게 제공하므로 중복 노출하지 않는다. *@
                            <button type="button" role="menuitem" class="nx-moremenu-item" @onclick="ToggleDensityAsync">
                                <RadzenIcon Icon="@(_compact ? "density_small" : "density_medium")" />
                                @(_compact ? T("common.densityRoomy", "편안한 밀도로") : T("common.densityCompact", "조밀한 밀도로"))
                            </button>
                        }
                        <button type="button" role="menuitem" class="nx-moremenu-item"
                                @onclick="ExportFromMoreAsync">
                            <RadzenIcon Icon="download" />
                            @T("common.exportCsv", "CSV로 내보내기")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    @if (_selectMode && Rows is { Count: > 0 })
    {
        @* 일괄 액션바(선택 모드) — 선택 수 + 선택 행 CSV/복사/해제. 액션은 선택 0이면 비활성. *@
        <div class="nx-bulkbar" role="toolbar" aria-label="@T("common.selectedActions", "선택 항목 작업")">
            <span class="nx-bulkbar-count" aria-live="polite">@_selected.Count @T("common.selectedCount", "개 선택")</span>
            <RadzenButton Icon="download" Text="@T("common.exportSelected", "선택 CSV")" Disabled="@(_selected.Count == 0)"
                          Click="ExportSelectedCsvAsync" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
            <RadzenButton Icon="content_copy" Text="@T("common.copySelected", "복사")" Disabled="@(_selected.Count == 0)"
                          Click="CopySelectedAsync" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
            <RadzenButton Icon="clear" Text="@T("common.clearSelection", "선택 해제")" Disabled="@(_selected.Count == 0)"
                          Click="ClearSelection" ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
        </div>
    }
    @if (_colFilters.Count > 0)
    {
        @* 활성 컬럼 필터 칩 — 어떤 조건이 걸려 있는지 항상 가시화(×로 개별 해제). *@
        <div class="nx-filterchips">
            @foreach (var f in _colFilters)
            {
                var key = f.Key;
                <span class="nx-filterchip">
                    @(CaptionOf(key)) @(f.Value.Op == "equals" ? "=" : "~") "@f.Value.Val"
                    <button type="button" class="x" title="@T("common.removeFilter", "필터 해제")"
                            aria-label="@($"{CaptionOf(key)} {T("common.removeFilter", "필터 해제")}")"
                            @onclick="() => RemoveColumnFilter(key)">×</button>
                </span>
            }
        </div>
    }
    @if (_truncatedFrom > 0)
    {
        @* P1 — 상한 초과 안내: 클라 페이징 화면이 대용량 결과 전체를 회로에 올리면 렌더가 폭주하므로
           MaxClientRows까지만 표시한다. 전체 조회는 조건을 좁히거나(서버 필터) CSV 내보내기(원본 Rows 전량). *@
        <div class="nx-grid-trunc" role="status">
            <RadzenIcon Icon="warning_amber" />
            <span>@string.Format(T("common.truncated", "결과 {0}행 중 처음 {1}행만 표시됩니다. 조건을 좁혀 조회하거나 CSV로 전체를 내보내세요."), _truncatedFrom, MaxClientRows)</span>
        </div>
    }
    <div id="@GridContentId" class="meta-grid-content view-@ViewStorageValue(EffectiveViewMode)">
        @if (Loading && Rows is { Count: > 0 })
        {
            @* 기존 결과를 유지한 채 다시 읽는 경우에는 표를 지우지 않고 상단 진행 상태만 알린다. *@
            <div class="nx-grid-refreshing" role="status" aria-live="polite">
                <span class="nx-grid-refreshing-bar" aria-hidden="true"></span>
                <span>@T("common.refreshing", "새로고침 중…")</span>
            </div>
        }
        @if (Loading && Rows is not { Count: > 0 })
        {
            @* 스켈레톤 로더(P2 상태화면) — 조회 중 shimmer 행으로 체감 성능↑(텍스트 스피너 대체). *@
            <div class="nx-skeleton" role="status" aria-busy="true" aria-label="@T("common.loading", "조회 중…")">
                @for (var r = 0; r < 7; r++)
                {
                    <div class="nx-skel-row">
                        @foreach (var _ in cols) { <div class="nx-skel-cell"></div> }
                    </div>
                }
            </div>
        }
        else if (Rows is null)
        {
            <p class="meta-grid-note">@T("common.runHint", "실행하면 결과가 표시됩니다.")</p>
        }
        else if (EffectiveViewMode == MetaGridViewMode.Card)
        {
            var primary = MetaGridColumnPolicy.CardPrimary(cols);
            var cardFields = MetaGridColumnPolicy.CardSummary(cols, primary).ToList();
            var cardRows = CardPageItems(view);
            @if (view.Count == 0)
            {
                @emptyState
            }
            else
            {
                @if (_selectMode)
                {
                    <label class="nx-card-select-all">
                        <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                        <span>@T("common.selectAll", "전체 선택")</span>
                    </label>
                }
                @* 현재 페이지에 한 건만 있으면 넓은 핵심 정보 카드로 전환한다. 전체 결과가 아닌 cardRows를
                   기준으로 해야 마지막 페이지/서버 페이지에서도 실제 보이는 카드 수와 레이아웃이 일치한다. *@
                <div class="nx-card-view@(cardRows.Count == 1 ? " is-single" : string.Empty)"
                     role="list" aria-label="@T("grid.cardList", "카드 목록")">
                    @foreach (var row in cardRows)
                    {
                        var primaryValue = primary is null ? T("common.item", "항목") : CardDisplayValue(row, primary);
                        <article class="@CardItemCss(row)" role="listitem">
                            <header class="nx-data-card-head">
                                @if (_selectMode)
                                {
                                    <input type="checkbox" checked="@_selected.Contains(row)"
                                           aria-label="@($"{primaryValue} {T("common.selectRow", "행 선택")}")"
                                           @onchange="() => ToggleRowSelection(row)" @onclick:stopPropagation="true" />
                                }
                                <button type="button" class="nx-data-card-open"
                                        aria-pressed="@IsRowSelected(row).ToString().ToLowerInvariant()"
                                        aria-label="@CardAriaLabel(row, primary, primaryValue)"
                                        @onclick="() => OnRowSelectedInternal(row)">
                                    <span class="nx-data-card-title">
                                        @if (primary is not null) { <span>@ColumnCaption(primary)</span> }
                                        <strong title="@primaryValue">@primaryValue</strong>
                                    </span>
                                    <RadzenIcon Icon="chevron_right" aria-hidden="true" />
                                </button>
                            </header>
                            @if (cardFields.Count > 0)
                            {
                                <dl class="nx-data-card-fields">
                                    @foreach (var col in cardFields)
                                    {
                                        var value = CardDisplayValue(row, col);
                                        <div>
                                            <dt title="@ColumnCaption(col)">@ColumnCaption(col)</dt>
                                            <dd class="@CardValueCss(row, col)" title="@value">@value</dd>
                                        </div>
                                    }
                                </dl>
                            }
                            @if (cols.Count - (primary is null ? 0 : 1) > cardFields.Count)
                            {
                                <footer class="nx-data-card-more">+@(cols.Count - (primary is null ? 0 : 1) - cardFields.Count) @T("grid.moreFields", "개 필드")</footer>
                            }
                        </article>
                    }
                </div>
                @if (ServerTotal is int cardServerTotal)
                {
                    @serverPager(cardServerTotal)
                }
                else
                {
                    var cardPageCount = PageCountOf(view.Count);
                    @if (cardPageCount <= 1)
                    {
                        <p class="meta-grid-note">@view.Count @T("common.rowsUnit", "행")</p>
                    }
                    else
                    {
                        <nav class="meta-grid-pager nx-card-pager" aria-label="@T("common.pagination", "목록 페이지 이동")">
                            <span class="meta-grid-note">@view.Count @T("common.rowsUnit", "행")</span>
                            <RadzenButton Icon="chevron_left" Text="@T("common.prev", "이전")" Disabled="@(_cardPage == 0)" class="pager-btn"
                                          Click="() => ChangeCardPage(-1, view.Count)"
                                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
                            <span class="meta-grid-note">@(_cardPage + 1) / @cardPageCount</span>
                            <RadzenButton Icon="chevron_right" Text="@T("common.next", "다음")" Disabled="@(_cardPage >= cardPageCount - 1)" class="pager-btn"
                                          Click="() => ChangeCardPage(1, view.Count)"
                                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
                        </nav>
                    }
                }
            }
        }
        else if (EffectiveViewMode == MetaGridViewMode.SplitDetail)
        {
            <div class="nx-split-view">
                <section class="nx-split-master" aria-label="@T("grid.masterList", "관리 목록")">
                    @tableContent
                </section>
                <aside class="nx-split-detail"
                       aria-label="@T("grid.quickReferenceDetail", "빠른 참조 상세")"
                       aria-describedby="@($"{_uid}-split-description")">
                    <p id="@($"{_uid}-split-description")" class="nx-visually-hidden">
                        @T("grid.quickReferenceDetailHint", "선택한 항목을 편집하지 않고 빠르게 확인하는 읽기 전용 상세입니다.")
                    </p>
                    @if (_selectMode)
                    {
                        <div class="nx-split-empty" role="status">
                            <RadzenIcon Icon="checklist" aria-hidden="true" />
                            <strong>@T("grid.multiSelectActive", "다중 선택 모드")</strong>
                            <span>@T("grid.multiSelectDetailHint", "선택 모드를 끄면 단일 항목 상세를 볼 수 있습니다.")</span>
                        </div>
                    }
                    else if (_selectedItem is null)
                    {
                        <div class="nx-split-empty" role="status">
                            <RadzenIcon Icon="touch_app" aria-hidden="true" />
                            <strong>@T("grid.selectForDetail", "상세를 볼 항목을 선택하세요")</strong>
                            <span>@T("grid.selectForDetailHint", "왼쪽 표의 행을 선택하면 전체 필드가 여기에 표시됩니다.")</span>
                        </div>
                    }
                    else
                    {
                        var detailPrimary = MetaGridColumnPolicy.CardPrimary(cols);
                        var detailTitle = detailPrimary is null ? T("common.detail", "상세 정보") : CardDisplayValue(_selectedItem, detailPrimary);
                        <header class="nx-split-detail-head" aria-live="polite" aria-atomic="true">
                            <span>@T("grid.quickReferenceDetail", "빠른 참조 상세")</span>
                            <strong title="@detailTitle">@detailTitle</strong>
                        </header>
                        <dl class="nx-split-detail-fields">
                            @foreach (var col in cols)
                            {
                                var value = CardDisplayValue(_selectedItem, col);
                                <div>
                                    <dt>@ColumnCaption(col)</dt>
                                    <dd class="@CardValueCss(_selectedItem, col)" title="@value">@value</dd>
                                </div>
                            }
                        </dl>
                    }
                </aside>
            </div>
        }
        else
        {
            @tableContent
        }
    </div>
</div>

@using static NexaOne.Web.Components.Meta.MetaGridFormat
@code {
    // 한 화면에 여러 그리드가 있어도 팝오버 제어 id가 충돌하지 않게 인스턴스 접두사를 둔다.
    private readonly string _uid = $"mg-{Guid.NewGuid():N}";

    // 페이지 크기 — 클라이언트 분할과 서버측 페이징(MetaScreen @limit)의 단일 출처.
    public const int PageSize = 20;

    // P1 안전장치 상한 — 클라 페이징 화면(ServerTotal 없음)이 한 번에 회로로 올릴 최대 행 수.
    // 초과분은 변환/렌더하지 않고 배너로만 안내한다(전체는 CSV 내보내기가 원본 Rows 전량 처리).
    public const int MaxClientRows = 500;

    // P4 — 컬럼 종류 추론 샘플 크기(전 행 스캔 대신 앞 N행). 혼합 컬럼은 InferKind의 '전부' 규칙상 텍스트 폴백.
    private const int InferSampleSize = 100;

    private string FilterMenuId => $"{_uid}-filter-menu";
    private string ColumnMenuId => $"{_uid}-column-menu";
    private string MoreMenuId => $"{_uid}-more-menu";
    private string GridContentId => $"{_uid}-content";
    private string ViewSortId => $"{_uid}-view-sort";

    private enum PopupKind { None, Filter, Columns, More }

    private ElementReference _filterMenuRef;
    private ElementReference _columnMenuRef;
    private ElementReference _moreMenuRef;
    private RadzenButton? _filterTrigger;
    private RadzenButton? _columnTrigger;
    private RadzenButton? _moreTrigger;
    private PopupKind _pendingPopupFocus;
    private PopupKind _pendingTriggerFocus;

    private MetaGridViewMode _viewMode = MetaGridViewMode.StandardTable;
    private int _cardPage;
    private MetaGridViewMode EffectiveViewMode => EnableViewModes ? _viewMode : MetaGridViewMode.StandardTable;
    // 표준↔밀집 전환은 같은 DataGrid 인스턴스를 유지해 내부 페이지·사용자 조정 폭이 초기화되지 않게 한다.
    // 선택 모드만 조건부 체크박스 컬럼 때문에 기존처럼 재생성이 필요하다.
    private string GridRenderKey => _selectMode.ToString();
    private bool UseRoomyDensity => EnableViewModes
        ? EffectiveViewMode == MetaGridViewMode.StandardTable
        : !_compact;
    private string GridCssClass
        => $"meta-grid view-{ViewStorageValue(EffectiveViewMode)}{(UseRoomyDensity ? " nx-density-roomy" : string.Empty)}{(_freezeFirst ? " nx-freeze-first" : string.Empty)}{(Loading ? " is-loading" : string.Empty)}";

    private string GridAriaLabel => string.IsNullOrWhiteSpace(ScreenKey)
        ? T("common.dataList", "데이터 목록")
        : $"{ScreenKey} {T("common.dataList", "데이터 목록")}";
    private string GridState => Loading ? "loading"
        : Rows is null ? "idle"
        : Rows.Count == 0 ? "empty"
        : "ready";
    private string EmptyHint => CanAdd && OnAddNew.HasDelegate
        ? T("common.noResultAddHint", "조건을 바꾸거나 새 항목을 추가해 보세요.")
        : T("common.noResultHint", "조회 조건을 바꾼 뒤 다시 실행해 보세요.");

    private string SortAriaLabel(string caption, string key)
        => _sortKey != key
            ? $"{caption}, {T("common.sortNone", "정렬 안 됨")}. {T("common.sortAscending", "오름차순 정렬")}"
            : _sortDesc
                ? $"{caption}, {T("common.sortedDescending", "현재 내림차순")}. {T("common.sortAscending", "오름차순으로 변경")}"
                : $"{caption}, {T("common.sortedAscending", "현재 오름차순")}. {T("common.sortDescending", "내림차순으로 변경")}";

    private static int PageCountOf(int total) => total > 0 ? (total + PageSize - 1) / PageSize : 0;

    // 보이는 컬럼만 헤더로 그리고, 각 행에서 컬럼 Key로 값을 찾아 셀에 표시한다.
    [Parameter, EditorRequired]
    public IReadOnlyList<GridColumnDefinition> Columns { get; set; } = Array.Empty<GridColumnDefinition>();

    // null = 미실행(안내 문구), 빈 목록 = 결과 없음, 그 외 = 행 렌더.
    [Parameter] public IReadOnlyList<Dictionary<string, object?>>? Rows { get; set; }

    // P1-3 — 조회 진행 중 표시(안내 문구 대체). 기존 행이 있으면 그대로 두고 문구만 생략.
    [Parameter] public bool Loading { get; set; }

    // P1-1 — 행 클릭 콜백(전체 행 딕셔너리 — 표시되지 않는 컬럼도 포함해 폼 채우기에 쓴다).
    [Parameter] public EventCallback<Dictionary<string, object?>> OnRowSelect { get; set; }

    // P3-9 v2 — 서버측 페이징(CountQueryId 화면). ServerTotal 지정 시 Radzen이 Count 기준 페이저를 그리고
    // 페이지 전환은 LoadData→OnServerPageChange로 부모(MetaScreen)가 @offset 재조회한다.
    [Parameter] public int? ServerTotal { get; set; }
    [Parameter] public int ServerPage { get; set; }
    [Parameter] public EventCallback<int> OnServerPageChange { get; set; }

    // 화면별 그리드 개인화(밀도·숨긴 컬럼) 저장 키 — MetaScreen이 UiId를 넘긴다. 없으면 개인화는 세션 한정.
    [Parameter] public string? ScreenKey { get; set; }

    /// <summary>
    /// 관리 화면용 표준 표·밀집 표·카드·분할 상세 전환을 노출합니다. false이면 기존 그리드 UX와
    /// 밀도 개인화를 그대로 유지합니다.
    /// </summary>
    [Parameter] public bool EnableViewModes { get; set; }

    // 그리드 표준 CRUD(디자인 심층검토 후속) — 추가=폼 초기화 콜백(신규 입력 모드), 삭제=선택 행 삭제 콜백.
    // 실행·확인 다이얼로그·재조회는 부모(MetaScreen)가 소유하고, 그리드는 선택 상태와 버튼만 담당한다.
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public EventCallback OnAddNew { get; set; }
    [Parameter] public string? AddDisabledReason { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public EventCallback<List<Dictionary<string, object?>>> OnDeleteRows { get; set; }
    [Parameter] public string? DeleteDisabledReason { get; set; }

    // 그리드 일괄 명령(도메인 상태전이) — 화면 정의(BulkCommands)의 버튼을 툴바에 렌더하고,
    // 클릭 시 선택 행(원본 딕셔너리)을 부모(MetaScreen)에 넘긴다(확인·실행·재조회는 부모 소유).
    [Parameter] public IReadOnlyList<BulkCommandDefinition>? BulkCommands { get; set; }
    [Parameter] public EventCallback<(BulkCommandDefinition Command, List<Dictionary<string, object?>> Rows)> OnBulkCommand { get; set; }
    [Parameter] public Func<BulkCommandDefinition, IReadOnlyList<Dictionary<string, object?>>, string?>? BulkCommandDisabledReason { get; set; }

    private static string ActionAriaLabel(string label, string? disabledReason)
        => disabledReason is null ? label : $"{label} — {disabledReason}";

    // Radzen 바인딩용 변환분(원본 Rows와 동일 순서·인덱스). Radzen 동적 데이터는 ExpandoObject를 정식
    // 지원한다(IDictionary 인터페이스 자체는 Property 접근자 빌드가 실패). null 값은 렌더/정렬 안전상 ""으로.
    private List<System.Dynamic.ExpandoObject> _items = new();

    // 필터(빠른 부분일치, 클라이언트 화면) + 컬럼 종류 캐시(데이터 적재 시 1회 추론).
    private string _filter = "";
    private Dictionary<string, ColumnKind> _colKind = new(StringComparer.Ordinal);

    // Rows 참조를 기억해, 변경됐을 때만 _items를 재빌드한다. 부모 재렌더(행 선택→폼 로드 등)로 Rows가
    // 그대로면 재빌드를 건너뛰어 ExpandoObject 인스턴스·선택 강조(_selectedItem)·정렬을 보존한다
    // (매번 재빌드하면 참조가 깨져 선택 강조가 즉시 리셋되던 버그).
    private IReadOnlyList<Dictionary<string, object?>>? _lastRows;
    private string? _lastScreenKey;
    private bool? _lastEnableViewModes;

    // 원본 행수(P1 상한 초과로 잘렸을 때만 > 0) — 절단 배너 표시용.
    private int _truncatedFrom;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastScreenKey, ScreenKey, StringComparison.Ordinal)
            || _lastEnableViewModes != EnableViewModes)
        {
            _lastScreenKey = ScreenKey;
            _lastEnableViewModes = EnableViewModes;
            _prefsLoadedFor = null;
            _viewMode = MetaGridViewMode.StandardTable;
            _cardPage = 0;
        }

        if (ReferenceEquals(Rows, _lastRows)) return;
        _lastRows = Rows;
        _viewDirty = true;   // 데이터 변경 → 정렬/필터 뷰 캐시 무효화(P3)
        _cardPage = 0;       // 결과 집합이 바뀌면 카드 페이저를 첫 페이지로 되돌린다.

        // P1 안전장치 — 클라이언트 페이징 화면(ServerTotal 없음)이 대용량 결과 전체를 회로에 적재하면
        // ExpandoObject 변환·SignalR diff·렌더가 폭주한다. 상한(MaxClientRows)까지만 변환하고 초과분은
        // 배너로 알린다(서버 페이징 화면은 이미 페이지 단위라 미적용).
        var source = Rows ?? (IReadOnlyList<Dictionary<string, object?>>)Array.Empty<Dictionary<string, object?>>();
        _truncatedFrom = 0;
        if (ServerTotal is null && source.Count > MaxClientRows)
        {
            _truncatedFrom = source.Count;
            source = source.Take(MaxClientRows).ToList();
        }

        _items = source
            .Select(r =>
            {
                var e = new System.Dynamic.ExpandoObject();
                var d = (IDictionary<string, object?>)e;   // ExpandoObject 실제 구현 시그니처(CS8619 방지)
                foreach (var kv in r) d[kv.Key] = kv.Value ?? (object)"";
                return e;
            })
            .ToList();
        _selectedItem = null;   // 재조회(Rows 변경) 시에만 선택 해제
        _selected.Clear();      // 다중선택 참조는 새 ExpandoObject라 무효 → 재조회 시 초기화

        // 컬럼 종류 추론 — 앞 InferSampleSize행 샘플로 숫자/시각/상태/불리언/빈/텍스트 판별(폭·정렬·셀 표현 결정).
        // 전 행 스캔은 대용량에서 낭비라 대표 샘플만 본다(혼합 컬럼은 '전부' 규칙상 안전하게 텍스트 폴백).
        _colKind = new Dictionary<string, ColumnKind>(StringComparer.Ordinal);
        var sample = _items.Count > InferSampleSize ? _items.Take(InferSampleSize).ToList() : _items;
        foreach (var col in Columns.Where(c => c.Visible))
            _colKind[col.Key] = InferGridKind(col.Key, sample.Select(e => Cell(e, col.Key)).ToList());
    }

    private ColumnKind KindOf(string key) => _colKind.TryGetValue(key, out var k) ? k : ColumnKind.Text;

    /// <summary>상태 의미가 명시된 컬럼 키는 미정 상태값도 중성 칩으로 유지하고, 나머지는 기존 값 기반 추론을 사용합니다.</summary>
    private static ColumnKind InferGridKind(string key, IReadOnlyList<string> values)
    {
        var nonEmpty = values.Where(value => !string.IsNullOrWhiteSpace(value)).ToList();
        if (nonEmpty.Count > 0 && (IsStatusKey(key) || nonEmpty.All(value => KnownStatusStyle(value) is not null)))
            return ColumnKind.Status;
        return InferKind(values);
    }

    private static bool IsStatusKey(string key) => MetaStatusPresentation.IsStatusKey(key);

    /// <summary>알려진 업무 상태를 대소문자와 무관하게 semantic tone으로 매핑합니다.</summary>
    private static Radzen.BadgeStyle? KnownStatusStyle(string raw) => MetaStatusPresentation.StyleOf(raw);

    private static Radzen.BadgeStyle StatusStyle(string raw)
        => KnownStatusStyle(raw) ?? Radzen.BadgeStyle.Light;

    /// <summary>원본 계약 값은 유지하고 표시 문자열만 UiText 리소스/안전한 공통 상태 폴백으로 현지화합니다.</summary>
    private string StatusLabel(string raw)
    {
        EnsureUiText();
        return MetaStatusPresentation.LabelOf(raw, _uiText);
    }

    // 선택 행 강조 — RadzenDataGrid @bind-Value는 ExpandoObject에서 하이라이트가 안 붙어(참조매칭 마찰),
    // 자체 선택 추적 + RowRender로 행에 data-selected 속성을 얹고 CSS로 강조한다(class 대신 data-*라 rz-data-row 보존).
    private System.Dynamic.ExpandoObject? _selectedItem;

    // 선택 모드(사용자 선택: 전 화면 토글) — 켜면 체크박스 컬럼 + 일괄 액션바가 뜨고 행 클릭은 다중선택 토글이
    // 된다(단일선택=폼로드 마스터-디테일 흐름과 배타). 모드는 세션 한정(미영속), 선택 집합은 재조회 시 초기화.
    private bool _selectMode;
    private readonly HashSet<System.Dynamic.ExpandoObject> _selected = new();

    private void OnRowRender(Radzen.RowRenderEventArgs<System.Dynamic.ExpandoObject> args)
    {
        var on = _selectMode ? args.Data is not null && _selected.Contains(args.Data) : ReferenceEquals(args.Data, _selectedItem);
        if (on) args.Attributes["data-selected"] = "true";
    }

    // 자체 정렬(P3-9) — Radzen Property 정렬이 ExpandoObject에서 불가하므로 헤더 클릭으로 직접 정렬한다.
    // 숫자 컬럼(전 값이 숫자/공백)은 수치 정렬, 그 외 문자열 정렬(옛 수제 그리드 로직 재사용).
    private string? _sortKey;
    private bool _sortDesc;

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = false; }
        _cardPage = 0;
    }

    /// <summary>세그먼트 버튼의 활성 상태를 시각 클래스와 aria-pressed에 동일하게 반영합니다.</summary>
    private string ViewButtonCss(MetaGridViewMode mode)
        => $"nx-view-button{(EffectiveViewMode == mode ? " is-active" : string.Empty)}";

    private string IsViewActive(MetaGridViewMode mode)
        => (EffectiveViewMode == mode).ToString().ToLowerInvariant();

    internal static string ViewStorageValue(MetaGridViewMode mode) => mode switch
    {
        MetaGridViewMode.StandardTable => "standard-table",
        MetaGridViewMode.DenseTable => "dense-table",
        MetaGridViewMode.Card => "card",
        MetaGridViewMode.SplitDetail => "split-detail",
        _ => "standard-table",
    };

    internal static MetaGridViewMode ParseViewMode(string? value)
        => value?.Trim().ToLowerInvariant() switch
        {
            "dense-table" or "densetable" => MetaGridViewMode.DenseTable,
            "card" => MetaGridViewMode.Card,
            "split-detail" or "splitdetail" => MetaGridViewMode.SplitDetail,
            _ => MetaGridViewMode.StandardTable,
        };

    private async Task SetViewModeAsync(MetaGridViewMode mode)
    {
        if (!EnableViewModes || _viewMode == mode) return;
        _viewMode = mode;
        _cardPage = 0;
        await SaveAsync(ViewKey, ViewStorageValue(mode));
    }

    private void SetCardSortColumn(ChangeEventArgs args)
    {
        var key = args.Value?.ToString();
        _sortKey = Columns.Any(column => column.Visible && column.Key == key) ? key : null;
        _sortDesc = false;
        _cardPage = 0;
    }

    private void ToggleCardSortDirection()
    {
        if (_sortKey is null) return;
        _sortDesc = !_sortDesc;
        _cardPage = 0;
    }

    private string CardSortDirectionLabel => _sortKey is null
        ? T("grid.sortDirectionDisabled", "정렬 기준을 먼저 선택하세요")
        : _sortDesc
            ? T("grid.sortedDescendingChange", "현재 내림차순, 오름차순으로 변경")
            : T("grid.sortedAscendingChange", "현재 오름차순, 내림차순으로 변경");

    private string CardDisplayValue(System.Dynamic.ExpandoObject row, GridColumnDefinition column)
    {
        var raw = Cell(row, column.Key);
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        return KindOf(column.Key) switch
        {
            ColumnKind.Status => StatusLabel(raw),
            ColumnKind.Boolean => IsTruthy(raw) ? T("common.yes", "예") : T("common.no", "아니오"),
            ColumnKind.DateTime => FormatCell(raw),
            _ => raw,
        };
    }

    private string CardValueCss(System.Dynamic.ExpandoObject row, GridColumnDefinition column)
    {
        var classes = new List<string> { "nx-card-value" };
        var raw = Cell(row, column.Key);
        switch (KindOf(column.Key))
        {
            case ColumnKind.Numeric: classes.Add("is-numeric"); break;
            case ColumnKind.Status:
                classes.Add(KnownStatusStyle(raw) switch
                {
                    Radzen.BadgeStyle.Success => "is-success",
                    Radzen.BadgeStyle.Warning => "is-warning",
                    Radzen.BadgeStyle.Danger => "is-danger",
                    Radzen.BadgeStyle.Info => "is-info",
                    _ => "is-neutral",
                });
                break;
            case ColumnKind.Empty: classes.Add("is-empty"); break;
        }
        return string.Join(' ', classes);
    }

    private bool IsRowSelected(System.Dynamic.ExpandoObject row)
        => _selectMode ? _selected.Contains(row) : ReferenceEquals(row, _selectedItem);

    private string CardItemCss(System.Dynamic.ExpandoObject row)
        => $"nx-data-card{(IsRowSelected(row) ? " is-selected" : string.Empty)}";

    private string CardAriaLabel(
        System.Dynamic.ExpandoObject row,
        GridColumnDefinition? primary,
        string value)
    {
        var itemName = primary is null ? value : $"{ColumnCaption(primary)} {value}";
        if (!_selectMode)
            return $"{itemName} {T("grid.openDetail", "상세 보기")}";

        var action = _selected.Contains(row)
            ? T("common.deselect", "선택 해제")
            : T("common.select", "선택");
        return $"{itemName} {action}";
    }

    private IReadOnlyList<System.Dynamic.ExpandoObject> CardPageItems(List<System.Dynamic.ExpandoObject> items)
    {
        if (ServerTotal is not null) return items;
        var pageCount = PageCountOf(items.Count);
        var safePage = pageCount == 0 ? 0 : Math.Min(_cardPage, pageCount - 1);
        return items.Skip(safePage * PageSize).Take(PageSize).ToList();
    }

    private void ChangeCardPage(int delta, int total)
    {
        var pageCount = PageCountOf(total);
        _cardPage = Math.Clamp(_cardPage + delta, 0, Math.Max(0, pageCount - 1));
    }

    // P3 — 정렬/필터 뷰 캐시. 입력(_filter/_sortKey/_sortDesc/_items)이 그대로면 재계산하지 않는다.
    // (무관한 부모 재렌더 — 행선택·폼로드 등 — 에도 전체 재정렬/재할당하던 낭비 제거). _items 참조 변경은
    // OnParametersSet가 _viewDirty로, 필터/정렬 변경은 아래 캐시키 비교로 무효화한다.
    private List<System.Dynamic.ExpandoObject> _view = new();
    private bool _viewDirty = true;
    private string _viewFilter = "";
    private string? _viewSortKey;
    private bool _viewSortDesc;

    // 필터(부분일치) → 정렬. 필터는 보이는 컬럼 무관 대소문자 무시 contains. 정렬은 숫자 컬럼이면 수치.
    private List<System.Dynamic.ExpandoObject> SortedItems()
    {
        if (!_viewDirty && _viewFilter == _filter && _viewSortKey == _sortKey && _viewSortDesc == _sortDesc
            && _viewFilterRev == _filterRev)
            return _view;

        IEnumerable<System.Dynamic.ExpandoObject> items = _items;

        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var f = _filter.Trim();
            var keys = Columns.Where(c => c.Visible).Select(c => c.Key).ToList();
            items = items.Where(e => keys.Any(k => Cell(e, k).Contains(f, StringComparison.OrdinalIgnoreCase)));
        }

        // 컬럼 필터(팝업 적용본) — 컬럼별 포함/일치 AND 결합.
        if (_colFilters.Count > 0)
            foreach (var (cfKey, cf) in _colFilters)
                items = items.Where(e => MatchColumnFilter(Cell(e, cfKey), cf.Op, cf.Val));

        if (_sortKey is { } key && _items.Count > 0)
        {
            var numeric = _items.All(e => { var s = Cell(e, key); return s.Length == 0 || decimal.TryParse(s, out _); });
            items = numeric
                ? (_sortDesc ? items.OrderByDescending(e => ParseDec(Cell(e, key))) : items.OrderBy(e => ParseDec(Cell(e, key))))
                : (_sortDesc ? items.OrderByDescending(e => Cell(e, key), StringComparer.Ordinal) : items.OrderBy(e => Cell(e, key), StringComparer.Ordinal));
        }

        _view = items.ToList();
        _viewDirty = false;
        _viewFilter = _filter; _viewSortKey = _sortKey; _viewSortDesc = _sortDesc; _viewFilterRev = _filterRev;
        return _view;
    }

    // ── 그리드 표준 CRUD(추가/삭제) + 컬럼 필터 팝업 ─────────────────────────────

    // 삭제 대상 수 — 일반 모드=단일 선택(0/1), 선택 모드=체크 수. 버튼 활성화 판단.
    private int SelectedCountForDelete => _selectMode ? _selected.Count : (_selectedItem is null ? 0 : 1);

    // 선택 항목(Expando)을 원본 Rows 딕셔너리로 되짚는다 — 삭제/일괄 명령 공용(전체 컬럼 파라미터 바인딩).
    private List<Dictionary<string, object?>> SelectedOriginalRows()
    {
        var targets = new List<Dictionary<string, object?>>();
        if (Rows is null) return targets;
        IEnumerable<System.Dynamic.ExpandoObject> picked = _selectMode ? _selected : (_selectedItem is null
            ? Enumerable.Empty<System.Dynamic.ExpandoObject>() : new[] { _selectedItem });
        foreach (var item in picked)
        {
            var idx = _items.IndexOf(item);
            if (idx >= 0 && idx < Rows.Count) targets.Add(Rows[idx]);
        }
        return targets;
    }

    private async Task DeleteSelectedAsync()
    {
        if (!OnDeleteRows.HasDelegate) return;
        var targets = SelectedOriginalRows();
        if (targets.Count > 0) await OnDeleteRows.InvokeAsync(targets);
    }

    private async Task EmitBulkCommandAsync(BulkCommandDefinition command)
    {
        if (!OnBulkCommand.HasDelegate) return;
        var targets = SelectedOriginalRows();
        if (targets.Count > 0) await OnBulkCommand.InvokeAsync((command, targets));
    }

    // 컬럼 필터 — 적용본(_colFilters)과 편집 드래프트(_cfOp/_cfVal)를 분리(팝업에서 적용 눌러야 반영).
    private readonly Dictionary<string, (string Op, string Val)> _colFilters = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _cfOp = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _cfVal = new(StringComparer.Ordinal);
    private bool _showFilterMenu;
    private int _filterRev;                    // 적용/해제 시 증가 — SortedItems 메모 무효화 키.
    private int _viewFilterRev = -1;

    private string OpOf(string key) => _cfOp.TryGetValue(key, out var v) ? v : "contains";
    private string ValOf(string key) => _cfVal.TryGetValue(key, out var v) ? v : "";
    private void SetFilterOp(string key, ChangeEventArgs e) => _cfOp[key] = e.Value?.ToString() ?? "contains";
    private void SetFilterVal(string key, ChangeEventArgs e) => _cfVal[key] = e.Value?.ToString() ?? "";
    private void OnFilterKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    { if (e.Key == "Enter") ApplyColumnFilters(); }

    private string CaptionOf(string key)
    {
        var column = Columns.FirstOrDefault(c => c.Key == key);
        return column is null ? key : ColumnCaption(column);
    }

    private void OpenFilterMenu()
    {
        // 드래프트를 적용본으로 시드(팝업 재오픈 시 현재 조건이 보이게).
        foreach (var (k, f) in _colFilters) { _cfOp[k] = f.Op; _cfVal[k] = f.Val; }
        CloseAllPopups();
        _showFilterMenu = true;
        _pendingPopupFocus = PopupKind.Filter;
    }

    private void ApplyColumnFilters()
    {
        _colFilters.Clear();
        foreach (var (k, v) in _cfVal)
            if (!string.IsNullOrWhiteSpace(v)) _colFilters[k] = (OpOf(k), v.Trim());
        _filterRev++;
        _cardPage = 0;
        ClosePopup(PopupKind.Filter);
    }

    private void RemoveColumnFilter(string key)
    {
        _colFilters.Remove(key);
        _cfVal.Remove(key);
        _filterRev++;
        _cardPage = 0;
    }

    private void ClearColumnFilters()
    {
        _colFilters.Clear(); _cfVal.Clear(); _cfOp.Clear();
        _filterRev++;
        _cardPage = 0;
        ClosePopup(PopupKind.Filter);
    }

    /// <summary>비모달 팝오버를 하나만 열고, 열린 패널로 포커스를 옮길 준비를 합니다.</summary>
    private void ToggleColumnMenu()
    {
        var open = !_showColMenu;
        CloseAllPopups();
        if (!open) return;
        _showColMenu = true;
        _pendingPopupFocus = PopupKind.Columns;
    }

    private void ToggleMoreMenu()
    {
        var open = !_showMoreMenu;
        CloseAllPopups();
        if (!open) return;
        _showMoreMenu = true;
        _pendingPopupFocus = PopupKind.More;
    }

    /// <summary>Escape·바깥 클릭·완료 후 팝오버를 닫고 원래 트리거로 포커스를 복귀시킵니다.</summary>
    private void ClosePopup(PopupKind popup)
    {
        switch (popup)
        {
            case PopupKind.Filter: _showFilterMenu = false; break;
            case PopupKind.Columns: _showColMenu = false; break;
            case PopupKind.More: _showMoreMenu = false; break;
        }
        _pendingPopupFocus = PopupKind.None;
        _pendingTriggerFocus = popup;
    }

    private void CloseAllPopups()
    {
        _showFilterMenu = false;
        _showColMenu = false;
        _showMoreMenu = false;
        _pendingPopupFocus = PopupKind.None;
        _pendingTriggerFocus = PopupKind.None;
    }

    private void HandlePopupKeyDown(PopupKind popup, KeyboardEventArgs args)
    {
        if (args.Key == "Escape") ClosePopup(popup);
    }

    private async Task ExportFromMoreAsync()
    {
        ClosePopup(PopupKind.More);
        await ExportCsvAsync();
    }

    private static bool MatchColumnFilter(string cell, string op, string val) => op switch
    {
        "equals" => string.Equals(cell, val, StringComparison.OrdinalIgnoreCase),
        _ => cell.Contains(val, StringComparison.OrdinalIgnoreCase),
    };

    // P2 — 빠른 필터 디바운스. Blazor Server는 입력마다 회로 왕복이라, 타이핑이 멈춘 뒤(FilterDebounceMs)에만
    // 실제 필터(_filter)를 적용해 재정렬/재렌더한다. 입력값(_filterInput)은 즉시 보관해 다음 렌더에 반영.
    private const int FilterDebounceMs = 250;
    private string _filterInput = "";
    private CancellationTokenSource? _filterCts;

    private async Task OnFilterInput(ChangeEventArgs e)
    {
        _filterInput = e.Value?.ToString() ?? "";
        _filterCts?.Cancel();
        var cts = new CancellationTokenSource();
        _filterCts = cts;
        try
        {
            await Task.Delay(FilterDebounceMs, cts.Token);
            _filter = _filterInput;
            _cardPage = 0;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* 다음 입력이 이전 대기를 취소 — 무시 */ }
    }

    public void Dispose()
    {
        _filterCts?.Cancel();
        _filterCts?.Dispose();
    }

    // ── 그리드 개인화(밀도·컬럼 표시·첫 컬럼 고정) — 화면별 localStorage 저장 ────────────
    private bool _compact = true;                             // 기본 조밀(Radzen Compact)
    private bool _freezeFirst;                                // 첫 컬럼 가로 고정(넓은 표에서 식별자 유지)
    private HashSet<string> _hiddenKeys = new(StringComparer.Ordinal);
    private bool _showColMenu;
    private bool _showMoreMenu;   // '더보기'(고정·밀도·CSV) 팝업 — 토글류는 클릭 후에도 유지
    private string? _prefsLoadedFor;                          // 개인화를 로드한 ScreenKey(중복 로드 방지)

    private string DensityKey => $"nxgrid:{ScreenKey}:density";
    private string HiddenKey => $"nxgrid:{ScreenKey}:hidden";
    private string FreezeKey => $"nxgrid:{ScreenKey}:freeze";
    private string ViewKey => $"nxgrid:{ScreenKey}:view";

    // 화면(ScreenKey) 진입/전환 시 저장된 개인화를 1회 로드. JS(localStorage)는 렌더 이후에만 안전.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingPopupFocus is not PopupKind.None)
        {
            var popup = _pendingPopupFocus;
            _pendingPopupFocus = PopupKind.None;
            var panel = popup switch
            {
                PopupKind.Filter => _filterMenuRef,
                PopupKind.Columns => _columnMenuRef,
                PopupKind.More => _moreMenuRef,
                _ => default,
            };
            try { await panel.FocusAsync(); }
            catch { /* 렌더 사이에 닫힌 팝오버는 포커스 이동을 생략한다. */ }
        }

        if (_pendingTriggerFocus is not PopupKind.None)
        {
            var popup = _pendingTriggerFocus;
            _pendingTriggerFocus = PopupKind.None;
            var trigger = popup switch
            {
                PopupKind.Filter => _filterTrigger,
                PopupKind.Columns => _columnTrigger,
                PopupKind.More => _moreTrigger,
                _ => null,
            };
            try
            {
                if (trigger is not null) await trigger.Element.FocusAsync();
            }
            catch { /* 비대화형 테스트/분리 호스트에서는 포커스 복귀를 안전하게 생략한다. */ }
        }

        if (string.IsNullOrEmpty(ScreenKey) || _prefsLoadedFor == ScreenKey) return;
        _prefsLoadedFor = ScreenKey;
        try
        {
            var density = await JS.InvokeAsync<string?>("localStorage.getItem", DensityKey);
            var hidden = await JS.InvokeAsync<string?>("localStorage.getItem", HiddenKey);
            var freeze = await JS.InvokeAsync<string?>("localStorage.getItem", FreezeKey);
            var storedView = EnableViewModes
                ? await JS.InvokeAsync<string?>("localStorage.getItem", ViewKey)
                : null;
            var newCompact = density is null ? _compact : density != "roomy";
            var newFreeze = freeze is null ? _freezeFirst : freeze == "1";
            // 신규 view 키가 최우선이다. 아직 view 키가 없는 기존 사용자는 저장된 density를 한 번
            // 표준/밀집 보기로 승격하고, 둘 다 없으면 가독성 우선의 표준 표를 기본으로 쓴다.
            var newView = !EnableViewModes
                ? _viewMode
                : !string.IsNullOrWhiteSpace(storedView)
                    ? ParseViewMode(storedView)
                    : density == "compact"
                        ? MetaGridViewMode.DenseTable
                        : MetaGridViewMode.StandardTable;
            var newHidden = string.IsNullOrEmpty(hidden)
                ? new HashSet<string>(StringComparer.Ordinal)
                : new HashSet<string>(hidden.Split(',', StringSplitOptions.RemoveEmptyEntries), StringComparer.Ordinal);
            if (newCompact != _compact || newFreeze != _freezeFirst || newView != _viewMode || !newHidden.SetEquals(_hiddenKeys))
            {
                _compact = newCompact;
                _freezeFirst = newFreeze;
                _viewMode = newView;
                _cardPage = 0;
                _hiddenKeys = newHidden;
                StateHasChanged();
            }
        }
        catch { /* localStorage 미지원/비보안 컨텍스트 — 개인화는 세션 한정으로 폴백 */ }
    }

    private async Task ToggleDensityAsync()
    {
        _compact = !_compact;
        await SaveAsync(DensityKey, _compact ? "compact" : "roomy");
    }

    private async Task ToggleFreezeAsync()
    {
        _freezeFirst = !_freezeFirst;
        await SaveAsync(FreezeKey, _freezeFirst ? "1" : "0");
    }

    // 컬럼 표시/숨김 토글 — 마지막 한 컬럼은 숨길 수 없다(체크박스 disabled로도 가드하지만 이중 방어).
    private async Task ToggleColumnAsync(string key)
    {
        if (_hiddenKeys.Contains(key)) _hiddenKeys.Remove(key);
        else
        {
            var shownCount = Columns.Count(c => c.Visible && !_hiddenKeys.Contains(c.Key));
            if (shownCount <= 1) return;   // 마지막 남은 컬럼은 유지
            _hiddenKeys.Add(key);
        }
        await SaveAsync(HiddenKey, string.Join(',', _hiddenKeys));
    }

    private async Task ResetColumnsAsync()
    {
        _hiddenKeys.Clear();
        ClosePopup(PopupKind.Columns);
        await SaveAsync(HiddenKey, "");
    }

    private bool _persistWarned;   // 개인화 저장 실패 경고는 1회만(토글마다 반복 토스트 방지)

    private async Task SaveAsync(string key, string value)
    {
        if (string.IsNullOrEmpty(ScreenKey)) return;   // 저장 키 없으면 세션 한정(개인화는 유지되나 미영속)
        try { await JS.InvokeVoidAsync("localStorage.setItem", key, value); }
        catch
        {
            // 세션 내 상태는 유지되나 새로고침 시 소실 — 사용자는 저장됐다고 믿으므로 1회 알린다.
            if (_persistWarned) return;
            _persistWarned = true;
            Notify(Radzen.NotificationSeverity.Warning, T("grid.persistFail", "개인화 저장 안 됨 — 이 세션에서만 유지됩니다"));
        }
    }

    // 행 선택 — Radzen이 넘긴 변환 항목의 인덱스로 원본 Rows를 되짚어 콜백한다(폼 로드용 전체 딕셔너리).
    // 선택 행을 기록해(모든 그리드에서 클릭 피드백) RowRender가 data-selected로 강조하게 한다.
    private async Task OnRowSelectedInternal(System.Dynamic.ExpandoObject item)
    {
        // 선택 모드에선 행 클릭 = 다중선택 토글(폼로드 안 함). 일반 모드에선 단일선택 + 폼로드 콜백.
        if (_selectMode) { ToggleRowSelection(item); return; }
        _selectedItem = item;
        if (!OnRowSelect.HasDelegate || Rows is null) return;
        var idx = _items.IndexOf(item);
        if (idx >= 0 && idx < Rows.Count) await OnRowSelect.InvokeAsync(Rows[idx]);
    }

    // ── 다중선택(선택 모드) ─────────────────────────────────────────────────────
    // 현재 뷰(필터·정렬 적용분) 전체가 선택됐는지 — 헤더 전체선택 체크박스 상태.
    private bool AllVisibleSelected { get { var v = SortedItems(); return v.Count > 0 && v.All(_selected.Contains); } }

    private void ToggleRowSelection(System.Dynamic.ExpandoObject row)
    {
        if (!_selected.Remove(row)) _selected.Add(row);
    }

    // 전체 선택/해제 — 현재 뷰 기준. 이미 전부 선택돼 있으면 뷰 항목만 해제, 아니면 뷰 전체 추가.
    private void ToggleSelectAll()
    {
        var view = SortedItems();
        if (view.Count > 0 && view.All(_selected.Contains)) foreach (var r in view) _selected.Remove(r);
        else foreach (var r in view) _selected.Add(r);
    }

    private void ClearSelection() => _selected.Clear();

    private async Task ToggleSelectModeAsync()
    {
        _selectMode = !_selectMode;
        _selected.Clear();          // 모드 전환 시 선택 초기화(모드 간 상태 누수 방지)
        _selectedItem = null;       // 단일선택 강조도 해제(모드 배타)
        await Task.CompletedTask;
    }

    // 선택 행 CSV — 보이는 컬럼×선택 행(뷰 순서 보존)을 CSV로 내보낸다(전체 CSV와 동일 빌더, 선택분만).
    private async Task ExportSelectedCsvAsync()
    {
        var colsList = Columns.Where(c => c.Visible && !_hiddenKeys.Contains(c.Key)).ToList();
        if (colsList.Count == 0 || _selected.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Join(",", colsList.Select(c => CsvField(ColumnCaption(c))))).Append('\n');
        foreach (var row in SortedItems().Where(_selected.Contains))
            sb.Append(string.Join(",", colsList.Select(c => CsvField(Cell(row, c.Key))))).Append('\n');
        try { await JS.InvokeVoidAsync("nxDownloadCsv", "selected.csv", sb.ToString()); }
        catch { Notify(Radzen.NotificationSeverity.Warning, T("grid.exportFail", "CSV 내보내기 실패")); }
    }

    // 선택 행 복사 — 스프레드시트 붙여넣기용 TSV(보이는 컬럼×선택 행, 뷰 순서).
    private async Task CopySelectedAsync()
    {
        var colsList = Columns.Where(c => c.Visible && !_hiddenKeys.Contains(c.Key)).ToList();
        if (colsList.Count == 0 || _selected.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        foreach (var row in SortedItems().Where(_selected.Contains))
            sb.Append(string.Join("\t", colsList.Select(c => Cell(row, c.Key)))).Append('\n');
        try
        {
            var ok = await JS.InvokeAsync<bool>("nxCopy", sb.ToString());
            if (ok) Notify(Radzen.NotificationSeverity.Success, $"{_selected.Count}{T("grid.rowsCopied", "행 복사됨")}");
            else Notify(Radzen.NotificationSeverity.Warning, T("grid.copyFail", "복사 실패 — 클립보드 미지원(HTTPS에서만 지원)"));
        }
        catch { Notify(Radzen.NotificationSeverity.Warning, T("grid.copyFail", "복사 실패 — 클립보드 미지원(HTTPS에서만 지원)")); }
    }

    // CSV 내보내기 — 보이는 컬럼×적재 행(서버 페이징은 현재 페이지)을 CSV로 만들어 다운로드한다.
    // Radzen 내장 Export는 컬럼 Property로 값을 뽑는데 우리 컬럼은 Template-only(정렬 이슈로 Property 미지정)라
    // 값이 비므로, 딕셔너리에서 직접 뽑는 자체 CSV 빌더를 쓴다.
    private async Task ExportCsvAsync()
    {
        var cols = Columns.Where(c => c.Visible).ToList();
        if (cols.Count == 0 || Rows is not { Count: > 0 }) return;
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Join(",", cols.Select(c => CsvField(ColumnCaption(c))))).Append('\n');
        foreach (var row in Rows)
            sb.Append(string.Join(",", cols.Select(c => CsvField(RawCell(row, c.Key))))).Append('\n');
        try { await JS.InvokeVoidAsync("nxDownloadCsv", "export.csv", sb.ToString()); }
        catch { Notify(Radzen.NotificationSeverity.Warning, T("grid.exportFail", "CSV 내보내기 실패")); }
    }

    // P3-9 — 셀 더블클릭 복사. nxCopy가 성공 여부를 boolean으로 반환(미지원/거부=false)하므로
    // 결과를 토스트로 알린다 — 복사는 브라우저 고유 피드백이 없어 무음이면 성공 여부를 알 길이 없다.
    private async Task CopyCellAsync(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return;
        try
        {
            var ok = await JS.InvokeAsync<bool>("nxCopy", raw);
            if (ok) Notify(Radzen.NotificationSeverity.Success, T("grid.copied", "복사됨"));
            else Notify(Radzen.NotificationSeverity.Warning, T("grid.copyFail", "복사 실패 — 클립보드 미지원(HTTPS에서만 지원)"));
        }
        catch { Notify(Radzen.NotificationSeverity.Warning, T("grid.copyFail", "복사 실패 — 클립보드 미지원(HTTPS에서만 지원)")); }
    }

    // 다국어(P3-14) — 호스트 DI가 있으면 번역, 없으면(테스트) 한국어 폴백.
    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        EnsureUiText();
        return _uiText?.T(key, fallback) ?? fallback;
    }

    /// <summary>메타 컬럼 라벨을 현재 언어로 해석하고, 번역이 없는 영문 화면은 안정적인 필드 키를 사용합니다.</summary>
    private string ColumnCaption(GridColumnDefinition column)
    {
        EnsureUiText();
        return _uiText?.Field(column.Key, column.Caption) ?? column.Caption;
    }

    private void EnsureUiText()
    {
        if (_uiTextLookedUp) return;
        _uiTextLookedUp = true;
        _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
    }

    // 작업 피드백 토스트(무음 실패 방지) — NotificationService는 UiTextService와 같은 옵셔널 lookup.
    // @inject(필수 주입)로 바꾸면 미등록 DI인 bUnit 전 테스트가 깨진다. 렌더는 셸의 RadzenComponents 담당.
    private Radzen.NotificationService? _notify;
    private bool _notifyLookedUp;
    private void Notify(Radzen.NotificationSeverity severity, string text)
    {
        if (!_notifyLookedUp)
        {
            _notifyLookedUp = true;
            _notify = Services.GetService(typeof(Radzen.NotificationService)) as Radzen.NotificationService;
        }
        _notify?.Notify(new Radzen.NotificationMessage { Severity = severity, Summary = text, Duration = 2500 });
    }
}
