@* Phase 4 — ScreenDefinition.Columns(메타데이터)를 받아 행 데이터를 런타임 렌더하는 그리드.
   행은 파일 기반 쿼리 게이트웨이(ExecuteQueryAsync) 결과(컬럼명→값 Dictionary)로 공급된다 —
   손코딩 .razor 없이 컬럼 메타 + 명명 쿼리만으로 조회 화면을 구성한다(고코드 타입드 리포와 공존).
   OnRowSelect가 배선되면 행 클릭=선택(하이라이트)+콜백 — MetaScreen이 폼에 로드한다(P1-1).
   P3-9: 헤더 클릭 정렬(숫자 인지, ▲/▼ 토글)과 클라이언트 페이징(20행/페이지) — 서버 LIMIT 결과
   안에서의 표시 정렬/분할이며 데이터 소스는 불변이다. *@
@using NexaOne.Web.Services.Meta
@inject IServiceProvider Services

@{ var cols = Columns.Where(c => c.Visible).ToList(); var view = View(); }
@* 스타일은 smartux.css .meta-grid 규칙(테마 토큰) 단일 출처 — 인라인 금지(P3-17 다크모드). *@
<div class="meta-grid @(OnRowSelect.HasDelegate ? "selectable" : "")">
    <table class="@(cols.Any(c => c.Width is > 0) ? "fixed" : null)">
        @* 컬럼 폭 메타(Phase-2) — Width(px) 지정 컬럼은 colgroup으로 고정하고(table-layout:fixed 필요),
           미지정 컬럼은 잔여 폭을 자동 분배한다. 표시 순서는 Columns 목록 순서가 담당. *@
        @if (cols.Any(c => c.Width is > 0))
        {
            <colgroup>
                @foreach (var col in cols)
                {
                    @if (col.Width is > 0) { <col style="width:@(col.Width)px;" /> }
                    else { <col /> }
                }
            </colgroup>
        }
        <thead>
            <tr>
                @foreach (var col in cols)
                {
                    var key = col.Key;
                    <th class="sortable" title="클릭하여 정렬" @onclick="() => SortBy(key)">
                        @col.Caption@(key == _sortKey ? (_sortDesc ? " ▼" : " ▲") : "")
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in view)
            {
                var r = row;   @* 람다 캡처용 로컬 복사 *@
                <tr class="@(ReferenceEquals(r, _selected) ? "selected" : "")" @onclick="() => SelectAsync(r)">
                    @foreach (var col in cols)
                    {
                        <td>@Cell(r, col.Key)</td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @* P2-8 — 푸터 안내 공통 클래스(.meta-grid-note). 페이지가 여럿이면 페이저를 함께 렌더(P3-9). *@
    @if (Loading && Rows is not { Count: > 0 })
    {
        <p class="meta-grid-note">@T("common.loading", "조회 중…")</p>
    }
    else if (Rows is null)
    {
        <p class="meta-grid-note">@T("common.runHint", "실행하면 결과가 표시됩니다.")</p>
    }
    else if (Rows.Count == 0)
    {
        <p class="meta-grid-note">@T("common.noResult", "결과 없음")</p>
    }
    else if (PageCount <= 1)
    {
        <p class="meta-grid-note">@Rows.Count @T("common.rowsUnit", "행")</p>
    }
    else
    {
        <div class="meta-grid-pager">
            <span class="meta-grid-note">@Rows.Count @T("common.rowsUnit", "행")</span>
            <button class="pager-btn" disabled="@(_page == 0)" @onclick="() => _page--">@T("common.prev", "‹ 이전")</button>
            <span class="meta-grid-note">@(_page + 1) / @PageCount</span>
            <button class="pager-btn" disabled="@(_page >= PageCount - 1)" @onclick="() => _page++">@T("common.next", "다음 ›")</button>
        </div>
    }
</div>

@code {
    private const int PageSize = 20;

    // 보이는 컬럼만 캡션을 헤더로 그리고, 각 행에서 컬럼 Key로 값을 찾아 셀에 표시한다.
    [Parameter, EditorRequired]
    public IReadOnlyList<GridColumnDefinition> Columns { get; set; } = Array.Empty<GridColumnDefinition>();

    // null = 미실행(안내 문구), 빈 목록 = 결과 없음, 그 외 = 행 렌더.
    [Parameter] public IReadOnlyList<Dictionary<string, object?>>? Rows { get; set; }

    // P1-3 — 조회 진행 중 표시(안내 문구 대체). 기존 행이 있으면 그대로 두고 문구만 생략.
    [Parameter] public bool Loading { get; set; }

    // P1-1 — 행 클릭 콜백(전체 행 딕셔너리 — 표시되지 않는 컬럼도 포함해 폼 채우기에 쓴다).
    [Parameter] public EventCallback<Dictionary<string, object?>> OnRowSelect { get; set; }

    private Dictionary<string, object?>? _selected;
    private string? _sortKey;
    private bool _sortDesc;
    private int _page;
    private IReadOnlyList<Dictionary<string, object?>>? _lastRows;

    // 재조회(새 Rows 인스턴스)면 페이지를 처음으로 되돌린다 — 정렬 선택은 유지(레거시 그리드 관례).
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastRows, Rows))
        {
            _lastRows = Rows;
            _page = 0;
        }
    }

    private int PageCount => Rows is { Count: > 0 } ? (Rows.Count + PageSize - 1) / PageSize : 0;

    // 정렬(선택 시) + 현재 페이지 분할. 숫자 컬럼(전 값이 숫자/공백)은 수치 정렬, 그 외 문자열 정렬.
    private IEnumerable<Dictionary<string, object?>> View()
    {
        if (Rows is not { Count: > 0 }) return Array.Empty<Dictionary<string, object?>>();
        IEnumerable<Dictionary<string, object?>> v = Rows;
        if (_sortKey is { } key)
        {
            var numeric = Rows.All(r =>
            {
                var s = Cell(r, key);
                return s.Length == 0 || decimal.TryParse(s, out _);
            });
            v = numeric
                ? (_sortDesc
                    ? v.OrderByDescending(r => decimal.TryParse(Cell(r, key), out var d) ? d : decimal.MinValue)
                    : v.OrderBy(r => decimal.TryParse(Cell(r, key), out var d) ? d : decimal.MinValue))
                : (_sortDesc
                    ? v.OrderByDescending(r => Cell(r, key), StringComparer.Ordinal)
                    : v.OrderBy(r => Cell(r, key), StringComparer.Ordinal));
        }
        return v.Skip(_page * PageSize).Take(PageSize);
    }

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;   // 같은 컬럼 재클릭 = 방향 토글
        else { _sortKey = key; _sortDesc = false; }
        _page = 0;
    }

    private async Task SelectAsync(Dictionary<string, object?> row)
    {
        if (!OnRowSelect.HasDelegate) return;
        _selected = row;
        await OnRowSelect.InvokeAsync(row);
    }


    // 다국어(P3-14) — 호스트 DI가 있으면 번역, 없으면(테스트) 한국어 폴백.
    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
        }
        return _uiText?.T(key, fallback) ?? fallback;
    }

    private static string Cell(Dictionary<string, object?> row, string key)
        => row.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";
}
