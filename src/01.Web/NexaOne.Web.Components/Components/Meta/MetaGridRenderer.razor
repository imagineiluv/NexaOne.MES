@* Phase 4 — ScreenDefinition.Columns(메타데이터)를 받아 행 데이터를 런타임 렌더하는 그리드.
   행은 파일 기반 쿼리 게이트웨이(ExecuteQueryAsync) 결과(컬럼명→값 Dictionary)로 공급된다 —
   손코딩 .razor 없이 컬럼 메타 + 명명 쿼리만으로 조회 화면을 구성한다(고코드 타입드 리포와 공존).
   OnRowSelect가 배선되면 행 클릭=선택(하이라이트)+콜백 — MetaScreen이 폼에 로드한다(P1-1).
   P3-9: 헤더 클릭 정렬(숫자 인지, ▲/▼ 토글)과 클라이언트 페이징(20행/페이지) — 서버 LIMIT 결과
   안에서의 표시 정렬/분할이며 데이터 소스는 불변이다. *@
@using NexaOne.Web.Services.Meta
@implements IDisposable
@inject IServiceProvider Services
@inject Microsoft.JSInterop.IJSRuntime JS

@{ var cols = Columns.Where(c => c.Visible).ToList(); var view = View(); var widths = cols.Select(EffectiveWidth).ToList(); }
@* 스타일은 smartux.css .meta-grid 규칙(테마 토큰) 단일 출처 — 인라인 금지(P3-17 다크모드). *@
<div class="meta-grid @(OnRowSelect.HasDelegate ? "selectable" : "")" @ref="_root">
    <table class="@(widths.Any(w => w is > 0) ? "fixed" : null)">
        @* 컬럼 폭 — 메타(Width px)와 런타임 리사이즈(P3-9 v3, 헤더 경계 드래그)를 병합해 colgroup으로
           고정하고(table-layout:fixed 필요), 미지정 컬럼은 잔여 폭을 자동 분배한다.
           colgroup은 컬럼이 있으면 항상 렌더한다 — 리사이즈 부트 스크립트가 <col>에 폭을 쓰기 때문. *@
        @if (cols.Count > 0)
        {
            <colgroup>
                @for (var wi = 0; wi < cols.Count; wi++)
                {
                    @if (widths[wi] is > 0) { <col style="width:@(widths[wi])px;" /> }
                    else { <col /> }
                }
            </colgroup>
        }
        <thead>
            <tr>
                @foreach (var col in cols)
                {
                    var key = col.Key;
                    <th class="sortable" title="클릭하여 정렬" @onclick="() => SortBy(key)">
                        @col.Caption@(key == _sortKey ? (_sortDesc ? " ▼" : " ▲") : "")
                        @* P3-9 v3 — 컬럼 리사이즈 핸들. 드래그는 부트 스크립트(nxGridResizeInit) 델리게이션이 처리. *@
                        <span class="col-resize" aria-hidden="true"></span>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in view)
            {
                var r = row;   @* 람다 캡처용 로컬 복사 *@
                @* tabindex — 선택 가능 그리드는 행 키보드 내비(방향키/Enter, P3-15) 대상. *@
                <tr class="@(ReferenceEquals(r, _selected) ? "selected" : "")" tabindex="@(OnRowSelect.HasDelegate ? 0 : (int?)null)"
                    @onclick="() => SelectAsync(r)"
                    @onkeydown="e => OnRowKeyDownAsync(e, r)">
                    @foreach (var col in cols)
                    {
                        var colKey = col.Key;   @* 람다 캡처용 로컬 복사 *@
                        @* P3-9 — 더블클릭=셀 값 클립보드 복사(성공 시 셀 플래시). 빈 셀은 무시. *@
                        <td class="@(IsCopied(r, colKey) ? "copied" : null)"
                            @ondblclick="() => CopyCellAsync(r, colKey)">@Cell(r, colKey)</td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @* P2-8 — 푸터 안내 공통 클래스(.meta-grid-note). 페이지가 여럿이면 페이저를 함께 렌더(P3-9). *@
    @if (Loading && Rows is not { Count: > 0 })
    {
        <p class="meta-grid-note"><span class="nx-spin" aria-hidden="true"></span> @T("common.loading", "조회 중…")</p>
    }
    else if (Rows is null)
    {
        <p class="meta-grid-note">@T("common.runHint", "실행하면 결과가 표시됩니다.")</p>
    }
    else if (Rows.Count == 0 && (ServerTotal ?? 0) == 0)
    {
        <p class="meta-grid-note meta-grid-empty">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5 5h14l3 7v7H2v-7z"/></svg>
            @T("common.noResult", "결과 없음")
        </p>
    }
    else if (ServerTotal is int total)
    {
        @* P3-9 v2 — 서버측 페이징: 페이지 전환은 부모(MetaScreen)가 @offset 재조회로 처리한다. *@
        @if (ServerPageCount(total) <= 1)
        {
            <p class="meta-grid-note">@total @T("common.rowsUnit", "행")</p>
        }
        else
        {
            <div class="meta-grid-pager">
                <span class="meta-grid-note">@total @T("common.rowsUnit", "행")</span>
                <button class="pager-btn" disabled="@(ServerPage == 0)"
                        @onclick="() => OnServerPageChange.InvokeAsync(ServerPage - 1)">@T("common.prev", "‹ 이전")</button>
                <span class="meta-grid-note">@(ServerPage + 1) / @ServerPageCount(total)</span>
                <button class="pager-btn" disabled="@(ServerPage >= ServerPageCount(total) - 1)"
                        @onclick="() => OnServerPageChange.InvokeAsync(ServerPage + 1)">@T("common.next", "다음 ›")</button>
            </div>
        }
    }
    else if (PageCount <= 1)
    {
        <p class="meta-grid-note">@Rows.Count @T("common.rowsUnit", "행")</p>
    }
    else
    {
        <div class="meta-grid-pager">
            <span class="meta-grid-note">@Rows.Count @T("common.rowsUnit", "행")</span>
            <button class="pager-btn" disabled="@(_page == 0)" @onclick="() => _page--">@T("common.prev", "‹ 이전")</button>
            <span class="meta-grid-note">@(_page + 1) / @PageCount</span>
            <button class="pager-btn" disabled="@(_page >= PageCount - 1)" @onclick="() => _page++">@T("common.next", "다음 ›")</button>
        </div>
    }
</div>

@code {
    // 페이지 크기 — 클라이언트 분할과 서버측 페이징(MetaScreen @limit)의 단일 출처.
    public const int PageSize = 20;

    // 보이는 컬럼만 캡션을 헤더로 그리고, 각 행에서 컬럼 Key로 값을 찾아 셀에 표시한다.
    [Parameter, EditorRequired]
    public IReadOnlyList<GridColumnDefinition> Columns { get; set; } = Array.Empty<GridColumnDefinition>();

    // null = 미실행(안내 문구), 빈 목록 = 결과 없음, 그 외 = 행 렌더.
    [Parameter] public IReadOnlyList<Dictionary<string, object?>>? Rows { get; set; }

    // P1-3 — 조회 진행 중 표시(안내 문구 대체). 기존 행이 있으면 그대로 두고 문구만 생략.
    [Parameter] public bool Loading { get; set; }

    // P1-1 — 행 클릭 콜백(전체 행 딕셔너리 — 표시되지 않는 컬럼도 포함해 폼 채우기에 쓴다).
    [Parameter] public EventCallback<Dictionary<string, object?>> OnRowSelect { get; set; }

    // P3-9 v2 — 서버측 페이징(CountQueryId 화면). ServerTotal 지정 시 클라이언트 분할을 끄고(행=이미 한 페이지)
    // 서버 페이저를 렌더한다 — 페이지 전환은 OnServerPageChange로 부모가 @offset 재조회.
    [Parameter] public int? ServerTotal { get; set; }
    [Parameter] public int ServerPage { get; set; }
    [Parameter] public EventCallback<int> OnServerPageChange { get; set; }

    private static int ServerPageCount(int total) => total > 0 ? (total + PageSize - 1) / PageSize : 0;

    private Dictionary<string, object?>? _selected;
    private string? _sortKey;
    private bool _sortDesc;
    private int _page;
    private IReadOnlyList<Dictionary<string, object?>>? _lastRows;

    // P3-9 v3 — 컬럼 리사이즈: 헤더 경계 드래그로 조절한 폭(컬럼 Key→px). 메타 Width보다 우선한다.
    private readonly Dictionary<string, int> _resizeWidths = new(StringComparer.Ordinal);
    private ElementReference _root;
    private DotNetObjectReference<MetaGridRenderer>? _selfRef;
    private bool _resizeInit;

    // 컬럼의 실효 폭 — 런타임 리사이즈가 있으면 그 값, 없으면 메타 Width(둘 다 없으면 자동).
    private int? EffectiveWidth(GridColumnDefinition col)
        => _resizeWidths.TryGetValue(col.Key, out var w) ? w : col.Width;

    // 재조회(새 Rows 인스턴스)면 페이지를 처음으로 되돌린다 — 정렬 선택은 유지(레거시 그리드 관례).
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastRows, Rows))
        {
            _lastRows = Rows;
            _page = 0;
        }
    }

    // P3-9 v3 — 리사이즈 핸들 드래그를 호스트 부트 스크립트(nxGridResizeInit, 이벤트 델리게이션)에 위임한다.
    // 루트 엘리먼트당 1회 초기화(idempotent) — 화면 전환으로 컬럼이 바뀌어도 델리게이션이라 재초기화 불필요.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_resizeInit) return;
        _resizeInit = true;
        _selfRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("nxGridResizeInit", _root, _selfRef); }
        catch { /* JS 미탑재(테스트 등) — 리사이즈 없이 정상 동작 */ }
    }

    // 드래그 종료 시 부트 스크립트가 보이는 컬럼 순서의 폭 배열을 콜백한다(모든 컬럼 폭 동결 → 안정 재렌더).
    [JSInvokable]
    public Task OnColumnsResized(int[] widths)
    {
        var cols = Columns.Where(c => c.Visible).ToList();
        for (var i = 0; i < cols.Count && i < widths.Length; i++)
            if (widths[i] > 0) _resizeWidths[cols[i].Key] = widths[i];
        return InvokeAsync(StateHasChanged);
    }

    // P3-15 — 행 키보드 내비(선택 가능 그리드만). 방향키=행 이동(포커스), Enter/Space=선택.
    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, Dictionary<string, object?> row)
    {
        if (!OnRowSelect.HasDelegate) return;
        switch (e.Key)
        {
            case "ArrowDown": await FocusMoveAsync(1); break;
            case "ArrowUp": await FocusMoveAsync(-1); break;
            case "Enter": case " ": case "Spacebar": await SelectAsync(row); break;
        }
    }

    private async Task FocusMoveAsync(int dir)
    {
        try { await JS.InvokeVoidAsync("nxGridFocusMove", _root, dir); }
        catch { /* JS 미탑재(테스트) — 무시 */ }
    }

    private int PageCount => Rows is { Count: > 0 } ? (Rows.Count + PageSize - 1) / PageSize : 0;

    // 정렬(선택 시) + 현재 페이지 분할. 숫자 컬럼(전 값이 숫자/공백)은 수치 정렬, 그 외 문자열 정렬.
    // 서버 페이징 모드에선 분할을 끈다(행=이미 한 페이지; 정렬은 페이지 내 표시 정렬로 유지).
    private IEnumerable<Dictionary<string, object?>> View()
    {
        if (Rows is not { Count: > 0 }) return Array.Empty<Dictionary<string, object?>>();
        IEnumerable<Dictionary<string, object?>> v = Rows;
        if (_sortKey is { } key)
        {
            var numeric = Rows.All(r =>
            {
                var s = Cell(r, key);
                return s.Length == 0 || decimal.TryParse(s, out _);
            });
            v = numeric
                ? (_sortDesc
                    ? v.OrderByDescending(r => decimal.TryParse(Cell(r, key), out var d) ? d : decimal.MinValue)
                    : v.OrderBy(r => decimal.TryParse(Cell(r, key), out var d) ? d : decimal.MinValue))
                : (_sortDesc
                    ? v.OrderByDescending(r => Cell(r, key), StringComparer.Ordinal)
                    : v.OrderBy(r => Cell(r, key), StringComparer.Ordinal));
        }
        return ServerTotal.HasValue ? v : v.Skip(_page * PageSize).Take(PageSize);
    }

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;   // 같은 컬럼 재클릭 = 방향 토글
        else { _sortKey = key; _sortDesc = false; }
        _page = 0;
    }

    private async Task SelectAsync(Dictionary<string, object?> row)
    {
        if (!OnRowSelect.HasDelegate) return;
        _selected = row;
        await OnRowSelect.InvokeAsync(row);
    }

    // P3-9 — 셀 더블클릭 복사. 호스트 부트 스크립트의 nxCopy(navigator.clipboard 래퍼)를 쓰고,
    // 미지원/거부 환경(비보안 컨텍스트 등)에선 표시 없이 무시한다. 성공 시 1.2초 셀 플래시.
    private (Dictionary<string, object?> Row, string Key)? _copied;

    private bool IsCopied(Dictionary<string, object?> row, string key)
        => _copied is { } c && ReferenceEquals(c.Row, row) && string.Equals(c.Key, key, StringComparison.Ordinal);

    private async Task CopyCellAsync(Dictionary<string, object?> row, string key)
    {
        var text = Cell(row, key);
        if (text.Length == 0) return;
        try { await JS.InvokeVoidAsync("nxCopy", text); }
        catch { return; }
        _copied = (row, key);
        StateHasChanged();
        await Task.Delay(1200);
        if (IsCopied(row, key)) { _copied = null; StateHasChanged(); }
    }


    // 다국어(P3-14) — 호스트 DI가 있으면 번역, 없으면(테스트) 한국어 폴백.
    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
        }
        return _uiText?.T(key, fallback) ?? fallback;
    }

    private static string Cell(Dictionary<string, object?> row, string key)
        => row.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";

    public void Dispose() => _selfRef?.Dispose();
}
