@* Phase 4 — ScreenDefinition.Columns(메타)를 받아 명명 쿼리 결과(Dictionary 행)를 런타임 렌더하는 그리드.
   렌더 엔진은 RadzenDataGrid(무료 MIT) — 딕셔너리 행을 IDictionary<string,object>로 변환해 정렬/페이징/
   리사이즈를 라이브러리에 위임한다. 서버측 페이징(CountQueryId)은 LoadData↔OnServerPageChange로 연결
   (클라/서버는 Radzen에서 LoadData 유무로 갈리는 배타 경로라 두 분기로 렌더, 컬럼은 공유 프래그먼트).
   심각도 값(Error/Warning 등)은 배지로, 타임스탬프 값은 사람이 읽는 형식으로 셀 템플릿에서 표시한다. *@
@using NexaOne.Web.Services.Meta
@inject IServiceProvider Services
@inject Microsoft.JSInterop.IJSRuntime JS

@{
    var cols = Columns.Where(c => c.Visible).ToList();
    // 컬럼 정의 공유 프래그먼트 — 두 그리드 분기 중 하나에만 렌더되므로 중복 등록 없음.
    RenderFragment gridColumns =@<text>
        @foreach (var col in cols)
        {
            var key = col.Key;
            @* Property는 지정하지 않는다 — Radzen의 Property 기반 정렬은 ExpandoObject에서 접근자 빌드가
               실패하므로, 정렬은 자체 헤더 클릭(HeaderTemplate)으로 처리하고 셀은 Template로 렌더한다. *@
            <RadzenDataGridColumn TItem="System.Dynamic.ExpandoObject" Title="@col.Caption" Sortable="false"
                                  Width="@(col.Width is > 0 ? $"{col.Width}px" : null)">
                <HeaderTemplate>
                    <span class="nx-sort" @onclick="() => SortBy(key)">
                        @col.Caption@(_sortKey == key ? (_sortDesc ? " ▼" : " ▲") : "")
                    </span>
                </HeaderTemplate>
                <Template Context="row">
                    @{ var raw = Cell(row, key); var sev = SeverityOf(raw); }
                    @if (sev is not null)
                    {
                        <RadzenBadge Text="@raw" BadgeStyle="sev.Value" Variant="Variant.Flat" />
                    }
                    else
                    {
                        <span @ondblclick="() => CopyCellAsync(raw)">@FormatCell(raw)</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        }
    </text>;
}
<div class="meta-grid">
    @if (Rows is { Count: > 0 })
    {
        <div class="meta-grid-toolbar">
            <RadzenButton Text="⬇ CSV" Click="ExportCsvAsync" title="@T("common.exportCsv", "CSV로 내보내기")"
                          ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" class="pager-btn" />
        </div>
    }
    @if (Loading && Rows is not { Count: > 0 })
    {
        <p class="meta-grid-note"><span class="nx-spin" aria-hidden="true"></span> @T("common.loading", "조회 중…")</p>
    }
    else if (Rows is null)
    {
        <p class="meta-grid-note">@T("common.runHint", "실행하면 결과가 표시됩니다.")</p>
    }
    else if (ServerTotal is int total)
    {
        @* 서버측 페이징 — Radzen 페이징은 끄고(한 페이지만 표시) 자체 페이저로 부모 재조회를 요청한다.
           (Radzen LoadData는 외부 데이터 소유와 충돌해 재발화 루프가 생기므로, 서버 페이징은 외부 페이저로.) *@
        <RadzenDataGrid TItem="System.Dynamic.ExpandoObject" Data="SortedItems()" AllowPaging="false"
                        AllowSorting="false" AllowColumnResize="true"
                        Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                        SelectionMode="DataGridSelectionMode.Single"
                        RowSelect="OnRowSelectedInternal" EmptyText="@T("common.noResult", "결과 없음")">
            <Columns>@gridColumns</Columns>
        </RadzenDataGrid>
        @if (PageCountOf(total) <= 1)
        {
            <p class="meta-grid-note">@total @T("common.rowsUnit", "행")</p>
        }
        else
        {
            <div class="meta-grid-pager">
                <span class="meta-grid-note">@total @T("common.rowsUnit", "행")</span>
                <RadzenButton Text="@T("common.prev", "‹ 이전")" Disabled="@(ServerPage == 0)" class="pager-btn"
                              Click="() => OnServerPageChange.InvokeAsync(ServerPage - 1)"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
                <span class="meta-grid-note">@(ServerPage + 1) / @PageCountOf(total)</span>
                <RadzenButton Text="@T("common.next", "다음 ›")" Disabled="@(ServerPage >= PageCountOf(total) - 1)" class="pager-btn"
                              Click="() => OnServerPageChange.InvokeAsync(ServerPage + 1)"
                              ButtonStyle="Radzen.ButtonStyle.Light" Variant="Radzen.Variant.Flat" Size="Radzen.ButtonSize.Small" />
            </div>
        }
    }
    else
    {
        @* 클라이언트 페이징/정렬 — 전체 행을 Radzen이 내부에서 페이지/정렬한다. *@
        <RadzenDataGrid TItem="System.Dynamic.ExpandoObject" Data="SortedItems()"
                        AllowPaging="true" PageSize="PageSize" AllowSorting="false" AllowColumnResize="true"
                        Density="Density.Compact" GridLines="DataGridGridLines.Horizontal"
                        SelectionMode="DataGridSelectionMode.Single"
                        RowSelect="OnRowSelectedInternal" EmptyText="@T("common.noResult", "결과 없음")">
            <Columns>@gridColumns</Columns>
        </RadzenDataGrid>
        <p class="meta-grid-note">@_items.Count @T("common.rowsUnit", "행")</p>
    }
</div>

@code {
    // 페이지 크기 — 클라이언트 분할과 서버측 페이징(MetaScreen @limit)의 단일 출처.
    public const int PageSize = 20;

    private static int PageCountOf(int total) => total > 0 ? (total + PageSize - 1) / PageSize : 0;

    // 보이는 컬럼만 헤더로 그리고, 각 행에서 컬럼 Key로 값을 찾아 셀에 표시한다.
    [Parameter, EditorRequired]
    public IReadOnlyList<GridColumnDefinition> Columns { get; set; } = Array.Empty<GridColumnDefinition>();

    // null = 미실행(안내 문구), 빈 목록 = 결과 없음, 그 외 = 행 렌더.
    [Parameter] public IReadOnlyList<Dictionary<string, object?>>? Rows { get; set; }

    // P1-3 — 조회 진행 중 표시(안내 문구 대체). 기존 행이 있으면 그대로 두고 문구만 생략.
    [Parameter] public bool Loading { get; set; }

    // P1-1 — 행 클릭 콜백(전체 행 딕셔너리 — 표시되지 않는 컬럼도 포함해 폼 채우기에 쓴다).
    [Parameter] public EventCallback<Dictionary<string, object?>> OnRowSelect { get; set; }

    // P3-9 v2 — 서버측 페이징(CountQueryId 화면). ServerTotal 지정 시 Radzen이 Count 기준 페이저를 그리고
    // 페이지 전환은 LoadData→OnServerPageChange로 부모(MetaScreen)가 @offset 재조회한다.
    [Parameter] public int? ServerTotal { get; set; }
    [Parameter] public int ServerPage { get; set; }
    [Parameter] public EventCallback<int> OnServerPageChange { get; set; }

    // Radzen 바인딩용 변환분(원본 Rows와 동일 순서·인덱스). Radzen 동적 데이터는 ExpandoObject를 정식
    // 지원한다(IDictionary 인터페이스 자체는 Property 접근자 빌드가 실패). null 값은 렌더/정렬 안전상 ""으로.
    private List<System.Dynamic.ExpandoObject> _items = new();

    protected override void OnParametersSet()
    {
        _items = (Rows ?? (IReadOnlyList<Dictionary<string, object?>>)Array.Empty<Dictionary<string, object?>>())
            .Select(r =>
            {
                var e = new System.Dynamic.ExpandoObject();
                var d = (IDictionary<string, object>)e;
                foreach (var kv in r) d[kv.Key] = kv.Value ?? (object)"";
                return e;
            })
            .ToList();
    }

    // 자체 정렬(P3-9) — Radzen Property 정렬이 ExpandoObject에서 불가하므로 헤더 클릭으로 직접 정렬한다.
    // 숫자 컬럼(전 값이 숫자/공백)은 수치 정렬, 그 외 문자열 정렬(옛 수제 그리드 로직 재사용).
    private string? _sortKey;
    private bool _sortDesc;

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = false; }
    }

    private IEnumerable<System.Dynamic.ExpandoObject> SortedItems()
    {
        if (_sortKey is not { } key || _items.Count == 0) return _items;
        var numeric = _items.All(e =>
        {
            var s = Cell(e, key);
            return s.Length == 0 || decimal.TryParse(s, out _);
        });
        return numeric
            ? (_sortDesc
                ? _items.OrderByDescending(e => decimal.TryParse(Cell(e, key), out var d) ? d : decimal.MinValue)
                : _items.OrderBy(e => decimal.TryParse(Cell(e, key), out var d) ? d : decimal.MinValue))
            : (_sortDesc
                ? _items.OrderByDescending(e => Cell(e, key), StringComparer.Ordinal)
                : _items.OrderBy(e => Cell(e, key), StringComparer.Ordinal));
    }

    // 행 선택 — Radzen이 넘긴 변환 항목의 인덱스로 원본 Rows를 되짚어 콜백한다(폼 로드용 전체 딕셔너리).
    private async Task OnRowSelectedInternal(System.Dynamic.ExpandoObject item)
    {
        if (!OnRowSelect.HasDelegate || Rows is null) return;
        var idx = _items.IndexOf(item);
        if (idx >= 0 && idx < Rows.Count) await OnRowSelect.InvokeAsync(Rows[idx]);
    }

    // 셀 값 조회(문자열). ExpandoObject를 IDictionary로 보고 Key로 찾는다.
    private static string Cell(System.Dynamic.ExpandoObject row, string key)
        => ((IDictionary<string, object>)row).TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";

    // 타임스탬프 포맷(P1) — ISO 등으로 파싱되는 DateTime은 "yyyy-MM-dd HH:mm:ss"(로컬)로. 그 외는 원문.
    internal static string FormatCell(string raw)
        => DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.RoundtripKind, out var dt)
           ? dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
           : raw;

    // 심각도 배지(P1) — 알려진 상태 단어만 색 배지로(오탐 방지). 그 외는 null(평문).
    internal static Radzen.BadgeStyle? SeverityOf(string raw) => raw.Trim() switch
    {
        "Error" or "Critical" or "Fatal" or "Fail" or "Failed" or "Danger" or "Down" or "Stopped" or "Interlock"
            => Radzen.BadgeStyle.Danger,
        "Warning" or "Warn" or "Pending" or "Idle" or "Hold" => Radzen.BadgeStyle.Warning,
        "Success" or "OK" or "Normal" or "Active" or "Running" or "Completed" or "Done" or "Valid"
            => Radzen.BadgeStyle.Success,
        "Information" or "Info" or "Draft" or "Confirmed" or "Issued" or "Planned" => Radzen.BadgeStyle.Info,
        _ => null,
    };

    // CSV 내보내기 — 보이는 컬럼×적재 행(서버 페이징은 현재 페이지)을 CSV로 만들어 다운로드한다.
    // Radzen 내장 Export는 컬럼 Property로 값을 뽑는데 우리 컬럼은 Template-only(정렬 이슈로 Property 미지정)라
    // 값이 비므로, 딕셔너리에서 직접 뽑는 자체 CSV 빌더를 쓴다.
    private async Task ExportCsvAsync()
    {
        var cols = Columns.Where(c => c.Visible).ToList();
        if (cols.Count == 0 || Rows is not { Count: > 0 }) return;
        var sb = new System.Text.StringBuilder();
        sb.Append(string.Join(",", cols.Select(c => CsvField(c.Caption)))).Append('\n');
        foreach (var row in Rows)
            sb.Append(string.Join(",", cols.Select(c => CsvField(RawCell(row, c.Key))))).Append('\n');
        try { await JS.InvokeVoidAsync("nxDownloadCsv", "export.csv", sb.ToString()); }
        catch { /* JS 미탑재 — 무시 */ }
    }

    private static string CsvField(string s) => "\"" + s.Replace("\"", "\"\"") + "\"";

    private static string RawCell(Dictionary<string, object?> row, string key)
        => row.TryGetValue(key, out var v) && v is not null ? v.ToString() ?? "" : "";

    // P3-9 — 셀 더블클릭 복사. 호스트 부트 스크립트 nxCopy(navigator.clipboard 래퍼). 미지원/거부는 무시.
    private async Task CopyCellAsync(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return;
        try { await JS.InvokeVoidAsync("nxCopy", raw); }
        catch { /* clipboard 미지원(비보안 컨텍스트 등) — 무시 */ }
    }

    // 다국어(P3-14) — 호스트 DI가 있으면 번역, 없으면(테스트) 한국어 폴백.
    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        if (!_uiTextLookedUp)
        {
            _uiTextLookedUp = true;
            _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
        }
        return _uiText?.T(key, fallback) ?? fallback;
    }
}
