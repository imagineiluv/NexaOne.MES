@* Phase 3 — ScreenDefinition을 받아 필드를 런타임 렌더하는 메타데이터 주도 폼. 값은 Dictionary 모델에
   양방향 바인딩. 입력 컴포넌트는 Radzen Blazor(TextBox/Numeric/DatePicker/CheckBox/DropDown) —
   딕셔너리(문자열) 모델 ↔ 타입드 입력은 필드별 get/set 어댑터로 잇는다(값은 항상 문자열로 저장). *@
@using NexaOne.Web.Services.Meta
@inject IServiceProvider Services

<div class="meta-form" role="group" aria-label="@(string.IsNullOrWhiteSpace(Definition.Title) ? null : T($"screen.{Definition.UiId}.title", Definition.Title))">
    @foreach (var field in Definition.Fields.Where(field => !field.Hidden))
    {
        var key = field.Key;
        var err = ErrorFor(field);
        @* 접근성 배선 — 라벨↔입력(id/for·aria-labelledby)·오류(aria-invalid/describedby·role=alert)·
           필수(aria-required; 시각 *는 aria-hidden 유지). id는 인스턴스 접두사(_uid) 포함 —
           레이아웃 화면에서 같은 정의가 위젯으로 2회 렌더돼도 페이지 내 중복되지 않는다. *@
        var inputId = $"mf-{_uid}-{key}";
        var labelId = $"{inputId}-label";
        var errId = err is null ? null : $"{inputId}-err";
        <div class="@FieldCssClass(field, err)" data-field-key="@key" data-field-type="@field.Type.ToString().ToLowerInvariant()">
            <label id="@labelId" for="@inputId">
                <span>@FieldLabel(field.Key, field.Label)</span>
                @if (field.Required) { <span class="req" aria-hidden="true">*</span> }
                @if (field.ReadOnly)
                {
                    <span class="meta-field-readonly" title="@T("common.readOnly", "읽기 전용")"
                          aria-label="@T("common.readOnly", "읽기 전용")"><RadzenIcon Icon="lock" aria-hidden="true" /></span>
                }
            </label>
            <div class="meta-field-control" data-readonly="@field.ReadOnly.ToString().ToLowerInvariant()">
                @switch (field.Type)
                {
                    case FieldType.Boolean:
                        <RadzenCheckBox TValue="bool" Value="@GetBool(key)" Disabled="@field.ReadOnly"
                                        Change="@(v => Set(key, v))"
                                        InputAttributes="@BuildAria(inputId, labelId, errId, field.Required, field.ReadOnly)"
                                        class="@(err is null ? null : "nx-invalid")" />
                        break;

                    case FieldType.Select:
                        var opts = ResolveOptions(field);
                        @* DropDown은 네이티브 select가 아니라 label for 연결이 불완전 — aria-labelledby가 확실하다. *@
                        <RadzenDropDown TValue="string" Data="@opts" TextProperty="Label" ValueProperty="Value"
                                        Value="@GetString(key)" Disabled="@field.ReadOnly" AllowClear="true"
                                        Placeholder="@T("common.select", "(선택)")"
                                        Change="@(v => Set(key, v))"
                                        InputAttributes="@BuildAria(inputId, labelId, errId, field.Required, field.ReadOnly)"
                                        class="@(err is null ? null : "nx-invalid")" />
                        break;

                    case FieldType.Number:
                        <RadzenNumeric TValue="decimal?" Value="@GetDecimal(key)" Disabled="@field.ReadOnly"
                                       Change="@(v => Set(key, v?.ToString(System.Globalization.CultureInfo.InvariantCulture)))"
                                       InputAttributes="@BuildAria(inputId, labelId, errId, field.Required, field.ReadOnly)"
                                       class="@(err is null ? null : "nx-invalid")" />
                        break;

                    case FieldType.Date:
                        <RadzenDatePicker TValue="DateTime?" Value="@GetDate(key)" Disabled="@field.ReadOnly"
                                          DateFormat="yyyy-MM-dd" Change="@(v => SetDate(key, v))"
                                          InputAttributes="@BuildAria(inputId, labelId, errId, field.Required, field.ReadOnly)"
                                          class="@(err is null ? null : "nx-invalid")" />
                        break;

                    default:
                        @* TextBox는 루트가 input이라 스플랫(id/aria)이 입력 요소에 직접 얹힌다. *@
                        <RadzenTextBox Value="@GetString(key)" ReadOnly="@field.ReadOnly"
                                       Change="@(v => Set(key, v))"
                                       @attributes="BuildAria(inputId, labelId, errId, field.Required, field.ReadOnly)"
                                       class="@(err is null ? null : "nx-invalid")" />
                        break;
                }
                @* P2-7 — 필드 인라인 오류(하단 목록 나열 대체). MetaScreen이 캐스케이딩으로 내려보낸다.
                   role=alert — 검증 실패로 나타나는 순간 스크린리더가 즉시 낭독한다. *@
                <div class="meta-field-message" aria-live="polite">
                    @if (err is not null)
                    {
                        <div class="meta-field-error" id="@errId" role="alert">
                            <RadzenIcon Icon="error_outline" aria-hidden="true" />
                            <span>@err</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScreenDefinition Definition { get; set; } = default!;
    [Parameter] public Dictionary<string, object?> Model { get; set; } = new();
    [Parameter] public EventCallback<Dictionary<string, object?>> ModelChanged { get; set; }

    // 동적 Select 옵션(OptionsQueryId) — MetaScreen이 화면 로드 시 조회해 캐스케이딩으로 내려보낸다.
    // (LayoutRenderer가 재귀 렌더 중간에 있어도 파라미터 배관 없이 도달한다)
    [CascadingParameter(Name = "MetaDynamicOptions")]
    public Dictionary<string, IReadOnlyList<MetaFieldOption>>? DynamicOptions { get; set; }

    // P2-7 — 필드별 검증 오류(키→메시지). MetaScreen이 저장/커맨드 검증 시 채워 내려보낸다.
    [CascadingParameter(Name = "MetaFieldErrors")]
    public Dictionary<string, string>? FieldErrors { get; set; }

    private string? ErrorFor(FieldDefinition field)
        => FieldErrors is not null && FieldErrors.TryGetValue(field.Key, out var msg) ? msg : null;

    // 접근성 속성 딕셔너리 — TextBox엔 @attributes 스플랫(루트=input), 나머지 Radzen 입력엔
    // InputAttributes(내부 input 대상)로 전달한다. 인스턴스 접두사는 동일 정의 2회 렌더 시 id 충돌 방지.
    private readonly string _uid = Guid.NewGuid().ToString("N")[..6];

    private Dictionary<string, object> BuildAria(
        string inputId,
        string labelId,
        string? errId,
        bool required,
        bool readOnly)
    {
        var d = new Dictionary<string, object> { ["id"] = inputId, ["aria-labelledby"] = labelId };
        if (required) d["aria-required"] = "true";
        if (readOnly) d["aria-readonly"] = "true";
        if (errId is not null) { d["aria-invalid"] = "true"; d["aria-describedby"] = errId; }
        return d;
    }

    /// <summary>필드 상태를 스타일 클래스에 반영해 오류·필수·읽기전용·불리언 변형을 재사용합니다.</summary>
    private static string FieldCssClass(FieldDefinition field, string? error)
    {
        var classes = new List<string> { "meta-field", $"meta-field--{field.Type.ToString().ToLowerInvariant()}" };
        if (field.Required) classes.Add("is-required");
        if (field.ReadOnly) classes.Add("is-readonly");
        if (error is not null) classes.Add("has-error");
        return string.Join(' ', classes);
    }

    /// <summary>
    /// 정적 옵션은 원본 계약 값을 유지하면서 상태 옵션의 표시 라벨만 현재 언어로 변환합니다.
    /// 동적 옵션은 조회 결과가 값/라벨을 함께 제공하므로 서버 라벨을 그대로 사용합니다.
    /// </summary>
    private IReadOnlyList<MetaFieldOption> ResolveOptions(FieldDefinition field)
    {
        if (field.Options is { Count: > 0 } staticOptions)
        {
            EnsureUiText();
            var statusOptions = MetaStatusPresentation.IsStatusKey(field.Key)
                || staticOptions.All(MetaStatusPresentation.IsKnown);
            return staticOptions
                .Select(value => new MetaFieldOption(
                    value,
                    statusOptions ? MetaStatusPresentation.LabelOf(value, _uiText) : value))
                .ToList();
        }

        return DynamicOptions is not null && DynamicOptions.TryGetValue(field.Key, out var dynamicOptions)
            ? dynamicOptions
            : Array.Empty<MetaFieldOption>();
    }


    // 다국어(P3-14) — 호스트 DI가 있으면 번역, 없으면(테스트) 한국어 폴백.
    private NexaOne.Web.Services.UiTextService? _uiText;
    private bool _uiTextLookedUp;
    private string T(string key, string fallback)
    {
        EnsureUiText();
        return _uiText?.T(key, fallback) ?? fallback;
    }

    /// <summary>현재 언어의 명시 번역을 우선하고, 영문 리소스가 없는 신규 필드는 안정적인 키 라벨로 표시합니다.</summary>
    private string FieldLabel(string key, string fallback)
    {
        EnsureUiText();
        return _uiText?.Field(key, fallback) ?? fallback;
    }

    private void EnsureUiText()
    {
        if (_uiTextLookedUp) return;
        _uiTextLookedUp = true;
        _uiText = Services.GetService(typeof(NexaOne.Web.Services.UiTextService)) as NexaOne.Web.Services.UiTextService;
    }

    // 딕셔너리(문자열) 모델 ↔ 타입드 입력 어댑터. 값은 항상 문자열로 저장해 저장쿼리 @param 계약을 유지한다.
    private string GetString(string key) => Model.TryGetValue(key, out var v) ? v?.ToString() ?? string.Empty : string.Empty;
    private bool GetBool(string key) => Model.TryGetValue(key, out var v) && (v is true || v?.ToString() is "1" or "true" or "True");

    private decimal? GetDecimal(string key)
        => decimal.TryParse(GetString(key), System.Globalization.NumberStyles.Any,
               System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : null;

    private DateTime? GetDate(string key)
        => DateTime.TryParse(GetString(key), System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var dt) ? dt : null;

    private async Task Set(string key, object? value)
    {
        // Boolean은 bool 그대로(검증/저장이 0/1·true를 인지), 그 외는 문자열로 정규화.
        Model[key] = value is bool ? value : value?.ToString();
        await ModelChanged.InvokeAsync(Model);
    }

    // 날짜는 ISO(yyyy-MM-dd) 문자열로 저장한다(저장쿼리 @param 계약 유지). null=미선택.
    private Task SetDate(string key, DateTime? value) => Set(key, value?.ToString("yyyy-MM-dd"));
}
