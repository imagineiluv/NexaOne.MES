@implements IDisposable
@inject MdiTabService TabSvc
@inject MenuCacheService MenuCache
@inject MenuPersonalizationService Personal
@inject NavigationManager Nav
@inject DirtyTracker Dirty

@* 설계서 §20.7 — 다중 탭(MDI) 폼 관리: 탭 스트립 + 닫기/전체 닫기 + 더티 가드 *@

@if (TabSvc.Tabs.Count > 0)
{
    <div class="mdi-tabbar">
        <div class="mdi-tabbar-scroll">
            @foreach (var tab in TabSvc.Tabs)
            {
                <div @key="tab.TabId"
                     class="mdi-tab @(tab.IsActive ? "active" : null) @(tab.IsDirty ? "dirty" : null)"
                     title="@tab.Url"
                     @onclick="() => ActivateTab(tab)">
                    <span class="mdi-tab-title">@tab.DisplayTitle</span>
                    <span class="mdi-tab-close" title="닫기"
                          @onclick="() => RequestClose(tab)"
                          @onclick:stopPropagation="true">×</span>
                </div>
            }
        </div>
        @if (TabSvc.Tabs.Count > 1)
        {
            <button class="mdi-tab-closeall" @onclick="RequestCloseAll">전체 닫기</button>
        }
    </div>
}

<ConfirmCloseDialog Visible="_showConfirm" ErrorText="@_confirmError" OnAction="HandleConfirmAction" />

@* §20.7 전체 닫기: 더티 탭 목록 표시 → 모두 저장 후 닫기 / 저장하지 않고 닫기 / 취소 *@
@if (_showCloseAll)
{
    <div class="confirm-close-backdrop">
        <div class="confirm-close-dialog">
            <div class="confirm-close-title">전체 닫기</div>
            <div class="confirm-close-body">
                저장되지 않은 탭이 있습니다.
                <ul class="mdi-dirty-list">
                    @foreach (var t in TabSvc.DirtyTabs)
                    {
                        <li>@t.Title</li>
                    }
                </ul>
            </div>
            @if (!string.IsNullOrEmpty(_closeAllError))
            {
                <div class="confirm-close-error">@_closeAllError</div>
            }
            <div class="confirm-close-actions">
                <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                            OnClick="SaveAllAndClose">모두 저장 후 닫기</NexaButton>
                <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                            OnClick="DiscardAllAndClose">저장하지 않고 닫기</NexaButton>
                <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                            OnClick="@(() => _showCloseAll = false)">취소</NexaButton>
            </div>
        </div>
    </div>
}

@code {
    private MdiTab? _closing;            // × 버튼으로 닫는 중인 탭
    private string? _pendingNavigation;  // 더티 가드에 막힌 이동 대상 URL
    private bool _showConfirm;
    private bool _showCloseAll;
    private string? _confirmError;
    private string _closeAllError = string.Empty;
    private IDisposable? _locationGuard;

    protected override async Task OnInitializedAsync()
    {
        TabSvc.Changed     += OnTabsChanged;
        Dirty.StateChanged += OnDirtyChanged;
        Nav.LocationChanged += OnLocationChanged;
        _locationGuard = Nav.RegisterLocationChangingHandler(OnLocationChanging);

        await RegisterCurrentLocationAsync();   // 첫 진입 화면을 탭으로 등록
    }

    // ── 탭 등록/활성화 ───────────────────────────────────────────────────────

    private async Task RegisterCurrentLocationAsync()
    {
        var (path, query) = SplitUri(Nav.Uri);
        if (!MdiTabService.IsTabbablePath(path)) return;

        var (menuName, menuId) = await ResolveMenuAsync(path);
        TabSvc.Open(path, query, menuName);
        RecordRecentMenu(menuId);
    }

    // §20.7: 탭 제목은 menuName(다국어) 기반 — 메뉴 캐시에서 조회, 실패 시 경로 폴백.
    // §20.12: 최근 메뉴 기록용으로 MenuId도 함께 반환한다 (메뉴 미등록 화면은 null → 기록 생략).
    private async Task<(string Name, string? MenuId)> ResolveMenuAsync(string path)
    {
        try
        {
            var menu = await MenuCache.FindByProgramIdAsync(path);
            if (menu is not null) return (menu.MenuName, menu.MenuId);
        }
        catch { /* 메뉴 API 실패 시 경로 폴백 */ }

        return (path == "/" ? "대시보드" : path.Trim('/').Split('/')[^1], null);
    }

    // §20.12: 최근 메뉴 기록은 탐색의 부수 효과 — fire-and-forget, 실패해도 화면 전환을 막지 않는다
    private void RecordRecentMenu(string? menuId)
    {
        if (menuId is null) return;
        _ = Personal.RecordRecentAsync(menuId);
    }

    private (string Path, string Query) SplitUri(string uri)
    {
        var rel  = "/" + Nav.ToBaseRelativePath(Nav.ToAbsoluteUri(uri).ToString());
        var qIdx = rel.IndexOf('?');
        return qIdx < 0 ? (rel, string.Empty) : (rel[..qIdx], rel[qIdx..]);
    }

    private void ActivateTab(MdiTab tab)
    {
        if (tab.IsActive) return;
        Nav.NavigateTo(tab.Url);   // 도착 시 OnLocationChanged가 Open()으로 활성화
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;   // async void — 폐기 이후 완료가 폐기된 렌더러를 건드리지 않도록 가드
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                var (path, query) = SplitUri(e.Location);
                if (!MdiTabService.IsTabbablePath(path)) return;

                var (menuName, menuId) = await ResolveMenuAsync(path);
                TabSvc.Open(path, query, menuName);
                RecordRecentMenu(menuId);
            });
        }
        catch { /* 내비게이션 경합 시 무시 */ }
    }

    // ── 더티 가드: 활성 탭이 더티면 이동 전 확인(§20.7 닫기 플로우의 웹 적응) ──

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        var active = TabSvc.ActiveTab;
        if (active is not { IsDirty: true }) return ValueTask.CompletedTask;

        var (path, query) = SplitUri(context.TargetLocation);
        var targetUrl = string.IsNullOrEmpty(query) ? path : $"{path}{query}";
        if (string.Equals(active.Url, targetUrl, StringComparison.OrdinalIgnoreCase))
            return ValueTask.CompletedTask;   // 같은 화면 내 이동은 허용

        context.PreventNavigation();
        _pendingNavigation = targetUrl;
        _closing       = null;
        _confirmError  = null;
        _showConfirm   = true;
        _ = InvokeAsync(StateHasChanged);
        return ValueTask.CompletedTask;
    }

    // ── 탭 닫기(§20.7: HasChanges → 저장 확인 → OnClosed 정리) ────────────────

    private async Task RequestClose(MdiTab tab)
    {
        if (tab.IsDirty)
        {
            _closing       = tab;
            _pendingNavigation = null;
            _confirmError  = null;
            _showConfirm   = true;
            return;
        }
        await CloseTab(tab);
    }

    private async Task HandleConfirmAction(CloseAction action)
    {
        if (action == CloseAction.Cancel)
        {
            _showConfirm   = false;
            _closing       = null;
            _pendingNavigation = null;
            _confirmError  = null;
            return;
        }

        // × 닫기 플로우
        if (_closing is not null)
        {
            var tab = _closing;

            if (action == CloseAction.SaveAndClose)
            {
                var ok = await TrySaveAsync(tab);
                if (!ok) return;   // §20.7: 저장 성공한 경우에만 닫기 — 다이얼로그 유지
            }

            _showConfirm = false;
            _closing     = null;
            ClearDirty(tab);
            await CloseTab(tab);
            return;
        }

        // 더티 내비게이션 가드 플로우
        if (_pendingNavigation is not null)
        {
            var target = _pendingNavigation;
            var active = TabSvc.ActiveTab;

            if (action == CloseAction.SaveAndClose && active is not null)
            {
                var ok = await TrySaveAsync(active);
                if (!ok) return;
            }

            _showConfirm       = false;
            _pendingNavigation = null;
            if (active is not null) ClearDirty(active);
            Nav.NavigateTo(target);
        }
    }

    // §20.7: 해당 폼의 표준 저장 명령 실행. 핸들러 미등록 화면은 저장 실패로 처리.
    private async Task<bool> TrySaveAsync(MdiTab tab)
    {
        if (tab.SaveHandler is null)
        {
            _confirmError = "이 화면은 저장 명령이 등록되지 않았습니다. 화면에서 직접 저장한 뒤 닫아 주세요.";
            return false;
        }

        try
        {
            var ok = await tab.SaveHandler();
            if (!ok) _confirmError = "저장에 실패했습니다.";
            return ok;
        }
        catch (Exception ex)
        {
            _confirmError = $"저장 중 오류: {ex.Message}";
            return false;
        }
    }

    private void ClearDirty(MdiTab tab)
    {
        if (tab.IsActive) Dirty.ClearAll();   // 페이지 측 더티 트래커도 초기화
        tab.IsDirty = false;
    }

    private async Task CloseTab(MdiTab tab)
    {
        var wasActive = tab.IsActive;
        var next      = TabSvc.NextAfterClose(tab);
        TabSvc.Remove(tab);

        if (!wasActive) return;

        if (next is not null)
        {
            TabSvc.Activate(next);
            Nav.NavigateTo(next.Url);
        }
        else
        {
            await NavigateHomeAsync();
        }
    }

    // 같은 URI로의 NavigateTo는 LocationChanged가 발생하지 않을 수 있어,
    // 이미 홈("/")이면 현재 위치를 직접 재등록한다.
    private async Task NavigateHomeAsync()
    {
        var (path, _) = SplitUri(Nav.Uri);
        if (path == "/") await RegisterCurrentLocationAsync();
        else Nav.NavigateTo("/");
    }

    // ── 전체 닫기(§20.7: 더티 목록 → 모두 저장/저장 안 함/취소) ───────────────

    private async Task RequestCloseAll()
    {
        if (TabSvc.DirtyTabs.Count > 0)
        {
            _closeAllError = string.Empty;
            _showCloseAll  = true;
            return;
        }
        await CloseAllCore();
    }

    // §20.7: 모두 저장은 탭 순서대로 실행, 하나라도 실패하면 중단하고 실패 탭 활성화
    private async Task SaveAllAndClose()
    {
        foreach (var tab in TabSvc.DirtyTabs)
        {
            var ok = tab.SaveHandler is not null && await SafeSaveAsync(tab);
            if (!ok)
            {
                _closeAllError = $"'{tab.Title}' 저장에 실패했습니다. 전체 닫기를 중단합니다.";
                TabSvc.Activate(tab);
                Nav.NavigateTo(tab.Url);
                return;
            }
            ClearDirty(tab);
        }

        _showCloseAll = false;
        await CloseAllCore();
    }

    private static async Task<bool> SafeSaveAsync(MdiTab tab)
    {
        try { return tab.SaveHandler is not null && await tab.SaveHandler(); }
        catch { return false; }
    }

    private async Task DiscardAllAndClose()
    {
        Dirty.ClearAll();
        foreach (var t in TabSvc.Tabs) t.IsDirty = false;
        _showCloseAll = false;
        await CloseAllCore();
    }

    private async Task CloseAllCore()
    {
        TabSvc.Clear();
        await NavigateHomeAsync();
    }

    // ── 더티/탭 상태 동기화 ──────────────────────────────────────────────────

    private void OnDirtyChanged() => TabSvc.SetActiveDirty(Dirty.IsDirty);

    private void OnTabsChanged() { if (_disposed) return; _ = InvokeAsync(StateHasChanged); }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        TabSvc.Changed      -= OnTabsChanged;
        Dirty.StateChanged  -= OnDirtyChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _locationGuard?.Dispose();
    }
}
