@inherits LayoutComponentBase
@inject NexaHubService HubService
@inject AuthTokenService TokenService
@inject IApiClient Api
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<WaitOverlay />
<ApiToastHost />

@* 접근성: 키보드 사용자가 반복되는 사이드바를 건너뛰고 본문으로 이동(첫 포커스 가능 요소) *@
<a href="#main-content" class="skip-link">본문으로 건너뛰기</a>

<div class="app-layout">
    <aside class="sidebar" aria-label="주 메뉴">
        <div class="sidebar-header">
            <span>NexaOne MES</span>
        </div>
        <NavMenu />
    </aside>

    <div class="main-content">
        <header class="topbar">
            <span></span>
            <AuthorizeView>
                <Authorized>
                    <span style="font-size:0.875rem; color:#475569;">
                        @context.User.Identity?.Name
                        &nbsp;|&nbsp;
                        <a href="/auth/logout" style="color:#ef4444; text-decoration:none;">로그아웃</a>
                    </span>
                </Authorized>
            </AuthorizeView>
        </header>
        <AuthorizeView>
            <Authorized>
                <HubStatusBar />
                <MdiTabBar />
            </Authorized>
        </AuthorizeView>
        <main id="main-content" class="page-body" tabindex="-1" aria-label="본문">
            @Body
        </main>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || HubService.IsConnected) return;

        var authState = await AuthState.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true) return;

        // §20.10 — 임시 비밀번호(pwdChange 클레임) 상태면 메뉴/업무 화면 대신 비밀번호 변경으로 강제 이동.
        // 클레임 이름은 API JwtService.PasswordChangeClaim과 일치(Web은 API 미참조 — 의도적 리터럴)
        if (authState.User.HasClaim(c => c.Type == "pwdChange" && c.Value == "true"))
        {
            Nav.NavigateTo("/auth/change-password", forceLoad: true);
            return;
        }

        var token = await TokenService.GetAccessTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            // §20.9: 갱신 인지 프로바이더 — 자동/수동 재연결 협상 시 만료(임박) 토큰은 갱신해서 공급한다
            await HubService.ConnectAsync(() => Api.GetValidAccessTokenAsync());
        }
    }
}
