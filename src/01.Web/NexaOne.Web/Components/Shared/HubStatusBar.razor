@inject IHubStatusSource HubService
@implements IDisposable

@* §20.9: 재연결 중에는 화면 상단에 진행 상태를 표시하고,
   자동 재연결 실패(소진) 시 폴백 조회 모드 안내 + 수동 재연결 버튼을 제공한다 *@
@if (HubService.Status == HubStatus.Reconnecting)
{
    <div class="hub-status-bar hub-status-reconnecting">
        <span class="hub-status-dot"></span>
        실시간 연결이 끊어져 재연결하는 중입니다...
    </div>
}
else if (_reconnecting)
{
    @* 수동 재연결 진행 중 — Status가 Disconnected인 동안에도 빨간 배너로 되돌리지 않고
       진행 상태를 유지해 버튼 연타·혼동을 막는다 (§20.9) *@
    <div class="hub-status-bar hub-status-reconnecting">
        <span class="hub-status-dot"></span>
        다시 연결하는 중입니다...
    </div>
}
else if (HubService.Status == HubStatus.Disconnected)
{
    <div class="hub-status-bar hub-status-disconnected">
        <span class="hub-status-dot"></span>
        실시간 연결이 끊어졌습니다 — 주기 조회 모드로 동작 중입니다.
        <NexaButton Variant="NexaButton.ButtonVariant.Secondary" Class="ms-2" OnClick="ManualReconnectAsync">다시 연결</NexaButton>
    </div>
}

@code {
    private bool _reconnecting;
    private bool _disposed;

    protected override void OnInitialized() => HubService.OnStatusChanged += OnStatusChanged;

    // SignalR 상태 이벤트는 백그라운드 스레드에서 올 수 있다 → InvokeAsync로 UI 스레드 전환 (§20.9)
    private void OnStatusChanged(HubStatus _)
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private async Task ManualReconnectAsync()
    {
        _reconnecting = true;
        try { await HubService.ReconnectAsync(); }
        finally { _reconnecting = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        HubService.OnStatusChanged -= OnStatusChanged;
    }
}
