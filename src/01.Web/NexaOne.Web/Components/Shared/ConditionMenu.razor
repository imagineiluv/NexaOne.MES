@inject IApiClient Api
@inject NavigationManager Nav

@* 설계서 §20.8 — 조건 저장/불러오기.
   현행 검색 버튼 우클릭 메뉴의 웹 적응: 조회 버튼 옆 '조건 ▾' 드롭다운으로 제공한다.
   - 현재 조건 저장(동일 조건명 덮어쓰기 확인), 저장된 조건 목록(클릭 적용/× 삭제), 최근 조건 초기화
   - 조회 성공 시 페이지가 NotifySearchSucceededAsync()를 호출해 latest를 자동 저장
   - 폼 오픈 시 latest 자동 복원하되, 메뉴 링크 파라미터(쿼리스트링)로 넘어온 키는 링크 값을 우선 *@

<div class="condition-menu">
    <button type="button" class="condition-menu-toggle" title="조건 저장/불러오기"
            @onclick="ToggleMenu">조건 ▾</button>

    @if (_open)
    {
        <div class="condition-menu-backdrop" @onclick="() => _open = false"></div>
        <div class="condition-menu-panel">
            <button type="button" class="condition-menu-item" @onclick="OpenSaveDialog">현재 조건 저장…</button>
            <div class="condition-menu-divider"></div>
            <div class="condition-menu-section">저장된 조건</div>
            @if (_loading)
            {
                <div class="condition-menu-empty">불러오는 중…</div>
            }
            else if (_loadError)
            {
                <div class="condition-menu-empty">조건 목록을 불러오지 못했습니다.</div>
            }
            else if (_items.Count == 0)
            {
                <div class="condition-menu-empty">저장된 조건이 없습니다.</div>
            }
            else
            {
                @foreach (var item in _items)
                {
                    <div class="condition-menu-saved" @key="item.Name" title="@item.Name"
                         @onclick="() => ApplyAsync(item)">
                        <span class="condition-saved-name">@item.Name</span>
                        <span class="condition-saved-date">@item.SavedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        <span class="condition-saved-delete" title="삭제"
                              @onclick="() => RequestDelete(item)"
                              @onclick:stopPropagation="true">×</span>
                    </div>
                }
            }
            <div class="condition-menu-divider"></div>
            <button type="button" class="condition-menu-item" disabled="@(_latest is null)"
                    @onclick="RequestClearLatest">최근 조건 초기화</button>
        </div>
    }
</div>

@* 조건명 입력 팝업 *@
@if (_showSave)
{
    <div class="confirm-close-backdrop">
        <div class="confirm-close-dialog">
            <div class="confirm-close-title">현재 조건 저장</div>
            <div class="confirm-close-body">
                <NexaTextBox @bind-Value="_saveName" Placeholder="조건명 (예: 일별 설비 조회)" />
            </div>
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="confirm-close-error">@_saveError</div>
            }
            <div class="confirm-close-actions">
                <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="SaveRequestedAsync">저장</NexaButton>
                <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                          OnClick="@(() => _showSave = false)">취소</NexaButton>
            </div>
        </div>
    </div>
}

@* 덮어쓰기/삭제/초기화 공용 확인 팝업 *@
@if (_confirmMessage is not null)
{
    <div class="confirm-close-backdrop">
        <div class="confirm-close-dialog">
            <div class="confirm-close-title">확인</div>
            <div class="confirm-close-body">@_confirmMessage</div>
            <div class="confirm-close-actions">
                <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmAsync">확인</NexaButton>
                <NexaButton Variant="NexaButton.ButtonVariant.Secondary" OnClick="CancelConfirm">취소</NexaButton>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>조건 저장 키. 미지정 시 현재 라우트 경로(소문자)를 사용한다.</summary>
    [Parameter] public string? MenuId { get; set; }

    /// <summary>현재 화면의 조건 값 수집. 키는 링크 파라미터(쿼리스트링) 키와 같은 소문자 키를 사용한다.</summary>
    [Parameter] public Func<Dictionary<string, string?>>? GetValues { get; set; }

    /// <summary>저장된 조건 값을 화면 컨트롤에 반영. 날짜 등 특수 값은 ConditionValueAdapter로 변환한다.</summary>
    [Parameter] public EventCallback<IReadOnlyDictionary<string, string?>> OnApply { get; set; }

    /// <summary>조건 적용 후 자동 조회 여부 — 화면 옵션 (설계 20.8).</summary>
    [Parameter] public bool AutoSearchOnApply { get; set; }

    /// <summary>자동 조회 시 실행할 조회 콜백.</summary>
    [Parameter] public EventCallback OnSearch { get; set; }

    /// <summary>폼 오픈 시 latest 자동 복원 여부 (기본 true).</summary>
    [Parameter] public bool RestoreLatestOnInit { get; set; } = true;

    private string _menuId = string.Empty;
    private bool _open;
    private bool _loading = true;
    private bool _loadError;   // 목록 조회 실패를 '저장된 조건 없음'과 구분한다
    private List<ConditionItemDto> _items = [];
    private ConditionItemDto? _latest;

    private bool _showSave;
    private string _saveName = string.Empty;
    private string? _saveError;

    private string? _confirmMessage;
    private Func<Task>? _confirmAction;

    protected override async Task OnInitializedAsync()
    {
        _menuId = (MenuId ?? CurrentPath()).ToLowerInvariant();
        await ReloadAsync();

        if (RestoreLatestOnInit)
            await RestoreLatestAsync();
    }

    // ── latest 자동 복원: 링크 파라미터 우선, 나머지 키만 latest에서 보완 (설계 20.8) ──

    private async Task RestoreLatestAsync()
    {
        var linkKeys = CurrentQueryKeys();

        // ToDictionary는 대소문자만 다른 중복 키에서 예외를 던져 페이지를 죽인다 — TryAdd로 관용 처리 (첫 값 우선)
        var supplement = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in _latest?.Values ?? Enumerable.Empty<KeyValuePair<string, string?>>())
        {
            if (!linkKeys.Contains(kv.Key))
                supplement.TryAdd(kv.Key, kv.Value);
        }

        if (supplement.Count > 0)
            await OnApply.InvokeAsync(supplement);

        // 링크 파라미터로 열렸거나 latest를 복원했으면 화면 옵션에 따라 자동 조회
        if (AutoSearchOnApply && (linkKeys.Count > 0 || supplement.Count > 0))
            await OnSearch.InvokeAsync();
    }

    /// <summary>조회 성공 시 페이지에서 호출 — 마지막 조회 조건을 latest로 자동 저장한다 (설계 20.8).</summary>
    public async Task NotifySearchSucceededAsync()
    {
        if (GetValues is null) return;

        var values = GetValues();
        try
        {
            // 저장이 실제로 성공했을 때만 로컬 상태를 갱신한다 — 실패를 최근 조건으로 오인하지 않기 위함
            if (await Api.SaveLatestConditionAsync(_menuId, values))
                _latest = new ConditionItemDto("$latest", DateTime.UtcNow, values);
        }
        catch { /* latest 자동 저장 실패는 조회 흐름을 막지 않는다 */ }
    }

    // ── 메뉴/목록 ─────────────────────────────────────────────────────────────

    private async Task ToggleMenu()
    {
        _open = !_open;
        if (_open) await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            // GetConditionSettingsAsync는 실패 시 null을 반환한다 — 빈 목록으로 위장하지 않는다
            var dto = await Api.GetConditionSettingsAsync(_menuId);
            if (dto is null)
            {
                _loadError = true;
            }
            else
            {
                _loadError = false;
                _items = dto.Items;
                _latest = dto.Latest;
            }
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── 저장 (동일 조건명 덮어쓰기 확인) ──────────────────────────────────────

    private void OpenSaveDialog()
    {
        _open = false;
        _saveName = string.Empty;
        _saveError = null;
        _showSave = true;
    }

    private async Task SaveRequestedAsync()
    {
        var name = _saveName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            _saveError = "조건명을 입력해 주세요.";
            return;
        }

        // 서버 검증과 동일한 예약명 규칙 — 왕복 전에 즉시 안내한다
        if (name.StartsWith("$", StringComparison.Ordinal))
        {
            _saveError = "'$'로 시작하는 조건명은 예약되어 사용할 수 없습니다.";
            return;
        }

        if (_items.Any(i => string.Equals(i.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            _confirmMessage = $"'{name}' 조건이 이미 있습니다. 덮어쓰시겠습니까?";
            _confirmAction = () => SaveAsync(name);
            return;
        }

        await SaveAsync(name);
    }

    private async Task SaveAsync(string name)
    {
        if (GetValues is null)
        {
            _saveError = "이 화면은 조건 수집이 설정되지 않았습니다.";
            return;
        }

        try
        {
            var saved = await Api.SaveConditionAsync(_menuId, name, GetValues());
            if (saved is null)
            {
                _saveError = "조건 저장에 실패했습니다.";
                return;
            }

            _showSave = false;
            await ReloadAsync();   // 한도 초과 자동 삭제 반영 포함 목록 갱신
        }
        catch (Exception ex)
        {
            _saveError = $"저장 중 오류: {ex.Message}";
        }
    }

    // ── 적용 ──────────────────────────────────────────────────────────────────

    private async Task ApplyAsync(ConditionItemDto item)
    {
        _open = false;
        await OnApply.InvokeAsync(item.Values);
        if (AutoSearchOnApply)
            await OnSearch.InvokeAsync();
    }

    // ── 삭제 / 최근 조건 초기화 ───────────────────────────────────────────────

    private void RequestDelete(ConditionItemDto item)
    {
        _confirmMessage = $"저장된 조건 '{item.Name}'을(를) 삭제하시겠습니까?";
        _confirmAction = async () =>
        {
            var ok = await Api.DeleteConditionAsync(_menuId, item.Name);
            await ReloadAsync();   // 삭제 후 목록 즉시 갱신 (설계 20.8)
            if (!ok)
                ShowAlert($"'{item.Name}' 삭제에 실패했습니다.");
        };
    }

    private void RequestClearLatest()
    {
        _open = false;
        _confirmMessage = "최근 조회 조건을 초기화하시겠습니까?";
        _confirmAction = async () =>
        {
            // 서버 삭제가 성공했을 때만 로컬 latest를 비운다
            if (await Api.ClearLatestConditionAsync(_menuId))
                _latest = null;
            else
                ShowAlert("최근 조건 초기화에 실패했습니다.");
        };
    }

    private async Task ConfirmAsync()
    {
        var action = _confirmAction;
        _confirmMessage = null;
        _confirmAction = null;
        if (action is not null)
        {
            try { await action(); }
            catch
            {
                ShowAlert("요청 처리 중 오류가 발생했습니다.");
            }
        }
    }

    // 확인 팝업을 액션 없는 알림으로 재사용한다 (확인/취소 모두 닫기만 수행)
    private void ShowAlert(string message)
    {
        _confirmMessage = message;
        _confirmAction = null;
    }

    private void CancelConfirm()
    {
        _confirmMessage = null;
        _confirmAction = null;
    }

    // ── URI 헬퍼 ──────────────────────────────────────────────────────────────

    private string CurrentPath()
    {
        var rel = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var qIdx = rel.IndexOf('?');
        var path = qIdx < 0 ? rel : rel[..qIdx];
        // '/fdc/monitor/'와 '/fdc/monitor'가 다른 저장 버킷으로 갈라지지 않도록 후행 슬래시 제거 (루트는 유지)
        path = path.TrimEnd('/');
        return path.Length == 0 ? "/" : path;
    }

    private HashSet<string> CurrentQueryKeys()
    {
        var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return keys;

        foreach (var key in Microsoft.AspNetCore.WebUtilities.QueryHelpers
                     .ParseQuery(uri.Query.TrimStart('?')).Keys)
        {
            keys.Add(key.ToLowerInvariant());
        }
        return keys;
    }
}
