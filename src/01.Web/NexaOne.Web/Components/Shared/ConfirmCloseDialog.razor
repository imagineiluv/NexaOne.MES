@if (Visible)
{
    <div class="confirm-close-backdrop">
        <div class="confirm-close-dialog">
            <div class="confirm-close-title">저장되지 않은 변경 사항</div>
            <div class="confirm-close-body">변경된 내용이 있습니다. 어떻게 하시겠습니까?</div>
            @if (!string.IsNullOrEmpty(ErrorText))
            {
                <div class="confirm-close-error">@ErrorText</div>
            }
            <div class="confirm-close-actions">
                <DxButton Text="저장 후 닫기"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Click="@(() => HandleAction(CloseAction.SaveAndClose))" />
                <DxButton Text="저장하지 않고 닫기"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Click="@(() => HandleAction(CloseAction.DiscardAndClose))" />
                <DxButton Text="취소"
                          RenderStyle="ButtonRenderStyle.Light"
                          Click="@(() => HandleAction(CloseAction.Cancel))" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public EventCallback<CloseAction> OnAction { get; set; }

    private async Task HandleAction(CloseAction action)
        => await OnAction.InvokeAsync(action);
}
