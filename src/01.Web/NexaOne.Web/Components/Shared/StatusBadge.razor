<span class="status-badge @CssClass">@Value</span>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    private string CssClass => Value?.ToLowerInvariant() switch
    {
        "active" or "completed" or "shipped" or "released"  => "status-active",
        "inactive" or "cancelled" or "rejected"             => "status-inactive",
        "draft"                                              => "status-draft",
        "issued" or "pending" or "waitapproval"             => "status-pending",
        _ => "status-draft"
    };
}
