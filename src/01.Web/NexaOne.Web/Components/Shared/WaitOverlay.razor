@inject WaitOverlayService WaitService
@implements IDisposable

@if (WaitService.IsVisible)
{
    <div class="wait-overlay">
        <div class="wait-overlay-box">
            <div class="wait-spinner"></div>
            <div class="wait-message">@WaitService.Message</div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
        => WaitService.StateChanged += OnServiceStateChanged;

    private void OnServiceStateChanged()
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => WaitService.StateChanged -= OnServiceStateChanged;
}
