@* NexaUI — DxCheckBox 대체. bool 양방향 바인딩(@bind-Value). 라벨은 선택. *@
<label class="@WrapperClass">
    <input type="checkbox"
           class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
           checked="@Value"
           disabled="@Disabled"
           @onchange="OnChanged"
           @attributes="Extra" />
    @if (ChildContent is not null)
    {
        <span class="text-sm text-gray-700">@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span class="text-sm text-gray-700">@Label</span>
    }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string WrapperClass => string.Join(' ', new[] { "inline-flex items-center gap-2 cursor-pointer", Class }
        .Where(c => !string.IsNullOrWhiteSpace(c)));

    private async Task OnChanged(ChangeEventArgs e)
    {
        Value = e.Value is bool b && b;
        await ValueChanged.InvokeAsync(Value);
    }
}
