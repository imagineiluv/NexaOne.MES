@* NexaUI — DxDateEdit 대체. DateTime? 양방향 바인딩(@bind-Value). HTML date 입력(ISO yyyy-MM-dd). *@
<input type="date"
       class="@CssClass"
       value="@(Value?.ToString("yyyy-MM-dd"))"
       readonly="@ReadOnly"
       disabled="@Disabled"
       @onchange="OnChanged"
       @attributes="Extra" />

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "nexa-input" : $"nexa-input {Class}";

    private async Task OnChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Value = DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                                  System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;
        await ValueChanged.InvokeAsync(Value);
    }
}
