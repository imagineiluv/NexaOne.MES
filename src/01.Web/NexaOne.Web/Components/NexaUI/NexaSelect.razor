@* NexaUI — DxComboBox 대체(경량). 제네릭 TValue 양방향 바인딩(@bind-Value).
   <option>은 ChildContent로 제공한다. 문자열↔TValue는 BindConverter로 변환. *@
@typeparam TValue
@using Microsoft.AspNetCore.Components

<select class="@CssClass"
        value="@FormatValue(Value)"
        disabled="@Disabled"
        @onchange="OnChanged"
        @attributes="Extra">
    @ChildContent
</select>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "nexa-input" : $"nexa-input {Class}";

    private static string? FormatValue(TValue? value)
        => value is IFormattable f ? f.ToString(null, System.Globalization.CultureInfo.InvariantCulture) : value?.ToString();

    private async Task OnChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw))
        {
            Value = default;
        }
        else if (BindConverter.TryConvertTo<TValue>(raw, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            Value = parsed;
        }
        else
        {
            return;
        }
        await ValueChanged.InvokeAsync(Value);
    }
}
