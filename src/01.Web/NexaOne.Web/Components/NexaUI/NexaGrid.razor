@* NexaUI — DxGrid 대체. Microsoft QuickGrid(무료·공식) 래퍼.
   컬럼은 ChildContent(PropertyColumn/TemplateColumn 등)로 제공한다.
   Tailwind 스타일은 Class로 주입(기본 테두리/스트라이프). QuickGrid는 IQueryable을 요구한다. *@
@typeparam TItem
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="overflow-x-auto">
    <QuickGrid TGridItem="TItem"
               Items="@Items"
               Class="@GridClass"
               Pagination="@Pagination"
               @attributes="Extra">
        @ChildContent
    </QuickGrid>
</div>

@code {
    [Parameter, EditorRequired] public IQueryable<TItem> Items { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public PaginationState? Pagination { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Extra { get; set; }

    private string GridClass => string.Join(' ', new[] { "nexa-grid w-full text-sm", Class }
        .Where(c => !string.IsNullOrWhiteSpace(c)));
}
