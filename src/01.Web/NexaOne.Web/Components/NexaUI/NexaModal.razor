@* NexaUI — DxPopup 대체. Visible 양방향 바인딩(@bind-Visible). Title/ChildContent/Footer 슬롯.
   CloseOnOverlayClick(기본 false) — DxPopup 기본동작(바깥 클릭으로 닫히지 않음)과 동일.
   바깥 클릭 닫기를 원하면 CloseOnOverlayClick="true".
   접근성(WCAG 2.1.2/4.1.2): 패널에 role="dialog"·aria-modal="true"·aria-labelledby(제목 연결),
   표시 시 패널 초기 포커스, ESC 닫기(닫기가 허용된 모달 한정 — ShowCloseButton=true). *@
@if (Visible)
{
    <div class="nexa-modal-overlay" @onclick="OnOverlayClick">
        @* 패널 내부 클릭은 오버레이로 전파되지 않도록 차단. tabindex=-1 + @ref로 표시 시 초기 포커스를 받아
           키보드(ESC) 이벤트를 패널에서 처리한다. *@
        <div class="nexa-modal-panel" role="dialog" aria-modal="true"
             aria-labelledby="@(string.IsNullOrEmpty(Title) ? null : _titleId)"
             aria-label="@(string.IsNullOrEmpty(Title) ? AriaLabel : null)"
             tabindex="-1" @ref="_panel"
             @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            @if (!string.IsNullOrEmpty(Title) || ShowCloseButton)
            {
                <div class="flex items-center justify-between mb-3 border-b pb-2">
                    <h3 id="@_titleId" class="text-base font-semibold text-gray-800">@Title</h3>
                    @if (ShowCloseButton)
                    {
                        <button type="button" class="text-gray-400 hover:text-gray-600 text-lg leading-none"
                                @onclick="Close" aria-label="닫기">&times;</button>
                    }
                </div>
            }
            <div class="text-sm text-gray-700">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <div class="mt-4 flex justify-end gap-2 border-t pt-3">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    /// <summary>제목(Title)이 없을 때 dialog의 접근성 이름으로 쓰는 라벨(선택).</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public bool CloseOnOverlayClick { get; set; } = false;

    // 제목과 aria-labelledby를 잇는 컴포넌트 인스턴스별 고유 id.
    private readonly string _titleId = "nexa-modal-title-" + Guid.NewGuid().ToString("N");
    private ElementReference _panel;
    private bool _wasVisible;

    // 표시로 전환된 첫 렌더에서 패널에 초기 포커스를 준다(키보드 사용자 진입점 + ESC 수신).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            try { await _panel.FocusAsync(); } catch { /* 포커스 불가(렌더 타이밍 등)는 무시 */ }
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    // ESC: 닫기가 허용된 모달(ShowCloseButton)에서만 닫는다. 강제 선택 모달(ShowCloseButton=false)은 ESC로 닫히지 않는다.
    private Task OnKeyDown(KeyboardEventArgs e) =>
        e.Key == "Escape" && ShowCloseButton ? Close() : Task.CompletedTask;

    private Task OnOverlayClick() => CloseOnOverlayClick ? Close() : Task.CompletedTask;

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
