<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexaOne.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 단위 테스트에서 internal 접근 허용 (JwtAuthStateProvider.ParseToken은 RCL로 이관됨) -->
    <InternalsVisibleTo Include="NexaOne.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 4 — /meta 의존 폐포(컴포넌트·메타·인증·ApiClient)를 보유한 RCL. 네임스페이스 보존 이동이라
         기존 27개 화면/Program.cs/_Imports는 무수정으로 이 어셈블리에서 타입을 해석한다. -->
    <ProjectReference Include="..\NexaOne.Web.Components\NexaOne.Web.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DevExpress.Blazor 제거 완료(평가판 라이선스 DX1000/DX1001) → Tailwind+QuickGrid+NexaUI로 전면 교체 -->
    <!-- DxGrid 대체 무료 공식 그리드(QuickGrid). NexaUI/Tailwind로 스타일링 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.*" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.*" />

    <!-- §17.4 — OpenTelemetry 분산 추적. API와 동일 구성으로, Web↔API HttpClient 호출을
         같은 트레이스로 상관(correlate)시킨다(OTLP 미설정 시 개발용 Console exporter). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.*" />
  </ItemGroup>

</Project>
