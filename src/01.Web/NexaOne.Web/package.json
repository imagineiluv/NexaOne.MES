{
  "name": "nexaone-web-styles",
  "private": true,
  "description": "NexaOne.Web Tailwind CSS 빌드(DevExpress 교체). 컴포넌트는 .razor(C#), 이 npm은 CSS 생성 전용.",
  "scripts": {
    "css:build": "tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/css/app.tailwind.css --minify",
    "css:watch": "tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/css/app.tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10"
  }
}
