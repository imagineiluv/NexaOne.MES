@page "/qms/inspection-specs"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">검사 기준</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">기준 등록</NexaButton>
</div>

<NexaConditionGrid TRow="InspectionSpecDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_processId" Placeholder="공정 ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((InspectionSpecDto r) => r.Id)"           Title="기준 ID" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.SpecName)"     Title="기준명" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.ProcessId)"    Title="공정" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.ItemName)"     Title="검사 항목" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.MeasureType)"  Title="측정 유형" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.NominalValue)" Title="기준값" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.TolerancePlus)" Title="공차(+)" />
        <PropertyColumn Property="@((InspectionSpecDto r) => r.ToleranceMinus)" Title="공차(-)" />
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="검사 기준 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.SpecId"    Placeholder="기준 ID *" />
            <NexaTextBox @bind-Value="_form.SpecName"  Placeholder="기준명 *" />
            <NexaTextBox @bind-Value="_form.ProcessId" Placeholder="공정 ID *" />
            <NexaTextBox @bind-Value="_form.ItemName"  Placeholder="검사 항목 *" />
            <NexaSelect TValue="string" @bind-Value="_form.MeasureType"><option value="">측정 유형 *</option>@foreach (var x in _measureTypes) { <option value="@x">@x</option> }</NexaSelect>
            <NexaNumberInput @bind-Value="_form.NominalValue"   Placeholder="기준값 (Numeric용)" />
            <NexaNumberInput @bind-Value="_form.TolerancePlus"  Placeholder="공차(+) (Numeric용)" />
            <NexaNumberInput @bind-Value="_form.ToleranceMinus" Placeholder="공차(-) (Numeric용)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<InspectionSpecDto> _items = new();
    private string _processId = string.Empty;
    private bool _showCreate;
    private SpecForm _form = new();

    private static readonly List<string> _measureTypes = new() { "Numeric", "Attribute" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
        => _items = await Api.GetInspectionSpecsAsync(string.IsNullOrEmpty(_processId) ? null : _processId);

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task Create()
    {
        await Api.CreateInspectionSpecAsync(new
        {
            SpecId = _form.SpecId, SpecName = _form.SpecName, ProcessId = _form.ProcessId,
            ItemName = _form.ItemName, MeasureType = _form.MeasureType,
            NominalValue = _form.NominalValue, TolerancePlus = _form.TolerancePlus, ToleranceMinus = _form.ToleranceMinus
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class SpecForm
    {
        public string   SpecId         { get; set; } = string.Empty;
        public string   SpecName       { get; set; } = string.Empty;
        public string   ProcessId      { get; set; } = string.Empty;
        public string   ItemName       { get; set; } = string.Empty;
        public string   MeasureType    { get; set; } = string.Empty;
        public decimal? NominalValue   { get; set; }
        public decimal? TolerancePlus  { get; set; }
        public decimal? ToleranceMinus { get; set; }
    }
}
