@page "/qms/inspection-specs"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">검사 기준</h1>
    <DxButton Text="기준 등록" RenderStyle="ButtonRenderStyle.Primary" Click="OpenCreateDialog" />
</div>

<NexaConditionGrid TRow="InspectionSpecDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_processId" NullText="공정 ID" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"           Caption="기준 ID"    Width="130px" />
        <DxGridDataColumn FieldName="SpecName"     Caption="기준명"      Width="180px" />
        <DxGridDataColumn FieldName="ProcessId"    Caption="공정"        Width="120px" />
        <DxGridDataColumn FieldName="ItemName"     Caption="검사 항목"   Width="140px" />
        <DxGridDataColumn FieldName="MeasureType"  Caption="측정 유형"   Width="100px" />
        <DxGridDataColumn FieldName="NominalValue" Caption="기준값"      Width="90px" />
        <DxGridDataColumn FieldName="TolerancePlus" Caption="공차(+)"   Width="80px" />
        <DxGridDataColumn FieldName="ToleranceMinus" Caption="공차(-)"  Width="80px" />
    </Columns>
</NexaConditionGrid>

@if (_showCreate)
{
    <DxPopup @bind-Visible="_showCreate" HeaderText="검사 기준 등록" Width="480px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.SpecId"    NullText="기준 ID *" />
                <DxTextBox @bind-Text="_form.SpecName"  NullText="기준명 *" />
                <DxTextBox @bind-Text="_form.ProcessId" NullText="공정 ID *" />
                <DxTextBox @bind-Text="_form.ItemName"  NullText="검사 항목 *" />
                <DxComboBox Data="_measureTypes" @bind-Value="_form.MeasureType" NullText="측정 유형 *" />
                <DxSpinEdit @bind-Value="_form.NominalValue"   NullText="기준값 (Numeric용)" />
                <DxSpinEdit @bind-Value="_form.TolerancePlus"  NullText="공차(+) (Numeric용)" />
                <DxSpinEdit @bind-Value="_form.ToleranceMinus" NullText="공차(-) (Numeric용)" />
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" Click="Create" />
            <DxButton Text="취소" Click="@(() => _showCreate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<InspectionSpecDto> _items = new();
    private string _processId = string.Empty;
    private bool _showCreate;
    private SpecForm _form = new();

    private static readonly List<string> _measureTypes = new() { "Numeric", "Attribute" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
        => _items = await Api.GetInspectionSpecsAsync(string.IsNullOrEmpty(_processId) ? null : _processId);

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task Create()
    {
        await Api.CreateInspectionSpecAsync(new
        {
            SpecId = _form.SpecId, SpecName = _form.SpecName, ProcessId = _form.ProcessId,
            ItemName = _form.ItemName, MeasureType = _form.MeasureType,
            NominalValue = _form.NominalValue, TolerancePlus = _form.TolerancePlus, ToleranceMinus = _form.ToleranceMinus
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class SpecForm
    {
        public string   SpecId         { get; set; } = string.Empty;
        public string   SpecName       { get; set; } = string.Empty;
        public string   ProcessId      { get; set; } = string.Empty;
        public string   ItemName       { get; set; } = string.Empty;
        public string   MeasureType    { get; set; } = string.Empty;
        public decimal? NominalValue   { get; set; }
        public decimal? TolerancePlus  { get; set; }
        public decimal? ToleranceMinus { get; set; }
    }
}
