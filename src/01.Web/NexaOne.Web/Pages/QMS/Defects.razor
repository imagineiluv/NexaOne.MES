@page "/qms/defects"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">불량 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">불량 보고</NexaButton>
</div>

<NexaConditionGrid TRow="DefectDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_lotId" Placeholder="Lot ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((DefectDto r) => r.Id)"            Title="불량 ID" />
        <PropertyColumn Property="@((DefectDto r) => r.LotId)"         Title="Lot" />
        <PropertyColumn Property="@((DefectDto r) => r.EquipmentId)"   Title="설비" />
        <PropertyColumn Property="@((DefectDto r) => r.DefectClassId)" Title="불량 유형" />
        <PropertyColumn Property="@((DefectDto r) => r.DefectCount)"   Title="불량수" />
        <PropertyColumn Property="@((DefectDto r) => r.DefectRate)"    Title="불량률(%)"   Format="F2" />
        <PropertyColumn Property="@((DefectDto r) => r.InspectedAt)"   Title="검사일시"    Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((DefectDto r) => r.InspectorId)"   Title="검사자" />
        <TemplateColumn TGridItem="DefectDto" Title="확정">
            <StatusBadge Value="@(context.IsConfirmed ? "Completed" : "Pending")" />
        </TemplateColumn>
        <TemplateColumn TGridItem="DefectDto" Title="">
            @{
                if (!context.IsConfirmed)
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                                OnClick="@(() => ConfirmDefect(context.Id))">확정</NexaButton>
                }
            }
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="불량 보고">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.DefectId"     Placeholder="불량 ID *" />
            <NexaTextBox @bind-Value="_form.LotId"        Placeholder="Lot ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentId"  Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.DefectClassId" Placeholder="불량 유형 ID *" />
            <NexaNumberInput @bind-Value="_form.Count"      Min="0" Placeholder="불량 수량 *" />
            <NexaNumberInput @bind-Value="_form.Rate"       Min="0" Max="100" Placeholder="불량률(%)" />
            <NexaTextBox @bind-Value="_form.InspectorId"  Placeholder="검사자 ID *" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateDefect">보고</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<DefectDto> _items = new();
    private string _lotId = string.Empty;
    private string _currentUserId = string.Empty;
    private bool _showCreate;
    private DefectForm _form = new();
    private string? _createError;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData() => _items = await Api.GetDefectsAsync(_lotId);

    private void OpenCreateDialog()
    {
        _form = new() { InspectorId = _currentUserId };
        _createError = null;
        _showCreate = true;
    }

    private async Task CreateDefect()
    {
        _createError = null;
        var result = await Api.RecordDefectAsync(new
        {
            DefectId     = _form.DefectId,
            LotId        = _form.LotId,
            EquipmentId  = _form.EquipmentId,
            DefectClassId = _form.DefectClassId,
            Count        = _form.Count,
            Rate         = _form.Rate,
            InspectorId  = _form.InspectorId
        });
        if (result is null) { _createError = "보고에 실패했습니다."; return; }
        _showCreate = false;
        await LoadData();
    }

    private async Task ConfirmDefect(string defectId)
    {
        await Api.ConfirmDefectAsync(defectId, _currentUserId);
        await LoadData();
    }

    private sealed class DefectForm
    {
        public string  DefectId     { get; set; } = string.Empty;
        public string  LotId        { get; set; } = string.Empty;
        public string  EquipmentId  { get; set; } = string.Empty;
        public string  DefectClassId { get; set; } = string.Empty;
        public int     Count        { get; set; }
        public decimal Rate         { get; set; }
        public string  InspectorId  { get; set; } = string.Empty;
    }
}
