@page "/qms/spc-params"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">SPC 파라미터</h1>
    <DxButton Text="파라미터 등록" RenderStyle="ButtonRenderStyle.Primary" Click="OpenCreateDialog" />
</div>

<NexaConditionGrid TRow="SpcParamDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_equipmentId" NullText="설비 ID *" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"          Caption="파라미터 ID" Width="140px" />
        <DxGridDataColumn FieldName="ParamName"   Caption="파라미터명"   Width="160px" />
        <DxGridDataColumn FieldName="EquipmentId" Caption="설비"         Width="110px" />
        <DxGridDataColumn FieldName="ProcessId"   Caption="공정"         Width="110px" />
        <DxGridDataColumn FieldName="Mean"        Caption="평균(μ)"      Width="90px" />
        <DxGridDataColumn FieldName="Ucl"         Caption="UCL"          Width="90px" />
        <DxGridDataColumn FieldName="Lcl"         Caption="LCL"          Width="90px" />
        <DxGridDataColumn FieldName="Usl"         Caption="USL"          Width="90px" />
        <DxGridDataColumn FieldName="Lsl"         Caption="LSL"          Width="90px" />
        <DxGridDataColumn FieldName="SampleSize"  Caption="샘플 수"      Width="80px" />
        <DxGridCommandColumn Width="120px">
            <CellDisplayTemplate>
                @{
                    var p = (SpcParamDto)context.DataItem;
                    <DxButton Text="한계 수정" Click="@(() => OpenUpdateDialog(p))" />
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
    </Columns>
</NexaConditionGrid>

@if (_showCreate)
{
    <DxPopup @bind-Visible="_showCreate" HeaderText="SPC 파라미터 등록" Width="480px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.ParamId"    NullText="파라미터 ID *" />
                <DxTextBox @bind-Text="_form.ParamName"  NullText="파라미터명 *" />
                <DxTextBox @bind-Text="_form.EquipmentId" NullText="설비 ID *" />
                <DxTextBox @bind-Text="_form.ProcessId"  NullText="공정 ID *" />
                <DxSpinEdit @bind-Value="_form.Mean" Step="0.01m" NullText="평균(μ) *" />
                <DxSpinEdit @bind-Value="_form.Ucl"  Step="0.01m" NullText="UCL *" />
                <DxSpinEdit @bind-Value="_form.Lcl"  Step="0.01m" NullText="LCL *" />
                <DxSpinEdit @bind-Value="_form.Usl"  Step="0.01m" NullText="USL (선택)" />
                <DxSpinEdit @bind-Value="_form.Lsl"  Step="0.01m" NullText="LSL (선택)" />
                <DxSpinEdit @bind-Value="_form.SampleSize" MinValue="1" Step="1m" NullText="샘플 수 *" />
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" Click="Create" />
            <DxButton Text="취소" Click="@(() => _showCreate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@if (_showUpdate)
{
    <DxPopup @bind-Visible="_showUpdate" HeaderText="@($"관리 한계 수정 — {_updateParamName}")" Width="360px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxSpinEdit @bind-Value="_updateMean" Step="0.01m" NullText="평균(μ) *" />
                <DxSpinEdit @bind-Value="_updateUcl"  Step="0.01m" NullText="UCL *" />
                <DxSpinEdit @bind-Value="_updateLcl"  Step="0.01m" NullText="LCL *" />
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="수정" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmUpdate" />
            <DxButton Text="취소" Click="@(() => _showUpdate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<SpcParamDto> _items = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private ParamForm _form = new();
    private bool _showUpdate;
    private string _updateParamId = string.Empty;
    private string _updateParamName = string.Empty;
    private decimal _updateMean;
    private decimal _updateUcl;
    private decimal _updateLcl;

    protected override async Task OnInitializedAsync() { }

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_equipmentId))
            _items = await Api.GetSpcParamsAsync(_equipmentId);
    }

    private void OpenCreateDialog() { _form = new() { EquipmentId = _equipmentId }; _showCreate = true; }

    private async Task Create()
    {
        await Api.CreateSpcParamAsync(new
        {
            ParamId = _form.ParamId, ParamName = _form.ParamName, EquipmentId = _form.EquipmentId,
            ProcessId = _form.ProcessId, Mean = _form.Mean, Ucl = _form.Ucl, Lcl = _form.Lcl,
            SampleSize = (int)_form.SampleSize, Usl = _form.Usl, Lsl = _form.Lsl
        });
        _showCreate = false;
        await LoadData();
    }

    private void OpenUpdateDialog(SpcParamDto p)
    {
        _updateParamId = p.Id;
        _updateParamName = p.ParamName;
        _updateMean = p.Mean;
        _updateUcl = p.Ucl;
        _updateLcl = p.Lcl;
        _showUpdate = true;
    }

    private async Task ConfirmUpdate()
    {
        await Api.UpdateSpcLimitsAsync(_updateParamId, _updateMean, _updateUcl, _updateLcl);
        _showUpdate = false;
        await LoadData();
    }

    private sealed class ParamForm
    {
        public string   ParamId     { get; set; } = string.Empty;
        public string   ParamName   { get; set; } = string.Empty;
        public string   EquipmentId { get; set; } = string.Empty;
        public string   ProcessId   { get; set; } = string.Empty;
        public decimal  Mean        { get; set; }
        public decimal  Ucl         { get; set; }
        public decimal  Lcl         { get; set; }
        public decimal? Usl         { get; set; }
        public decimal? Lsl         { get; set; }
        public decimal  SampleSize  { get; set; } = 1;
    }
}
