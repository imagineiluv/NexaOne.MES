@page "/qms/spc-params"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">SPC 파라미터</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">파라미터 등록</NexaButton>
</div>

<NexaConditionGrid TRow="SpcParamDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID *" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((SpcParamDto r) => r.Id)"          Title="파라미터 ID" />
        <PropertyColumn Property="@((SpcParamDto r) => r.ParamName)"   Title="파라미터명" />
        <PropertyColumn Property="@((SpcParamDto r) => r.EquipmentId)" Title="설비" />
        <PropertyColumn Property="@((SpcParamDto r) => r.ProcessId)"   Title="공정" />
        <PropertyColumn Property="@((SpcParamDto r) => r.Mean)"        Title="평균(μ)" />
        <PropertyColumn Property="@((SpcParamDto r) => r.Ucl)"         Title="UCL" />
        <PropertyColumn Property="@((SpcParamDto r) => r.Lcl)"         Title="LCL" />
        <PropertyColumn Property="@((SpcParamDto r) => r.Usl)"         Title="USL" />
        <PropertyColumn Property="@((SpcParamDto r) => r.Lsl)"         Title="LSL" />
        <PropertyColumn Property="@((SpcParamDto r) => r.SampleSize)"  Title="샘플 수" />
        <TemplateColumn TGridItem="SpcParamDto" Title="">
            <NexaButton OnClick="@(() => OpenUpdateDialog(context))">한계 수정</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="SPC 파라미터 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.ParamId"    Placeholder="파라미터 ID *" />
            <NexaTextBox @bind-Value="_form.ParamName"  Placeholder="파라미터명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentId" Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.ProcessId"  Placeholder="공정 ID *" />
            <NexaNumberInput @bind-Value="_form.Mean" Step="0.01m" Placeholder="평균(μ) *" />
            <NexaNumberInput @bind-Value="_form.Ucl"  Step="0.01m" Placeholder="UCL *" />
            <NexaNumberInput @bind-Value="_form.Lcl"  Step="0.01m" Placeholder="LCL *" />
            <NexaNumberInput @bind-Value="_form.Usl"  Step="0.01m" Placeholder="USL (선택)" />
            <NexaNumberInput @bind-Value="_form.Lsl"  Step="0.01m" Placeholder="LSL (선택)" />
            <NexaNumberInput @bind-Value="_form.SampleSize" min="1" Step="1m" Placeholder="샘플 수 *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showUpdate" Title="@($"관리 한계 수정 — {_updateParamName}")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaNumberInput @bind-Value="_updateMean" Step="0.01m" Placeholder="평균(μ) *" />
            <NexaNumberInput @bind-Value="_updateUcl"  Step="0.01m" Placeholder="UCL *" />
            <NexaNumberInput @bind-Value="_updateLcl"  Step="0.01m" Placeholder="LCL *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmUpdate">수정</NexaButton>
        <NexaButton OnClick="@(() => _showUpdate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<SpcParamDto> _items = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private ParamForm _form = new();
    private bool _showUpdate;
    private string _updateParamId = string.Empty;
    private string _updateParamName = string.Empty;
    private decimal _updateMean;
    private decimal _updateUcl;
    private decimal _updateLcl;

    protected override async Task OnInitializedAsync() { }

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_equipmentId))
            _items = await Api.GetSpcParamsAsync(_equipmentId);
    }

    private void OpenCreateDialog() { _form = new() { EquipmentId = _equipmentId }; _showCreate = true; }

    private async Task Create()
    {
        await Api.CreateSpcParamAsync(new
        {
            ParamId = _form.ParamId, ParamName = _form.ParamName, EquipmentId = _form.EquipmentId,
            ProcessId = _form.ProcessId, Mean = _form.Mean, Ucl = _form.Ucl, Lcl = _form.Lcl,
            SampleSize = (int)_form.SampleSize, Usl = _form.Usl, Lsl = _form.Lsl
        });
        _showCreate = false;
        await LoadData();
    }

    private void OpenUpdateDialog(SpcParamDto p)
    {
        _updateParamId = p.Id;
        _updateParamName = p.ParamName;
        _updateMean = p.Mean;
        _updateUcl = p.Ucl;
        _updateLcl = p.Lcl;
        _showUpdate = true;
    }

    private async Task ConfirmUpdate()
    {
        await Api.UpdateSpcLimitsAsync(_updateParamId, _updateMean, _updateUcl, _updateLcl);
        _showUpdate = false;
        await LoadData();
    }

    private sealed class ParamForm
    {
        public string   ParamId     { get; set; } = string.Empty;
        public string   ParamName   { get; set; } = string.Empty;
        public string   EquipmentId { get; set; } = string.Empty;
        public string   ProcessId   { get; set; } = string.Empty;
        public decimal  Mean        { get; set; }
        public decimal  Ucl         { get; set; }
        public decimal  Lcl         { get; set; }
        public decimal? Usl         { get; set; }
        public decimal? Lsl         { get; set; }
        public decimal  SampleSize  { get; set; } = 1;
    }
}
