@page "/qms/inspection-results"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">검사 결과</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">결과 기록</NexaButton>
</div>

<NexaConditionGrid TRow="InspectionResultDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_lotId" Placeholder="Lot ID *" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((InspectionResultDto r) => r.Id)" Title="결과 ID" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.SpecId)" Title="기준 ID" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.LotId)" Title="Lot ID" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.EquipmentId)" Title="설비" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.MeasuredValue)" Title="측정값" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.AttributeResult)" Title="판정" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.InspectedAt)" Title="검사일시" Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((InspectionResultDto r) => r.InspectorId)" Title="검사자" />
        <TemplateColumn TGridItem="InspectionResultDto" Title="합부">
            <StatusBadge Value="@(context.IsPass ? "Pass" : "Fail")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="검사 결과 기록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.ResultId"    Placeholder="결과 ID *" />
            <NexaTextBox @bind-Value="_form.SpecId"      Placeholder="기준 ID *" />
            <NexaTextBox @bind-Value="_form.LotId"       Placeholder="Lot ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentId" Placeholder="설비 ID *" />
            <NexaNumberInput @bind-Value="_form.MeasuredValue" Placeholder="측정값 (Numeric용)" />
            <NexaTextBox @bind-Value="_form.AttributeResult" Placeholder="판정 결과 (Attribute용, Pass/Fail)" />
            <NexaTextBox @bind-Value="_form.Remark"      Placeholder="비고" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">기록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<InspectionResultDto> _items = new();
    private string _lotId = string.Empty;
    private bool _showCreate;
    private ResultForm _form = new();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
        => _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_lotId))
            _items = await Api.GetInspectionResultsAsync(_lotId);
    }

    private void OpenCreateDialog()
    {
        _form = new() { LotId = _lotId, InspectorId = _currentUserId };
        _showCreate = true;
    }

    private async Task Create()
    {
        bool? isPass = string.IsNullOrEmpty(_form.AttributeResult) ? null
            : _form.AttributeResult.Equals("Pass", StringComparison.OrdinalIgnoreCase) ? true : false;

        await Api.RecordInspectionResultAsync(new
        {
            ResultId = _form.ResultId, SpecId = _form.SpecId, LotId = _form.LotId,
            EquipmentId = _form.EquipmentId, InspectorId = _form.InspectorId,
            MeasuredValue = _form.MeasuredValue, AttributeResult = _form.AttributeResult,
            IsPass = isPass, Remark = _form.Remark
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class ResultForm
    {
        public string   ResultId        { get; set; } = string.Empty;
        public string   SpecId          { get; set; } = string.Empty;
        public string   LotId           { get; set; } = string.Empty;
        public string   EquipmentId     { get; set; } = string.Empty;
        public string   InspectorId     { get; set; } = string.Empty;
        public decimal? MeasuredValue   { get; set; }
        public string   AttributeResult { get; set; } = string.Empty;
        public string?  Remark          { get; set; }
    }
}
