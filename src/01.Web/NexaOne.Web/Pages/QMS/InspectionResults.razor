@page "/qms/inspection-results"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">검사 결과</h1>
    <DxButton Text="결과 기록" RenderStyle="ButtonRenderStyle.Primary" Click="OpenCreateDialog" />
</div>

<NexaConditionGrid TRow="InspectionResultDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_lotId" NullText="Lot ID *" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"             Caption="결과 ID"    Width="130px" />
        <DxGridDataColumn FieldName="SpecId"         Caption="기준 ID"    Width="130px" />
        <DxGridDataColumn FieldName="LotId"          Caption="Lot ID"     Width="120px" />
        <DxGridDataColumn FieldName="EquipmentId"    Caption="설비"        Width="110px" />
        <DxGridDataColumn FieldName="MeasuredValue"  Caption="측정값"      Width="90px" />
        <DxGridDataColumn FieldName="AttributeResult" Caption="판정"       Width="80px" />
        <DxGridDataColumn FieldName="InspectedAt"    Caption="검사일시"    Width="160px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="InspectorId"    Caption="검사자"      Width="100px" />
        <DxGridDataColumn FieldName="IsPass"         Caption="합부"        Width="80px">
            <CellDisplayTemplate>
                <StatusBadge Value="@((bool)context.Value ? "Pass" : "Fail")" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</NexaConditionGrid>

@if (_showCreate)
{
    <DxPopup @bind-Visible="_showCreate" HeaderText="검사 결과 기록" Width="480px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.ResultId"    NullText="결과 ID *" />
                <DxTextBox @bind-Text="_form.SpecId"      NullText="기준 ID *" />
                <DxTextBox @bind-Text="_form.LotId"       NullText="Lot ID *" />
                <DxTextBox @bind-Text="_form.EquipmentId" NullText="설비 ID *" />
                <DxSpinEdit @bind-Value="_form.MeasuredValue" NullText="측정값 (Numeric용)" />
                <DxTextBox @bind-Text="_form.AttributeResult" NullText="판정 결과 (Attribute용, Pass/Fail)" />
                <DxTextBox @bind-Text="_form.Remark"      NullText="비고" />
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="기록" RenderStyle="ButtonRenderStyle.Primary" Click="Create" />
            <DxButton Text="취소" Click="@(() => _showCreate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<InspectionResultDto> _items = new();
    private string _lotId = string.Empty;
    private bool _showCreate;
    private ResultForm _form = new();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
        => _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_lotId))
            _items = await Api.GetInspectionResultsAsync(_lotId);
    }

    private void OpenCreateDialog()
    {
        _form = new() { LotId = _lotId, InspectorId = _currentUserId };
        _showCreate = true;
    }

    private async Task Create()
    {
        bool? isPass = string.IsNullOrEmpty(_form.AttributeResult) ? null
            : _form.AttributeResult.Equals("Pass", StringComparison.OrdinalIgnoreCase) ? true : false;

        await Api.RecordInspectionResultAsync(new
        {
            ResultId = _form.ResultId, SpecId = _form.SpecId, LotId = _form.LotId,
            EquipmentId = _form.EquipmentId, InspectorId = _form.InspectorId,
            MeasuredValue = _form.MeasuredValue, AttributeResult = _form.AttributeResult,
            IsPass = isPass, Remark = _form.Remark
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class ResultForm
    {
        public string   ResultId        { get; set; } = string.Empty;
        public string   SpecId          { get; set; } = string.Empty;
        public string   LotId           { get; set; } = string.Empty;
        public string   EquipmentId     { get; set; } = string.Empty;
        public string   InspectorId     { get; set; } = string.Empty;
        public decimal? MeasuredValue   { get; set; }
        public string   AttributeResult { get; set; } = string.Empty;
        public string?  Remark          { get; set; }
    }
}
