@page "/qms/defect-classes"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">불량 분류</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">분류 등록</NexaButton>
</div>

<NexaConditionGrid TRow="DefectClassDto" Items="_items">
    <Columns>
        <PropertyColumn Property="@((DefectClassDto r) => r.Id)" Title="분류 ID" />
        <PropertyColumn Property="@((DefectClassDto r) => r.DefectClassName)" Title="분류명" />
        <PropertyColumn Property="@((DefectClassDto r) => r.Description)" Title="설명" />
        <TemplateColumn TGridItem="DefectClassDto" Title="심각도">
            <StatusBadge Value="@context.Severity" />
        </TemplateColumn>
        <TemplateColumn TGridItem="DefectClassDto" Title="활성">
            @(context.IsActive ? "활성" : "비활성")
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="불량 분류 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.DefectClassId"   Placeholder="분류 ID *" />
            <NexaTextBox @bind-Value="_form.DefectClassName" Placeholder="분류명 *" />
            <NexaTextBox @bind-Value="_form.Description"     Placeholder="설명" />
            <NexaSelect TValue="string" @bind-Value="_form.Severity"><option value="">심각도 *</option>@foreach (var x in _severities) { <option value="@x">@x</option> }</NexaSelect>
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<DefectClassDto> _items = new();
    private bool _showCreate;
    private Form _form = new();

    private static readonly List<string> _severities = new() { "Critical", "Major", "Minor" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetDefectClassesAsync();

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task Create()
    {
        await Api.CreateDefectClassAsync(new
        {
            DefectClassId = _form.DefectClassId, DefectClassName = _form.DefectClassName,
            Description = _form.Description, Severity = _form.Severity
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class Form
    {
        public string DefectClassId   { get; set; } = string.Empty;
        public string DefectClassName { get; set; } = string.Empty;
        public string Description     { get; set; } = string.Empty;
        public string Severity        { get; set; } = string.Empty;
    }
}
