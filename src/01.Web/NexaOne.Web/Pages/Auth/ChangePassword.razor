@page "/auth/change-password"
@layout NexaOne.Web.Components.Layout.BlankLayout
@inject IApiClient Api
@inject AuthTokenService TokenService
@inject NavigationManager Nav

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">NexaOne</div>
        <div class="login-subtitle">비밀번호 변경</div>

        <p style="font-size:0.85rem; color:#6b7280; text-align:center; margin-bottom:1rem;">
            임시 비밀번호로 로그인하셨습니다. 새 비밀번호를 설정해 주세요.
        </p>

        <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div style="margin-bottom:1rem;">
                <label style="font-size:0.875rem; font-weight:500; color:#374151;">현재 비밀번호 (임시)</label>
                <DxTextBox @bind-Text="_model.CurrentPassword"
                           Password="true"
                           NullText="임시 비밀번호를 입력하세요"
                           CssClass="mt-1" />
            </div>

            <div style="margin-bottom:1rem;">
                <label style="font-size:0.875rem; font-weight:500; color:#374151;">새 비밀번호</label>
                <DxTextBox @bind-Text="_model.NewPassword"
                           Password="true"
                           NullText="새 비밀번호를 입력하세요"
                           CssClass="mt-1" />
            </div>

            <div style="margin-bottom:1.25rem;">
                <label style="font-size:0.875rem; font-weight:500; color:#374151;">새 비밀번호 확인</label>
                <DxTextBox @bind-Text="_model.ConfirmPassword"
                           Password="true"
                           NullText="새 비밀번호를 다시 입력하세요"
                           CssClass="mt-1" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="color:#dc2626; font-size:0.875rem; margin-bottom:1rem;">@_error</div>
            }

            <DxButton SubmitFormOnClick="true"
                      Text="비밀번호 변경"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="w-100"
                      Enabled="!_loading" />
        </EditForm>
    </div>
</div>

@code {
    private FormModel _model = new();
    private string? _error;
    private bool _loading;

    // §19.2.2 — 안내용 클라이언트 검증. 서버(PasswordPolicy)가 최종 검증한다.
    // Web은 NexaOne.Common을 참조하지 않으므로 정규식을 의도적으로 중복한다 (동기화 유지).
    private static readonly System.Text.RegularExpressions.Regex PolicyPattern =
        new(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*?_~\-\(\)]).{8,}$");

    private async Task HandleSubmit()
    {
        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _error = "새 비밀번호가 일치하지 않습니다.";
            return;
        }

        if (!PolicyPattern.IsMatch(_model.NewPassword))
        {
            _error = "비밀번호는 8자 이상이며 대문자, 소문자, 숫자, 특수문자(!@#$%^&*?_~-())를 각각 1자 이상 포함해야 합니다.";
            return;
        }

        _error = null;
        _loading = true;
        try
        {
            await Api.ChangePasswordAsync(_model.CurrentPassword, _model.NewPassword, _model.ConfirmPassword);
            Nav.NavigateTo("/mdm/equipment", forceLoad: true);
        }
        catch
        {
            _error = "비밀번호 변경에 실패했습니다. 현재 비밀번호와 비밀번호 정책을 확인해 주세요.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class FormModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword     { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
