@page "/auth/forgot-password"
@layout NexaOne.Web.Components.Layout.BlankLayout
@inject IApiClient Api
@inject NavigationManager Nav

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">NexaOne</div>
        <div class="login-subtitle">비밀번호 분실</div>

        @if (_sent)
        {
            <div style="text-align:center; color:#374151; font-size:0.9rem; margin-bottom:1.5rem;">
                등록된 이메일로 임시 비밀번호가 발송되었습니다.<br />
                이메일을 확인해 주세요.
            </div>
            <DxButton Text="로그인으로 돌아가기"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="w-100"
                      Click="@(() => Nav.NavigateTo("/auth/login"))" />
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div style="margin-bottom:1rem;">
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">사용자 ID</label>
                    <DxTextBox @bind-Text="_model.UserId"
                               NullText="사용자 ID를 입력하세요"
                               CssClass="mt-1" />
                </div>

                <div style="margin-bottom:1rem;">
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">등록된 이메일</label>
                    <DxTextBox @bind-Text="_model.Email"
                               NullText="이메일을 입력하세요"
                               CssClass="mt-1" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div style="color:#dc2626; font-size:0.875rem; margin-bottom:1rem;">@_error</div>
                }

                <DxButton SubmitFormOnClick="true"
                          Text="임시 비밀번호 발송"
                          RenderStyle="ButtonRenderStyle.Primary"
                          CssClass="w-100"
                          Enabled="!_loading" />

                <div style="text-align:center; margin-top:0.75rem;">
                    <a href="/auth/login" style="font-size:0.813rem; color:#6b7280;">로그인으로 돌아가기</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private FormModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _sent;

    private async Task HandleSubmit()
    {
        _error = null;
        _loading = true;
        try
        {
            await Api.ForgotPasswordAsync(_model.UserId, _model.Email);
            _sent = true;
        }
        catch
        {
            _error = "요청 처리 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class FormModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Email  { get; set; } = string.Empty;
    }
}
