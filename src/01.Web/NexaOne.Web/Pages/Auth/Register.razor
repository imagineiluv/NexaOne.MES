@page "/auth/register"
@layout NexaOne.Web.Components.Layout.BlankLayout
@inject IApiClient Api
@inject NavigationManager Nav

@* §19.3.2 — 사용자 등록 신청 (로그인 전 익명 화면). 약관 동의 시각/IP는 서버가 기록한다.
   Plant는 익명 상태라 마스터 조회가 불가해 텍스트 입력으로 적응 (Login의 plantId 입력과 동일 맥락) *@
<div class="login-wrapper">
    <div class="login-card" style="width:430px;">
        <div class="login-logo">NexaOne</div>
        <div class="login-subtitle">사용자 등록 신청</div>

        @if (_sent)
        {
            <div style="text-align:center; color:#374151; font-size:0.9rem; margin-bottom:1.5rem;">
                등록 신청이 접수되었습니다.<br />
                관리자 승인 후 입력하신 이메일로<br />
                임시 비밀번호가 발송됩니다.
            </div>
            <DxButton Text="로그인으로 돌아가기"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="w-100"
                      Click="@(() => Nav.NavigateTo("/auth/login"))" />
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div style="margin-bottom:0.75rem;">
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">사용자 ID *</label>
                    <div style="display:flex; gap:0.5rem;" class="mt-1">
                        <DxTextBox @bind-Text="_model.UserId"
                                   NullText="사용할 ID를 입력하세요"
                                   CssClass="flex-grow-1" />
                        <DxButton Text="중복확인" Click="CheckUserId" Enabled="!_loading" />
                    </div>
                    @if (_idMessage is not null)
                    {
                        <div style="font-size:0.8rem; margin-top:0.25rem; color:@(_idAvailable ? "#16a34a" : "#dc2626");">
                            @_idMessage
                        </div>
                    }
                </div>

                <div style="margin-bottom:0.75rem;">
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">이름 *</label>
                    <DxTextBox @bind-Text="_model.UserName" NullText="이름" CssClass="mt-1" />
                </div>

                <div style="margin-bottom:0.75rem;">
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">이메일 *</label>
                    <DxTextBox @bind-Text="_model.Email" NullText="승인 안내를 받을 이메일" CssClass="mt-1" />
                </div>

                <div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">부서 *</label>
                        <DxTextBox @bind-Text="_model.Department" NullText="부서" CssClass="mt-1" />
                    </div>
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">직급 *</label>
                        <DxTextBox @bind-Text="_model.Position" NullText="직급" CssClass="mt-1" />
                    </div>
                </div>

                <div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">직책</label>
                        <DxTextBox @bind-Text="_model.Duty" NullText="직책 (선택)" CssClass="mt-1" />
                    </div>
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">휴대폰</label>
                        <DxTextBox @bind-Text="_model.CellPhoneNumber" NullText="휴대폰 (선택)" CssClass="mt-1" />
                    </div>
                </div>

                <div style="display:flex; gap:0.5rem; margin-bottom:0.75rem;">
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">Plant *</label>
                        <DxTextBox @bind-Text="_model.PlantId" NullText="예: DEFAULT" CssClass="mt-1" />
                    </div>
                    <div style="flex:1;">
                        <label style="font-size:0.875rem; font-weight:500; color:#374151;">언어</label>
                        <DxComboBox Data="_languages" @bind-Value="_model.Language" CssClass="mt-1" />
                    </div>
                </div>

                @* §19.3.2 — 약관 동의 (필수). 동의 없이 신청 불가 *@
                <div style="border:1px solid #e5e7eb; border-radius:6px; padding:0.6rem;
                            font-size:0.78rem; color:#6b7280; max-height:90px; overflow-y:auto;
                            margin-bottom:0.5rem;">
                    <strong>개인정보 수집·이용 동의 (필수)</strong><br />
                    수집 항목: 이름, 이메일, 부서, 직급, 연락처(선택)<br />
                    이용 목적: MES 사용자 계정 등록 및 시스템 운영<br />
                    보유 기간: 계정 삭제 또는 동의 철회 시까지<br />
                    동의를 거부할 수 있으나, 거부 시 계정 등록이 불가합니다.
                </div>
                <div style="margin-bottom:1rem;">
                    <DxCheckBox @bind-Checked="_model.TermsAccepted">위 약관에 동의합니다 *</DxCheckBox>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div style="color:#dc2626; font-size:0.875rem; margin-bottom:1rem;">@_error</div>
                }

                <DxButton SubmitFormOnClick="true"
                          Text="등록 신청"
                          RenderStyle="ButtonRenderStyle.Primary"
                          CssClass="w-100"
                          Enabled="!_loading" />

                <div style="text-align:center; margin-top:0.75rem;">
                    <a href="/auth/login" style="font-size:0.813rem; color:#6b7280;">로그인으로 돌아가기</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    private FormModel _model = new();
    private string? _error;
    private bool _loading;
    private bool _sent;

    // §19.3.2 — [중복확인]을 통과한 ID만 신청 가능. ID를 바꾸면 재확인을 요구한다
    private string? _checkedUserId;
    private bool _idAvailable;
    private string? _idMessage;

    private static readonly List<string> _languages = new() { "KoKr", "EnUs", "ZhCn", "ViVn", "LoLo" };

    private async Task CheckUserId()
    {
        _idMessage = null;
        _idAvailable = false;
        var id = _model.UserId.Trim();
        if (string.IsNullOrEmpty(id))
        {
            _idMessage = "사용자 ID를 먼저 입력하세요.";
            return;
        }

        var available = await Api.CheckUserIdAvailableAsync(id);
        if (available is null)
        {
            _idMessage = "중복 확인에 실패했습니다. 잠시 후 다시 시도해 주세요.";
            return;
        }

        _idAvailable = available.Value;
        _checkedUserId = id;
        _idMessage = _idAvailable ? "사용 가능한 ID입니다." : "이미 사용 중인 ID입니다.";
    }

    private async Task HandleSubmit()
    {
        _error = null;

        if (!_idAvailable || _checkedUserId != _model.UserId.Trim())
        {
            _error = "아이디 중복 확인을 해주세요.";
            return;
        }
        if (!_model.TermsAccepted)
        {
            _error = "약관 동의는 필수입니다.";
            return;
        }

        _loading = true;
        try
        {
            var (request, error) = await Api.RegisterUserAsync(new
            {
                UserId = _model.UserId.Trim(),
                _model.UserName,
                _model.Email,
                _model.Department,
                _model.Position,
                _model.PlantId,
                DefaultLanguageType = _model.Language,
                _model.TermsAccepted,
                Duty = NullIfEmpty(_model.Duty),
                CellPhoneNumber = NullIfEmpty(_model.CellPhoneNumber)
            });

            if (error is not null)
            {
                _error = error;   // 서버 검증 메시지(한국어)를 그대로 표시
                return;
            }
            _sent = request is not null;
        }
        catch
        {
            _error = "신청 처리 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? NullIfEmpty(string value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class FormModel
    {
        public string UserId          { get; set; } = string.Empty;
        public string UserName        { get; set; } = string.Empty;
        public string Email           { get; set; } = string.Empty;
        public string Department      { get; set; } = string.Empty;
        public string Position        { get; set; } = string.Empty;
        public string Duty            { get; set; } = string.Empty;
        public string CellPhoneNumber { get; set; } = string.Empty;
        public string PlantId         { get; set; } = "DEFAULT";
        public string Language        { get; set; } = "KoKr";
        public bool   TermsAccepted   { get; set; }
    }
}
