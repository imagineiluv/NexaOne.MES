@page "/auth/login"
@layout NexaOne.Web.Components.Layout.BlankLayout
@inject IApiClient Api
@inject AuthTokenService TokenService
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">NexaOne</div>
        <div class="login-subtitle">Manufacturing Execution System</div>

        <EditForm Model="@_model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div style="margin-bottom:1rem;">
                <label style="font-size:0.875rem; font-weight:500; color:#374151;">사용자 ID</label>
                <DxTextBox @bind-Text="_model.UserId"
                           NullText="ID를 입력하세요"
                           CssClass="mt-1" />
            </div>

            <div style="margin-bottom:1rem;">
                <label style="font-size:0.875rem; font-weight:500; color:#374151;">비밀번호</label>
                <DxTextBox @bind-Text="_model.Password"
                           Password="true"
                           NullText="비밀번호를 입력하세요"
                           CssClass="mt-1" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div style="color:#dc2626; font-size:0.875rem; margin-bottom:1rem;">@_error</div>
            }

            <DxButton SubmitFormOnClick="true"
                      Text="로그인"
                      RenderStyle="ButtonRenderStyle.Primary"
                      CssClass="w-100"
                      Enabled="!_loading" />

            <div style="text-align:center; margin-top:0.75rem;">
                <a href="/auth/forgot-password" style="font-size:0.813rem; color:#6b7280;">비밀번호 분실</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginFormModel _model = new();
    private string? _error;
    private bool _loading;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;
        try
        {
            var result = await Api.LoginAsync(_model.UserId, _model.Password);
            if (result.Response is null)
            {
                // §20.10 — 계정 잠금은 서버가 보낸 안내(남은 시간 포함)를 그대로 노출하고,
                // 그 외에는 열거 방지를 위해 동일한 일반 메시지를 표시한다
                _error = result.ErrorCode == "ACCOUNT_LOCKED"
                    ? (result.ErrorMessage ?? "비밀번호 5회 연속 오류로 계정이 잠겼습니다. 잠시 후 다시 시도하거나 관리자에게 문의하세요.")
                    : "로그인에 실패했습니다.";
                return;
            }
            var response = result.Response;
            await TokenService.SaveAsync(response.AccessToken, response.RefreshToken, response.UserId);
            AuthState.NotifyAuthChanged(null); // trigger re-evaluation
            var destination = response.RequirePasswordChange
                ? "/auth/change-password"
                : (ReturnUrl ?? "/mdm/equipment");
            Nav.NavigateTo(destination, forceLoad: true);
        }
        catch
        {
            _error = "서버 연결에 실패했습니다.";
        }
        finally
        {
            _loading = false;
        }
    }

    private sealed class LoginFormModel
    {
        public string UserId   { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
