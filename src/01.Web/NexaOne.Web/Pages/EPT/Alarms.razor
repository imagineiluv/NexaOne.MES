@page "/ept/alarms"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext
@inject NexaHubService HubService
@implements IAsyncDisposable

<div class="page-header">
    <h1 class="page-title">알람 현황</h1>
</div>

<NexaConditionGrid TRow="AlarmDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_plantId" NullText="Plant ID" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"             Caption="알람 ID"    Width="120px" />
        <DxGridDataColumn FieldName="EquipmentId"    Caption="설비"        Width="120px" />
        <DxGridDataColumn FieldName="AlarmCode"      Caption="코드"        Width="100px" />
        <DxGridDataColumn FieldName="AlarmName"      Caption="알람명"      Width="200px" />
        <DxGridDataColumn FieldName="AlarmLevel"     Caption="레벨"        Width="80px">
            <CellDisplayTemplate>
                <StatusBadge Value="@((string)context.Value)" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="OccurredAt"     Caption="발생일시"    Width="160px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="ClearedAt"      Caption="해제일시"    Width="160px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="ElapsedSeconds" Caption="경과(초)"   Width="100px" />
        <DxGridCommandColumn Width="100px">
            <CellDisplayTemplate>
                @{
                    var alarm = (AlarmDto)context.DataItem;
                    if (alarm.ClearedAt is null)
                    {
                        <DxButton Text="해제" RenderStyle="ButtonRenderStyle.Warning"
                                  Click="@(() => ClearAlarm(alarm.Id))" />
                    }
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
    </Columns>
</NexaConditionGrid>

@code {
    private List<AlarmDto> _items = new();
    private string _plantId = string.Empty;

    private CoalescingTrigger? _refreshTrigger;
    private FallbackPoller? _fallbackPoller;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        // 트리거/폴러 생성과 허브 구독은 첫 await 이전(동기 구간)에 끝낸다 — 초기 조회 중
        // 페이지를 떠나면 DisposeAsync가 먼저 실행되어 이후 생성분이 해제되지 않기 때문 (§20.9)
        // §20.9: 알람 발생/해제 push는 즉시 반영하되, 대량 알람 동기화는 1초 단위로 병합한다
        _refreshTrigger = new CoalescingTrigger(RefreshAsync);
        // §20.9: 허브 연결이 끊긴 동안은 주기 조회 폴백으로 갱신한다
        _fallbackPoller = new FallbackPoller(HubService, RefreshAsync);
        HubService.OnAlarmUpdated += OnHubAlarmUpdated;

        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    // 조회 실패(null) 시 표시 중인 목록을 유지한다 — 폴백/병합 갱신이 그리드를 비우지 않도록 (§20.9)
    private async Task LoadData() => _items = await Api.GetAlarmsAsync(_plantId) ?? _items;

    private async Task ClearAlarm(string alarmId)
    {
        await Api.ClearAlarmAsync(alarmId);
        await LoadData();
    }

    // §20.9: 폼이 이미 dispose됐으면 수신 이벤트를 무시한다
    private void OnHubAlarmUpdated()
    {
        if (_disposed) return;
        _refreshTrigger?.Signal();
    }

    // 타이머/허브 스레드에서 호출될 수 있으므로 InvokeAsync로 UI 스레드 전환 (§20.9)
    private Task RefreshAsync() => InvokeAsync(async () =>
    {
        if (_disposed) return;
        await LoadData();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        HubService.OnAlarmUpdated -= OnHubAlarmUpdated;
        _refreshTrigger?.Dispose();
        _fallbackPoller?.Dispose();
        return ValueTask.CompletedTask;
    }
}
