@page "/meta/{UiId}"
@attribute [Authorize]
@inject IScreenDefinitionProvider Definitions
@inject IApiClient Api

@* Phase 3 — 메타데이터 주도 화면: 정적 @@page 컴파일 화면이 아니라 UiId로 ScreenDefinition을 해석해 동적 렌더. *@
<div class="page-header">
    <h1 class="page-title">@(_definition?.Title ?? "알 수 없는 화면")</h1>
</div>

@if (_definition is null)
{
    <p>화면 정의를 찾을 수 없습니다: <code>@UiId</code></p>
}
else
{
    @* 폼(입력 필드)이 정의된 화면만 폼·저장 영역을 렌더한다 — 그리드 전용(조회) 화면은 폼이 비어 있을 수 있다. *@
    @if (_definition.Fields.Count > 0)
    {
        <MetaFormRenderer Definition="_definition" @bind-Model="_model" />

        <div class="meta-actions">
            <button @onclick="Save" disabled="@_saving">@(_saving ? "저장 중…" : "저장")</button>
            @if (_saved) { <span class="save-ok" style="color:#15803d; margin-left:0.5rem;">저장됨</span> }
        </div>

        @if (_errors.Count > 0)
        {
            <ul class="validation-errors">
                @foreach (var err in _errors) { <li>@err</li> }
            </ul>
        }
    }

    @* 그리드(컬럼) 메타가 있으면 명명 쿼리 결과를 런타임 렌더한다 — 손코딩 없이 메타+파일쿼리로 조회 화면 구성. *@
    @if (_definition.Columns is { Count: > 0 })
    {
        <MetaGridRenderer Columns="_definition.Columns" Rows="_rows" />
    }
}

@code {
    [Parameter] public string UiId { get; set; } = string.Empty;

    private ScreenDefinition? _definition;
    private Dictionary<string, object?> _model = new();
    private List<string> _errors = new();
    private IReadOnlyList<Dictionary<string, object?>>? _rows;   // 그리드 데이터(명명 쿼리 결과); null=미실행
    private bool _saving;
    private bool _saved;

    protected override async Task OnParametersSetAsync()
    {
        // 인메모리 캐시 우선, 없으면 DB 저장소(SYS_SCREEN_DEFINITION)에서 로드해 캐시 등록(Phase 4 후속)
        _definition = Definitions.Get(UiId);
        if (_definition is null)
        {
            var record = await Api.GetScreenDefinitionAsync(UiId);
            if (record is not null)
            {
                _definition = ScreenDefinitionJson.Deserialize(record.DefinitionJson);
                if (_definition is not null) Definitions.Register(_definition);
            }
        }

        // 그리드 컬럼 + 명명 쿼리가 바인딩돼 있으면 파일 기반 쿼리 게이트웨이로 행을 조회한다.
        // (403/5xx는 ApiClient가 빈 목록으로 흡수하고 전역 토스트가 사유를 알린다)
        _rows = null;
        if (_definition?.Columns is { Count: > 0 } && !string.IsNullOrWhiteSpace(_definition.QueryId))
        {
            _rows = await Api.ExecuteQueryAsync(_definition.QueryId);
        }
    }

    private async Task Save()
    {
        _saved = false;
        _errors = Validate();
        if (_errors.Count > 0) return;

        // SaveQueryId(명명 쓰기쿼리)가 바인딩돼 있으면 폼 값(필드 Key→값)을 command 게이트웨이로 보내 저장한다.
        // 감사 컬럼(@currentUser/@utcNow)은 서버 게이트웨이가 토큰·UTC로 주입하므로 폼이 보낼 필요가 없다.
        if (string.IsNullOrWhiteSpace(_definition?.SaveQueryId))
        {
            _errors.Add("이 화면에는 저장(쓰기) 쿼리가 바인딩돼 있지 않습니다.");
            return;
        }

        _saving = true;
        try
        {
            _saved = await Api.ExecuteCommandAsync(_definition.SaveQueryId, _model);
            if (!_saved) _errors.Add("저장에 실패했습니다(권한/입력 확인).");
        }
        finally
        {
            _saving = false;
        }
    }

    private List<string> Validate()
    {
        var errors = new List<string>();
        if (_definition is null) return errors;
        foreach (var field in _definition.Fields.Where(f => f.Required))
        {
            if (!_model.TryGetValue(field.Key, out var v) || string.IsNullOrWhiteSpace(v?.ToString()))
                errors.Add($"{field.Label}은(는) 필수입니다.");
        }
        return errors;
    }
}
