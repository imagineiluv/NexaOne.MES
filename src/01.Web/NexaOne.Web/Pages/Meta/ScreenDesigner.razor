@page "/designer/screen"
@page "/designer"
@attribute [Authorize]
@inject IScreenDefinitionProvider Definitions
@inject IApiClient Api

@* Phase 4 — 프론트엔드 Low-Code: 현업이 필드/그리드 컬럼을 시각적으로 조립해 ScreenDefinition을 만들고
   DB(SYS_SCREEN_DEFINITION)에 저장한다. 저장된 화면은 Phase 3 런타임(/meta/{UiId})이 렌더한다.
   (※ 비즈니스 로직 워크플로우 디자이너와는 별개 트랙) *@
@* NexaUI 적용 PoC — DxButton/DxTextBox/DxComboBox/DxCheckBox 없이 Tailwind+NexaUI로 동일 화면 구성 *@
<div class="p-4 space-y-6 max-w-5xl">
    <div>
        <h1 class="text-xl font-semibold text-gray-800">화면 디자이너 (Low-Code)</h1>
    </div>

    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <label class="nexa-label">화면 ID(UiId)</label>
            <NexaTextBox Value="@_uiId" ValueChanged="v => { _uiId = v ?? string.Empty; _saved = false; }" Placeholder="예: DEMO_PARAM" />
        </div>
        <div>
            <label class="nexa-label">제목</label>
            <NexaTextBox Value="@_title" ValueChanged="v => { _title = v ?? string.Empty; _saved = false; }" Placeholder="화면 제목" />
        </div>
    </section>

    <section class="space-y-2">
        <h3 class="text-base font-semibold text-gray-700">필드</h3>
        <table class="nexa-grid w-full text-sm">
            <thead><tr><th>Key</th><th>레이블</th><th>유형</th><th>필수</th><th>읽기전용</th><th></th></tr></thead>
            <tbody>
                @for (var i = 0; i < _fields.Count; i++)
                {
                    var f = _fields[i];
                    var idx = i;
                    <tr>
                        <td><NexaTextBox Value="@f.Key" ValueChanged="v => { f.Key = v ?? string.Empty; _saved = false; }" /></td>
                        <td><NexaTextBox Value="@f.Label" ValueChanged="v => { f.Label = v ?? string.Empty; _saved = false; }" /></td>
                        <td>
                            <NexaSelect TValue="FieldType" Value="f.Type" ValueChanged="v => { f.Type = v; _saved = false; }">
                                @foreach (var t in Enum.GetValues<FieldType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </NexaSelect>
                        </td>
                        <td><NexaCheckBox Value="f.Required" ValueChanged="v => { f.Required = v; _saved = false; }" /></td>
                        <td><NexaCheckBox Value="f.ReadOnly" ValueChanged="v => { f.ReadOnly = v; _saved = false; }" /></td>
                        <td><NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="() => Remove(idx)">삭제</NexaButton></td>
                    </tr>
                }
            </tbody>
        </table>
        <NexaButton Variant="NexaButton.ButtonVariant.Secondary" OnClick="AddField">+ 필드 추가</NexaButton>
        <div class="max-w-md pt-2">
            <label class="nexa-label">저장(쓰기) 쿼리 ID(선택)</label>
            <NexaTextBox Value="@_saveQueryId" ValueChanged="v => { _saveQueryId = v ?? string.Empty; _saved = false; }" Placeholder="예: MDM.CreatePlant" />
            <p class="text-xs text-gray-500">바인딩하면 <code>/meta/{UiId}</code> 폼 저장이 명명 쓰기쿼리(kind=&quot;write&quot;)로 INSERT/UPDATE합니다(@@param=필드 Key).</p>
        </div>
    </section>

    <section class="space-y-2">
        <h3 class="text-base font-semibold text-gray-700">그리드 컬럼 (선택)</h3>
        <p class="text-sm text-gray-500">컬럼을 정의하고 데이터 소스로 파일 기반 명명 쿼리(db/queries)를 바인딩하면
            <code>/meta/{UiId}</code> 런타임이 손코딩 없이 조회 그리드를 렌더합니다.</p>
        <div class="max-w-md">
            <label class="nexa-label">데이터 소스 쿼리 ID(선택)</label>
            <NexaTextBox Value="@_queryId" ValueChanged="v => { _queryId = v ?? string.Empty; _saved = false; }" Placeholder="예: MDM.PlantList" />
        </div>
        <table class="nexa-grid w-full text-sm">
            <thead><tr><th>Key</th><th>캡션</th><th>표시</th><th></th></tr></thead>
            <tbody>
                @for (var i = 0; i < _columns.Count; i++)
                {
                    var c = _columns[i];
                    var idx = i;
                    <tr>
                        <td><NexaTextBox Value="@c.Key" ValueChanged="v => { c.Key = v ?? string.Empty; _saved = false; }" /></td>
                        <td><NexaTextBox Value="@c.Caption" ValueChanged="v => { c.Caption = v ?? string.Empty; _saved = false; }" /></td>
                        <td><NexaCheckBox Value="c.Visible" ValueChanged="v => { c.Visible = v; _saved = false; }" /></td>
                        <td><NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="() => RemoveColumn(idx)">삭제</NexaButton></td>
                    </tr>
                }
            </tbody>
        </table>
        <NexaButton Variant="NexaButton.ButtonVariant.Secondary" OnClick="AddColumn">+ 컬럼 추가</NexaButton>
    </section>

    <section class="space-y-2">
        <h3 class="text-base font-semibold text-gray-700">미리보기</h3>
        @if (_fields.Count > 0)
        {
            <MetaFormRenderer Definition="BuildDefinition()" @bind-Model="_preview" />
        }
        @if (_columns.Count > 0)
        {
            @* 디자인 시점 미리보기 — 컬럼 헤더만(행 데이터는 런타임 쿼리에서 공급). *@
            <MetaGridRenderer Columns="BuildDefinition().Columns ?? Array.Empty<GridColumnDefinition>()" Rows="null" />
        }
        <details class="text-sm">
            <summary class="cursor-pointer text-gray-600">정의 JSON</summary>
            <pre class="mt-2 p-2 bg-gray-50 rounded border border-gray-200 overflow-auto text-xs">@ScreenDefinitionJson.Serialize(BuildDefinition())</pre>
        </details>
    </section>

    <div class="flex items-center gap-3 border-t pt-4">
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Save" Disabled="@(!CanSave || _busy)">@(_busy ? "저장 중…" : "저장(DB)")</NexaButton>
        @if (_saved) { <span class="text-sm text-green-700">저장됨 — <a class="underline" href="@($"/meta/{_uiId}")">/meta/@_uiId</a> 에서 렌더됩니다.</span> }
        @if (_error is not null) { <span class="text-sm text-red-600">@_error</span> }
    </div>
</div>

@code {
    private sealed class FieldDraft
    {
        public string Key = string.Empty;
        public string Label = string.Empty;
        public FieldType Type = FieldType.Text;
        public bool Required;
        public bool ReadOnly;
    }

    private sealed class ColumnDraft
    {
        public string Key = string.Empty;
        public string Caption = string.Empty;
        public bool Visible = true;
    }

    private string _uiId = string.Empty;
    private string _title = string.Empty;
    private string _queryId = string.Empty;
    private string _saveQueryId = string.Empty;
    private readonly List<FieldDraft> _fields = new();
    private readonly List<ColumnDraft> _columns = new();
    private Dictionary<string, object?> _preview = new();
    private bool _saved;
    private bool _busy;
    private string? _error;

    // 폼(필드) 또는 그리드(컬럼) 중 하나 이상이 있어야 저장 가능 — 그리드 전용 조회 화면도 허용.
    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_uiId) && !string.IsNullOrWhiteSpace(_title)
        && (_fields.Count > 0 || _columns.Count > 0)
        && _fields.All(f => !string.IsNullOrWhiteSpace(f.Key) && !string.IsNullOrWhiteSpace(f.Label))
        && _columns.All(c => !string.IsNullOrWhiteSpace(c.Key) && !string.IsNullOrWhiteSpace(c.Caption));

    private void AddField()
    {
        _fields.Add(new FieldDraft { Key = $"field{_fields.Count + 1}", Label = "새 필드" });
        _saved = false;
    }

    private void Remove(int idx)
    {
        _fields.RemoveAt(idx);
        _saved = false;
    }

    private void AddColumn()
    {
        _columns.Add(new ColumnDraft { Key = $"col{_columns.Count + 1}", Caption = "새 컬럼" });
        _saved = false;
    }

    private void RemoveColumn(int idx)
    {
        _columns.RemoveAt(idx);
        _saved = false;
    }

    private ScreenDefinition BuildDefinition() => new(
        _uiId,
        string.IsNullOrWhiteSpace(_title) ? "(제목 없음)" : _title,
        _fields.Select(f => new FieldDefinition(f.Key, f.Label, f.Type, f.Required, f.ReadOnly)).ToList(),
        _columns.Count == 0 ? null : _columns.Select(c => new GridColumnDefinition(c.Key, c.Caption, c.Visible)).ToList(),
        string.IsNullOrWhiteSpace(_queryId) ? null : _queryId,
        string.IsNullOrWhiteSpace(_saveQueryId) ? null : _saveQueryId);

    private async Task Save()
    {
        _error = null;
        if (!CanSave)
        {
            _error = "UiId·제목·필드(키/레이블)를 모두 채우세요.";
            return;
        }
        if (_fields.Select(f => f.Key).Distinct(StringComparer.OrdinalIgnoreCase).Count() != _fields.Count)
        {
            _error = "필드 Key가 중복됩니다.";
            return;
        }

        var def = BuildDefinition();
        Definitions.Register(def);   // 즉시 인메모리 캐시(렌더 가능)
        _busy = true;
        try
        {
            await Api.SaveScreenDefinitionAsync(_uiId, def.Title, ScreenDefinitionJson.Serialize(def));   // DB 영속
            _saved = true;
        }
        catch (Exception)
        {
            _error = "DB 저장에 실패했습니다(권한/연결 확인). 캐시에는 등록되어 현재 세션에서는 렌더됩니다.";
        }
        finally
        {
            _busy = false;
        }
    }
}
