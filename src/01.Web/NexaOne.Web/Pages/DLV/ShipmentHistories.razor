@page "/dlv/shipments"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">출하 이력</h1>
    <DxButton Text="출하 기록" RenderStyle="ButtonRenderStyle.Primary" Click="OpenCreateDialog"
              Enabled="@(!string.IsNullOrWhiteSpace(_orderId))" />
</div>

<NexaConditionGrid TRow="ShipmentHistoryDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_orderId" NullText="납품 주문 ID *" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"          Caption="이력 ID"    Width="130px" />
        <DxGridDataColumn FieldName="ShippedAt"   Caption="출하일시"    Width="160px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="ShippedQty"  Caption="출하 수량"   Width="100px" />
        <DxGridDataColumn FieldName="ShippedBy"   Caption="출하자"      Width="110px" />
        <DxGridDataColumn FieldName="Carrier"     Caption="운송사"      Width="120px" />
        <DxGridDataColumn FieldName="TrackingNo"  Caption="운송장 번호" Width="150px" />
    </Columns>
</NexaConditionGrid>

@if (_showCreate)
{
    <DxPopup @bind-Visible="_showCreate" HeaderText="출하 기록" Width="460px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.HistoryId"  NullText="이력 ID *" />
                <DxSpinEdit @bind-Value="_form.ShippedQty" MinValue="0.01m" Step="1m" NullText="출하 수량 *" />
                <DxTextBox @bind-Text="_form.ShippedBy"  NullText="출하자 ID *" />
                <DxTextBox @bind-Text="_form.Carrier"    NullText="운송사 (선택)" />
                <DxTextBox @bind-Text="_form.TrackingNo" NullText="운송장 번호 (선택)" />
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="기록" RenderStyle="ButtonRenderStyle.Primary" Click="Create" />
            <DxButton Text="취소" Click="@(() => _showCreate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<ShipmentHistoryDto> _items = new();
    private string _orderId = string.Empty;
    private bool _showCreate;
    private ShipForm _form = new();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
        => _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_orderId))
            _items = await Api.GetShipmentHistoryAsync(_orderId);
    }

    private void OpenCreateDialog()
    {
        _form = new() { ShippedBy = _currentUserId };
        _showCreate = true;
    }

    private async Task Create()
    {
        await Api.RecordShipmentAsync(_orderId, new
        {
            HistoryId = _form.HistoryId, ShippedQty = _form.ShippedQty,
            ShippedBy = _form.ShippedBy,
            Carrier = string.IsNullOrEmpty(_form.Carrier) ? null : _form.Carrier,
            TrackingNo = string.IsNullOrEmpty(_form.TrackingNo) ? null : _form.TrackingNo
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class ShipForm
    {
        public string  HistoryId  { get; set; } = string.Empty;
        public decimal ShippedQty { get; set; }
        public string  ShippedBy  { get; set; } = string.Empty;
        public string? Carrier    { get; set; }
        public string? TrackingNo { get; set; }
    }
}
