@page "/dlv/orders"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">납품 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">납품 등록</NexaButton>
</div>

<NexaConditionGrid TRow="DeliveryOrderDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_plantId" Placeholder="Plant ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((DeliveryOrderDto r) => r.Id)"            Title="주문 ID" />
        <PropertyColumn Property="@((DeliveryOrderDto r) => r.CustomerName)"  Title="고객사" />
        <PropertyColumn Property="@((DeliveryOrderDto r) => r.PlantId)"       Title="Plant" />
        <PropertyColumn Property="@((DeliveryOrderDto r) => r.RequestedDate)" Title="요청일" Format="yyyy-MM-dd" />
        <PropertyColumn Property="@((DeliveryOrderDto r) => r.ShippedDate)"   Title="출하일" Format="yyyy-MM-dd" />
        <TemplateColumn TGridItem="DeliveryOrderDto" Title="상태">
            <StatusBadge Value="@context.Status" />
        </TemplateColumn>
        <TemplateColumn TGridItem="DeliveryOrderDto" Title="">
            <div style="display:flex; gap:4px;">
                @if (context.Status == "Draft")
                {
                    <NexaButton OnClick="@(() => ConfirmOrder(context.Id))">확정</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelOrder(context.Id))">취소</NexaButton>
                }
                @if (context.Status == "Confirmed")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="@(() => OpenShipDialog(context.Id))">출하</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="납품 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox  @bind-Value="_form.OrderId"      Placeholder="주문 ID *" />
            <NexaTextBox  @bind-Value="_form.CustomerName" Placeholder="고객사 *" />
            <NexaTextBox  @bind-Value="_form.PlantId"      Placeholder="Plant ID *" />
            <NexaDateInput @bind-Value="_form.RequestedDate" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateOrder">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showShip" Title="출하 처리">
    <ChildContent>
        <div style="padding:0.5rem;">
            <label style="font-size:0.875rem; font-weight:500; color:#374151; display:block; margin-bottom:0.5rem;">출하일</label>
            <NexaDateInput @bind-Value="_shipDate" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmShip">출하 확인</NexaButton>
        <NexaButton OnClick="@(() => _showShip = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<DeliveryOrderDto> _items = new();
    private string _plantId = string.Empty;
    private bool _showCreate;
    private OrderForm _form = new();
    private bool _showShip;
    private string _shipOrderId = string.Empty;
    private DateTime _shipDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData() => _items = await Api.GetDeliveryOrdersAsync(_plantId);

    private void OpenCreateDialog()
    {
        _form = new() { PlantId = _plantId };
        _showCreate = true;
    }

    private async Task CreateOrder()
    {
        await Api.CreateDeliveryOrderAsync(new { _form.OrderId, _form.CustomerName, _form.PlantId, RequestedDate = _form.RequestedDate });
        _showCreate = false;
        await LoadData();
    }

    private async Task ConfirmOrder(string id) { await Api.ConfirmDeliveryOrderAsync(id); await LoadData(); }
    private async Task CancelOrder(string id)  { await Api.CancelDeliveryOrderAsync(id);  await LoadData(); }

    private void OpenShipDialog(string id)
    {
        _shipOrderId = id;
        _shipDate = DateTime.Today;
        _showShip = true;
    }

    private async Task ConfirmShip()
    {
        await Api.ShipDeliveryOrderAsync(_shipOrderId, _shipDate);
        _showShip = false;
        await LoadData();
    }

    private sealed class OrderForm
    {
        public string   OrderId       { get; set; } = string.Empty;
        public string   CustomerName  { get; set; } = string.Empty;
        public string   PlantId       { get; set; } = string.Empty;
        public DateTime RequestedDate { get; set; } = DateTime.Today.AddDays(7);
    }
}
