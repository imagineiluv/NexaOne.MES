@page "/sys/deploy"
@attribute [Authorize(Roles = "ADMIN")]
@inject IApiClient Api

@* §20.11 — 배포 파일 업로드/관리: 현행 UpdateServer 파일 배포의 웹 적응.
   클라이언트는 GET /api/v1/deploy/latest 로 최신 버전을 확인하고 다운로드한다. *@

<div class="page-header">
    <h1 class="page-title">배포 파일 관리</h1>
    @if (_latest is not null)
    {
        <span class="deploy-latest-badge">
            최신 버전: @_latest.Version @(_latest.ForceUpdate ? "(강제 업데이트)" : "")
        </span>
    }
</div>

<div class="deploy-upload-panel">
    <NexaTextBox @bind-Value="_version"     Placeholder="버전 (예: 3.6.0.0) *" Class="deploy-field-version" />
    <NexaTextBox @bind-Value="_description" Placeholder="릴리스 노트"          Class="deploy-field-note" />
    <NexaCheckBox @bind-Value="_forceUpdate">강제 업데이트</NexaCheckBox>
    <InputFile OnChange="OnFileSelected" />
    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
              Disabled="@(!(!_uploading && _selected is not null))"
              OnClick="Upload">@(_uploading ? "업로드 중..." : "업로드")</NexaButton>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="deploy-message error">@_error</div>
}
@if (!string.IsNullOrEmpty(_info))
{
    <div class="deploy-message success">@_info</div>
}

<NexaConditionGrid TRow="DeployFileDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((DeployFileDto r) => r.Version)"    Title="버전" />
        <PropertyColumn Property="@((DeployFileDto r) => r.FileName)"   Title="파일명" />
        <TemplateColumn TGridItem="DeployFileDto" Title="크기">
            @FormatSize(context.FileSize)
        </TemplateColumn>
        <PropertyColumn Property="@((DeployFileDto r) => r.Description)" Title="릴리스 노트" />
        <TemplateColumn TGridItem="DeployFileDto" Title="강제">
            @(context.ForceUpdate ? "예" : "")
        </TemplateColumn>
        <TemplateColumn TGridItem="DeployFileDto" Title="상태">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
        <PropertyColumn Property="@((DeployFileDto r) => r.UploadedBy)" Title="업로더" />
        <PropertyColumn Property="@((DeployFileDto r) => r.UploadedAt)" Title="업로드 일시" Format="yyyy-MM-dd HH:mm" />
        <TemplateColumn TGridItem="DeployFileDto" Title="">
            @{
                @* §20.11 — 문제 버전 회수/복구: latest 선정·다운로드 대상에서 제외/복귀 *@
                if (context.IsActive)
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                              OnClick="@(() => SetActive(context.FileId, false))">비활성화</NexaButton>
                }
                else
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                              OnClick="@(() => SetActive(context.FileId, true))">활성화</NexaButton>
                }
            }
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@code {
    // 서버 측 DeployController.MaxUploadBytes(500MB)와 동일해야 한다 — Web은 API를 참조하지 않아 별도 상수
    private const long MaxUploadBytes = 500L * 1024 * 1024;

    private List<DeployFileDto> _items = new();
    private DeployLatestDto? _latest;
    private IBrowserFile? _selected;
    private string _version = string.Empty;
    private string _description = string.Empty;
    private bool _forceUpdate;
    private bool _uploading;
    private string? _error;
    private string? _info;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _items  = await Api.GetDeployFilesAsync();
        _latest = await Api.GetLatestDeployAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selected = e.File;
        _error = null;
        _info  = null;
    }

    private async Task Upload()
    {
        if (_selected is null) return;

        _uploading = true;
        _error = null;
        _info  = null;
        try
        {
            // InputFile은 SignalR로 스트리밍된다 — 상한 초과 시 읽기 중 IOException
            await using var stream = _selected.OpenReadStream(MaxUploadBytes);
            var (file, error) = await Api.UploadDeployFileAsync(
                stream, _selected.Name, _version, _description, _forceUpdate);

            if (file is null)
            {
                _error = error ?? "업로드에 실패했습니다.";
                return;
            }

            _info = $"버전 {file.Version} 업로드 완료 — SHA-256 {file.Hash}";
            _selected    = null;
            _version     = string.Empty;
            _description = string.Empty;
            _forceUpdate = false;
            await LoadData();
        }
        catch (IOException)
        {
            _error = $"파일이 업로드 상한({MaxUploadBytes / (1024 * 1024)}MB)을 초과합니다.";
        }
        catch (Exception ex)
        {
            _error = $"업로드 중 오류: {ex.Message}";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SetActive(string fileId, bool isActive)
    {
        _error = null;
        _info  = null;
        if (!await Api.SetDeployFileActiveAsync(fileId, isActive))
            _error = isActive ? "활성화에 실패했습니다." : "비활성화에 실패했습니다.";
        await LoadData();
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024 * 1024):0.##} GB",
        >= 1024 * 1024        => $"{bytes / (1024.0 * 1024):0.##} MB",
        >= 1024               => $"{bytes / 1024.0:0.##} KB",
        _                     => $"{bytes} B"
    };
}
