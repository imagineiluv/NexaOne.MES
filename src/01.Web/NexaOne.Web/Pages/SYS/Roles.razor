@page "/sys/roles"
@attribute [Authorize(Roles = "ADMIN")]
@inject IApiClient Api
@inject WaitOverlayService WaitSvc

<div class="page-header">
    <h1 class="page-title">역할 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">역할 등록</NexaButton>
</div>

<NexaConditionGrid TRow="RoleDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((RoleDto r) => r.Id)"          Title="역할 ID" />
        <PropertyColumn Property="@((RoleDto r) => r.RoleName)"    Title="역할명" />
        <PropertyColumn Property="@((RoleDto r) => r.Description)" Title="설명" />
        <TemplateColumn TGridItem="RoleDto" Title="">
            <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                        OnClick="@(() => OpenPermissionsDialog(context))">권한 관리</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="역할 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.RoleId"      Placeholder="역할 ID *" />
            <NexaTextBox @bind-Value="_form.RoleName"    Placeholder="역할명 *" />
            <NexaTextBox @bind-Value="_form.Description" Placeholder="설명" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateRole">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showPermissions" Title="@($"권한 관리 — {_selectedRole?.RoleName}")">
    <ChildContent>
        @if (_selectedRole is not null)
        {
            <div style="padding:0.5rem;">
                <div style="margin-bottom:0.75rem; display:flex; gap:0.5rem;">
                    <NexaTextBox @bind-Value="_newPermission" Placeholder="새 권한 코드 (예: MDM.WRITE)" Style="flex:1" />
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="AddPermission">추가</NexaButton>
                </div>
                @foreach (var perm in _selectedRole.Permissions)
                {
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:0.35rem 0; border-bottom:1px solid #eee;">
                        <span>@perm</span>
                        <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                                    OnClick="@(() => RemovePermission(perm))">삭제</NexaButton>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <NexaButton OnClick="@(() => _showPermissions = false)">닫기</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<RoleDto> _items = new();
    private bool _showCreate;
    private bool _showPermissions;
    private RoleDto? _selectedRole;
    private string _newPermission = string.Empty;
    private RoleForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var _ = WaitSvc.Show("조회 중...");
        _items = await Api.GetRolesAsync();
    }

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task CreateRole()
    {
        using var _ = WaitSvc.Show("저장 중...");
        await Api.CreateRoleAsync(new { _form.RoleId, _form.RoleName, _form.Description });
        _showCreate = false;
        await LoadData();
    }

    private void OpenPermissionsDialog(RoleDto role)
    {
        _selectedRole = role;
        _newPermission = string.Empty;
        _showPermissions = true;
    }

    private async Task AddPermission()
    {
        if (string.IsNullOrWhiteSpace(_newPermission) || _selectedRole is null) return;
        using var _ = WaitSvc.Show("저장 중...");
        await Api.AddPermissionAsync(_selectedRole.Id, _newPermission.Trim());
        _newPermission = string.Empty;
        _selectedRole = await Api.GetRoleAsync(_selectedRole.Id);
        await LoadData();
    }

    private async Task RemovePermission(string permission)
    {
        if (_selectedRole is null) return;
        using var _ = WaitSvc.Show("저장 중...");
        await Api.RemovePermissionAsync(_selectedRole.Id, permission);
        _selectedRole = await Api.GetRoleAsync(_selectedRole.Id);
        await LoadData();
    }

    private sealed class RoleForm
    {
        public string RoleId      { get; set; } = string.Empty;
        public string RoleName    { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
