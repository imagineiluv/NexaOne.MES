@page "/sys/languages"
@attribute [Authorize(Roles = "ADMIN")]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">다국어 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenUpsertDialog">리소스 등록/수정</NexaButton>
</div>

<div style="display:flex; gap:0.75rem; margin-bottom:1rem; align-items:flex-end;">
    <div>
        <label class="form-label">메뉴 ID</label>
        <NexaTextBox @bind-Value="_filterMenuId" Placeholder="메뉴 ID 입력" />
    </div>
    <div>
        <label class="form-label">언어</label>
        <NexaSelect TValue="string" @bind-Value="_filterLanguage">@foreach (var x in _languages) { <option value="@x">@x</option> }</NexaSelect>
    </div>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="LoadData">조회</NexaButton>
</div>

<NexaConditionGrid TRow="MultiLanguageResourceDto" Items="_items">
    <ConditionPanel>
        <span style="font-size:0.85rem; color:#666;">필터 조건을 입력하고 조회하세요.</span>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((MultiLanguageResourceDto r) => r.Id)" Title="리소스 키" />
        <PropertyColumn Property="@((MultiLanguageResourceDto r) => r.MenuId)" Title="메뉴 ID" />
        <PropertyColumn Property="@((MultiLanguageResourceDto r) => r.Language)" Title="언어" />
        <PropertyColumn Property="@((MultiLanguageResourceDto r) => r.Value)" Title="번역 값" />
        <TemplateColumn TGridItem="MultiLanguageResourceDto" Title="">
            <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                        OnClick="@(() => OpenEditDialog(context))">수정</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showUpsert" Title="@(_isEdit ? "번역 수정" : "번역 등록")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.ResourceKey" Placeholder="리소스 키 *" ReadOnly="_isEdit" />
            <NexaTextBox @bind-Value="_form.MenuId"      Placeholder="메뉴 ID *" />
            <NexaSelect TValue="string" @bind-Value="_form.Language">@foreach (var x in _languages) { <option value="@x">@x</option> }</NexaSelect>
            <NexaTextBox @bind-Value="_form.Value"       Placeholder="번역 값 *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="UpsertResource">저장</NexaButton>
        <NexaButton OnClick="@(() => _showUpsert = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<MultiLanguageResourceDto> _items = new();
    private bool _showUpsert;
    private bool _isEdit;
    private string _filterMenuId = string.Empty;
    private string _filterLanguage = "KoKr";
    private LangForm _form = new();

    // LanguageType enum과 일치해야 한다 — 목록에 없는 값은 서버가 400으로 거부한다
    private static readonly List<string> _languages = new() { "KoKr", "EnUs", "ZhCn", "ViVn", "LoLo" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _items = await Api.GetLanguageResourcesAsync(
            menuId: string.IsNullOrWhiteSpace(_filterMenuId) ? null : _filterMenuId,
            language: string.IsNullOrWhiteSpace(_filterLanguage) ? null : _filterLanguage);
    }

    private void OpenUpsertDialog() { _form = new(); _isEdit = false; _showUpsert = true; }

    private void OpenEditDialog(MultiLanguageResourceDto r)
    {
        _form = new LangForm { ResourceKey = r.Id, MenuId = r.MenuId, Language = r.Language, Value = r.Value };
        _isEdit = true;
        _showUpsert = true;
    }

    private async Task UpsertResource()
    {
        await Api.UpsertLanguageResourceAsync(new
        {
            ResourceKey = _form.ResourceKey,
            _form.MenuId,
            _form.Language,
            _form.Value
        });
        _showUpsert = false;
        await LoadData();
    }

    private sealed class LangForm
    {
        public string ResourceKey { get; set; } = string.Empty;
        public string MenuId      { get; set; } = string.Empty;
        public string Language    { get; set; } = "KoKr";
        public string Value       { get; set; } = string.Empty;
    }
}
