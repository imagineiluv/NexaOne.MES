@page "/sys/user-requests"
@attribute [Authorize(Roles = "ADMIN")]
@inject IApiClient Api

@* §19.3.4~§19.3.6 — 가입 신청 승인/반려 (관리자 전용).
   승인 시 역할을 지정해 사용자를 생성하고(설계 표준의 Plant 권한 그룹 → RoleId 적응),
   임시 비밀번호 메일이 발송된다. 반려는 사유 필수이며 같은 ID로 재신청이 가능하다. *@
<div class="page-header">
    <h1 class="page-title">가입 승인</h1>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div style="color:#dc2626; font-size:0.875rem; margin-bottom:0.5rem;">@_error</div>
}

<NexaConditionGrid TRow="UserRequestDto" Items="_items">
    <ConditionPanel>
        <DxTextBox @bind-Text="_plantId" NullText="Plant" />
        <DxComboBox Data="_statusFilters" @bind-Value="_status" />
        <DxTextBox @bind-Text="_userId"   NullText="사용자 ID" />
        <DxTextBox @bind-Text="_userName" NullText="이름" />
        <DxDateEdit @bind-Date="_from" NullText="신청일(시작)" />
        <DxDateEdit @bind-Date="_to"   NullText="신청일(종료)" />
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="UserId"     Caption="사용자 ID" Width="110px" />
        <DxGridDataColumn FieldName="UserName"   Caption="이름"      Width="100px" />
        <DxGridDataColumn FieldName="Email"      Caption="이메일"    Width="180px" />
        <DxGridDataColumn FieldName="Department" Caption="부서"      Width="110px" />
        <DxGridDataColumn FieldName="Position"   Caption="직급"      Width="80px" />
        <DxGridDataColumn FieldName="PlantId"    Caption="Plant"     Width="90px" />
        <DxGridDataColumn FieldName="Status"     Caption="상태"      Width="90px">
            <CellDisplayTemplate>
                <StatusBadge Value="@((string)context.Value)" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="RequestVersion" Caption="차수"   Width="60px" />
        <DxGridDataColumn FieldName="RequestedAt"    Caption="신청일" Width="150px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="RejectReason"   Caption="반려 사유" Width="160px" />
        <DxGridCommandColumn Width="160px">
            <CellDisplayTemplate>
                @{
                    var r = (UserRequestDto)context.DataItem;
                    if (r.Status == "Request")
                    {
                        <DxButton Text="승인" RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@(() => OpenApprove(r))" CssClass="me-1" />
                        <DxButton Text="반려" RenderStyle="ButtonRenderStyle.Danger"
                                  Click="@(() => OpenReject(r))" />
                    }
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
    </Columns>
</NexaConditionGrid>

@if (_showApprove && _selected is not null)
{
    <DxPopup @bind-Visible="_showApprove" HeaderText="가입 승인" Width="420px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <div style="font-size:0.9rem; color:#374151;">
                    <strong>@_selected.UserName</strong> (@_selected.UserId) — @_selected.Department / @_selected.Position<br />
                    <span style="color:#6b7280;">Plant: @_selected.PlantId · 이메일: @_selected.Email</span>
                </div>
                <div>
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">부여할 역할</label>
                    <DxComboBox Data="_roleIds" @bind-Value="_approveRoleId" CssClass="mt-1" />
                </div>
                <div style="font-size:0.8rem; color:#6b7280;">
                    승인 시 사용자가 생성되고 임시 비밀번호가 이메일로 발송됩니다.
                </div>
                @if (!string.IsNullOrEmpty(_popupError))
                {
                    <div style="color:#dc2626; font-size:0.875rem;">@_popupError</div>
                }
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="승인" RenderStyle="ButtonRenderStyle.Primary" Click="Approve" Enabled="!_processing" />
            <DxButton Text="취소" Click="@(() => _showApprove = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@if (_showReject && _selected is not null)
{
    <DxPopup @bind-Visible="_showReject" HeaderText="가입 반려" Width="420px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <div style="font-size:0.9rem; color:#374151;">
                    <strong>@_selected.UserName</strong> (@_selected.UserId) — @_selected.Department / @_selected.Position
                </div>
                <div>
                    <label style="font-size:0.875rem; font-weight:500; color:#374151;">반려 사유 *</label>
                    <DxMemo @bind-Text="_rejectReason" NullText="반려 사유를 입력하세요" Rows="3" CssClass="mt-1 w-100" />
                </div>
                <div style="font-size:0.8rem; color:#6b7280;">
                    반려 사유는 신청자에게 메일로 안내되며, 같은 ID로 재신청할 수 있습니다.
                </div>
                @if (!string.IsNullOrEmpty(_popupError))
                {
                    <div style="color:#dc2626; font-size:0.875rem;">@_popupError</div>
                }
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="반려" RenderStyle="ButtonRenderStyle.Danger" Click="Reject" Enabled="!_processing" />
            <DxButton Text="취소" Click="@(() => _showReject = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<UserRequestDto> _items = new();
    private string _plantId  = string.Empty;
    private string _userId   = string.Empty;
    private string _userName = string.Empty;
    private string _status   = "Request";   // 기본은 처리 대기 목록
    private DateTime? _from;
    private DateTime? _to;
    private string? _error;

    private static readonly List<string> _statusFilters = new() { "전체", "Request", "Approved", "Rejected" };

    private bool _showApprove;
    private bool _showReject;
    private bool _processing;
    private string? _popupError;
    private UserRequestDto? _selected;
    private string _approveRoleId = "USER";
    private string _rejectReason = string.Empty;
    private List<string> _roleIds = new() { "USER" };

    protected override async Task OnInitializedAsync()
    {
        var roles = await Api.GetRolesAsync();
        if (roles.Count > 0)
        {
            _roleIds = roles.Select(r => r.Id).ToList();
            if (!_roleIds.Contains(_approveRoleId))
                _approveRoleId = _roleIds[0];
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        _error = null;
        _items = await Api.GetUserRequestsAsync(
            NullIfEmpty(_plantId),
            _status == "전체" ? null : _status,
            NullIfEmpty(_userId),
            NullIfEmpty(_userName),
            email: null,
            _from,
            _to?.Date.AddDays(1).AddTicks(-1));   // 종료일 당일 포함
    }

    private void OpenApprove(UserRequestDto r)
    {
        _selected = r;
        _popupError = null;
        _showApprove = true;
    }

    private void OpenReject(UserRequestDto r)
    {
        _selected = r;
        _rejectReason = string.Empty;
        _popupError = null;
        _showReject = true;
    }

    private async Task Approve()
    {
        if (_selected is null) return;
        _processing = true;
        try
        {
            var (_, error) = await Api.ApproveUserRequestAsync(_selected.RequestId, _approveRoleId);
            if (error is not null)
            {
                _popupError = error;
                return;
            }
            _showApprove = false;
            await LoadData();
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task Reject()
    {
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            _popupError = "반려 사유는 필수입니다.";
            return;
        }

        _processing = true;
        try
        {
            var (_, error) = await Api.RejectUserRequestAsync(_selected.RequestId, _rejectReason.Trim());
            if (error is not null)
            {
                _popupError = error;
                return;
            }
            _showReject = false;
            await LoadData();
        }
        finally
        {
            _processing = false;
        }
    }

    private static string? NullIfEmpty(string value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
