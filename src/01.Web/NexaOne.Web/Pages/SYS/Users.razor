@page "/sys/users"
@attribute [Authorize(Roles = "ADMIN")]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">사용자 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">사용자 등록</NexaButton>
</div>

<NexaConditionGrid TRow="UserDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((UserDto r) => r.Id)"       Title="사용자 ID" />
        <PropertyColumn Property="@((UserDto r) => r.UserName)" Title="이름" />
        <PropertyColumn Property="@((UserDto r) => r.Email)"    Title="이메일" />
        <PropertyColumn Property="@((UserDto r) => r.RoleId)"   Title="역할" />
        <PropertyColumn Property="@((UserDto r) => r.Language)" Title="언어" />
        <TemplateColumn TGridItem="UserDto" Title="상태">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
        <PropertyColumn Property="@((UserDto r) => r.LastLoginAt)" Title="최근 로그인" Format="yyyy-MM-dd HH:mm" />
        <TemplateColumn TGridItem="UserDto" Title="">
            @* §20.10 — 잠금 해제는 시간 만료 또는 관리자만 가능 *@
            @if (context.IsLocked)
            {
                <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                            OnClick="@(() => UnlockUser(context.Id))" Class="me-1">잠금 해제</NexaButton>
            }
            @if (context.IsActive)
            {
                <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                            OnClick="@(() => DeactivateUser(context.Id))">비활성화</NexaButton>
            }
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="사용자 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.UserId"   Placeholder="사용자 ID *" />
            <NexaTextBox @bind-Value="_form.UserName" Placeholder="이름 *" />
            <NexaTextBox @bind-Value="_form.Password" Placeholder="초기 비밀번호 *" Type="password" />
            <NexaTextBox @bind-Value="_form.Email"    Placeholder="이메일" />
            <NexaSelect TValue="string" @bind-Value="_form.RoleId">@foreach (var x in _roles) { <option value="@x">@x</option> }</NexaSelect>
            <NexaSelect TValue="string" @bind-Value="_form.Language">@foreach (var x in _languages) { <option value="@x">@x</option> }</NexaSelect>
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateUser">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<UserDto> _items = new();
    private bool _showCreate;
    private UserForm _form = new();

    private static readonly List<string> _roles     = new() { "ADMIN", "ENGINEER", "OPERATOR", "VIEWER" };
    // LanguageType enum과 일치해야 한다 — 목록에 없는 값은 서버에서 KoKr로 조용히 대체된다
    private static readonly List<string> _languages = new() { "KoKr", "EnUs", "ZhCn", "ViVn", "LoLo" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetUsersAsync();

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task CreateUser()
    {
        await Api.CreateUserAsync(new
        {
            _form.UserId, _form.UserName,
            PasswordHash = HashPassword(_form.Password),
            _form.Email, _form.RoleId, Language = _form.Language
        });
        _showCreate = false;
        await LoadData();
    }

    private async Task DeactivateUser(string userId)
    {
        await Api.DeactivateUserAsync(userId);
        await LoadData();
    }

    private async Task UnlockUser(string userId)
    {
        await Api.UnlockUserAsync(userId);
        await LoadData();
    }

    private static string HashPassword(string pw)
    {
        var bytes = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(pw));
        return Convert.ToHexString(bytes).ToLowerInvariant();
    }

    private sealed class UserForm
    {
        public string UserId   { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Email    { get; set; } = string.Empty;
        public string RoleId   { get; set; } = "OPERATOR";
        public string Language { get; set; } = "KoKr";
    }
}
