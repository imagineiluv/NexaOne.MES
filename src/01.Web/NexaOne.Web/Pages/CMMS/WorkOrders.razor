@page "/cmms/work-orders"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">작업 지시</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">작업 지시 생성</NexaButton>
</div>

<NexaConditionGrid TRow="WorkOrderDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaSelect TValue="string" @bind-Value="_statusFilter"><option value="">상태 전체</option>@foreach (var x in _statuses) { <option value="@x">@x</option> }</NexaSelect>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((WorkOrderDto r) => r.Id)"          Title="WO ID" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.EquipmentId)" Title="설비" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.WoType)"      Title="유형" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.AssigneeId)"  Title="담당자" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.IssuedAt)"    Title="지시일시"    Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.StartedAt)"   Title="시작일시"    Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((WorkOrderDto r) => r.CompletedAt)" Title="완료일시"    Format="yyyy-MM-dd HH:mm" />
        <TemplateColumn TGridItem="WorkOrderDto" Title="상태">
            <StatusBadge Value="@context.Status" />
        </TemplateColumn>
        <TemplateColumn TGridItem="WorkOrderDto" Title="">
            <div style="display:flex; gap:4px;">
                @if (context.Status == "Issued")
                {
                    <NexaButton OnClick="@(() => StartWo(context.Id))">시작</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelWo(context.Id))">취소</NexaButton>
                }
                @if (context.Status == "InProgress")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="@(() => OpenCompleteDialog(context.Id))">완료</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="작업 지시 생성">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.WoId"        Placeholder="WO ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentId" Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.WoType"      Placeholder="유형 (예: PM)" />
            <NexaTextBox @bind-Value="_form.AssigneeId"  Placeholder="담당자 ID *" />
            <NexaTextBox @bind-Value="_form.Description" Placeholder="설명" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateWo">생성</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showComplete" Title="작업 완료">
    <ChildContent>
        <div style="padding:0.5rem;">
            <NexaTextBox @bind-Value="_completeRemark" Placeholder="완료 비고 (선택)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmComplete">완료 처리</NexaButton>
        <NexaButton OnClick="@(() => _showComplete = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<WorkOrderDto> _items = new();
    private string _equipmentId = string.Empty;
    private string? _statusFilter;
    private bool _showCreate;
    private WoForm _form = new();
    private bool _showComplete;
    private string _completeWoId = string.Empty;
    private string _completeRemark = string.Empty;
    private string _currentUserId = string.Empty;

    private static readonly List<string> _statuses = new() { "Issued", "InProgress", "Completed", "Cancelled" };

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData() => _items = await Api.GetWorkOrdersAsync(_equipmentId, _statusFilter);

    private void OpenCreateDialog() { _form = new() { AssigneeId = _currentUserId }; _showCreate = true; }

    private async Task CreateWo()
    {
        await Api.CreateWorkOrderAsync(new { _form.WoId, _form.EquipmentId, _form.WoType, Description = _form.Description, _form.AssigneeId });
        _showCreate = false;
        await LoadData();
    }

    private async Task StartWo(string id)  { await Api.StartWorkOrderAsync(id);  await LoadData(); }
    private async Task CancelWo(string id) { await Api.CancelWorkOrderAsync(id); await LoadData(); }

    private void OpenCompleteDialog(string id)
    {
        _completeWoId = id;
        _completeRemark = string.Empty;
        _showComplete = true;
    }

    private async Task ConfirmComplete()
    {
        await Api.CompleteWorkOrderAsync(_completeWoId, _completeRemark);
        _showComplete = false;
        await LoadData();
    }

    private sealed class WoForm
    {
        public string WoId        { get; set; } = string.Empty;
        public string EquipmentId { get; set; } = string.Empty;
        public string WoType      { get; set; } = string.Empty;
        public string AssigneeId  { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
