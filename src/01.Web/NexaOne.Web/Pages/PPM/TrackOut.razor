@page "/ppm/track-out"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">Lot Track Out</h1>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<NexaConditionGrid TRow="LotDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((LotDto r) => r.Id)"               Title="Lot ID" />
        <PropertyColumn Property="@((LotDto r) => r.ProductId)"        Title="제품" />
        <PropertyColumn Property="@((LotDto r) => r.Qty)"              Title="수량" Format="N1" />
        <PropertyColumn Property="@((LotDto r) => r.CurrentProcessId)" Title="현재 공정" />
        <PropertyColumn Property="@((LotDto r) => r.EquipmentId)"      Title="설비" />
        <PropertyColumn Property="@((LotDto r) => r.TrackInTime)"      Title="Track In 시각" Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((LotDto r) => r.TrackInUser)"      Title="작업자" />
        <TemplateColumn TGridItem="LotDto" Title="">
            @{
                if (!context.IsHold)
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                                OnClick="@(() => OpenTrackOutDialog(context))">Track Out</NexaButton>
                }
            }
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showTrackOut" Title="@($"Track Out — {_targetLotId}")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.EquipmentId" Placeholder="설비 ID * (Track In 설비)" />
            <NexaNumberInput @bind-Value="_form.Qty" min="0" />
            <NexaTextBox @bind-Value="_form.CarrierId" Placeholder="Carrier ID (선택)" />

            <div style="display:flex; align-items:center; justify-content:space-between;">
                <strong>불량 입력</strong>
                <NexaButton OnClick="AddDefectRow">행 추가</NexaButton>
            </div>
            @foreach (var defect in _form.Defects)
            {
                <div style="display:flex; gap:6px; align-items:center;">
                    <NexaTextBox @bind-Value="defect.DefectCode" Placeholder="불량 코드" />
                    <NexaNumberInput @bind-Value="defect.DefectQty" min="0" />
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                                OnClick="@(() => _form.Defects.Remove(defect))">삭제</NexaButton>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmTrackOut">Track Out</NexaButton>
        <NexaButton OnClick="@(() => _showTrackOut = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<LotDto> _items = new();
    private string _plantId = string.Empty;
    private string? _error;

    private bool _showTrackOut;
    private string _targetLotId = string.Empty;
    private TrackOutForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        _error = null;
        // Track Out 대상은 Processing(설비 점유 중) Lot만
        _items = await Api.GetLotsAsync(_plantId, "Processing");
    }

    private void OpenTrackOutDialog(LotDto lot)
    {
        _targetLotId = lot.Id;
        _form = new() { EquipmentId = lot.EquipmentId ?? string.Empty, Qty = lot.Qty };
        _showTrackOut = true;
    }

    private void AddDefectRow() => _form.Defects.Add(new DefectRow());

    private async Task ConfirmTrackOut()
    {
        var defects = _form.Defects
            .Where(d => !string.IsNullOrWhiteSpace(d.DefectCode))
            .Select(d => new { d.DefectCode, d.DefectQty })
            .ToList();
        var (_, error) = await Api.TrackOutAsync(_targetLotId, new
        {
            PlantId = _plantId,
            _form.EquipmentId,
            _form.Qty,
            Defects = defects.Count == 0 ? null : defects,
            CarrierId = string.IsNullOrWhiteSpace(_form.CarrierId) ? null : _form.CarrierId
        });
        _error = error;
        if (error is null)
        {
            _showTrackOut = false;
            await LoadData();
        }
    }

    private sealed class TrackOutForm
    {
        public string  EquipmentId { get; set; } = string.Empty;
        public decimal Qty         { get; set; }
        public string? CarrierId   { get; set; }
        public List<DefectRow> Defects { get; } = new();
    }

    private sealed class DefectRow
    {
        public string  DefectCode { get; set; } = string.Empty;
        public decimal DefectQty  { get; set; }
    }
}
