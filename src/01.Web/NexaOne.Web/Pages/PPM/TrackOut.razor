@page "/ppm/track-out"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">Lot Track Out</h1>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<NexaConditionGrid TRow="LotDto" Items="_items">
    <ConditionPanel>
        <DxButton Text="조회" Click="LoadData" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"               Caption="Lot ID"      Width="140px" />
        <DxGridDataColumn FieldName="ProductId"        Caption="제품"         Width="120px" />
        <DxGridDataColumn FieldName="Qty"              Caption="수량"         Width="90px"  DisplayFormat="{0:N1}" />
        <DxGridDataColumn FieldName="CurrentProcessId" Caption="현재 공정"    Width="120px" />
        <DxGridDataColumn FieldName="EquipmentId"      Caption="설비"         Width="110px" />
        <DxGridDataColumn FieldName="TrackInTime"      Caption="Track In 시각" Width="150px" DisplayFormat="{0:yyyy-MM-dd HH:mm}" />
        <DxGridDataColumn FieldName="TrackInUser"      Caption="작업자"       Width="100px" />
        <DxGridCommandColumn Width="120px">
            <CellDisplayTemplate>
                @{
                    var lot = (LotDto)context.DataItem;
                    if (!lot.IsHold)
                    {
                        <DxButton Text="Track Out" RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@(() => OpenTrackOutDialog(lot))" />
                    }
                }
            </CellDisplayTemplate>
        </DxGridCommandColumn>
    </Columns>
</NexaConditionGrid>

@if (_showTrackOut)
{
    <DxPopup @bind-Visible="_showTrackOut" HeaderText="@($"Track Out — {_targetLotId}")" Width="520px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.EquipmentId" NullText="설비 ID * (Track In 설비)" />
                <DxSpinEdit @bind-Value="_form.Qty" MinValue="0" />
                <DxTextBox @bind-Text="_form.CarrierId" NullText="Carrier ID (선택)" />

                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <strong>불량 입력</strong>
                    <DxButton Text="행 추가" Click="AddDefectRow" />
                </div>
                @foreach (var defect in _form.Defects)
                {
                    <div style="display:flex; gap:6px; align-items:center;">
                        <DxTextBox @bind-Text="defect.DefectCode" NullText="불량 코드" />
                        <DxSpinEdit @bind-Value="defect.DefectQty" MinValue="0" />
                        <DxButton Text="삭제" RenderStyle="ButtonRenderStyle.Danger"
                                  Click="@(() => _form.Defects.Remove(defect))" />
                    </div>
                }
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Track Out" RenderStyle="ButtonRenderStyle.Primary" Click="ConfirmTrackOut" />
            <DxButton Text="취소" Click="@(() => _showTrackOut = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<LotDto> _items = new();
    private string _plantId = string.Empty;
    private string? _error;

    private bool _showTrackOut;
    private string _targetLotId = string.Empty;
    private TrackOutForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        _error = null;
        // Track Out 대상은 Processing(설비 점유 중) Lot만
        _items = await Api.GetLotsAsync(_plantId, "Processing");
    }

    private void OpenTrackOutDialog(LotDto lot)
    {
        _targetLotId = lot.Id;
        _form = new() { EquipmentId = lot.EquipmentId ?? string.Empty, Qty = lot.Qty };
        _showTrackOut = true;
    }

    private void AddDefectRow() => _form.Defects.Add(new DefectRow());

    private async Task ConfirmTrackOut()
    {
        var defects = _form.Defects
            .Where(d => !string.IsNullOrWhiteSpace(d.DefectCode))
            .Select(d => new { d.DefectCode, d.DefectQty })
            .ToList();
        var (_, error) = await Api.TrackOutAsync(_targetLotId, new
        {
            PlantId = _plantId,
            _form.EquipmentId,
            _form.Qty,
            Defects = defects.Count == 0 ? null : defects,
            CarrierId = string.IsNullOrWhiteSpace(_form.CarrierId) ? null : _form.CarrierId
        });
        _error = error;
        if (error is null)
        {
            _showTrackOut = false;
            await LoadData();
        }
    }

    private sealed class TrackOutForm
    {
        public string  EquipmentId { get; set; } = string.Empty;
        public decimal Qty         { get; set; }
        public string? CarrierId   { get; set; }
        public List<DefectRow> Defects { get; } = new();
    }

    private sealed class DefectRow
    {
        public string  DefectCode { get; set; } = string.Empty;
        public decimal DefectQty  { get; set; }
    }
}
