@page "/mdm/products"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">제품 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">제품 등록</NexaButton>
</div>

<NexaConditionGrid TRow="ProductDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((ProductDto r) => r.Id)"          Title="제품 ID" />
        <PropertyColumn Property="@((ProductDto r) => r.ProductName)" Title="제품명" />
        <PropertyColumn Property="@((ProductDto r) => r.ProductType)" Title="유형" />
        <PropertyColumn Property="@((ProductDto r) => r.Unit)"        Title="단위" />
        <TemplateColumn TGridItem="ProductDto" Title="상태">
            <StatusBadge Value="@context.ValidState" />
        </TemplateColumn>
        <PropertyColumn Property="@((ProductDto r) => r.Description)" Title="설명" />
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="제품 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.ProductId"   Placeholder="제품 ID *" />
            <NexaTextBox @bind-Value="_form.ProductName" Placeholder="제품명 *" />
            <NexaTextBox @bind-Value="_form.ProductType" Placeholder="유형 (예: FG, WIP, RAW)" />
            <NexaTextBox @bind-Value="_form.Unit"        Placeholder="단위 (예: EA, KG)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateProduct">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<ProductDto> _items = new();
    private bool _showCreate;
    private ProductForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetProductsAsync();

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task CreateProduct()
    {
        await Api.CreateProductAsync(new { _form.ProductId, ProductName = _form.ProductName, _form.ProductType, _form.Unit });
        _showCreate = false;
        await LoadData();
    }

    private sealed class ProductForm
    {
        public string ProductId   { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public string ProductType { get; set; } = string.Empty;
        public string Unit        { get; set; } = "EA";
    }
}
