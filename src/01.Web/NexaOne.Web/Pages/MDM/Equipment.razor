@page "/mdm/equipment"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext
@inject WaitOverlayService WaitSvc
@inject DirtyTracker Dirty
@implements IDisposable

<div class="page-header">
    <h1 class="page-title">설비 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">설비 등록</NexaButton>
</div>

<NexaConditionGrid TRow="EquipmentDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_searchPlantId" Placeholder="Plant ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((EquipmentDto r) => r.Id)"            Title="설비 ID" />
        <PropertyColumn Property="@((EquipmentDto r) => r.EquipmentName)" Title="설비명" />
        <PropertyColumn Property="@((EquipmentDto r) => r.PlantId)"       Title="Plant" />
        <PropertyColumn Property="@((EquipmentDto r) => r.AreaId)"        Title="Area" />
        <PropertyColumn Property="@((EquipmentDto r) => r.EquipmentType)" Title="유형" />
        <PropertyColumn Property="@((EquipmentDto r) => r.Vendor)"        Title="제조사" />
        <PropertyColumn Property="@((EquipmentDto r) => r.Model)"         Title="모델" />
        <TemplateColumn TGridItem="EquipmentDto" Title="상태">
            <StatusBadge Value="@(context.ValidState)" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal Visible="_showCreate" VisibleChanged="OnCreateDialogClose" Title="설비 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.EquipmentId"      @bind-Value:after="MarkFormDirty" Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentName"    @bind-Value:after="MarkFormDirty" Placeholder="설비명 *" />
            <NexaTextBox @bind-Value="_form.PlantId"          @bind-Value:after="MarkFormDirty" Placeholder="Plant ID *" />
            <NexaTextBox @bind-Value="_form.AreaId"           @bind-Value:after="MarkFormDirty" Placeholder="Area ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentType"    @bind-Value:after="MarkFormDirty" Placeholder="유형 (예: CNC)" />
            <NexaTextBox @bind-Value="_form.EquipmentClassId" @bind-Value:after="MarkFormDirty" Placeholder="설비 클래스 ID" />
            <NexaTextBox @bind-Value="_form.Vendor"           @bind-Value:after="MarkFormDirty" Placeholder="제조사" />
            <NexaTextBox @bind-Value="_form.Model"            @bind-Value:after="MarkFormDirty" Placeholder="모델" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateEquipment">등록</NexaButton>
        <NexaButton OnClick="@(() => RequestCloseDialog())" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<ConfirmCloseDialog Visible="_showConfirmClose" OnAction="HandleConfirmClose" />

@code {
    private List<EquipmentDto> _items = [];
    private string _searchPlantId = string.Empty;
    private bool _showCreate;
    private bool _showConfirmClose;
    private EquipmentForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        Dirty.StateChanged += OnDirtyChanged;
        _searchPlantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    // 다른 컴포넌트와 일관되게 InvokeAsync로 감싼다 — 향후 백그라운드(허브/타이머) 경로에서 Dirty가
    // 바뀌어도 렌더러 스레드에서 안전하게 StateHasChanged가 호출되도록 한다.
    private void OnDirtyChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadData()
    {
        using var _ = WaitSvc.Show("조회 중...");
        _items = await Api.GetEquipmentListAsync(_searchPlantId);
    }

    private void OpenCreateDialog()
    {
        _form = new() { PlantId = _searchPlantId };
        Dirty.MarkClean("create");
        _showCreate = true;
    }

    private void RequestCloseDialog()
    {
        if (Dirty.IsDirty)
            _showConfirmClose = true;
        else
            CloseCreateDialog();
    }

    private void OnCreateDialogClose(bool visible)
    {
        if (!visible) RequestCloseDialog();
    }

    private void MarkFormDirty() => Dirty.MarkDirty("create");

    private async Task HandleConfirmClose(CloseAction action)
    {
        _showConfirmClose = false;
        if (action == CloseAction.SaveAndClose)
            await CreateEquipment();
        else if (action == CloseAction.DiscardAndClose)
            CloseCreateDialog();
        // Cancel — do nothing
    }

    private void CloseCreateDialog()
    {
        _showCreate = false;
        Dirty.MarkClean("create");
    }

    private async Task CreateEquipment()
    {
        using var _ = WaitSvc.Show("저장 중...");
        await Api.CreateEquipmentAsync(new
        {
            _form.EquipmentId, _form.EquipmentName, _form.PlantId, _form.AreaId,
            _form.EquipmentType, _form.EquipmentClassId, _form.Vendor, _form.Model,
            Description = ""
        });
        CloseCreateDialog();
        await LoadData();
    }

    public void Dispose() => Dirty.StateChanged -= OnDirtyChanged;

    private sealed class EquipmentForm
    {
        public string EquipmentId      { get; set; } = string.Empty;
        public string EquipmentName    { get; set; } = string.Empty;
        public string PlantId          { get; set; } = string.Empty;
        public string AreaId           { get; set; } = string.Empty;
        public string EquipmentType    { get; set; } = string.Empty;
        public string EquipmentClassId { get; set; } = string.Empty;
        public string Vendor           { get; set; } = string.Empty;
        public string Model            { get; set; } = string.Empty;
    }
}
