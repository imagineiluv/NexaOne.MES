@page "/mdm/codes"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">코드 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateClassDialog">코드 클래스 등록</NexaButton>
</div>

<NexaConditionGrid TRow="CodeClassDto" Items="_classes">
    <ConditionPanel>
        <NexaButton OnClick="LoadClasses">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((CodeClassDto r) => r.Id)"            Title="클래스 ID" />
        <PropertyColumn Property="@((CodeClassDto r) => r.CodeClassName)" Title="클래스명" />
        <PropertyColumn Property="@((CodeClassDto r) => r.Description)"   Title="설명" />
        <TemplateColumn TGridItem="CodeClassDto" Title="">
            <NexaButton OnClick="@(() => SelectClass(context.Id))">코드 조회</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@if (_selectedClassId is not null)
{
    <div class="page-header" style="margin-top:2rem;">
        <h2 class="page-title" style="font-size:1.1rem;">코드 목록 — @_selectedClassId</h2>
        <NexaButton OnClick="OpenCreateCodeDialog">코드 등록</NexaButton>
    </div>

    <NexaConditionGrid TRow="CodeDto" Items="_codes">
        <ConditionPanel />
        <Columns>
            <PropertyColumn Property="@((CodeDto r) => r.Id)"        Title="코드 ID" />
            <PropertyColumn Property="@((CodeDto r) => r.CodeName)"  Title="코드명" />
            <PropertyColumn Property="@((CodeDto r) => r.SortOrder)" Title="순서" />
            <TemplateColumn TGridItem="CodeDto" Title="상태">
                <StatusBadge Value="@context.ValidState" />
            </TemplateColumn>
        </Columns>
    </NexaConditionGrid>
}

<NexaModal @bind-Visible="_showCreateClass" Title="코드 클래스 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_classForm.CodeClassId"   Placeholder="클래스 ID *" />
            <NexaTextBox @bind-Value="_classForm.CodeClassName" Placeholder="클래스명 *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateClass">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreateClass = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showCreateCode" Title="코드 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_codeForm.CodeId"   Placeholder="코드 ID *" />
            <NexaTextBox @bind-Value="_codeForm.CodeName" Placeholder="코드명 *" />
            <NexaNumberInput @bind-Value="_codeForm.SortOrder" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateCode">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreateCode = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<CodeClassDto> _classes  = new();
    private List<CodeDto>      _codes    = new();
    private string? _selectedClassId;

    private bool _showCreateClass;
    private ClassForm _classForm = new();

    private bool _showCreateCode;
    private CodeForm _codeForm = new();

    protected override async Task OnInitializedAsync() => await LoadClasses();

    private async Task LoadClasses() => _classes = await Api.GetCodeClassesAsync();

    private async Task SelectClass(string classId)
    {
        _selectedClassId = classId;
        _codes = await Api.GetCodesAsync(classId);
    }

    private void OpenCreateClassDialog() { _classForm = new(); _showCreateClass = true; }

    private async Task CreateClass()
    {
        await Api.CreateCodeClassAsync(new { _classForm.CodeClassId, CodeClassName = _classForm.CodeClassName });
        _showCreateClass = false;
        await LoadClasses();
    }

    private void OpenCreateCodeDialog() { _codeForm = new(); _showCreateCode = true; }

    private async Task CreateCode()
    {
        if (_selectedClassId is null) return;
        await Api.CreateCodeAsync(new
        {
            CodeId = _codeForm.CodeId, CodeClassId = _selectedClassId,
            CodeName = _codeForm.CodeName, SortOrder = _codeForm.SortOrder
        });
        _showCreateCode = false;
        _codes = await Api.GetCodesAsync(_selectedClassId);
    }

    private sealed class ClassForm
    {
        public string CodeClassId   { get; set; } = string.Empty;
        public string CodeClassName { get; set; } = string.Empty;
    }

    private sealed class CodeForm
    {
        public string CodeId    { get; set; } = string.Empty;
        public string CodeName  { get; set; } = string.Empty;
        public int    SortOrder { get; set; }
    }
}
