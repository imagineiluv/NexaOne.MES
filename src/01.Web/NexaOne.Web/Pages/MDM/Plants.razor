@page "/mdm/plants"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">Plant 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">Plant 등록</NexaButton>
</div>

<NexaConditionGrid TRow="PlantDto" Items="_items">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((PlantDto r) => r.Id)"          Title="Plant ID" />
        <PropertyColumn Property="@((PlantDto r) => r.PlantName)"   Title="Plant명" />
        <PropertyColumn Property="@((PlantDto r) => r.Country)"     Title="국가" />
        <PropertyColumn Property="@((PlantDto r) => r.TimeZone)"    Title="시간대" />
        <PropertyColumn Property="@((PlantDto r) => r.Description)" Title="설명" />
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="Plant 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.PlantId"   Placeholder="Plant ID *" />
            <NexaTextBox @bind-Value="_form.PlantName" Placeholder="Plant명 *" />
            <NexaTextBox @bind-Value="_form.Country"   Placeholder="국가 (예: KR)" />
            <NexaTextBox @bind-Value="_form.TimeZone"  Placeholder="시간대 (예: Asia/Seoul)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreatePlant">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<PlantDto> _items = new();
    private bool _showCreate;
    private PlantForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetPlantsAsync();

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task CreatePlant()
    {
        await Api.CreatePlantAsync(new { _form.PlantId, PlantName = _form.PlantName, _form.Country, _form.TimeZone });
        _showCreate = false;
        await LoadData();
    }

    private sealed class PlantForm
    {
        public string PlantId   { get; set; } = string.Empty;
        public string PlantName { get; set; } = string.Empty;
        public string Country   { get; set; } = "KR";
        public string TimeZone  { get; set; } = "Asia/Seoul";
    }
}
