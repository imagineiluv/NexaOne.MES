@page "/rms/approval"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext
@inject WaitOverlayService WaitSvc

<div class="page-header">
    <h1 class="page-title">레시피 승인 대기</h1>
</div>

<div class="rms-approval-legend">
    <span class="rms-legend-item">
        <StatusBadge Value="WaitApproval" /> → 1차 승인 대기
    </span>
    <span class="rms-legend-item">
        <StatusBadge Value="Approved1" /> → 2차 승인 대기
    </span>
    <span class="rms-legend-item">
        <StatusBadge Value="Approved" /> → 릴리스 대기
    </span>
</div>

<NexaConditionGrid TRow="RecipeDto" Items="_pending">
    <ConditionPanel>
        <NexaButton OnClick="LoadData">새로 고침</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((RecipeDto r) => r.Id)"               Title="레시피 ID" />
        <PropertyColumn Property="@((RecipeDto r) => r.RecipeName)"       Title="레시피명" />
        <PropertyColumn Property="@((RecipeDto r) => r.EquipmentClassId)" Title="설비 클래스" />
        <PropertyColumn Property="@((RecipeDto r) => r.Version)"          Title="버전" />
        <TemplateColumn TGridItem="RecipeDto" Title="상태">
            <StatusBadge Value="@context.ApprovalState" />
        </TemplateColumn>
        <PropertyColumn Property="@((RecipeDto r) => r.FirstApproverId)"  Title="1차 승인자" />
        <TemplateColumn TGridItem="RecipeDto" Title="">
            <div style="display:flex; gap:4px;">
                <NexaButton OnClick="@(() => OpenWorkflowDialog(context))">워크플로우</NexaButton>
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@if (_showWorkflow && _selected is not null)
{
    var actionLabel = _selected.ApprovalState switch
    {
        "WaitApproval" => "1차 승인",
        "Approved1"    => "2차 승인",
        "Approved"     => "릴리스",
        _              => "처리"
    };

    <NexaModal @bind-Visible="_showWorkflow"
             Title="@($"승인 워크플로우 — {_selected.RecipeName}")">
        <ChildContent>
            <div class="rms-workflow-detail">
                <div class="rms-workflow-info-row">
                    <span class="label">레시피 ID</span><span>@_selected.Id</span>
                </div>
                <div class="rms-workflow-info-row">
                    <span class="label">설비 클래스</span><span>@_selected.EquipmentClassId</span>
                </div>
                <div class="rms-workflow-info-row">
                    <span class="label">버전</span><span>v@(_selected.Version)</span>
                </div>

                <div class="rms-workflow-steps" style="margin:1.5rem 0;">
                    @foreach (var (step, idx) in _workflowSteps.Select((s, i) => (s, i)))
                    {
                        var currentIdx = _workflowSteps.IndexOf(_selected.ApprovalState);
                        var cls = idx < currentIdx ? "done" : idx == currentIdx ? "current" : "pending";
                        var approver = idx == 3 ? _selected.FirstApproverId
                                     : idx == 4 ? _selected.SecondApproverId
                                     : null;
                        <div class="rms-step-group">
                            <div class="rms-step @cls">
                                <div class="rms-step-dot">@(idx < currentIdx ? "✓" : (idx + 1).ToString())</div>
                                <div class="rms-step-label">@step</div>
                                @if (approver is not null)
                                {
                                    <div class="rms-step-approver">@approver</div>
                                }
                            </div>
                            @if (idx < _workflowSteps.Count - 1)
                            {
                                <div class="rms-step-connector @(idx < currentIdx ? "done" : "pending")">→</div>
                            }
                        </div>
                    }
                </div>

                <div class="rms-workflow-action">
                    @if (_selected.ApprovalState is "WaitApproval" or "Approved1")
                    {
                        <label class="form-label">담당자 ID (자동: @_currentUserId)</label>
                        <NexaTextBox @bind-Value="_actionUserId"
                                   Placeholder="@($"{_currentUserId} (미입력 시 자동 사용)")" />
                    }
                    @if (!string.IsNullOrEmpty(_workflowError))
                    {
                        <div class="text-danger small mt-2">@_workflowError</div>
                    }
                </div>
            </div>
        </ChildContent>
        <Footer>
            <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                      OnClick="ConfirmWorkflowAction">@actionLabel</NexaButton>
            <NexaButton Variant="NexaButton.ButtonVariant.Danger" Class="ms-2"
                      OnClick="@(() => _showRejectInline = true)">거부</NexaButton>
            <NexaButton OnClick="@(() => _showWorkflow = false)" Class="ms-2">닫기</NexaButton>
        </Footer>
    </NexaModal>
}

@if (_showRejectInline && _selected is not null)
{
    <NexaModal @bind-Visible="_showRejectInline" Title="거부 확인">
        <ChildContent>
            <div style="display:flex; flex-direction:column; gap:.75rem; padding:.5rem;">
                <div class="text-muted small">@_selected.RecipeName (v@(_selected.Version))을 거부합니다.</div>
                <NexaTextArea @bind-Value="_rejectReason" Rows="3" Placeholder="거부 사유 *" />
            </div>
        </ChildContent>
        <Footer>
            <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="ConfirmReject">거부 확인</NexaButton>
            <NexaButton OnClick="@(() => _showRejectInline = false)" Class="ms-2">취소</NexaButton>
        </Footer>
    </NexaModal>
}

@code {
    private List<RecipeDto> _pending = [];
    private RecipeDto? _selected;
    private string _currentUserId = string.Empty;
    private string _actionUserId  = string.Empty;
    private string _workflowError = string.Empty;
    private string _rejectReason  = string.Empty;

    private bool _showWorkflow;
    private bool _showRejectInline;

    private static readonly List<string> _workflowSteps =
        ["Draft", "승인 요청", "1차 승인", "2차 승인", "릴리스"];
    private static readonly List<string> _stateOrder =
        ["Draft", "WaitApproval", "Approved1", "Approved", "Released"];

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        using var _ = WaitSvc.Show("조회 중...");
        var wait      = await Api.GetRecipesAsync(state: "WaitApproval");
        var approved1 = await Api.GetRecipesAsync(state: "Approved1");
        var approved  = await Api.GetRecipesAsync(state: "Approved");
        _pending = [..wait, ..approved1, ..approved];
    }

    private void OpenWorkflowDialog(RecipeDto recipe)
    {
        _selected      = recipe;
        _actionUserId  = string.Empty;
        _workflowError = string.Empty;
        _rejectReason  = string.Empty;
        _showWorkflow  = true;
    }

    private async Task ConfirmWorkflowAction()
    {
        if (_selected is null) return;
        _workflowError = string.Empty;

        var userId = string.IsNullOrWhiteSpace(_actionUserId) ? _currentUserId : _actionUserId;
        if (string.IsNullOrWhiteSpace(userId))
        {
            _workflowError = "담당자 ID를 확인할 수 없습니다."; return;
        }

        using var _ = WaitSvc.Show("처리 중...");

        if (_selected.ApprovalState == "WaitApproval")
            await Api.ApproveRecipe1Async(_selected.Id, userId);
        else if (_selected.ApprovalState == "Approved1")
            await Api.ApproveRecipe2Async(_selected.Id, userId);
        else if (_selected.ApprovalState == "Approved")
            await Api.ReleaseRecipeAsync(_selected.Id, userId);

        _showWorkflow = false;
        await LoadData();
    }

    private async Task ConfirmReject()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_rejectReason)) return;
        using var _ = WaitSvc.Show("처리 중...");
        await Api.RejectRecipeAsync(_selected.Id, _rejectReason);
        _showRejectInline = false;
        _showWorkflow     = false;
        await LoadData();
    }
}
