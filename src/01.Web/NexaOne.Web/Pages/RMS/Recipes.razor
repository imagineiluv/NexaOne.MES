@page "/rms/recipes"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext
@inject WaitOverlayService WaitSvc

<div class="page-header">
    <h1 class="page-title">레시피 관리</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">레시피 등록</NexaButton>
</div>

<NexaConditionGrid TRow="RecipeDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_classId" Placeholder="설비 클래스 ID" />
        <NexaSelect TValue="string" @bind-Value="_stateFilter">
            <option value="">상태 전체</option>
            @foreach (var s in _states)
            {
                <option value="@s">@s</option>
            }
        </NexaSelect>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((RecipeDto r) => r.Id)"               Title="레시피 ID" />
        <PropertyColumn Property="@((RecipeDto r) => r.RecipeName)"       Title="레시피명" />
        <PropertyColumn Property="@((RecipeDto r) => r.EquipmentClassId)" Title="설비 클래스" />
        <PropertyColumn Property="@((RecipeDto r) => r.Version)"          Title="버전" />
        <TemplateColumn TGridItem="RecipeDto" Title="승인 상태">
            <StatusBadge Value="@context.ApprovalState" />
        </TemplateColumn>
        <PropertyColumn Property="@((RecipeDto r) => r.FirstApproverId)"  Title="1차 승인자" />
        <PropertyColumn Property="@((RecipeDto r) => r.SecondApproverId)" Title="2차 승인자" />
        <PropertyColumn Property="@((RecipeDto r) => r.ReleasedAt)"       Title="릴리스일" Format="yyyy-MM-dd" />
        <TemplateColumn TGridItem="RecipeDto" Title="">
            <div style="display:flex; gap:3px; flex-wrap:wrap;">
                <NexaButton OnClick="@(() => OpenParamPanel(context.Id))">파라미터</NexaButton>
                @if (context.ApprovalState == "Draft")
                {
                    <NexaButton OnClick="@(() => RequestApproval(context.Id))">승인 요청</NexaButton>
                }
                @if (context.ApprovalState == "WaitApproval")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                                OnClick="@(() => OpenApproveDialog(context, 1))">1차 승인</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                                OnClick="@(() => OpenRejectDialog(context.Id))">거부</NexaButton>
                }
                @if (context.ApprovalState == "Approved1")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                                OnClick="@(() => OpenApproveDialog(context, 2))">2차 승인</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                                OnClick="@(() => OpenRejectDialog(context.Id))">거부</NexaButton>
                }
                @if (context.ApprovalState == "Approved")
                {
                    <NexaButton OnClick="@(() => OpenApproveDialog(context, 3))">릴리스</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger"
                                OnClick="@(() => OpenRejectDialog(context.Id))">거부</NexaButton>
                }
                @if (context.ApprovalState == "Released")
                {
                    <NexaButton OnClick="@(() => OpenNewVersionDialog(context.Id, context.Version))">새 버전</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@* ── 레시피 등록 ──────────────────────────────────────────────── *@
<NexaModal @bind-Visible="_showCreate" Title="레시피 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.RecipeId"         Placeholder="레시피 ID *" />
            <NexaTextBox @bind-Value="_form.Name"             Placeholder="레시피명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentClassId" Placeholder="설비 클래스 ID *" />
            <NexaTextBox @bind-Value="_form.Description"      Placeholder="설명" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div class="text-danger small">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateRecipe">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@* ── 승인 / 릴리스 ────────────────────────────────────────────── *@
@{
    var title = _approveStep switch { 1 => "1차 승인", 2 => "2차 승인", _ => "릴리스 확인" };
}
<NexaModal @bind-Visible="_showApprove" Title="@title">
    <ChildContent>
        @if (_approveTarget is not null)
        {
            <div class="rms-approve-dialog">
                <div class="rms-approve-recipe">
                    <span class="label">레시피</span>
                    <span>@_approveTarget.RecipeName (v@(_approveTarget.Version))</span>
                </div>
                <div class="rms-approve-recipe">
                    <span class="label">현재 상태</span>
                    <StatusBadge Value="@_approveTarget.ApprovalState" />
                </div>
                <div class="rms-workflow-steps">
                    @foreach (var step in _workflowSteps)
                    {
                        var idx = _workflowSteps.IndexOf(step);
                        var currentIdx = _workflowSteps.IndexOf(_approveTarget.ApprovalState);
                        var cls = idx < currentIdx ? "done" : idx == currentIdx ? "current" : "pending";
                        <div class="rms-step @cls">
                            <div class="rms-step-dot"></div>
                            <div class="rms-step-label">@step</div>
                        </div>
                        @if (idx < _workflowSteps.Count - 1)
                        {
                            <div class="rms-step-line @(idx < currentIdx ? "done" : "pending")"></div>
                        }
                    }
                </div>
                @if (_approveStep < 3)
                {
                    <NexaTextBox @bind-Value="_approverId" Placeholder="담당자 ID *" />
                }
                @if (!string.IsNullOrEmpty(_approveError))
                {
                    <div class="text-danger small">@_approveError</div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmApprove">@title</NexaButton>
        <NexaButton OnClick="@(() => _showApprove = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@* ── 거부 ─────────────────────────────────────────────────────── *@
<NexaModal @bind-Visible="_showReject" Title="레시피 거부">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <div class="text-muted small">거부 사유를 입력하면 레시피가 Rejected 상태로 변경됩니다.</div>
            <NexaTextArea @bind-Value="_rejectReason" Rows="3" Placeholder="거부 사유 *" />
            @if (!string.IsNullOrEmpty(_rejectError))
            {
                <div class="text-danger small">@_rejectError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="ConfirmReject">거부 확인</NexaButton>
        <NexaButton OnClick="@(() => _showReject = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@* ── 새 버전 ──────────────────────────────────────────────────── *@
<NexaModal @bind-Visible="_showNewVersion" Title="새 버전 생성">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_newVersionId" Placeholder="새 레시피 ID *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmNewVersion">생성</NexaButton>
        <NexaButton OnClick="@(() => _showNewVersion = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@* ── 파라미터 팝업 ─────────────────────────────────────────────── *@
<NexaModal @bind-Visible="_showParams" Title="@($"레시피 파라미터 — {_paramRecipeId}")" CloseOnOverlayClick="true">
    <div class="page-header" style="margin-bottom:.75rem;">
        <span></span>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                    OnClick="OpenAddParamDialog">파라미터 추가</NexaButton>
    </div>
    <QuickGrid TGridItem="RecipeParamDto" Items="@(_params.AsQueryable())" Pagination="_paramsPg" Class="nexa-grid w-full text-sm">
        <PropertyColumn Property="@((RecipeParamDto p) => p.ParamName)"  Title="파라미터명" />
        <PropertyColumn Property="@((RecipeParamDto p) => p.ParamValue)" Title="값" />
        <PropertyColumn Property="@((RecipeParamDto p) => p.Unit)"       Title="단위" />
        <PropertyColumn Property="@((RecipeParamDto p) => p.SortOrder)"  Title="순서" />
        <TemplateColumn TGridItem="RecipeParamDto" Title="">
            <NexaButton OnClick="@(() => OpenEditParamDialog(context))">편집</NexaButton>
            <NexaButton Variant="NexaButton.ButtonVariant.Danger" Class="ms-1"
                        OnClick="@(() => DeleteParam(context.Id))">삭제</NexaButton>
        </TemplateColumn>
    </QuickGrid>
    <Paginator State="_paramsPg" />
</NexaModal>

@* ── 파라미터 추가/편집 ────────────────────────────────────────── *@
<NexaModal @bind-Visible="_showParamEdit"
           Title="@(_editingParam is null ? "파라미터 추가" : "파라미터 편집")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            @if (_editingParam is null)
            {
                <NexaTextBox @bind-Value="_paramForm.ParamId"   Placeholder="파라미터 ID *" />
                <NexaTextBox @bind-Value="_paramForm.ParamName" Placeholder="파라미터명 *" />
                <NexaTextBox @bind-Value="_paramForm.Unit"      Placeholder="단위 (예: ℃, rpm)" />
                <NexaNumberInput @bind-Value="_paramForm.SortOrder" Placeholder="순서" />
            }
            <NexaTextBox @bind-Value="_paramForm.ParamValue" Placeholder="값 *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="SaveParam">저장</NexaButton>
        <NexaButton OnClick="@(() => _showParamEdit = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<RecipeDto>      _items  = new();
    private List<RecipeParamDto> _params = new();
    private readonly PaginationState _paramsPg = new() { ItemsPerPage = 20 };
    private string  _classId     = string.Empty;
    private string? _stateFilter;
    private string? _createError;

    // approve
    private bool _showApprove;
    private RecipeDto? _approveTarget;
    private int    _approveStep;
    private string _approverId  = string.Empty;
    private string _approveError = string.Empty;

    // reject
    private bool   _showReject;
    private string? _rejectRecipeId;
    private string  _rejectReason = string.Empty;
    private string  _rejectError  = string.Empty;

    // new version
    private bool   _showNewVersion;
    private string? _newVersionSourceId;
    private string  _newVersionId = string.Empty;

    // create
    private bool       _showCreate;
    private RecipeForm _form = new();

    // params
    private bool   _showParams;
    private bool   _showParamEdit;
    private string? _paramRecipeId;
    private RecipeParamDto? _editingParam;
    private ParamForm _paramForm = new();

    private static readonly List<string> _states =
        ["Draft", "WaitApproval", "Approved1", "Approved", "Released", "Rejected"];
    private static readonly List<string> _workflowSteps =
        ["Draft", "WaitApproval", "Approved1", "Approved", "Released"];

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        using var _ = WaitSvc.Show("조회 중...");
        _items = await Api.GetRecipesAsync(_classId, _stateFilter);
    }

    private void OpenCreateDialog() { _form = new(); _createError = null; _showCreate = true; }

    private async Task CreateRecipe()
    {
        _createError = null;
        using var _ = WaitSvc.Show("저장 중...");
        var result = await Api.CreateRecipeAsync(new
        {
            RecipeId = _form.RecipeId, Name = _form.Name,
            Description = _form.Description, EquipmentClassId = _form.EquipmentClassId
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await LoadData();
    }

    private async Task RequestApproval(string recipeId)
    {
        using var _ = WaitSvc.Show("처리 중...");
        await Api.RequestRecipeApprovalAsync(recipeId);
        await LoadData();
    }

    private void OpenApproveDialog(RecipeDto recipe, int step)
    {
        _approveTarget = recipe;
        _approveStep   = step;
        _approverId    = string.Empty;
        _approveError  = string.Empty;
        _showApprove   = true;
    }

    private async Task ConfirmApprove()
    {
        if (_approveTarget is null) return;
        if (_approveStep < 3 && string.IsNullOrWhiteSpace(_approverId))
        {
            _approveError = "담당자 ID를 입력하세요."; return;
        }
        _approveError = string.Empty;
        using var _ = WaitSvc.Show("처리 중...");

        if (_approveStep == 1)
            await Api.ApproveRecipe1Async(_approveTarget.Id, _approverId);
        else if (_approveStep == 2)
            await Api.ApproveRecipe2Async(_approveTarget.Id, _approverId);
        else
        {
            var userId = _approverId;
            if (string.IsNullOrWhiteSpace(userId))
                userId = await AuthContext.GetUserIdAsync() ?? "SYSTEM";
            await Api.ReleaseRecipeAsync(_approveTarget.Id, userId);
        }

        _showApprove = false;
        await LoadData();
    }

    private void OpenRejectDialog(string recipeId)
    {
        _rejectRecipeId = recipeId;
        _rejectReason   = string.Empty;
        _rejectError    = string.Empty;
        _showReject     = true;
    }

    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) { _rejectError = "거부 사유를 입력하세요."; return; }
        _rejectError = string.Empty;
        using var _ = WaitSvc.Show("처리 중...");
        await Api.RejectRecipeAsync(_rejectRecipeId!, _rejectReason);
        _showReject = false;
        await LoadData();
    }

    private void OpenNewVersionDialog(string recipeId, int currentVersion)
    {
        _newVersionSourceId = recipeId;
        _newVersionId       = $"{recipeId}_v{currentVersion + 1}";
        _showNewVersion     = true;
    }

    private async Task ConfirmNewVersion()
    {
        if (string.IsNullOrWhiteSpace(_newVersionId) || _newVersionSourceId is null) return;
        using var _ = WaitSvc.Show("처리 중...");
        await Api.CreateRecipeVersionAsync(_newVersionSourceId, _newVersionId);
        _showNewVersion = false;
        await LoadData();
    }

    // ── Params ────────────────────────────────────────────────────────────────

    private async Task OpenParamPanel(string recipeId)
    {
        _paramRecipeId = recipeId;
        using var _ = WaitSvc.Show("조회 중...");
        _params = await Api.GetRecipeParamsAsync(recipeId);
        _showParams = true;
    }

    private void OpenAddParamDialog()
    {
        _editingParam = null;
        _paramForm    = new ParamForm { SortOrder = _params.Count + 1 };
        _showParamEdit = true;
    }

    private void OpenEditParamDialog(RecipeParamDto p)
    {
        _editingParam = p;
        _paramForm    = new ParamForm { ParamId = p.Id, ParamName = p.ParamName, ParamValue = p.ParamValue, Unit = p.Unit, SortOrder = p.SortOrder };
        _showParamEdit = true;
    }

    private async Task SaveParam()
    {
        if (_paramRecipeId is null) return;
        using var _ = WaitSvc.Show("저장 중...");

        if (_editingParam is null)
        {
            await Api.AddRecipeParamAsync(_paramRecipeId, new
            {
                ParamId    = _paramForm.ParamId,
                ParamName  = _paramForm.ParamName,
                ParamValue = _paramForm.ParamValue,
                Unit       = _paramForm.Unit,
                SortOrder  = _paramForm.SortOrder
            });
        }
        else
        {
            await Api.UpdateRecipeParamAsync(_editingParam.Id, _paramForm.ParamValue);
        }

        _showParamEdit = false;
        _params = await Api.GetRecipeParamsAsync(_paramRecipeId);
    }

    private async Task DeleteParam(string paramId)
    {
        using var _ = WaitSvc.Show("삭제 중...");
        await Api.DeleteRecipeParamAsync(paramId);
        if (_paramRecipeId is not null)
            _params = await Api.GetRecipeParamsAsync(_paramRecipeId);
    }

    private sealed class RecipeForm
    {
        public string RecipeId         { get; set; } = string.Empty;
        public string Name             { get; set; } = string.Empty;
        public string EquipmentClassId { get; set; } = string.Empty;
        public string Description      { get; set; } = string.Empty;
    }

    private sealed class ParamForm
    {
        public string ParamId    { get; set; } = string.Empty;
        public string ParamName  { get; set; } = string.Empty;
        public string ParamValue { get; set; } = string.Empty;
        public string Unit       { get; set; } = string.Empty;
        public int    SortOrder  { get; set; }
    }
}
