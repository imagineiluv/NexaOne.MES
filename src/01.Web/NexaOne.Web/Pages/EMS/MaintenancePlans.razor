@page "/ems/maintenance-plans"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">보전 계획</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">보전 계획 생성</NexaButton>
</div>

<NexaConditionGrid TRow="MaintenancePlanDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaSelect TValue="string" @bind-Value="_statusFilter"><option value="">상태 전체</option>@foreach (var x in _statuses) { <option value="@x">@x</option> }</NexaSelect>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.Id)"                     Title="계획 ID" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.PlanName)"               Title="계획명" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.EquipmentId)"            Title="설비" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.PlanType)"               Title="유형" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.CycleType)"              Title="주기" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.ScheduledDate)"          Title="예정일" Format="yyyy-MM-dd" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.EstimatedDurationHours)" Title="예상 시간(h)" />
        <PropertyColumn Property="@((MaintenancePlanDto r) => r.AssigneeId)"             Title="담당자" />
        <TemplateColumn TGridItem="MaintenancePlanDto" Title="상태">
            <StatusBadge Value="@context.Status" />
        </TemplateColumn>
        <TemplateColumn TGridItem="MaintenancePlanDto" Title="">
            <div style="display:flex; gap:4px;">
                @if (context.Status == "Planned")
                {
                    <NexaButton OnClick="@(() => StartPlan(context.Id))">시작</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelPlan(context.Id))">취소</NexaButton>
                }
                @if (context.Status == "InProgress")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="@(() => CompletePlan(context.Id))">완료</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelPlan(context.Id))">취소</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="보전 계획 생성">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.PlanId"        Placeholder="계획 ID *" />
            <NexaTextBox @bind-Value="_form.PlanName"      Placeholder="계획명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentId"   Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.PlanType"      Placeholder="유형 (예: PM, CM)" />
            <NexaTextBox @bind-Value="_form.CycleType"     Placeholder="주기 (예: Monthly, Weekly)" />
            <NexaDateInput @bind-Value="_form.ScheduledDate" />
            <NexaNumberInput @bind-Value="_form.EstimatedDurationHours" Step="0.5" Placeholder="예상 시간(h) *" />
            <NexaTextBox @bind-Value="_form.AssigneeId"    Placeholder="담당자 ID *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreatePlan">생성</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<MaintenancePlanDto> _items = new();
    private string _equipmentId = string.Empty;
    private string? _statusFilter;
    private bool _showCreate;
    private PlanForm _form = new();
    private string _currentUserId = string.Empty;

    private static readonly List<string> _statuses = new() { "Planned", "InProgress", "Completed", "Cancelled" };

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData() => _items = await Api.GetMaintenancePlansAsync(_equipmentId);

    private void OpenCreateDialog()
    {
        _form = new() { AssigneeId = _currentUserId, ScheduledDate = DateTime.Today };
        _showCreate = true;
    }

    private async Task CreatePlan()
    {
        await Api.CreateMaintenancePlanAsync(new
        {
            PlanId = _form.PlanId, PlanName = _form.PlanName, EquipmentId = _form.EquipmentId,
            PlanType = _form.PlanType, CycleType = _form.CycleType,
            ScheduledDate = _form.ScheduledDate, EstimatedDurationHours = _form.EstimatedDurationHours,
            AssigneeId = _form.AssigneeId
        });
        _showCreate = false;
        await LoadData();
    }

    private async Task StartPlan(string id)    { await Api.StartMaintenancePlanAsync(id);    await LoadData(); }
    private async Task CompletePlan(string id) { await Api.CompleteMaintenancePlanAsync(id); await LoadData(); }
    private async Task CancelPlan(string id)   { await Api.CancelMaintenancePlanAsync(id);   await LoadData(); }

    private sealed class PlanForm
    {
        public string   PlanId                 { get; set; } = string.Empty;
        public string   PlanName               { get; set; } = string.Empty;
        public string   EquipmentId            { get; set; } = string.Empty;
        public string   PlanType               { get; set; } = string.Empty;
        public string   CycleType              { get; set; } = string.Empty;
        public DateTime ScheduledDate          { get; set; } = DateTime.Today;
        public decimal  EstimatedDurationHours { get; set; }
        public string   AssigneeId             { get; set; } = string.Empty;
    }
}
