@page "/ems/spare-parts"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">예비품 관리</h1>
    <div style="display:flex; gap:0.5rem;">
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">예비품 등록</NexaButton>
        <NexaButton Variant="@(_showLowStock ? NexaButton.ButtonVariant.Danger : NexaButton.ButtonVariant.Secondary)"
                  OnClick="ToggleLowStock">부족재고만 보기</NexaButton>
    </div>
</div>

<NexaConditionGrid TRow="SparePartDto" Items="_items">
    <Columns>
        <PropertyColumn Property="@((SparePartDto r) => r.Id)"            Title="품목 ID" />
        <PropertyColumn Property="@((SparePartDto r) => r.PartName)"      Title="품명" />
        <PropertyColumn Property="@((SparePartDto r) => r.PartNumber)"    Title="품번" />
        <PropertyColumn Property="@((SparePartDto r) => r.UnitOfMeasure)" Title="단위" />
        <PropertyColumn Property="@((SparePartDto r) => r.CurrentStock)"  Title="현재고" />
        <PropertyColumn Property="@((SparePartDto r) => r.MinStock)"      Title="최소재고" />
        <PropertyColumn Property="@((SparePartDto r) => r.MaxStock)"      Title="최대재고" />
        <PropertyColumn Property="@((SparePartDto r) => r.Location)"      Title="보관위치" />
        <TemplateColumn TGridItem="SparePartDto" Title="재고부족">
            <StatusBadge Value="@(context.IsLowStock ? "LowStock" : "OK")" />
        </TemplateColumn>
        <TemplateColumn TGridItem="SparePartDto" Title="">
            <NexaButton OnClick="@(() => OpenAdjustDialog(context))">재고 조정</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="예비품 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.PartId"        Placeholder="품목 ID *" />
            <NexaTextBox @bind-Value="_form.PartName"      Placeholder="품명 *" />
            <NexaTextBox @bind-Value="_form.PartNumber"    Placeholder="품번 *" />
            <NexaTextBox @bind-Value="_form.Description"   Placeholder="설명" />
            <NexaTextBox @bind-Value="_form.UnitOfMeasure" Placeholder="단위 (예: EA, KG)" />
            <NexaNumberInput @bind-Value="_form.CurrentStock" MinValue="0" Step="1m" Placeholder="현재 재고 *" />
            <NexaNumberInput @bind-Value="_form.MinStock"     MinValue="0" Step="1m" Placeholder="최소 재고 *" />
            <NexaNumberInput @bind-Value="_form.MaxStock"     MinValue="0" Step="1m" Placeholder="최대 재고 *" />
            <NexaTextBox @bind-Value="_form.Location"      Placeholder="보관위치 *" />
            <NexaTextBox @bind-Value="_form.EquipmentClassId" Placeholder="설비 분류 ID (선택)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreatePart">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showAdjust" Title="@($"재고 조정 — {_adjustPartName}")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <p>현재 재고: <strong>@_adjustCurrentStock</strong></p>
            <NexaNumberInput @bind-Value="_adjustDelta" Step="1m" Placeholder="조정 수량 (음수=출고, 양수=입고) *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmAdjust">적용</NexaButton>
        <NexaButton OnClick="@(() => _showAdjust = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<SparePartDto> _items = new();
    private bool _showLowStock;
    private bool _showCreate;
    private PartForm _form = new();
    private bool _showAdjust;
    private string _adjustPartId = string.Empty;
    private string _adjustPartName = string.Empty;
    private decimal _adjustCurrentStock;
    private decimal _adjustDelta;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetSparePartsAsync(_showLowStock);

    private async Task ToggleLowStock()
    {
        _showLowStock = !_showLowStock;
        await LoadData();
    }

    private void OpenCreateDialog() { _form = new(); _showCreate = true; }

    private async Task CreatePart()
    {
        await Api.CreateSparePartAsync(new
        {
            PartId = _form.PartId, PartName = _form.PartName, PartNumber = _form.PartNumber,
            Description = _form.Description, UnitOfMeasure = _form.UnitOfMeasure,
            CurrentStock = _form.CurrentStock, MinStock = _form.MinStock, MaxStock = _form.MaxStock,
            Location = _form.Location, EquipmentClassId = string.IsNullOrEmpty(_form.EquipmentClassId) ? null : _form.EquipmentClassId
        });
        _showCreate = false;
        await LoadData();
    }

    private void OpenAdjustDialog(SparePartDto part)
    {
        _adjustPartId = part.Id;
        _adjustPartName = part.PartName;
        _adjustCurrentStock = part.CurrentStock;
        _adjustDelta = 0;
        _showAdjust = true;
    }

    private async Task ConfirmAdjust()
    {
        await Api.AdjustStockAsync(_adjustPartId, _adjustDelta);
        _showAdjust = false;
        await LoadData();
    }

    private sealed class PartForm
    {
        public string  PartId          { get; set; } = string.Empty;
        public string  PartName        { get; set; } = string.Empty;
        public string  PartNumber      { get; set; } = string.Empty;
        public string  Description     { get; set; } = string.Empty;
        public string  UnitOfMeasure   { get; set; } = string.Empty;
        public decimal CurrentStock    { get; set; }
        public decimal MinStock        { get; set; }
        public decimal MaxStock        { get; set; }
        public string  Location        { get; set; } = string.Empty;
        public string? EquipmentClassId { get; set; }
    }
}
