@page "/pom/lot-tracking"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">생산 추적 보고서</h1>
</div>

<NexaConditionGrid TRow="LotHistoryDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_lotId"       Placeholder="Lot ID" />
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaTextBox @bind-Value="_processId"   Placeholder="공정 ID" />
        <NexaDateInput @bind-Value="_from" />
        <NexaDateInput @bind-Value="_to" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((LotHistoryDto r) => r.LotId)"         Title="Lot ID" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.ProcessId)"     Title="공정" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.EquipmentId)"   Title="설비" />
        <TemplateColumn TGridItem="LotHistoryDto" Title="구분">
            <StatusBadge Value="@context.ExecutionId" />
        </TemplateColumn>
        <PropertyColumn Property="@((LotHistoryDto r) => r.TrackInTime)"   Title="Track In"  Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.TrackOutTime)"  Title="Track Out" Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.Qty)"           Title="수량"      Format="N1" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.DefectQty)"     Title="불량"      Format="N1" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.LotState)"      Title="Lot 상태" />
        <PropertyColumn Property="@((LotHistoryDto r) => r.ExecutionUser)" Title="작업자" />
        <TemplateColumn TGridItem="LotHistoryDto" Title="">
            <NexaButton OnClick="@(() => ShowRoute(context.LotId))">경로</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@if (_showRoute && _route is not null)
{
    <NexaModal @bind-Visible="_showRoute" Title="@($"Lot 경로 — {_route.Lot.Id}")">
        <ChildContent>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <div>
                    <strong>공정 경로:</strong>
                    @for (var i = 0; i < _route.Lot.RouteSteps.Count; i++)
                    {
                        var step = _route.Lot.RouteSteps[i];
                        var isCurrent = i == _route.Lot.CurrentStepIndex && _route.Lot.State != "Completed";
                        <span style="@(isCurrent ? "font-weight:bold; color:var(--bs-primary);" : "")">
                            @step@(i < _route.Lot.RouteSteps.Count - 1 ? " > " : "")
                        </span>
                    }
                    <StatusBadge Value="@_route.Lot.State" />
                </div>

                <strong>이력</strong>
                <QuickGrid TGridItem="LotHistoryDto" Items="@(_route.Histories.AsQueryable())" Pagination="_historyPg" Class="nexa-grid w-full text-sm">
                    <PropertyColumn Property="@((LotHistoryDto r) => r.ProcessId)"    Title="공정" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.EquipmentId)"  Title="설비" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.ExecutionId)"  Title="구분" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.TrackInTime)"  Title="Track In"  Format="MM-dd HH:mm" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.TrackOutTime)" Title="Track Out" Format="MM-dd HH:mm" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.Qty)"          Title="수량"      Format="N1" />
                    <PropertyColumn Property="@((LotHistoryDto r) => r.DefectQty)"    Title="불량"      Format="N1" />
                </QuickGrid>
                <Paginator State="_historyPg" />

                @if (_route.MixingInputs.Count > 0)
                {
                    <strong>Mixing 투입 Lot</strong>
                    <QuickGrid TGridItem="LotMixingRelationDto" Items="@(_route.MixingInputs.AsQueryable())" Pagination="_mixingPg" Class="nexa-grid w-full text-sm">
                        <PropertyColumn Property="@((LotMixingRelationDto r) => r.InputLotId)" Title="투입 Lot" />
                        <PropertyColumn Property="@((LotMixingRelationDto r) => r.InputQty)"   Title="투입 수량" Format="N1" />
                        <PropertyColumn Property="@((LotMixingRelationDto r) => r.MixingRate)" Title="배합 비율" Format="P1" />
                        <PropertyColumn Property="@((LotMixingRelationDto r) => r.ConsumedBy)" Title="작업자" />
                    </QuickGrid>
                    <Paginator State="_mixingPg" />
                }
            </div>
        </ChildContent>
        <Footer>
            <NexaButton OnClick="@(() => _showRoute = false)">닫기</NexaButton>
        </Footer>
    </NexaModal>
}

@code {
    private List<LotHistoryDto> _items = new();
    private string _plantId = string.Empty;
    private string _lotId = string.Empty;
    private string _equipmentId = string.Empty;
    private string _processId = string.Empty;
    private DateTime? _from;
    private DateTime? _to;

    private bool _showRoute;
    private readonly PaginationState _historyPg = new() { ItemsPerPage = 10 };
    private readonly PaginationState _mixingPg = new() { ItemsPerPage = 5 };
    private LotRouteDto? _route;

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData()
        => _items = await Api.GetLotTrackingReportAsync(
            _plantId, _lotId, _equipmentId, _processId,
            _from, _to?.Date.AddDays(1).AddTicks(-1));

    private async Task ShowRoute(string lotId)
    {
        _route = await Api.GetLotRouteAsync(lotId);
        _showRoute = _route is not null;
    }
}
