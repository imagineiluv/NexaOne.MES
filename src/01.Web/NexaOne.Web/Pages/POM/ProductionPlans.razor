@page "/pom/plans"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">생산 계획</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">계획 등록</NexaButton>
</div>

<NexaConditionGrid TRow="ProductionPlanDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_plantId" Placeholder="Plant ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((ProductionPlanDto r) => r.Id)"               Title="계획 ID" />
        <PropertyColumn Property="@((ProductionPlanDto r) => r.PlanName)"         Title="계획명" />
        <PropertyColumn Property="@((ProductionPlanDto r) => r.ProductId)"        Title="제품" />
        <PropertyColumn Property="@((ProductionPlanDto r) => r.PlannedQty)"       Title="계획 수량"    Format="N0" />
        <PropertyColumn Property="@((ProductionPlanDto r) => r.PlannedStartDate)" Title="시작일"       Format="yyyy-MM-dd" />
        <PropertyColumn Property="@((ProductionPlanDto r) => r.PlannedEndDate)"   Title="종료일"       Format="yyyy-MM-dd" />
        <TemplateColumn TGridItem="ProductionPlanDto" Title="상태">
            <StatusBadge Value="@context.Status" />
        </TemplateColumn>
        <TemplateColumn TGridItem="ProductionPlanDto" Title="">
            <div style="display:flex; gap:4px;">
                @if (context.Status == "Draft")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="@(() => ReleasePlan(context.Id))">릴리스</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelPlan(context.Id))">취소</NexaButton>
                }
                @if (context.Status == "Released")
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="@(() => StartPlan(context.Id))">시작</NexaButton>
                    <NexaButton Variant="NexaButton.ButtonVariant.Danger" OnClick="@(() => CancelPlan(context.Id))">취소</NexaButton>
                }
                @if (context.Status == "InProgress")
                {
                    <NexaButton OnClick="@(() => CompletePlan(context.Id))">완료</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="생산 계획 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.PlanId"   Placeholder="계획 ID *" />
            <NexaTextBox @bind-Value="_form.PlanName" Placeholder="계획명 *" />
            <NexaTextBox @bind-Value="_form.PlantId"  Placeholder="Plant ID *" />
            <NexaTextBox @bind-Value="_form.ProductId" Placeholder="제품 ID *" />
            <NexaNumberInput @bind-Value="_form.Qty"    Min="1" />
            <NexaDateInput @bind-Value="_form.StartDate" />
            <NexaDateInput @bind-Value="_form.EndDate" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreatePlan">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<ProductionPlanDto> _items = new();
    private string _plantId = string.Empty;
    private bool _showCreate;
    private PlanForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData() => _items = await Api.GetPlansAsync(_plantId);

    private void OpenCreateDialog() { _form = new() { PlantId = _plantId }; _showCreate = true; }

    private async Task CreatePlan()
    {
        await Api.CreatePlanAsync(new
        {
            _form.PlanId, _form.PlanName, _form.PlantId, _form.ProductId,
            Qty = _form.Qty, StartDate = _form.StartDate, EndDate = _form.EndDate
        });
        _showCreate = false;
        await LoadData();
    }

    private async Task StartPlan(string id)    { await Api.StartPlanAsync(id);    await LoadData(); }
    private async Task ReleasePlan(string id)  { await Api.ReleasePlanAsync(id);  await LoadData(); }
    private async Task CompletePlan(string id) { await Api.CompletePlanAsync(id); await LoadData(); }
    private async Task CancelPlan(string id)   { await Api.CancelPlanAsync(id);   await LoadData(); }

    private sealed class PlanForm
    {
        public string   PlanId    { get; set; } = string.Empty;
        public string   PlanName  { get; set; } = string.Empty;
        public string   PlantId   { get; set; } = string.Empty;
        public string   ProductId { get; set; } = string.Empty;
        public decimal  Qty       { get; set; } = 1;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate   { get; set; } = DateTime.Today.AddDays(7);
    }
}
