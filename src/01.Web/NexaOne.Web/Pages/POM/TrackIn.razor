@page "/pom/track-in"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">Lot Track In</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">Lot 생성</NexaButton>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<NexaConditionGrid TRow="LotDto" Items="_items">
    <ConditionPanel>
        <NexaSelect TValue="string" @bind-Value="_stateFilter">
            <option value="">상태 전체</option>
            @foreach (var s in _states)
            {
                <option value="@s">@s</option>
            }
        </NexaSelect>
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((LotDto r) => r.Id)"               Title="Lot ID" />
        <PropertyColumn Property="@((LotDto r) => r.WorkOrderId)"      Title="작업지시" />
        <PropertyColumn Property="@((LotDto r) => r.ProductId)"        Title="제품" />
        <PropertyColumn Property="@((LotDto r) => r.Qty)"              Title="수량"      Format="N1" />
        <PropertyColumn Property="@((LotDto r) => r.CurrentProcessId)" Title="현재 공정" />
        <PropertyColumn Property="@((LotDto r) => r.EquipmentId)"      Title="설비" />
        <TemplateColumn TGridItem="LotDto" Title="상태">
            <StatusBadge Value="@context.State" />
        </TemplateColumn>
        <TemplateColumn TGridItem="LotDto" Title="Hold">
            @(context.IsHold ? "Y" : "")
        </TemplateColumn>
        <TemplateColumn TGridItem="LotDto" Title="">
            <div style="display:flex; gap:4px;">
                @if (context.State == "Queued" && !context.IsHold)
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Primary"
                                OnClick="@(() => OpenTrackInDialog(context))">Track In</NexaButton>
                }
                @if (!context.IsHold && context.State is not ("Completed" or "Consumed"))
                {
                    <NexaButton Variant="NexaButton.ButtonVariant.Warning"
                                OnClick="@(() => HoldLot(context.Id))">Hold</NexaButton>
                }
                @if (context.IsHold)
                {
                    <NexaButton OnClick="@(() => ReleaseHold(context.Id))">Hold 해제</NexaButton>
                }
            </div>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="Lot 생성">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_createForm.LotId"       Placeholder="Lot ID *" />
            <NexaTextBox @bind-Value="_createForm.WorkOrderId" Placeholder="작업지시 ID" />
            <NexaTextBox @bind-Value="_createForm.ProductId"   Placeholder="제품 ID *" />
            <NexaNumberInput @bind-Value="_createForm.Qty" Min="0.0001" />
            <NexaTextBox @bind-Value="_createForm.RouteSteps"  Placeholder="공정 경로 (쉼표 구분, 예: CUT,ASSY,TEST) *" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateLot">생성</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

<NexaModal @bind-Visible="_showTrackIn" Title="@($"Track In — {_targetLotId}")">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_trackInForm.EquipmentId" Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_trackInForm.RecipeDefId" Placeholder="Recipe ID (선택)" />
            <NexaNumberInput @bind-Value="_trackInForm.RecipeDefVersion" Placeholder="Recipe 버전 (선택)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="ConfirmTrackIn">Track In</NexaButton>
        <NexaButton OnClick="@(() => _showTrackIn = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private static readonly IReadOnlyList<string> _states =
        new[] { "Queued", "Processing", "Completed", "Consumed" };

    private List<LotDto> _items = new();
    private string _plantId = string.Empty;
    private string? _stateFilter = "Queued";
    private string? _error;

    private bool _showCreate;
    private CreateForm _createForm = new();

    private bool _showTrackIn;
    private string _targetLotId = string.Empty;
    private TrackInForm _trackInForm = new();

    protected override async Task OnInitializedAsync()
    {
        _plantId = await AuthContext.GetPlantIdAsync() ?? string.Empty;
        await LoadData();
    }

    private async Task LoadData()
    {
        _error = null;
        _items = await Api.GetLotsAsync(_plantId, _stateFilter);
    }

    private void OpenCreateDialog() { _createForm = new(); _showCreate = true; }

    private async Task CreateLot()
    {
        var steps = (_createForm.RouteSteps ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var (_, error) = await Api.CreateLotAsync(new
        {
            PlantId = _plantId,
            _createForm.LotId,
            WorkOrderId = string.IsNullOrWhiteSpace(_createForm.WorkOrderId) ? null : _createForm.WorkOrderId,
            _createForm.ProductId,
            _createForm.Qty,
            RouteSteps = steps
        });
        _error = error;
        if (error is null)
        {
            _showCreate = false;
            await LoadData();
        }
    }

    private void OpenTrackInDialog(LotDto lot)
    {
        _targetLotId = lot.Id;
        _trackInForm = new();
        _showTrackIn = true;
    }

    private async Task ConfirmTrackIn()
    {
        var (_, error) = await Api.TrackInAsync(_targetLotId, new
        {
            PlantId = _plantId,
            _trackInForm.EquipmentId,
            RecipeDefId = string.IsNullOrWhiteSpace(_trackInForm.RecipeDefId) ? null : _trackInForm.RecipeDefId,
            _trackInForm.RecipeDefVersion
        });
        _error = error;
        if (error is null)
        {
            _showTrackIn = false;
            await LoadData();
        }
    }

    private async Task HoldLot(string lotId)
    {
        _error = await Api.HoldLotAsync(lotId) ? null : "Hold에 실패했습니다.";
        await LoadData();
    }

    private async Task ReleaseHold(string lotId)
    {
        _error = await Api.ReleaseLotHoldAsync(lotId) ? null : "Hold 해제에 실패했습니다.";
        await LoadData();
    }

    private sealed class CreateForm
    {
        public string  LotId       { get; set; } = string.Empty;
        public string? WorkOrderId { get; set; }
        public string  ProductId   { get; set; } = string.Empty;
        public decimal Qty         { get; set; } = 1;
        public string? RouteSteps  { get; set; }
    }

    private sealed class TrackInForm
    {
        public string EquipmentId      { get; set; } = string.Empty;
        public string? RecipeDefId     { get; set; }
        public int?   RecipeDefVersion { get; set; }
    }
}
