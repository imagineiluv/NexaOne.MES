@page "/shp/shipments"
@attribute [Authorize]
@inject IApiClient Api
@inject AuthContextService AuthContext

<div class="page-header">
    <h1 class="page-title">출하 이력</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog"
              Disabled="@(!(!string.IsNullOrWhiteSpace(_orderId)))">출하 기록</NexaButton>
</div>

<NexaConditionGrid TRow="ShipmentHistoryDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_orderId" Placeholder="납품 주문 ID *" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.Id)"          Title="이력 ID" />
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.ShippedAt)"   Title="출하일시"    Format="yyyy-MM-dd HH:mm" />
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.ShippedQty)"  Title="출하 수량" />
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.ShippedBy)"   Title="출하자" />
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.Carrier)"     Title="운송사" />
        <PropertyColumn Property="@((ShipmentHistoryDto r) => r.TrackingNo)"  Title="운송장 번호" />
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="출하 기록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.HistoryId"  Placeholder="이력 ID *" />
            <NexaNumberInput @bind-Value="_form.ShippedQty" Min="0.01" Step="1" Placeholder="출하 수량 *" />
            <NexaTextBox @bind-Value="_form.ShippedBy"  Placeholder="출하자 ID *" />
            <NexaTextBox @bind-Value="_form.Carrier"    Placeholder="운송사 (선택)" />
            <NexaTextBox @bind-Value="_form.TrackingNo" Placeholder="운송장 번호 (선택)" />
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">기록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<ShipmentHistoryDto> _items = new();
    private string _orderId = string.Empty;
    private bool _showCreate;
    private ShipForm _form = new();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
        => _currentUserId = await AuthContext.GetUserIdAsync() ?? string.Empty;

    private async Task LoadData()
    {
        if (!string.IsNullOrWhiteSpace(_orderId))
            _items = await Api.GetShipmentHistoryAsync(_orderId);
    }

    private void OpenCreateDialog()
    {
        _form = new() { ShippedBy = _currentUserId };
        _showCreate = true;
    }

    private async Task Create()
    {
        await Api.RecordShipmentAsync(_orderId, new
        {
            HistoryId = _form.HistoryId, ShippedQty = _form.ShippedQty,
            ShippedBy = _form.ShippedBy,
            Carrier = string.IsNullOrEmpty(_form.Carrier) ? null : _form.Carrier,
            TrackingNo = string.IsNullOrEmpty(_form.TrackingNo) ? null : _form.TrackingNo
        });
        _showCreate = false;
        await LoadData();
    }

    private sealed class ShipForm
    {
        public string  HistoryId  { get; set; } = string.Empty;
        public decimal ShippedQty { get; set; }
        public string  ShippedBy  { get; set; } = string.Empty;
        public string? Carrier    { get; set; }
        public string? TrackingNo { get; set; }
    }
}
