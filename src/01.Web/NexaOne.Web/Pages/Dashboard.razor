@page "/"
@attribute [Authorize]
@inject IApiClient Api
@inject NavigationManager Nav
@inject NexaHubService HubService
@implements IAsyncDisposable

<div class="page-header">
    <h1 class="page-title">대시보드</h1>
    <DxButton Text="새로고침" Click="LoadData" />
</div>

@if (_summary is null)
{
    <p style="color:#94a3b8; padding:2rem;">로딩 중...</p>
}
else
{
    <div class="dashboard-grid">
        <div class="kpi-card kpi-danger" @onclick='@(() => Nav.NavigateTo("/ept/alarms"))'>
            <div class="kpi-value">@_summary.ActiveAlarms</div>
            <div class="kpi-label">미해제 알람</div>
            <div class="kpi-sub">EPT</div>
        </div>

        <div class="kpi-card kpi-warning" @onclick='@(() => Nav.NavigateTo("/ems/work-orders"))'>
            <div class="kpi-value">@_summary.IssuedWorkOrders</div>
            <div class="kpi-label">대기 작업 지시</div>
            <div class="kpi-sub">EMS · Issued</div>
        </div>

        <div class="kpi-card kpi-primary" @onclick='@(() => Nav.NavigateTo("/ems/work-orders"))'>
            <div class="kpi-value">@_summary.InProgressWorkOrders</div>
            <div class="kpi-label">진행 중 작업 지시</div>
            <div class="kpi-sub">EMS · InProgress</div>
        </div>

        <div class="kpi-card kpi-success" @onclick='@(() => Nav.NavigateTo("/ppm/plans"))'>
            <div class="kpi-value">@_summary.ReleasedPlans</div>
            <div class="kpi-label">릴리스된 생산 계획</div>
            <div class="kpi-sub">PPM · Released</div>
        </div>

        <div class="kpi-card kpi-info" @onclick='@(() => Nav.NavigateTo("/rms/recipes"))'>
            <div class="kpi-value">@_summary.PendingRecipeApprovals</div>
            <div class="kpi-label">레시피 승인 대기</div>
            <div class="kpi-sub">RMS · WaitApproval</div>
        </div>

        <div class="kpi-card kpi-neutral" @onclick='@(() => Nav.NavigateTo("/dlv/orders"))'>
            <div class="kpi-value">@_summary.OpenDeliveryOrders</div>
            <div class="kpi-label">진행 중 납품 주문</div>
            <div class="kpi-sub">DLV · Draft + Confirmed</div>
        </div>
    </div>
}

@code {
    private DashboardSummaryDto? _summary;

    private CoalescingTrigger? _refreshTrigger;
    private FallbackPoller? _fallbackPoller;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        // §20.9: 여러 소스(대시보드·알람·작업지시)의 갱신 이벤트 폭주를 1초 단위로 병합한다
        _refreshTrigger = new CoalescingTrigger(RefreshAsync);
        // §20.9: 허브 연결이 끊긴 동안은 주기 조회 폴백으로 갱신한다
        _fallbackPoller = new FallbackPoller(HubService, RefreshAsync);

        HubService.OnDashboardRefresh += OnHubRefresh;
        HubService.OnAlarmUpdated    += OnHubRefresh;
        HubService.OnWorkOrderUpdated += OnHubRefresh;
        await LoadData();
    }

    // 조회 실패(null) 시 표시 중인 KPI를 유지한다 — 폴백/병합 갱신 실패가 '로딩 중...'으로 되돌리지 않도록 (§20.9)
    private async Task LoadData() => _summary = await Api.GetDashboardAsync() ?? _summary;

    // §20.9: 폼이 이미 dispose됐으면 수신 이벤트를 무시한다
    private void OnHubRefresh()
    {
        if (_disposed) return;
        _refreshTrigger?.Signal();
    }

    // 타이머/허브 스레드에서 호출될 수 있으므로 InvokeAsync로 UI 스레드 전환 (§20.9)
    private Task RefreshAsync() => InvokeAsync(async () =>
    {
        if (_disposed) return;
        await LoadData();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        HubService.OnDashboardRefresh -= OnHubRefresh;
        HubService.OnAlarmUpdated    -= OnHubRefresh;
        HubService.OnWorkOrderUpdated -= OnHubRefresh;
        _refreshTrigger?.Dispose();
        _fallbackPoller?.Dispose();
        return ValueTask.CompletedTask;
    }
}
