@page "/fdc/alarm-configs"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 알람 설정</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreate">알람 설정 등록</NexaButton>
</div>

<NexaConditionGrid TRow="FdcAlarmConfigDto" Items="_configs">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaButton OnClick="Load">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((FdcAlarmConfigDto r) => r.Id)" Title="설정 ID" />
        <PropertyColumn Property="@((FdcAlarmConfigDto r) => r.EquipmentId)" Title="설비" />
        <PropertyColumn Property="@((FdcAlarmConfigDto r) => r.ParameterId)" Title="파라미터" />
        <TemplateColumn TGridItem="FdcAlarmConfigDto" Title="레벨">
            <StatusBadge Value="@(context.AlarmLevel)" />
        </TemplateColumn>
        <PropertyColumn Property="@((FdcAlarmConfigDto r) => r.Operator)" Title="연산자" />
        <PropertyColumn Property="@((FdcAlarmConfigDto r) => r.ThresholdValue)" Title="임계치" />
        <TemplateColumn TGridItem="FdcAlarmConfigDto" Title="활성">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="FDC 알람 설정 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.AlarmConfigId" Placeholder="설정 ID *" />
            <NexaTextBox @bind-Value="_form.EquipmentId"   Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.ParameterId"   Placeholder="파라미터 ID *" />
            <NexaSelect TValue="string" @bind-Value="_form.AlarmLevel">
                <option value="">레벨 (Warning/Critical) *</option>
                @foreach (var x in _levels) { <option value="@x">@x</option> }
            </NexaSelect>
            <NexaSelect TValue="string" @bind-Value="_form.Operator">
                <option value="">연산자 (GT/LT/GTE/LTE/EQ) *</option>
                @foreach (var x in _operators) { <option value="@x">@x</option> }
            </NexaSelect>
            <NexaNumberInput @bind-Value="_form.Threshold" Placeholder="임계치 *" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<FdcAlarmConfigDto> _configs = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private ConfigForm _form = new();
    private string? _createError;

    private readonly string[] _levels = { "Warning", "Critical" };
    private readonly string[] _operators = { "GT", "LT", "GTE", "LTE", "EQ" };

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _configs = await Api.GetFdcAlarmConfigsAsync(_equipmentId);

    private void OpenCreate() { _form = new() { EquipmentId = _equipmentId }; _createError = null; _showCreate = true; }

    private async Task Create()
    {
        _createError = null;
        var result = await Api.CreateFdcAlarmConfigAsync(new
        {
            _form.AlarmConfigId,
            _form.EquipmentId,
            _form.ParameterId,
            _form.AlarmLevel,
            _form.Operator,
            _form.Threshold
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await Load();
    }

    private sealed class ConfigForm
    {
        public string  AlarmConfigId { get; set; } = string.Empty;
        public string  EquipmentId   { get; set; } = string.Empty;
        public string  ParameterId   { get; set; } = string.Empty;
        public string  AlarmLevel    { get; set; } = "Warning";
        public string  Operator      { get; set; } = "GT";
        public decimal Threshold     { get; set; }
    }
}
