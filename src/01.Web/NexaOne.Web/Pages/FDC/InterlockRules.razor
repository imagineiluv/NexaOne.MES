@page "/fdc/interlock"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">인터록 규칙</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">규칙 등록</NexaButton>
</div>

<NexaConditionGrid TRow="InterlockRuleDto" Items="_items">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaButton OnClick="LoadData">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((InterlockRuleDto r) => r.Id)"             Title="규칙 ID" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.RuleName)"       Title="규칙명" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.EquipmentId)"    Title="설비" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.ParameterId)"    Title="파라미터" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.Operator)"       Title="연산자" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.ThresholdValue)" Title="임계값" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.Action)"         Title="조치" />
        <PropertyColumn Property="@((InterlockRuleDto r) => r.Priority)"       Title="우선순위" />
        <TemplateColumn TGridItem="InterlockRuleDto" Title="활성">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="인터록 규칙 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.RuleId"         Placeholder="규칙 ID *" />
            <NexaTextBox @bind-Value="_form.RuleName"       Placeholder="규칙명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentId"    Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.ParameterId"    Placeholder="파라미터 ID *" />
            <NexaSelect TValue="string" @bind-Value="_form.Operator"><option value="">연산자 *</option>@foreach (var op in _operators) { <option value="@op">@op</option> }</NexaSelect>
            <NexaNumberInput @bind-Value="_form.ThresholdValue" Placeholder="임계값 *" />
            <NexaSelect TValue="string" @bind-Value="_form.Action"><option value="">조치 *</option>@foreach (var ac in _actions) { <option value="@ac">@ac</option> }</NexaSelect>
            <NexaNumberInput @bind-Value="_form.Priority"      Placeholder="우선순위 (낮을수록 먼저)" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateRule">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<InterlockRuleDto> _items = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private RuleForm _form = new();
    private string? _createError;

    private static readonly List<string> _operators = new() { "GT", "GTE", "LT", "LTE", "EQ" };
    private static readonly List<string> _actions   = new() { "STOP", "ALARM", "NOTIFY" };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData() => _items = await Api.GetInterlockRulesAsync(_equipmentId);

    private void OpenCreateDialog() { _form = new(); _createError = null; _showCreate = true; }

    private async Task CreateRule()
    {
        _createError = null;
        var result = await Api.CreateInterlockRuleAsync(new
        {
            RuleId         = _form.RuleId,
            RuleName       = _form.RuleName,
            EquipmentId    = _form.EquipmentId,
            ParameterId    = _form.ParameterId,
            Operator       = _form.Operator,
            ThresholdValue = _form.ThresholdValue,
            Action         = _form.Action,
            Priority       = _form.Priority
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await LoadData();
    }

    private sealed class RuleForm
    {
        public string  RuleId         { get; set; } = string.Empty;
        public string  RuleName       { get; set; } = string.Empty;
        public string  EquipmentId    { get; set; } = string.Empty;
        public string  ParameterId    { get; set; } = string.Empty;
        public string  Operator       { get; set; } = string.Empty;
        public decimal ThresholdValue { get; set; }
        public string  Action         { get; set; } = string.Empty;
        public int     Priority       { get; set; } = 1;
    }
}
