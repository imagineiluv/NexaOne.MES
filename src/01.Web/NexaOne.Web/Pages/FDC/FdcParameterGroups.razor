@page "/fdc/parameter-groups"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 파라미터 그룹</h1>
    <DxButton Text="그룹 등록" RenderStyle="ButtonRenderStyle.Primary" Click="OpenCreate" />
</div>

<NexaConditionGrid TRow="FdcParameterGroupDto" Items="_groups">
    <ConditionPanel>
        <DxTextBox @bind-Text="_equipmentId" NullText="설비 ID" />
        <DxButton Text="조회" Click="Load" />
    </ConditionPanel>
    <Columns>
        <DxGridDataColumn FieldName="Id"           Caption="그룹 ID"  Width="140px" />
        <DxGridDataColumn FieldName="GroupName"    Caption="그룹명"   Width="200px" />
        <DxGridDataColumn FieldName="EquipmentId"  Caption="설비"     Width="120px" />
        <DxGridDataColumn FieldName="Description"  Caption="설명" />
        <DxGridDataColumn FieldName="DisplayOrder" Caption="순서"     Width="70px" />
        <DxGridDataColumn FieldName="IsActive"     Caption="활성"     Width="70px">
            <CellDisplayTemplate>
                <StatusBadge Value="@((bool)context.Value ? "Active" : "Inactive")" />
            </CellDisplayTemplate>
        </DxGridDataColumn>
    </Columns>
</NexaConditionGrid>

@if (_showCreate)
{
    <DxPopup @bind-Visible="_showCreate" HeaderText="FDC 파라미터 그룹 등록" Width="460px">
        <BodyContentTemplate>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
                <DxTextBox @bind-Text="_form.GroupId"     NullText="그룹 ID *" />
                <DxTextBox @bind-Text="_form.GroupName"   NullText="그룹명 *" />
                <DxTextBox @bind-Text="_form.EquipmentId" NullText="설비 ID *" />
                <DxTextBox @bind-Text="_form.Description" NullText="설명" />
                <DxSpinEdit @bind-Value="_form.DisplayOrder" Placeholder="표시 순서" />
                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
                }
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="등록" RenderStyle="ButtonRenderStyle.Primary" Click="Create" />
            <DxButton Text="취소" Click="@(() => _showCreate = false)" CssClass="ms-2" />
        </FooterContentTemplate>
    </DxPopup>
}

@code {
    private List<FdcParameterGroupDto> _groups = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private GroupForm _form = new();
    private string? _createError;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _groups = await Api.GetFdcParameterGroupsAsync(_equipmentId);

    private void OpenCreate() { _form = new() { EquipmentId = _equipmentId }; _createError = null; _showCreate = true; }

    private async Task Create()
    {
        _createError = null;
        var result = await Api.CreateFdcParameterGroupAsync(new
        {
            _form.GroupId,
            _form.GroupName,
            _form.EquipmentId,
            _form.Description,
            _form.DisplayOrder
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await Load();
    }

    private sealed class GroupForm
    {
        public string  GroupId      { get; set; } = string.Empty;
        public string  GroupName    { get; set; } = string.Empty;
        public string  EquipmentId  { get; set; } = string.Empty;
        public string? Description  { get; set; }
        public int     DisplayOrder { get; set; }
    }
}
