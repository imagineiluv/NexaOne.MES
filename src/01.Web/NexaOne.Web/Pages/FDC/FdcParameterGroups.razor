@page "/fdc/parameter-groups"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 파라미터 그룹</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreate">그룹 등록</NexaButton>
</div>

<NexaConditionGrid TRow="FdcParameterGroupDto" Items="_groups">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaButton OnClick="Load">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((FdcParameterGroupDto r) => r.Id)"           Title="그룹 ID" />
        <PropertyColumn Property="@((FdcParameterGroupDto r) => r.GroupName)"    Title="그룹명" />
        <PropertyColumn Property="@((FdcParameterGroupDto r) => r.EquipmentId)"  Title="설비" />
        <PropertyColumn Property="@((FdcParameterGroupDto r) => r.Description)"  Title="설명" />
        <PropertyColumn Property="@((FdcParameterGroupDto r) => r.DisplayOrder)" Title="순서" />
        <TemplateColumn TGridItem="FdcParameterGroupDto" Title="활성">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

<NexaModal @bind-Visible="_showCreate" Title="FDC 파라미터 그룹 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.GroupId"     Placeholder="그룹 ID *" />
            <NexaTextBox @bind-Value="_form.GroupName"   Placeholder="그룹명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentId" Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.Description" Placeholder="설명" />
            <NexaNumberInput @bind-Value="_form.DisplayOrder" Placeholder="표시 순서" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="Create">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)" Class="ms-2">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<FdcParameterGroupDto> _groups = new();
    private string _equipmentId = string.Empty;
    private bool _showCreate;
    private GroupForm _form = new();
    private string? _createError;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _groups = await Api.GetFdcParameterGroupsAsync(_equipmentId);

    private void OpenCreate() { _form = new() { EquipmentId = _equipmentId }; _createError = null; _showCreate = true; }

    private async Task Create()
    {
        _createError = null;
        var result = await Api.CreateFdcParameterGroupAsync(new
        {
            _form.GroupId,
            _form.GroupName,
            _form.EquipmentId,
            _form.Description,
            _form.DisplayOrder
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await Load();
    }

    private sealed class GroupForm
    {
        public string  GroupId      { get; set; } = string.Empty;
        public string  GroupName    { get; set; } = string.Empty;
        public string  EquipmentId  { get; set; } = string.Empty;
        public string? Description  { get; set; }
        public int     DisplayOrder { get; set; }
    }
}
