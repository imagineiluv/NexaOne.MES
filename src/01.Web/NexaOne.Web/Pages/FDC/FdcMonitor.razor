@page "/fdc/monitor"
@attribute [Authorize]
@inject IApiClient Api
@inject NexaHubService HubService
@inject WaitOverlayService WaitSvc
@inject NavigationManager Nav
@inject FdcMonitorState State
@using NexaOne.Web.Services
@implements IAsyncDisposable

<div class="page-header">
    <h1 class="page-title">FDC 실시간 모니터</h1>
</div>

<div class="fdc-monitor-toolbar">
    <NexaTextBox @bind-Value="State.ParameterId" Placeholder="파라미터 ID" style="width:220px;" />
    <NexaNumberInput @bind-Value="State.Limit" Min="10" Max="200" style="width:100px;" />
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="LoadData">조회</NexaButton>
    <ConditionMenu @ref="_condMenu"
                   GetValues="GetConditionValues"
                   OnApply="ApplyConditionValues"
                   AutoSearchOnApply="true"
                   OnSearch="LoadData" />
    <NexaButton Variant="@(State.IsWatching ? NexaButton.ButtonVariant.Warning : NexaButton.ButtonVariant.Success)"
                OnClick="ToggleWatch">@(State.IsWatching ? "실시간 중지" : "실시간 시작")</NexaButton>
    @if (State.IsWatching)
    {
        <span class="fdc-live-badge">● LIVE</span>
    }
</div>

@if (_latestValue is not null)
{
    <div class="fdc-summary-bar @(_latestValue.IsOutOfSpec ? "oos" : "ok")">
        <span class="fdc-summary-label">최신 값</span>
        <span class="fdc-summary-value">@_latestValue.Value.ToString("F4")</span>
        <span class="fdc-summary-range">범위 [@_latestValue.LowerLimit ~ @_latestValue.UpperLimit]</span>
        <span class="fdc-summary-quality">품질: @_latestValue.Quality</span>
        @if (_latestValue.IsOutOfSpec)
        {
            <span class="fdc-summary-oos">⚠ 범위 초과</span>
        }
    </div>
}

@if (State.InterlockLog.Count > 0)
{
    <div class="fdc-interlock-panel">
        <div class="fdc-interlock-header">
            <span>인터록 발동 이력</span>
            <NexaButton Variant="NexaButton.ButtonVariant.Secondary"
                        OnClick="@(() => State.InterlockLog.Clear())">지우기</NexaButton>
        </div>
        @foreach (var log in State.InterlockLog.TakeLast(10).Reverse())
        {
            <div class="fdc-interlock-item action-@log.Action.ToLower()">
                <span class="fdc-interlock-time">@log.Time.ToString("HH:mm:ss")</span>
                <span class="fdc-interlock-action">[@log.Action]</span>
                <span class="fdc-interlock-msg">@log.Message</span>
            </div>
        }
    </div>
}

@* OOS 행 강조(.row-oos)는 QuickGrid(.NET 8)에 행 클래스 훅이 없어 테이블을 직접 렌더한다 —
   구 DxGrid CustomizeElement 동작을 동등하게 보존. _items는 State.Limit(≤200)로 제한된 스냅숏. *@
<table class="nexa-grid w-full text-sm fdc-data-grid">
    <thead>
        <tr>
            <th>수집 시각</th><th>값</th><th>품질</th><th>하한</th><th>상한</th><th>범위 초과</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in _items)
        {
            <tr class="@(row.IsOutOfSpec ? "row-oos" : null)">
                <td>@row.CollectedAt.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                <td>@row.Value</td>
                <td>@row.Quality</td>
                <td>@row.LowerLimit</td>
                <td>@row.UpperLimit</td>
                <td><span class="@(row.IsOutOfSpec ? "badge-oos" : "badge-ok")">@(row.IsOutOfSpec ? "OOS" : "OK")</span></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<FdcCollectDataDto> _items = [];
    private FdcCollectDataDto? _latestValue;
    private ConditionMenu? _condMenu;

    private CoalescingTrigger? _fdcBatch;
    private FallbackPoller? _fallbackPoller;
    private bool _disposed;

    protected override void OnInitialized()
    {
        // §20.9: FDC 수집값은 버리지 않고(서버 DB 저장) 렌더링만 1초 주기로 배치 처리한다 — 트레일링 전용
        _fdcBatch = new CoalescingTrigger(RefreshDataAsync, leadingEdge: false);
        // §20.9: 허브 연결이 끊긴 동안은 주기 조회 폴백으로 갱신한다 (실시간 감시 중일 때만)
        _fallbackPoller = new FallbackPoller(HubService,
            () => State.IsWatching ? RefreshDataAsync() : Task.CompletedTask);

        HubService.OnFdcDataReceived   += OnHubFdcData;
        HubService.OnInterlockTriggered += OnHubInterlock;

        ApplyLinkParameters();   // 메뉴 링크 파라미터 우선 적용 (설계 20.8)

        // §20.9 탭 비활성화 조항의 웹 적응: 탭 복귀(재생성) 시 감시 상태가 보존되어 있으면
        // 전체 재조회 1회로 부재 중 누적분을 일괄 반영하고 감시를 자동 재개한다.
        if (State.IsWatching && !string.IsNullOrWhiteSpace(State.ParameterId))
            _ = RefreshDataAsync();
    }

    // ── 조건 저장/불러오기 (설계 20.8) ────────────────────────────────────────

    // 링크 파라미터: /fdc/monitor?parameterid=PARAM01&limit=100 형태를 지원한다.
    private void ApplyLinkParameters()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(query)) return;

        var parsed = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(query.TrimStart('?'));
        foreach (var (key, value) in parsed)
        {
            switch (key.ToLowerInvariant())
            {
                case "parameterid": State.ParameterId = value.ToString(); break;
                case "limit":       State.Limit = ConditionValueAdapter.ToInt(value.ToString()) ?? State.Limit; break;
            }
        }
    }

    private Dictionary<string, string?> GetConditionValues() => new()
    {
        ["parameterid"] = State.ParameterId,
        ["limit"]       = ConditionValueAdapter.From(State.Limit),
    };

    private void ApplyConditionValues(IReadOnlyDictionary<string, string?> values)
    {
        if (values.TryGetValue("parameterid", out var pid)) State.ParameterId = pid ?? string.Empty;
        if (values.TryGetValue("limit", out var limit))     State.Limit = ConditionValueAdapter.ToInt(limit) ?? State.Limit;
    }

    private async Task LoadData()
    {
        if (string.IsNullOrWhiteSpace(State.ParameterId)) return;
        using var _ = WaitSvc.Show("조회 중...");
        var items = await Api.GetLatestFdcDataAsync(State.ParameterId, State.Limit);
        if (items is null) return;   // 조회 실패 — 기존 데이터 유지, latest 자동 저장도 하지 않는다

        _items = items;
        _latestValue = _items.LastOrDefault();

        // 조회 '성공' 시에만 마지막 조회 조건을 latest로 자동 저장 (설계 20.8)
        if (_condMenu is not null)
            await _condMenu.NotifySearchSucceededAsync();
    }

    private void ToggleWatch() => State.IsWatching = !State.IsWatching;

    // §20.9: FDC 수신 이벤트는 즉시 다시 그리지 않고 배치 트리거에 신호만 보낸다 (수집 폭주 시 렌더링 1초 1회)
    private void OnHubFdcData(NexaHubService.FdcDataPayload payload)
    {
        if (_disposed || !State.IsWatching) return;
        if (!string.IsNullOrEmpty(State.ParameterId) && payload.ParameterId != State.ParameterId) return;

        _fdcBatch?.Signal();
    }

    // §20.9: 실시간 배치/폴백 갱신 — 오버레이·latest 자동 저장 없이 데이터만 다시 그린다.
    // 타이머/허브 스레드에서 호출될 수 있으므로 InvokeAsync로 UI 스레드 전환.
    // 표시 등가성 한계: 화면은 '최신 N건 스냅숏'이다 — 1초 윈도 안에 N건을 넘는 고속 수집이
    // 일어나면 중간 샘플은 화면에 렌더링되지 않는다 (DB에는 전량 저장, §20.9 데이터 무손실 원칙).
    private Task RefreshDataAsync() => InvokeAsync(async () =>
    {
        if (_disposed || string.IsNullOrWhiteSpace(State.ParameterId)) return;

        var items = await Api.GetLatestFdcDataAsync(State.ParameterId, State.Limit);
        if (items is null) return;   // 갱신 실패 시 기존 표시 유지

        _items = items;
        _latestValue = _items.LastOrDefault();
        StateHasChanged();
    });

    private void OnHubInterlock(NexaHubService.InterlockTriggeredPayload payload)
    {
        if (_disposed || !State.IsWatching) return;
        if (!string.IsNullOrEmpty(State.ParameterId))
        {
            // 현재 파라미터와 관련없는 이벤트는 무시
            if (payload.ParameterId != State.ParameterId) return;
        }

        InvokeAsync(() =>
        {
            if (_disposed) return Task.CompletedTask;   // §20.9: dispose 이후 수신 이벤트 무시
            State.InterlockLog.Add(new FdcMonitorState.InterlockLogEntry(
                DateTime.Now, payload.Action, payload.Message));
            StateHasChanged();
            return Task.CompletedTask;
        });
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        HubService.OnFdcDataReceived    -= OnHubFdcData;
        HubService.OnInterlockTriggered -= OnHubInterlock;
        _fdcBatch?.Dispose();
        _fallbackPoller?.Dispose();
        return ValueTask.CompletedTask;
    }
}
