@page "/fdc/parameters"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 파라미터</h1>
    <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="OpenCreateDialog">파라미터 등록</NexaButton>
</div>

<NexaConditionGrid TRow="FdcParameterDto" Items="_params">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaButton OnClick="LoadParams">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((FdcParameterDto r) => r.Id)"               Title="파라미터 ID" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.ParameterName)"    Title="파라미터명" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.EquipmentId)"      Title="설비" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.Unit)"             Title="단위" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.LowerLimit)"       Title="하한" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.UpperLimit)"       Title="상한" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.LowerControlLimit)" Title="LCL" />
        <PropertyColumn Property="@((FdcParameterDto r) => r.UpperControlLimit)" Title="UCL" />
        <TemplateColumn TGridItem="FdcParameterDto" Title="활성">
            <StatusBadge Value="@(context.IsActive ? "Active" : "Inactive")" />
        </TemplateColumn>
        <TemplateColumn TGridItem="FdcParameterDto" Title="">
            <NexaButton OnClick="@(() => OpenDataPanel(context.Id))">데이터 조회</NexaButton>
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@if (_selectedParamId is not null)
{
    <div class="page-header" style="margin-top:2rem;">
        <h2 class="page-title" style="font-size:1.1rem;">수집 데이터 — @_selectedParamId</h2>
    </div>

    <div style="display:flex; gap:0.75rem; align-items:center; margin-bottom:1rem;">
        <NexaDateInput @bind-Value="_dataFrom" />
        <span>~</span>
        <NexaDateInput @bind-Value="_dataTo" />
        <NexaButton OnClick="LoadCollectData">조회</NexaButton>
    </div>

    <NexaConditionGrid TRow="FdcCollectDataDto" Items="_collectData">
        <Columns>
            <PropertyColumn Property="@((FdcCollectDataDto r) => r.CollectedAt)" Title="수집 시각" Format="yyyy-MM-dd HH:mm:ss" />
            <PropertyColumn Property="@((FdcCollectDataDto r) => r.Value)"       Title="값" />
            <PropertyColumn Property="@((FdcCollectDataDto r) => r.Quality)"     Title="품질" />
            <PropertyColumn Property="@((FdcCollectDataDto r) => r.LowerLimit)"  Title="하한" />
            <PropertyColumn Property="@((FdcCollectDataDto r) => r.UpperLimit)"  Title="상한" />
            <TemplateColumn TGridItem="FdcCollectDataDto" Title="범위 초과">
                <StatusBadge Value="@(context.IsOutOfSpec ? "OutOfSpec" : "OK")" />
            </TemplateColumn>
        </Columns>
    </NexaConditionGrid>
}

<NexaModal @bind-Visible="_showCreate" Title="FDC 파라미터 등록">
    <ChildContent>
        <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem;">
            <NexaTextBox @bind-Value="_form.ParameterId"   Placeholder="파라미터 ID *" />
            <NexaTextBox @bind-Value="_form.ParameterName" Placeholder="파라미터명 *" />
            <NexaTextBox @bind-Value="_form.EquipmentId"   Placeholder="설비 ID *" />
            <NexaTextBox @bind-Value="_form.Unit"          Placeholder="단위 (예: ℃, mbar)" />
            <NexaNumberInput @bind-Value="_form.LowerLimit"  Placeholder="하한 *" />
            <NexaNumberInput @bind-Value="_form.UpperLimit"  Placeholder="상한 *" />
            @if (!string.IsNullOrEmpty(_createError))
            {
                <div style="color:#dc2626; font-size:0.875rem;">@_createError</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <NexaButton Variant="NexaButton.ButtonVariant.Primary" OnClick="CreateParameter">등록</NexaButton>
        <NexaButton OnClick="@(() => _showCreate = false)">취소</NexaButton>
    </Footer>
</NexaModal>

@code {
    private List<FdcParameterDto>     _params      = new();
    private List<FdcCollectDataDto>   _collectData = new();
    private string _equipmentId     = string.Empty;
    private string? _selectedParamId;
    private DateTime _dataFrom      = DateTime.Today.AddDays(-1);
    private DateTime _dataTo        = DateTime.Today;

    private bool _showCreate;
    private ParamForm _form = new();
    private string? _createError;

    protected override async Task OnInitializedAsync() => await LoadParams();

    private async Task LoadParams() => _params = await Api.GetFdcParametersAsync(_equipmentId);

    private void OpenCreateDialog() { _form = new() { EquipmentId = _equipmentId }; _createError = null; _showCreate = true; }

    private async Task CreateParameter()
    {
        _createError = null;
        var result = await Api.CreateFdcParameterAsync(new
        {
            ParameterId   = _form.ParameterId,
            ParameterName = _form.ParameterName,
            EquipmentId   = _form.EquipmentId,
            Unit          = _form.Unit,
            LowerLimit    = _form.LowerLimit,
            UpperLimit    = _form.UpperLimit
        });
        if (result is null) { _createError = "등록에 실패했습니다."; return; }
        _showCreate = false;
        await LoadParams();
    }

    private async Task OpenDataPanel(string parameterId)
    {
        _selectedParamId = parameterId;
        await LoadCollectData();
    }

    private async Task LoadCollectData()
    {
        if (_selectedParamId is null) return;
        _collectData = await Api.GetFdcCollectDataAsync(_selectedParamId, _dataFrom, _dataTo.AddDays(1).AddSeconds(-1));
    }

    private sealed class ParamForm
    {
        public string  ParameterId   { get; set; } = string.Empty;
        public string  ParameterName { get; set; } = string.Empty;
        public string  EquipmentId   { get; set; } = string.Empty;
        public string  Unit          { get; set; } = string.Empty;
        public decimal LowerLimit    { get; set; }
        public decimal UpperLimit    { get; set; } = 100;
    }
}
