@page "/fdc/alarm-history"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 알람 이력</h1>
</div>

<NexaConditionGrid TRow="FdcAlarmHistoryDto" Items="_history">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaDateInput @bind-Value="_from" />
        <span>~</span>
        <NexaDateInput @bind-Value="_to" />
        <NexaButton OnClick="Load">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((FdcAlarmHistoryDto r) => r.OccurredAt)" Title="발생 시각" Format="yyyy-MM-dd HH:mm:ss" />
        <PropertyColumn Property="@((FdcAlarmHistoryDto r) => r.ParameterId)" Title="파라미터" />
        <TemplateColumn TGridItem="FdcAlarmHistoryDto" Title="레벨">
            <StatusBadge Value="@(context.AlarmLevel)" />
        </TemplateColumn>
        <PropertyColumn Property="@((FdcAlarmHistoryDto r) => r.TriggerValue)" Title="발생 값" />
        <PropertyColumn Property="@((FdcAlarmHistoryDto r) => r.Message)" Title="메시지" />
        <PropertyColumn Property="@((FdcAlarmHistoryDto r) => r.ClearedAt)" Title="해제 시각" Format="yyyy-MM-dd HH:mm:ss" />
        <TemplateColumn TGridItem="FdcAlarmHistoryDto" Title="해제">
            <StatusBadge Value="@(context.IsCleared ? "Cleared" : "Open")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@code {
    private List<FdcAlarmHistoryDto> _history = new();
    private string _equipmentId = string.Empty;
    private DateTime _from = DateTime.Today.AddDays(-7);
    private DateTime _to   = DateTime.Today;

    private async Task Load()
        => _history = await Api.GetFdcAlarmHistoryAsync(_equipmentId, _from, _to.AddDays(1).AddSeconds(-1));
}
