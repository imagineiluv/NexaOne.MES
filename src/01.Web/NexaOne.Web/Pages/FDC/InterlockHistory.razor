@page "/fdc/interlock-history"
@attribute [Authorize]
@inject IApiClient Api

<div class="page-header">
    <h1 class="page-title">FDC 인터락 이력</h1>
</div>

<NexaConditionGrid TRow="FdcInterlockHistoryDto" Items="_history">
    <ConditionPanel>
        <NexaTextBox @bind-Value="_equipmentId" Placeholder="설비 ID" />
        <NexaDateInput @bind-Value="_from" />
        <span>~</span>
        <NexaDateInput @bind-Value="_to" />
        <NexaButton OnClick="Load">조회</NexaButton>
    </ConditionPanel>
    <Columns>
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.TriggeredAt)" Title="발동 시각" Format="yyyy-MM-dd HH:mm:ss" />
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.ParameterId)" Title="파라미터" />
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.Action)" Title="액션" />
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.TriggerValue)" Title="발동 값" />
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.Message)" Title="메시지" />
        <PropertyColumn Property="@((FdcInterlockHistoryDto r) => r.ResolvedAt)" Title="해제 시각" Format="yyyy-MM-dd HH:mm:ss" />
        <TemplateColumn TGridItem="FdcInterlockHistoryDto" Title="해제">
            <StatusBadge Value="@(context.IsResolved ? "Resolved" : "Active")" />
        </TemplateColumn>
    </Columns>
</NexaConditionGrid>

@code {
    private List<FdcInterlockHistoryDto> _history = new();
    private string _equipmentId = string.Empty;
    private DateTime _from = DateTime.Today.AddDays(-7);
    private DateTime _to   = DateTime.Today;

    private async Task Load()
        => _history = await Api.GetInterlockHistoryAsync(_equipmentId, _from, _to.AddDays(1).AddSeconds(-1));
}
